+static void *test_push_after_wait(void *argument)
+{
+    test_delayed_push *delayed = argument;
+    int64_t deadline = test_now_ms() + 2000;
+    while (atomic_load(&delayed->waits->entered) <= delayed->baseline) {
+        if (test_now_ms() >= deadline)
+            return NULL;
+        sched_yield();
+    }
+    delayed->fired = 1;
+    test_push_message(delayed->transport, &delayed->message);
+    return NULL;
+}
+
+static void test_tcp(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_message sent;
+    ldnr_message incoming;
+    test_delayed_push delayed;
+    pthread_t thread;
+    uint64_t connection_id;
+    char buffer[32];
+    int client;
+    int listener;
+    int accepted;
+    int baseline;
+    ssize_t size;
+    unsigned acknowledgements;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    CHECK(ldnr_get_peer_name(context, client, &name) == 0);
+    CHECK(name.address == peer.address && name.port == peer.port);
+    CHECK(ldnr_get_sock_name(context, client, &name) == 0);
+    CHECK(name.address == ldnr_ipv4(192, 168, 44, 10) && name.port != 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+    CHECK(connection_id != 0);
+    CHECK(sent.proxy.destination_address == peer.address);
+    CHECK(sent.proxy.destination_port == peer.port);
+
+    CHECK(ldnr_send(context, client, "hello", 5, 0) == 5);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.proxy.size == 5 && memcmp(sent.proxy.data, "hello", 5) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = name.port;
+    memcpy(incoming.proxy.data, "stream", 6);
+    incoming.proxy.size = 6;
+    memset(&delayed, 0, sizeof(delayed));
+    delayed.transport = transport;
+    delayed.waits = &waits;
+    delayed.baseline = atomic_load(&waits.entered);
+    delayed.message = incoming;
+    CHECK(pthread_create(&thread, NULL, test_push_after_wait, &delayed) == 0);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recv(context, client, buffer, 2, 2, 1000);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(delayed.fired);
+    CHECK(size == 2 && memcmp(buffer, "st", 2) == 0);
+    CHECK(atomic_load(&waits.entered) > delayed.baseline);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    CHECK(ldnr_recv(context, client, buffer, 2, 0, 0) == 2);
+    CHECK(memcmp(buffer, "st", 2) == 0);
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 0) == 4);
+    CHECK(memcmp(buffer, "ream", 4) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.connection_id = connection_id;
+    test_push_message(transport, &incoming);
+    baseline = 0;
+    while (baseline++ < 1000) {
+        size = ldnr_recv(context, client, buffer, sizeof(buffer), 0, 10);
+        if (size == 0)
+            break;
+        CHECK(size == -1 && ldnr_last_errno() == TEST_EAGAIN);
+    }
+    CHECK(size == 0);
+    CHECK(ldnr_send(context, client, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EPIPE);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    name.address = ldnr_ipv4(192, 168, 44, 10);
+    name.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &name) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+    memset(&delayed, 0, sizeof(delayed));
+    delayed.transport = transport;
+    delayed.waits = &waits;
+    delayed.baseline = atomic_load(&waits.entered);
+    delayed.message = incoming;
+    CHECK(pthread_create(&thread, NULL, test_push_after_wait, &delayed) == 0);
+    accepted = ldnr_accept(context, listener, &peer, 1000);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(delayed.fired);
+    CHECK(accepted >= 0);
+    CHECK(peer.address == incoming.proxy.source_address);
+    CHECK(peer.port == incoming.proxy.source_port);
+    CHECK(atomic_load(&waits.entered) > delayed.baseline);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == 0);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(ldnr_get_peer_name(context, accepted, &peer) == 0);
+    CHECK(peer.address == incoming.proxy.source_address);
+    CHECK(peer.port == incoming.proxy.source_port);
+    CHECK(ldnr_get_sock_name(context, accepted, &name) == 0);
+    CHECK(name.address == incoming.proxy.destination_address);
+    CHECK(name.port == incoming.proxy.destination_port);
+
+    CHECK(ldnr_send(context, accepted, "reply", 5, 0) == 5);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(sent.proxy.size == 5 && memcmp(sent.proxy.data, "reply", 5) == 0);
+
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    memcpy(incoming.proxy.data, "request", 7);
+    incoming.proxy.size = 7;
+    test_push_message(transport, &incoming);
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recv(context, accepted, buffer, sizeof(buffer), 0, 1000) == 7);
+    CHECK(memcmp(buffer, "request", 7) == 0);
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.size = 0;
+    test_push_message(transport, &incoming);
+    CHECK(ldnr_recv(context, accepted, buffer, sizeof(buffer), 0, 1000) == 0);
+    CHECK(ldnr_close_socket(context, accepted) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+
+    transport->proxy_ack_status = TEST_ECONNREFUSED;
+    client = ldnr_socket(context, 2, 1, 6);
+    peer.address = ldnr_ipv4(192, 168, 44, 40);
+    peer.port = ldnr_htons(9000);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNREFUSED);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
+
+int main(void)
+{
+    test_offline_and_fd_limit();
+    test_udp();
+    test_tcp();
+    puts("PASS");
+    return 0;
+}
