index 0000000..e15fe0c
--- /dev/null
+++ b/dm/host/ldnr/tests/t_protocol.c
@@ -0,0 +1,794 @@
+#include "ldnr_protocol.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+
+#define CHECK(condition)                                                           \
+    do {                                                                           \
+        if (!(condition)) {                                                        \
+            fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #condition);  \
+            exit(1);                                                               \
+        }                                                                          \
+    } while (0)
+
+static void put16(uint8_t *p, uint16_t value)
+{
+    p[0] = (uint8_t)value;
+    p[1] = (uint8_t)(value >> 8);
+}
+
+static void put32(uint8_t *p, uint32_t value)
+{
+    p[0] = (uint8_t)value;
+    p[1] = (uint8_t)(value >> 8);
+    p[2] = (uint8_t)(value >> 16);
+    p[3] = (uint8_t)(value >> 24);
+}
+
+static void decode_ok(const uint8_t *frame, size_t size, ldnr_message *message)
+{
+    memset(message, 0, sizeof(*message));
+    if (ldnr_protocol_decode(frame, size, message) != 0) {
+        const char *error = ldnr_protocol_error();
+        fprintf(stderr, "decode failed: %s\n", error ? error : "(no error)");
+        exit(1);
+    }
+}
+
+static void decode_bad(const uint8_t *frame, size_t size)
+{
+    ldnr_message message;
+
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode(frame, size, &message) != 0);
+    ldnr_protocol_message_free(&message);
+}
+
+static void encode_ok(const uint8_t *expected, size_t expected_size,
+                      ldnr_message_type type, uint64_t request_id,
+                      uint64_t network_id, const ldnr_message *message,
+                      const ldnr_operation *operation)
+{
+    uint8_t output[2048];
+    size_t size = 0;
+
+    CHECK(expected_size <= sizeof(output));
+    memset(output, 0xa5, sizeof(output));
+    if (ldnr_protocol_encode(output, expected_size, &size, type, request_id,
+                             network_id, message, operation) != 0) {
+        const char *error = ldnr_protocol_error();
+        fprintf(stderr, "encode type %d failed: %s\n", (int)type,
+                error ? error : "(no error)");
+        exit(1);
+    }
+    CHECK(size == expected_size);
+    if (memcmp(output, expected, expected_size) != 0) {
+        size_t i = 0;
+        while (i < expected_size && output[i] == expected[i]) ++i;
+        fprintf(stderr, "fixture mismatch type %d at %zu: got %02x want %02x\n",
+                (int)type, i, output[i], expected[i]);
+        exit(1);
+    }
+}
+
+/* Protocol 1.1 HELLO has no room-password field. This fixture uses an empty
+ * password, all non-TLS capabilities, player_name as ClientName, and the
+ * NX2Apple client version string. */
+static const uint8_t hello_frame[] = {
