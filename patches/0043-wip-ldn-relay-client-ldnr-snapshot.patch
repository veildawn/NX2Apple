+
+ldnr_native_status ldnr_native_network_info_encode(const ldnr_network_info *value,
+                                                   uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_NETWORK_INFO_SIZE);
+    size_t i;
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = validate_ssid(&value->common.ssid);
+    if (status == LDNR_NATIVE_OK)
+        status = validate_node_count_max(value->node_count_max);
+    if (status == LDNR_NATIVE_OK && value->node_count > LDNR_NATIVE_NODE_COUNT_MAX)
+        status = LDNR_NATIVE_ERROR_INVALID;
+    if (status == LDNR_NATIVE_OK &&
+        value->advertise_data_size > LDNR_NATIVE_ADVERTISE_DATA_MAX)
+        status = LDNR_NATIVE_ERROR_INVALID;
+    if (status != LDNR_NATIVE_OK)
+        return status;
+
+    memset(out, 0, LDNR_NATIVE_NETWORK_INFO_SIZE);
+    encode_network_id(&value->network_id, out);
+    encode_common(&value->common, out + 0x28);
+    memcpy(out + 0x58, value->server_random, sizeof(value->server_random));
+    put_u16(out + 0x68, value->security_mode);
+    out[0x6a] = value->station_accept_policy;
+    out[0x6b] = value->version;
+    out[0x6e] = (uint8_t)value->node_count_max;
+    out[0x6f] = value->node_count;
+    for (i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; ++i)
+        encode_node_info(&value->nodes[i], out + 0x70 + i * LDNR_NATIVE_NODE_INFO_SIZE);
+    put_u16(out + 0x272, value->advertise_data_size);
+    memcpy(out + 0x274, value->advertise_data, sizeof(value->advertise_data));
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_network_info_decode(ldnr_network_info *value,
+                                                   const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_NETWORK_INFO_SIZE);
+    ldnr_network_info decoded = {0};
+    size_t i;
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_network_id(&decoded.network_id, in);
+    status = decode_common(&decoded.common, in + 0x28);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memcpy(decoded.server_random, in + 0x58, sizeof(decoded.server_random));
+    decoded.security_mode = get_u16(in + 0x68);
+    decoded.station_accept_policy = in[0x6a];
+    decoded.version = in[0x6b];
+    decoded.node_count_max = get_i8(in + 0x6e);
+    decoded.node_count = in[0x6f];
+    status = validate_node_count_max(decoded.node_count_max);
+    if (status == LDNR_NATIVE_OK && decoded.node_count > LDNR_NATIVE_NODE_COUNT_MAX)
+        status = LDNR_NATIVE_ERROR_INVALID;
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    for (i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; ++i)
+        decode_node_info(&decoded.nodes[i], in + 0x70 + i * LDNR_NATIVE_NODE_INFO_SIZE);
+    decoded.advertise_data_size = get_u16(in + 0x272);
+    if (decoded.advertise_data_size > LDNR_NATIVE_ADVERTISE_DATA_MAX)
+        return LDNR_NATIVE_ERROR_INVALID;
+    memcpy(decoded.advertise_data, in + 0x274, sizeof(decoded.advertise_data));
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_user_config_encode(const ldnr_user_config *value,
+                                                  uint8_t *out, size_t out_size)
