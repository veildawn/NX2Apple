@@ -0,0 +1,399 @@
+// Optional nn::ldn / nn::socket takeover for relay play. The separate swldnr
+// section keeps force_init's upstream duplicate check and accounting unchanged.
+#ifdef LDNR_GLUE_SYNTAX_TEST
+#include "ldnr/tests/shim/hle.h"
+#else
+#include "hle.h"
+#include <mach-o/getsect.h>
+#include <mach-o/ldsyms.h>
+#endif
+#include "ldnr/ldnr_internal.h"
+#include "ldnr/ldnr_hook.h"
+#include <stdlib.h>
+#include <string.h>
+
+#define LDNR_HLE(mangled, ret, cname, ...) \
+    static ret cname(__VA_ARGS__); \
+    __attribute__((used, section("__DATA,swldnr"))) static const hle_ent ldnr_ent_##cname = {mangled, (void *)cname}; \
+    static ret cname(__VA_ARGS__)
+
+static pthread_mutex_t g_ldnr_mutex = PTHREAD_MUTEX_INITIALIZER;
+static ldnr *g_ldnr;
+static void *g_ldnr_event;
+
+static void lr_log(void *ctx, const char *text) { (void)ctx; LOG("ldnr: %s", text); }
+static void lr_state(void *ctx) {
+    (void)ctx;
+    if (g_ldnr_event) hle_signal_bound_system_event(g_ldnr_event);
+}
+static void lr_wait(void *ctx, int entering) { (void)ctx; dm_thread_native_wait(entering); }
+
+static ldnr *lr_ensure(void) {
+    pthread_mutex_lock(&g_ldnr_mutex);
+    if (!g_ldnr) {
+        ldnr_config config;
+        memset(&config, 0, sizeof config);
+        config.server = getenv("DM_LDNR_SERVER");
+        config.room_password = getenv("DM_LDNR_ROOM_PASSWORD");
+        config.player_name = getenv("DM_LDNR_NAME");
+        const char *verbose = getenv("DM_LDNR_LOG");
+        config.log = verbose && atoi(verbose);
+        config.callback_ctx = NULL;
+        config.state_changed = lr_state;
+        config.native_wait = lr_wait;
+        config.log_message = lr_log;
+        int result = ldnr_create(&config, &g_ldnr);
+        if (result) LOG("[RED] LDNR initialization failed: %s", ldnr_last_error(g_ldnr));
+    }
+    ldnr *l = g_ldnr;
+    pthread_mutex_unlock(&g_ldnr_mutex);
+    return l;
+}
+
+void *ldnr_hook_lookup(const char *name) {
+    static int enabled = -1;
+    if (enabled < 0) { const char *env = getenv("DM_LDNR"); enabled = env && atoi(env); }
+    if (!enabled) return NULL;
+    static const hle_ent *table;
+    static size_t count;
+    static int loaded;
+    if (!loaded) {
+        unsigned long size = 0;
+        table = (const hle_ent *)getsectiondata(&_mh_execute_header, "__DATA", "swldnr", &size);
+        count = table ? size / sizeof *table : 0;
+        loaded = 1;
+    }
+    for (size_t i = 0; i < count; i++) if (!strcmp(table[i].name, name)) return table[i].fn;
+    return NULL;
+}
+
+static int lr_guest_address(ldnr_sockaddr *out, const void *input, unsigned size) {
+    if (!out || !input || size < 8) return 0;
+    const uint8_t *bytes = input;
+    if (bytes[1] != 2) return 0;
+    memset(out, 0, sizeof *out);
+    memcpy(&out->port, bytes + 2, 2);
+    memcpy(&out->address, bytes + 4, 4);
+    return 1;
+}
+
+static void lr_put_address(void *output, unsigned *size, const ldnr_sockaddr *address) {
+    if (!output || !size) return;
+    uint8_t bytes[16] = {16, 2};
+    memcpy(bytes + 2, &address->port, 2);
+    memcpy(bytes + 4, &address->address, 4);
+    unsigned count = *size < sizeof bytes ? *size : (unsigned)sizeof bytes;
+    memcpy(output, bytes, count);
+    *size = sizeof bytes;
+}
+
+static int lr_timeval_ms(const int64_t *tv) {
+    if (!tv) return -1;
+    int64_t ms = tv[0] * 1000 + tv[1] / 1000;
+    if (ms > 0x7fffffff) return 0x7fffffff;
+    return ms < 0 ? 0 : (int)ms;
+}
+
+// ---------- nn::ldn ----------
+LDNR_HLE("_ZN2nn3ldn10InitializeEv", Result, lr_ldn_initialize, void) {
+    ldnr *l = lr_ensure();
+    return l && !ldnr_initialize(l) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn8FinalizeEv", void, lr_ldn_finalize, void) {
+    pthread_mutex_lock(&g_ldnr_mutex);
+    ldnr *l = g_ldnr;
+    g_ldnr = NULL;
+    g_ldnr_event = NULL;
+    pthread_mutex_unlock(&g_ldnr_mutex);
+    if (l) ldnr_destroy(l);
+}
+LDNR_HLE("_ZN2nn3ldn8GetStateEv", int, lr_ldn_state, void) { return ldnr_get_state(g_ldnr); }
+LDNR_HLE("_ZN2nn3ldn22AttachStateChangeEventEPNS_2os15SystemEventTypeE", void, lr_ldn_attach, void *event) {
+    hle_bind_system_event(event, 0);
+    g_ldnr_event = event;
+}
+LDNR_HLE("_ZN2nn3ldn11OpenStationEv", Result, lr_ldn_open_station, void) { return g_ldnr && !ldnr_open_station(g_ldnr) ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn3ldn12CloseStationEv", Result, lr_ldn_close_station, void) { return g_ldnr && !ldnr_close_station(g_ldnr) ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn3ldn15OpenAccessPointEv", Result, lr_ldn_open_ap, void) { return g_ldnr && !ldnr_open_access_point(g_ldnr) ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn3ldn16CloseAccessPointEv", Result, lr_ldn_close_ap, void) { return g_ldnr && !ldnr_close_access_point(g_ldnr) ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn3ldn10DisconnectEv", Result, lr_ldn_disconnect, void) { return g_ldnr && !ldnr_disconnect(g_ldnr) ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn3ldn14DestroyNetworkEv", Result, lr_ldn_destroy, void) { return g_ldnr && !ldnr_destroy_network(g_ldnr) ? RES_OK : RES_FAIL; }
+
+static Result lr_scan(ldnr *l, void *output, int *count, int maximum, const void *filter_bytes, int channel, int private_scan) {
+    if (count) *count = 0;
+    if (!l || !count || maximum < 0) return RES_FAIL;
+    ldnr_scan_filter filter;
+    if (filter_bytes && ldnr_native_scan_filter_decode(&filter, filter_bytes, sizeof filter) != LDNR_NATIVE_OK) return RES_FAIL;
+    ldnr_network_info *networks = maximum ? calloc((size_t)maximum, sizeof *networks) : NULL;
+    if (maximum && !networks) return RES_FAIL;
+    int result = ldnr_scan(l, networks, count, maximum, filter_bytes ? &filter : NULL, channel, private_scan);
+    if (!result) for (int i = 0; i < *count; i++)
+        if (ldnr_native_network_info_encode(&networks[i], (uint8_t *)output + (size_t)i * sizeof *networks, sizeof *networks) != LDNR_NATIVE_OK) {
+            result = -1;
+            break;
+        }
+    free(networks);
+    if (result && count) *count = 0;
+    return result ? RES_FAIL : RES_OK;
+}
+LDNR_HLE("_ZN2nn3ldn4ScanEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", Result, lr_ldn_scan, void *out, int *n, int max, const void *filter, int channel) {
+    return lr_scan(g_ldnr, out, n, max, filter, channel, 0);
+}
+LDNR_HLE("_ZN2nn3ldn11ScanPrivateEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", Result, lr_ldn_scan_private, void *out, int *n, int max, const void *filter, int channel) {
+    return lr_scan(g_ldnr, out, n, max, filter, channel, 1);
+}
+
+static Result lr_create(ldnr *l, const void *config_bytes, const void *security_bytes,
+                        const void *user_bytes, const void *parameter_bytes,
+                        int address_count, const void *address_bytes) {
+    if (!l || address_count < 0 || address_count > 8) return RES_FAIL;
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_security_parameter parameter;
+    ldnr_address_entry addresses[8];
+    if (ldnr_native_network_config_decode(&config, config_bytes, sizeof config) != LDNR_NATIVE_OK ||
+        ldnr_native_security_config_decode(&security, security_bytes, sizeof security) != LDNR_NATIVE_OK ||
+        (user_bytes && ldnr_native_user_config_decode(&user, user_bytes, sizeof user) != LDNR_NATIVE_OK) ||
+        (parameter_bytes && ldnr_native_security_parameter_decode(&parameter, parameter_bytes, sizeof parameter) != LDNR_NATIVE_OK))
+        return RES_FAIL;
+    for (int i = 0; i < address_count; i++)
+        if (ldnr_native_address_entry_decode(&addresses[i], (const uint8_t *)address_bytes + (size_t)i * sizeof *addresses, sizeof *addresses) != LDNR_NATIVE_OK)
+            return RES_FAIL;
+    return ldnr_create_network(l, &config, &security, user_bytes ? &user : NULL,
+                               parameter_bytes ? &parameter : NULL, addresses, address_count) ? RES_FAIL : RES_OK;
+}
+LDNR_HLE("_ZN2nn3ldn13CreateNetworkERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_10UserConfigE", Result, lr_ldn_create,
+         const void *config, const void *security, const void *user) {
+    return lr_create(g_ldnr, config, security, user, NULL, 0, NULL);
+}
+LDNR_HLE("_ZN2nn3ldn20CreateNetworkPrivateERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_17SecurityParameterERKNS0_10UserConfigEiPKNS0_12AddressEntryE", Result, lr_ldn_create_private,
+         const void *config, const void *security, const void *parameter, const void *user, int count, const void *addresses) {
+    return lr_create(g_ldnr, config, security, user, parameter, count, addresses);
+}
+
+static Result lr_connect(ldnr *l, const void *info_bytes, const void *config_bytes,
+                         const void *security_bytes, const void *user_bytes,
+                         const void *parameter_bytes, int option) {
+    if (!l) return RES_FAIL;
+    ldnr_network_info info;
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_security_parameter parameter;
+    if ((info_bytes && ldnr_native_network_info_decode(&info, info_bytes, sizeof info) != LDNR_NATIVE_OK) ||
+        (config_bytes && ldnr_native_network_config_decode(&config, config_bytes, sizeof config) != LDNR_NATIVE_OK) ||
+        ldnr_native_security_config_decode(&security, security_bytes, sizeof security) != LDNR_NATIVE_OK ||
+        (user_bytes && ldnr_native_user_config_decode(&user, user_bytes, sizeof user) != LDNR_NATIVE_OK) ||
+        (parameter_bytes && ldnr_native_security_parameter_decode(&parameter, parameter_bytes, sizeof parameter) != LDNR_NATIVE_OK))
+        return RES_FAIL;
+    return ldnr_connect_network(l, info_bytes ? &info : NULL, config_bytes ? &config : NULL,
+                                &security, user_bytes ? &user : NULL,
+                                parameter_bytes ? &parameter : NULL, option) ? RES_FAIL : RES_OK;
+}
+LDNR_HLE("_ZN2nn3ldn7ConnectERKNS0_11NetworkInfoERKNS0_14SecurityConfigERKNS0_10UserConfigEiNS0_13ConnectOptionE", Result, lr_ldn_connect,
+         const void *info, const void *security, const void *user, int timeout, int option) {
+    (void)timeout;
+    return lr_connect(g_ldnr, info, NULL, security, user, NULL, option);
+}
+LDNR_HLE("_ZN2nn3ldn14ConnectPrivateERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_17SecurityParameterERKNS0_10UserConfigEiNS0_13ConnectOptionE", Result, lr_ldn_connect_private,
+         const void *config, const void *security, const void *parameter, const void *user, int timeout, int option) {
+    (void)timeout;
+    return lr_connect(g_ldnr, NULL, config, security, user, parameter, option);
+}
+
+LDNR_HLE("_ZN2nn3ldn14GetNetworkInfoEPNS0_11NetworkInfoE", Result, lr_ldn_info, void *output) {
+    ldnr_network_info info;
+    return g_ldnr && !ldnr_get_network_info(g_ldnr, &info) &&
+        ldnr_native_network_info_encode(&info, output, sizeof info) == LDNR_NATIVE_OK ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn14GetIpv4AddressEPNS0_11Ipv4AddressEPNS0_10SubnetMaskE", Result, lr_ldn_ip, uint32_t *address, uint32_t *mask) {
+    return g_ldnr && !ldnr_get_ipv4_address(g_ldnr, address, mask) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn20GetSecurityParameterEPNS0_17SecurityParameterE", Result, lr_ldn_security, void *output) {
+    ldnr_security_parameter parameter;
+    return g_ldnr && !ldnr_get_security_parameter(g_ldnr, &parameter) &&
+        ldnr_native_security_parameter_encode(&parameter, output, sizeof parameter) == LDNR_NATIVE_OK ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn16SetAdvertiseDataEPKvm", Result, lr_ldn_advertise, const void *data, uint64_t size) {
+    return g_ldnr && size <= 0x180 && !ldnr_set_advertise_data(g_ldnr, data, (size_t)size) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn19GetDisconnectReasonEv", int, lr_ldn_reason, void) { return ldnr_get_disconnect_reason(g_ldnr); }
+LDNR_HLE("_ZN2nn3ldn20AddAcceptFilterEntryENS0_10MacAddressE", Result, lr_ldn_filter, uint64_t mac) {
+    uint8_t bytes[6];
+    memcpy(bytes, &mac, sizeof bytes);
+    return g_ldnr && !ldnr_add_accept_filter_entry(g_ldnr, bytes) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn22SetStationAcceptPolicyENS0_12AcceptPolicyE", Result, lr_ldn_policy, int policy) {
+    return g_ldnr && !ldnr_set_station_accept_policy(g_ldnr, policy) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn6RejectENS0_11Ipv4AddressE", Result, lr_ldn_reject, uint32_t address) {
+    return g_ldnr && !ldnr_reject(g_ldnr, address) ? RES_OK : RES_FAIL;
+}
+LDNR_HLE("_ZN2nn3ldn16GetNetworkConfigEPNS0_13NetworkConfigE", Result, lr_ldn_config, void *output) {
+    ldnr_network_config config;
+    return g_ldnr && !ldnr_get_network_config(g_ldnr, &config) &&
+        ldnr_native_network_config_encode(&config, output, sizeof config) == LDNR_NATIVE_OK ? RES_OK : RES_FAIL;
+}
+
+// ---------- nn::socket ----------
+static Result lr_socket_initialize(void) { return lr_ensure() ? RES_OK : RES_FAIL; }
+LDNR_HLE("_ZN2nn6socket10InitializeERKNS0_6ConfigE", Result, lr_socket_init, const void *config) { (void)config; return lr_socket_initialize(); }
+LDNR_HLE("_ZN2nn6socket10InitializeEPvmmi", Result, lr_socket_init4, void *memory, uint64_t size, uint64_t allocation, int concurrency) {
+    (void)memory; (void)size; (void)allocation; (void)concurrency;
+    return lr_socket_initialize();
+}
+LDNR_HLE("_ZN2nn6socket8FinalizeEv", Result, lr_socket_finalize, void) { return RES_OK; }
+LDNR_HLE("_ZN2nn6socket12GetLastErrnoEv", int, lr_socket_errno4, void) { return ldnr_last_errno(); }
+LDNR_HLE("_ZN2nn6socket12GetLastErrorEv", int, lr_socket_errno, void) { return ldnr_last_errno(); }
+LDNR_HLE("nnsocketGetLastErrno", int, lr_ns_errno, void) { return ldnr_last_errno(); }
+LDNR_HLE("nnsocketSetLastErrno", void, lr_ns_set_errno, int error) { ldnr_set_errno(error); }
+
+static int lr_socket_new(int family, int type, int protocol) { return g_ldnr ? ldnr_socket(g_ldnr, family, type, protocol) : ldnr_fail(LDNR_ENETDOWN); }
+LDNR_HLE("_ZN2nn6socket6SocketENS0_6FamilyENS0_4TypeENS0_8ProtocolE", int, lr_socket, int family, int type, int protocol) { return lr_socket_new(family, type, protocol); }
+LDNR_HLE("_ZN2nn6socket6SocketEiii", int, lr_socket4, int family, int type, int protocol) { return lr_socket_new(family, type, protocol); }
+LDNR_HLE("nnsocketSocket", int, lr_ns_socket, int family, int type, int protocol) { return lr_socket_new(family, type, protocol); }
+static int lr_bind(int fd, const void *address, unsigned size) {
+    ldnr_sockaddr parsed;
+    return g_ldnr && lr_guest_address(&parsed, address, size) ? ldnr_bind(g_ldnr, fd, &parsed) : ldnr_fail(LDNR_EINVAL);
+}
+LDNR_HLE("_ZN2nn6socket4BindEiPKNS0_8SockAddrEj", int, lr_bind_new, int fd, const void *address, unsigned size) { return lr_bind(fd, address, size); }
+LDNR_HLE("_ZN2nn6socket4BindEiPK8sockaddrj", int, lr_bind_old, int fd, const void *address, unsigned size) { return lr_bind(fd, address, size); }
+LDNR_HLE("nnsocketBind", int, lr_ns_bind, int fd, const void *address, unsigned size) { return lr_bind(fd, address, size); }
+static int lr_connect_socket(int fd, const void *address, unsigned size) {
+    ldnr_sockaddr parsed;
+    return g_ldnr && lr_guest_address(&parsed, address, size) ? ldnr_connect_socket(g_ldnr, fd, &parsed, -2) : ldnr_fail(LDNR_EINVAL);
+}
+LDNR_HLE("_ZN2nn6socket7ConnectEiPKNS0_8SockAddrEj", int, lr_connect_new, int fd, const void *address, unsigned size) { return lr_connect_socket(fd, address, size); }
+LDNR_HLE("_ZN2nn6socket7ConnectEiPK8sockaddrj", int, lr_connect_old, int fd, const void *address, unsigned size) { return lr_connect_socket(fd, address, size); }
+LDNR_HLE("nnsocketConnect", int, lr_ns_connect, int fd, const void *address, unsigned size) { return lr_connect_socket(fd, address, size); }
+static int lr_listen(int fd, int backlog) { return g_ldnr ? ldnr_listen(g_ldnr, fd, backlog) : ldnr_fail(LDNR_ENETDOWN); }
+LDNR_HLE("_ZN2nn6socket6ListenEii", int, lr_listen_cpp, int fd, int backlog) { return lr_listen(fd, backlog); }
+LDNR_HLE("nnsocketListen", int, lr_listen_c, int fd, int backlog) { return lr_listen(fd, backlog); }
+static int lr_accept(int fd, void *address, unsigned *size) {
+    ldnr_sockaddr peer;
+    int result = g_ldnr ? ldnr_accept(g_ldnr, fd, &peer, -2) : ldnr_fail(LDNR_ENETDOWN);
+    if (result >= 0 && address) lr_put_address(address, size, &peer);
+    return result;
+}
+LDNR_HLE("_ZN2nn6socket6AcceptEiPNS0_8SockAddrEPj", int, lr_accept_new, int fd, void *address, unsigned *size) { return lr_accept(fd, address, size); }
+LDNR_HLE("_ZN2nn6socket6AcceptEiP8sockaddrPj", int, lr_accept_old, int fd, void *address, unsigned *size) { return lr_accept(fd, address, size); }
+LDNR_HLE("nnsocketAccept", int, lr_accept_c, int fd, void *address, unsigned *size) { return lr_accept(fd, address, size); }
+static int lr_close(int fd) { return g_ldnr ? ldnr_close_socket(g_ldnr, fd) : ldnr_fail(LDNR_ENETDOWN); }
+LDNR_HLE("_ZN2nn6socket5CloseEi", int, lr_close_cpp, int fd) { return lr_close(fd); }
+LDNR_HLE("nnsocketClose", int, lr_close_c, int fd) { return lr_close(fd); }
+static int lr_shutdown(int fd, int how) { return g_ldnr ? ldnr_shutdown(g_ldnr, fd, how) : ldnr_fail(LDNR_ENETDOWN); }
+LDNR_HLE("_ZN2nn6socket8ShutdownEii", int, lr_shutdown_cpp, int fd, int how) { return lr_shutdown(fd, how); }
+LDNR_HLE("nnsocketShutdown", int, lr_shutdown_c, int fd, int how) { return lr_shutdown(fd, how); }
+
+static long lr_sendto(int fd, const void *data, unsigned long size, int flags, const void *address, unsigned address_size) {
+    ldnr_sockaddr parsed;
+    if (!g_ldnr || !lr_guest_address(&parsed, address, address_size)) return ldnr_fail(LDNR_EINVAL);
