diff --git a/dm/host/ldnr/tests/t_ldnr_e2e.c b/dm/host/ldnr/tests/t_ldnr_e2e.c
new file mode 100644
index 0000000..adb994b
--- /dev/null
+++ b/dm/host/ldnr/tests/t_ldnr_e2e.c
@@ -0,0 +1,181 @@
+// Real relay integration test. No server is bundled: set LDNR_SERVER_BIN.
+#include "ldnr.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL %s:%d: %s (errno=%d)\n", \
+    __FILE__, __LINE__, #x, ldnr_last_errno()); goto out; } } while (0)
+
+static uint16_t reserve_port(void) {
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return 0;
+    struct sockaddr_in address;
+    memset(&address, 0, sizeof address); address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (bind(fd, (struct sockaddr *)&address, sizeof address) ||
+        listen(fd, 1)) { close(fd); return 0; }
+    socklen_t size = sizeof address;
+    uint16_t port = getsockname(fd, (struct sockaddr *)&address, &size) ? 0 : ntohs(address.sin_port);
+    close(fd); return port;
+}
+
+static void test_sleep_ms(long ms) {
+    struct timespec delay = {ms / 1000, (ms % 1000) * 1000000};
+    while (nanosleep(&delay, &delay) && errno == EINTR) {}
+}
+
+static int wait_state(ldnr *l, int state) {
+    for (int i = 0; i < 100; i++) {
+        if (ldnr_get_state(l) == state) return 1;
+        test_sleep_ms(20);
+    }
+    return 0;
+}
+
+static int wait_nodes(ldnr *l, int nodes) {
+    for (int i = 0; i < 100; i++) {
+        ldnr_network_info info;
+        if (!ldnr_get_network_info(l, &info) && info.node_count == nodes) return 1;
+        test_sleep_ms(20);
+    }
+    return 0;
+}
+
+int main(void) {
+    const char *binary = getenv("LDNR_SERVER_BIN");
+    if (!binary || !*binary) { puts("SKIP: LDNR_SERVER_BIN is unset"); return 0; }
+    uint16_t port = reserve_port();
+    if (!port) { perror("reserve port"); return 1; }
+    pid_t server = fork();
+    if (server < 0) { perror("fork"); return 1; }
+    if (server == 0) {
+        char listen_arg[64];
+        snprintf(listen_arg, sizeof listen_arg, "127.0.0.1:%u", port);
+        execl(binary, binary, "-listen", listen_arg, "-log-level", "warn", (char *)NULL);
+        _exit(127);
+    }
+    char address[64];
+    snprintf(address, sizeof address, "127.0.0.1:%u", port);
+    ldnr *host = NULL, *station = NULL;
+    int result = 1, host_socket = -1, station_socket = -1;
+    ldnr_config config = {0};
+    config.server = address; config.room_password = "e2e-room"; config.player_name = "host";
+    config.connect_timeout_ms = 3000; config.scan_timeout_ms = 3000;
+    config.log = getenv("LDNR_LOG") != NULL;
+    CHECK(!ldnr_create(&config, &host));
+    config.player_name = "station";
+    CHECK(!ldnr_create(&config, &station));
+    CHECK(!ldnr_initialize(host)); CHECK(!ldnr_initialize(station));
+    int opened = 0;
+    for (int i = 0; i < 100 && !opened; i++) {
+        if (!ldnr_open_access_point(host)) opened = 1;
+        else test_sleep_ms(20);
+    }
+    CHECK(opened); CHECK(!ldnr_open_station(station));
+
+    ldnr_network_config network_config;
+    memset(&network_config, 0, sizeof network_config);
+    network_config.intent_id.local_communication_id = 0x11223344;
+    network_config.intent_id.scene_id = 7; network_config.channel = 6;
+    network_config.node_count_max = 4; network_config.local_communication_version = 1;
+    ldnr_security_config security;
+    memset(&security, 0, sizeof security);
+    ldnr_user_config user;
+    memset(&user, 0, sizeof user); memcpy(user.user_name, "host", 4);
+    CHECK(!ldnr_create_network(host, &network_config, &security, &user, NULL, NULL, 0));
+    const uint8_t advertise[] = {'e', '2', 'e', 0, 1, 2, 3, 4};
+    CHECK(!ldnr_set_advertise_data(host, advertise, sizeof advertise));
+    CHECK(!ldnr_set_station_accept_policy(host, 0));
+    const uint8_t filter_mac[6] = {2, 0, 0, 0, 0, 9};
+    CHECK(!ldnr_add_accept_filter_entry(host, filter_mac));
+
+    ldnr_scan_filter filter;
+    memset(&filter, 0, sizeof filter);
+    filter.flags = 0x03;
+    filter.network_id.intent_id.local_communication_id = network_config.intent_id.local_communication_id;
+    filter.network_id.intent_id.scene_id = 7;
+    ldnr_network_info found[4]; int count = 0;
+    memset(found, 0, sizeof found);
+    CHECK(!ldnr_scan(station, found, &count, 4, &filter, 0, 0));
+    CHECK(count >= 1);
+    int room = -1;
+    for (int i = 0; i < count; i++)
+        if (found[i].advertise_data_size == sizeof advertise &&
+            !memcmp(found[i].advertise_data, advertise, sizeof advertise)) room = i;
+    CHECK(room >= 0);
+    memset(&user, 0, sizeof user); memcpy(user.user_name, "station", 7);
+    CHECK(!ldnr_connect_network(station, &found[room], NULL, &security, &user, NULL, 0));
+    uint32_t host_ip = 0, station_ip = 0, mask = 0;
+    CHECK(!ldnr_get_ipv4_address(host, &host_ip, &mask));
+    CHECK(!ldnr_get_ipv4_address(station, &station_ip, &mask));
+    CHECK(host_ip == ldnr_ipv4(10, 114, 0, 1));
+    CHECK(station_ip == ldnr_ipv4(10, 114, 0, 2));
+    CHECK(mask == ldnr_ipv4(255, 255, 0, 0));
+    CHECK(wait_nodes(host, 2));
+
+    host_socket = ldnr_socket(host, 2, 2, 17); station_socket = ldnr_socket(station, 2, 2, 17);
+    CHECK(host_socket >= 0 && station_socket >= 0);
+    ldnr_sockaddr host_udp = {0, ldnr_htons(40000)}, station_udp = {0, ldnr_htons(40001)};
+    CHECK(!ldnr_bind(host, host_socket, &host_udp)); CHECK(!ldnr_bind(station, station_socket, &station_udp));
+    const char udp_message[] = "udp unicast";
+    station_udp.address = station_ip;
+    CHECK(ldnr_sendto(host, host_socket, udp_message, sizeof udp_message, 0, &station_udp) == sizeof udp_message);
+    uint8_t buffer[128]; ldnr_sockaddr source;
+    CHECK(ldnr_recvfrom(station, station_socket, buffer, sizeof buffer, 0, &source, 2000) == sizeof udp_message);
+    CHECK(!memcmp(buffer, udp_message, sizeof udp_message));
+    CHECK(source.address == host_ip && source.port == ldnr_htons(40000));
+    const char broadcast_message[] = "udp broadcast";
+    host_udp.address = ldnr_ipv4(10, 114, 255, 255);
+    CHECK(ldnr_sendto(station, station_socket, broadcast_message, sizeof broadcast_message, 0, &host_udp) == sizeof broadcast_message);
+    CHECK(ldnr_recvfrom(host, host_socket, buffer, sizeof buffer, 0, &source, 2000) == sizeof broadcast_message);
+    CHECK(!memcmp(buffer, broadcast_message, sizeof broadcast_message));
+    CHECK(!ldnr_close_socket(host, host_socket)); CHECK(!ldnr_close_socket(station, station_socket));
+    host_socket = station_socket = -1;
+
+    int listener = ldnr_socket(host, 2, 1, 6), connector = ldnr_socket(station, 2, 1, 6);
+    CHECK(listener >= 0 && connector >= 0);
+    ldnr_sockaddr tcp_address = {0, ldnr_htons(40002)};
+    CHECK(!ldnr_bind(host, listener, &tcp_address)); CHECK(!ldnr_listen(host, listener, 4));
+    tcp_address.address = host_ip;
+    CHECK(!ldnr_connect_socket(station, connector, &tcp_address, 3000));
+    int accepted = ldnr_accept(host, listener, &source, 2000);
+    CHECK(accepted >= 0 && source.address == station_ip);
+    const char request[] = "tcp request", response[] = "tcp response";
+    CHECK(ldnr_send(station, connector, request, sizeof request, 0) == sizeof request);
+    CHECK(ldnr_recv(host, accepted, buffer, sizeof buffer, 0, 2000) == sizeof request);
+    CHECK(!memcmp(buffer, request, sizeof request));
+    CHECK(ldnr_send(host, accepted, response, sizeof response, 0) == sizeof response);
+    CHECK(ldnr_recv(station, connector, buffer, sizeof buffer, 0, 2000) == sizeof response);
+    CHECK(!memcmp(buffer, response, sizeof response));
+    CHECK(!ldnr_close_socket(station, connector));
+    CHECK(ldnr_recv(host, accepted, buffer, sizeof buffer, 0, 2000) == 0);
+    CHECK(!ldnr_close_socket(host, accepted)); CHECK(!ldnr_close_socket(host, listener));
+
+    CHECK(!ldnr_disconnect(station));
+    CHECK(ldnr_get_state(station) == 3); CHECK(wait_nodes(host, 1));
+    CHECK(!ldnr_connect_network(station, &found[room], NULL, &security, &user, NULL, 0));
+    CHECK(wait_nodes(host, 2));
+    CHECK(!ldnr_destroy_network(host));
+    CHECK(ldnr_get_state(host) == 2); CHECK(wait_state(station, 3));
+    CHECK(ldnr_get_disconnect_reason(station) == 3);
+    CHECK(!ldnr_close_access_point(host)); CHECK(!ldnr_close_station(station));
+    result = 0;
+out:
+    if (host_socket >= 0 && host) ldnr_close_socket(host, host_socket);
+    if (station_socket >= 0 && station) ldnr_close_socket(station, station_socket);
+    if (station) ldnr_destroy(station);
+    if (host) ldnr_destroy(host);
+    kill(server, SIGTERM);
+    while (waitpid(server, NULL, 0) < 0 && errno == EINTR) {}
+    if (!result) puts("PASS: real relay host/join/scan/UDP/TCP/disconnect/destroy");
+    return result;
+}
diff --git a/dm/host/ldnr/tests/t_native.c b/dm/host/ldnr/tests/t_native.c
