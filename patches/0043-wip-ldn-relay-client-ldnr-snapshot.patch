diff --git a/dm/host/ldnr/ldnr_internal.h b/dm/host/ldnr/ldnr_internal.h
new file mode 100644
index 0000000..a70c33b
--- /dev/null
+++ b/dm/host/ldnr/ldnr_internal.h
@@ -0,0 +1,122 @@
+// Private shared state for the unity build and the standalone test build.
+#pragma once
+#include "ldnr.h"
+#include "ldnr_protocol.h"
+#include "ldnr_transport.h"
+#include <pthread.h>
+#include <stdatomic.h>
+
+#define LDNR_MAX_FRAME (1024 * 1024)
+#define LDNR_MAX_SOCKETS 64
+#define LDNR_FD_BASE 512
+#define LDNR_ACCEPT_MAX 16
+#define LDNR_QUEUE_MAX 64
+
+enum {
+    LDNR_STATE_NONE = 0, LDNR_STATE_INITIALIZED = 1,
+    LDNR_STATE_AP_OPEN = 2, LDNR_STATE_STATION_OPEN = 3,
+    LDNR_STATE_AP_CREATED = 4, LDNR_STATE_STATION_CONNECTED = 5,
+};
+enum {
+    LDNR_EBADF = 9, LDNR_EINVAL = 22, LDNR_EPIPE = 32, LDNR_EAGAIN = 35,
+    LDNR_EINPROGRESS = 36, LDNR_EALREADY = 37, LDNR_EMSGSIZE = 40,
+    LDNR_ENOPROTOOPT = 42, LDNR_EAFNOSUPPORT = 47, LDNR_EADDRINUSE = 48,
+    LDNR_EADDRNOTAVAIL = 49, LDNR_ENETDOWN = 50, LDNR_ECONNRESET = 54,
+    LDNR_ENOBUFS = 55, LDNR_EISCONN = 56, LDNR_ENOTCONN = 57,
+    LDNR_ESHUTDOWN = 58, LDNR_ETIMEDOUT = 60, LDNR_ECONNREFUSED = 61,
+    LDNR_EHOSTUNREACH = 65,
+};
+
+typedef struct ldnr_packet {
+    struct ldnr_packet *next;
+    ldnr_sockaddr source;
+    size_t size, offset;
+    uint8_t data[];
+} ldnr_packet;
+
+typedef struct {
+    int used, type, fd;
+    int nonblocking, recv_timeout_ms, send_timeout_ms;
+    int broadcast, reuse_address;
+    int bound, listening, backlog;
+    int connecting, connected, remote_eof, shut_read, shut_write;
+    int connect_error;
+    ldnr_sockaddr local, peer;
+    uint64_t connection_id;
+    ldnr_packet *head, *tail;
+    int queued;
+    int accept_fds[LDNR_ACCEPT_MAX], accept_head, accept_count;
+} ldnr_vsock;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    uint32_t local_address, subnet_mask;
+    ldnr_vsock sockets[LDNR_MAX_SOCKETS];
+    void *wait_ctx;
+    void (*native_wait)(void *, int);
+} ldnr_vnet;
+
+struct ldnr {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    pthread_t receive_thread;
+    int receive_started, owns_transport;
+    _Atomic int stop, transport_open;
+    const ldnr_transport *transport;
+    ldnr_config config;
+    char *server, *room_password, *player_name;
+    int state, disconnect_reason, initialized;
+    uint32_t ipv4, subnet_mask;
+    int has_network, has_network_config, has_security;
+    uint64_t network_id;
+    ldnr_network_info network;
+    ldnr_network_config network_config;
+    ldnr_security_parameter security;
+    ldnr_security_config security_config;
+    ldnr_user_config user_config;
+    uint64_t scan_ids[LDNR_MAX_NETWORKS];
+    uint8_t scan_sessions[LDNR_MAX_NETWORKS][16];
+    int scan_count;
+    uint64_t next_request_id, pending_request;
+    _Atomic uint64_t connection_id_seq;
+    ldnr_message_type pending_want;
+    int reply_ready, reply_status;
+    ldnr_message reply;
+    char error[256];
+    ldnr_vnet vnet;
+};
+
+void ldnr_set_errno(int error);
+int ldnr_fail(int error);
+void ldnr_log(ldnr *l, const char *format, ...);
+void ldnr_set_error(ldnr *l, const char *format, ...);
+void ldnr_state_set(ldnr *l, int state);
+int64_t ldnr_monotonic_ms(void);
+int ldnr_wait_until(ldnr *l, pthread_cond_t *condition, pthread_mutex_t *mutex,
+                    void *wait_ctx, void (*native_wait)(void *, int), int64_t deadline);
+
+int ldnr_client_open(ldnr *l);
+void ldnr_client_close(ldnr *l);
+int ldnr_client_request(ldnr *l, ldnr_message_type want, ldnr_message_type send_type,
+                        uint64_t network_id, const ldnr_message *message,
+                        const ldnr_operation *operation, int timeout_ms);
+int ldnr_client_send(ldnr *l, ldnr_message_type type, uint64_t network_id,
+                     const ldnr_message *message, const ldnr_operation *operation);
+void *ldnr_client_receive_main(void *argument);
+
+void ldnr_vnet_init(ldnr *l);
+void ldnr_vnet_destroy(ldnr *l);
+void ldnr_vnet_reset(ldnr *l);
+void ldnr_vnet_set_address(ldnr *l, uint32_t address, uint32_t mask);
+void ldnr_vnet_udp(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_connect(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_ack(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_data(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_disconnect(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_network_down(ldnr *l);
+int ldnr_vnet_send_udp(ldnr *l, ldnr_vsock *socket, const ldnr_sockaddr *destination,
+                       const void *data, size_t size);
+int ldnr_vnet_send_proxy(ldnr *l, ldnr_message_type type, ldnr_vsock *socket,
+                         const void *data, size_t size);
+uint64_t ldnr_next_connection_id(ldnr *l);
diff --git a/dm/host/ldnr/ldnr_native.c b/dm/host/ldnr/ldnr_native.c
new file mode 100644
index 0000000..41b2bae
--- /dev/null
+++ b/dm/host/ldnr/ldnr_native.c
@@ -0,0 +1,622 @@
+#include "ldnr_native.h"
+
+#include <limits.h>
+#include <string.h>
+
+_Static_assert(CHAR_BIT == 8, "LDN layouts require eight-bit bytes");
+
+static void put_u16(uint8_t *out, uint16_t value)
+{
+    out[0] = (uint8_t)value;
+    out[1] = (uint8_t)(value >> 8);
+}
+
+static void put_u32(uint8_t *out, uint32_t value)
+{
+    out[0] = (uint8_t)value;
+    out[1] = (uint8_t)(value >> 8);
+    out[2] = (uint8_t)(value >> 16);
+    out[3] = (uint8_t)(value >> 24);
+}
+
+static void put_u64(uint8_t *out, uint64_t value)
+{
+    unsigned int i;
+
+    for (i = 0; i < 8; ++i)
+        out[i] = (uint8_t)(value >> (i * 8));
+}
+
+static uint16_t get_u16(const uint8_t *in)
+{
+    return (uint16_t)((uint16_t)in[0] | ((uint16_t)in[1] << 8));
+}
+
+static uint32_t get_u32(const uint8_t *in)
+{
+    return (uint32_t)in[0] | ((uint32_t)in[1] << 8) |
+           ((uint32_t)in[2] << 16) | ((uint32_t)in[3] << 24);
+}
+
+static uint64_t get_u64(const uint8_t *in)
+{
+    uint64_t value = 0;
+    unsigned int i;
+
+    for (i = 0; i < 8; ++i)
+        value |= (uint64_t)in[i] << (i * 8);
+    return value;
+}
+
+/* Avoid implementation-defined unsigned-to-signed conversions for negative fields. */
+static int8_t get_i8(const uint8_t *in)
+{
+    uint8_t value = in[0];
+
+    if (value <= INT8_MAX)
+        return (int8_t)value;
+    return (int8_t)(-1 - (int16_t)(UINT8_MAX - value));
+}
+
+static int16_t get_i16(const uint8_t *in)
+{
+    uint16_t value = get_u16(in);
+
+    if (value <= INT16_MAX)
+        return (int16_t)value;
+    return (int16_t)(-1 - (int32_t)(UINT16_MAX - value));
+}
+
+static int64_t get_i64(const uint8_t *in)
+{
+    uint64_t value = get_u64(in);
+
+    if (value <= INT64_MAX)
+        return (int64_t)value;
+    return -1 - (int64_t)(UINT64_MAX - value);
+}
+
+static ldnr_native_status check_io(const void *value, const void *buffer,
+                                   size_t size, size_t expected)
+{
+    if (value == NULL || buffer == NULL)
+        return LDNR_NATIVE_ERROR_ARGUMENT;
+    if (size != expected)
+        return LDNR_NATIVE_ERROR_LENGTH;
+    return LDNR_NATIVE_OK;
+}
+
+static ldnr_native_status validate_ssid(const ldnr_ssid *ssid)
+{
+    return ssid->length <= LDNR_NATIVE_SSID_MAX ? LDNR_NATIVE_OK
+                                                : LDNR_NATIVE_ERROR_INVALID;
+}
+
+static ldnr_native_status validate_node_count_max(int8_t count)
+{
+    if (count < 0 || (uint8_t)count > LDNR_NATIVE_NODE_COUNT_MAX)
+        return LDNR_NATIVE_ERROR_INVALID;
+    return LDNR_NATIVE_OK;
+}
+
+static void encode_intent_id(const ldnr_intent_id *value, uint8_t *out)
+{
+    put_u64(out, (uint64_t)value->local_communication_id);
+    put_u16(out + 0x0a, value->scene_id);
+}
+
+static void decode_intent_id(ldnr_intent_id *value, const uint8_t *in)
+{
+    value->local_communication_id = get_i64(in);
+    value->scene_id = get_u16(in + 0x0a);
+}
+
+static void encode_network_id(const ldnr_network_id *value, uint8_t *out)
+{
+    encode_intent_id(&value->intent_id, out);
+    memcpy(out + 0x18, value->session_id, sizeof(value->session_id));
+}
+
+static void decode_network_id(ldnr_network_id *value, const uint8_t *in)
+{
+    decode_intent_id(&value->intent_id, in);
+    memcpy(value->session_id, in + 0x18, sizeof(value->session_id));
+}
+
+static void encode_ssid(const ldnr_ssid *value, uint8_t *out)
+{
+    out[0] = value->length;
+    memcpy(out + 1, value->string, sizeof(value->string));
+}
+
+static ldnr_native_status decode_ssid(ldnr_ssid *value, const uint8_t *in)
+{
+    if (in[0] > LDNR_NATIVE_SSID_MAX)
+        return LDNR_NATIVE_ERROR_INVALID;
+    value->length = in[0];
+    memcpy(value->string, in + 1, sizeof(value->string));
+    return LDNR_NATIVE_OK;
+}
+
+static void encode_common(const ldnr_common_network_info *value, uint8_t *out)
+{
+    memcpy(out, value->bssid, sizeof(value->bssid));
+    encode_ssid(&value->ssid, out + 0x06);
+    put_u16(out + 0x28, (uint16_t)value->channel);
+    out[0x2a] = (uint8_t)value->link_level;
+    out[0x2b] = value->network_type;
+}
+
+static ldnr_native_status decode_common(ldnr_common_network_info *value,
+                                        const uint8_t *in)
+{
+    ldnr_native_status status;
+
+    memcpy(value->bssid, in, sizeof(value->bssid));
+    status = decode_ssid(&value->ssid, in + 0x06);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    value->channel = get_i16(in + 0x28);
+    value->link_level = get_i8(in + 0x2a);
+    value->network_type = in[0x2b];
+    return LDNR_NATIVE_OK;
+}
+
+static void encode_node_info(const ldnr_node_info *value, uint8_t *out)
+{
+    put_u32(out, value->ipv4_address);
+    memcpy(out + 0x04, value->mac_address, sizeof(value->mac_address));
+    out[0x0a] = (uint8_t)value->node_id;
+    out[0x0b] = value->is_connected;
+    memcpy(out + 0x0c, value->user_name, sizeof(value->user_name));
+    out[0x2d] = value->platform;
+    put_u16(out + 0x2e, (uint16_t)value->local_communication_version);
+}
+
+static void decode_node_info(ldnr_node_info *value, const uint8_t *in)
+{
+    value->ipv4_address = get_u32(in);
+    memcpy(value->mac_address, in + 0x04, sizeof(value->mac_address));
+    value->node_id = get_i8(in + 0x0a);
+    value->is_connected = in[0x0b];
+    memcpy(value->user_name, in + 0x0c, sizeof(value->user_name));
+    value->platform = in[0x2d];
+    value->local_communication_version = get_i16(in + 0x2e);
+}
+
+ldnr_native_status ldnr_native_intent_id_encode(const ldnr_intent_id *value,
+                                                uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_INTENT_ID_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_INTENT_ID_SIZE);
+    encode_intent_id(value, out);
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_intent_id_decode(ldnr_intent_id *value,
+                                                const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_INTENT_ID_SIZE);
+    ldnr_intent_id decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_intent_id(&decoded, in);
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_network_id_encode(const ldnr_network_id *value,
+                                                 uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_NETWORK_ID_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_NETWORK_ID_SIZE);
+    encode_network_id(value, out);
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_network_id_decode(ldnr_network_id *value,
+                                                 const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_NETWORK_ID_SIZE);
+    ldnr_network_id decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_network_id(&decoded, in);
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_ssid_encode(const ldnr_ssid *value,
+                                           uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_SSID_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = validate_ssid(value);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    encode_ssid(value, out);
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_ssid_decode(ldnr_ssid *value,
+                                           const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_SSID_SIZE);
+    ldnr_ssid decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = decode_ssid(&decoded, in);
+    if (status == LDNR_NATIVE_OK)
+        *value = decoded;
+    return status;
+}
+
+ldnr_native_status ldnr_native_common_network_info_encode(
+    const ldnr_common_network_info *value, uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = validate_ssid(&value->ssid);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE);
+    encode_common(value, out);
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_common_network_info_decode(
+    ldnr_common_network_info *value, const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE);
+    ldnr_common_network_info decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = decode_common(&decoded, in);
+    if (status == LDNR_NATIVE_OK)
+        *value = decoded;
+    return status;
+}
