+static void test_auth_ping_and_pong(void)
+{
+    uint8_t output[sizeof(hello_frame)];
+    size_t size = 0;
+    ldnr_message message;
+
+    CHECK(ldnr_protocol_encode_auth(output, sizeof(output), &size, "", "tester") == 0);
+    CHECK(size == sizeof(hello_frame));
+    CHECK(memcmp(output, hello_frame, sizeof(hello_frame)) == 0);
+
+    memset(&message, 0, sizeof(message));
+    message.timestamp = UINT64_C(0x0102030405060708);
+    encode_ok(ping_frame, sizeof(ping_frame), LDNR_MSG_PING, UINT64_C(0x11121314),
+              0, &message, NULL);
+    encode_ok(pong_frame, sizeof(pong_frame), LDNR_MSG_PONG, UINT64_C(0x11121314),
+              0, &message, NULL);
+
+    decode_ok(ping_frame, sizeof(ping_frame), &message);
+    CHECK(message.type == LDNR_MSG_PING);
+    CHECK(message.request_id == UINT64_C(0x11121314));
+    CHECK(message.timestamp == UINT64_C(0x0102030405060708));
+    ldnr_protocol_message_free(&message);
+
+    decode_ok(pong_frame, sizeof(pong_frame), &message);
+    CHECK(message.type == LDNR_MSG_PONG);
+    CHECK(message.request_id == UINT64_C(0x11121314));
+    CHECK(message.timestamp == UINT64_C(0x0102030405060708));
+    ldnr_protocol_message_free(&message);
+}
