+static void test_offline_and_fd_limit(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr *context = test_create_context(api, NULL);
+    ldnr_sockaddr destination;
+    ldnr_pollfd pollfd;
+    int fds[TEST_MAX_SOCKETS];
+    int fd;
+    int replacement;
+    int i;
+    char byte = 'x';
+
+    destination.address = ldnr_ipv4(192, 168, 44, 20);
+    destination.port = ldnr_htons(5000);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    CHECK(ldnr_sendto(context, fd, &byte, 1, 0, &destination) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_connect_socket(context, fd, &destination, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_recvfrom(context, fd, &byte, 1, 0, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    pollfd.fd = fd;
+    pollfd.events = LDNR_POLLIN | LDNR_POLLOUT;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 0);
+    CHECK(pollfd.revents == 0);
+    CHECK(ldnr_close_socket(context, fd) == 0);
+
+    for (i = 0; i < TEST_MAX_SOCKETS; i++) {
+        fds[i] = ldnr_socket(context, 2, 2, 17);
+        CHECK(fds[i] >= 0);
+        if (i)
+            CHECK(fds[i] != fds[i - 1]);
+    }
+    CHECK(ldnr_socket(context, 2, 2, 17) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOBUFS);
+    CHECK(ldnr_close_socket(context, fds[10]) == 0);
+    replacement = ldnr_socket(context, 2, 2, 17);
+    CHECK(replacement == fds[10]);
+    fds[10] = replacement;
+    for (i = 0; i < TEST_MAX_SOCKETS; i++)
+        CHECK(ldnr_close_socket(context, fds[i]) == 0);
+    CHECK(ldnr_close_socket(context, fds[0]) == -1);
+    CHECK(ldnr_last_errno() == TEST_EBADF);
+    pollfd.fd = fds[0];
+    pollfd.events = LDNR_POLLIN;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLNVAL);
+    test_destroy_context(context, api);
+}
