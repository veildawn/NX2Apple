+    memcpy(out, value->user_name, sizeof(value->user_name));
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_user_config_decode(ldnr_user_config *value,
+                                                  const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_USER_CONFIG_SIZE);
+    ldnr_user_config decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memcpy(decoded.user_name, in, sizeof(decoded.user_name));
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_security_config_encode(
+    const ldnr_security_config *value, uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_SECURITY_CONFIG_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    if (value->passphrase_size > LDNR_NATIVE_PASSPHRASE_MAX)
+        return LDNR_NATIVE_ERROR_INVALID;
+    put_u16(out, value->security_mode);
+    put_u16(out + 0x02, value->passphrase_size);
+    memcpy(out + 0x04, value->passphrase, sizeof(value->passphrase));
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_security_config_decode(
+    ldnr_security_config *value, const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_SECURITY_CONFIG_SIZE);
+    ldnr_security_config decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.passphrase_size = get_u16(in + 0x02);
+    if (decoded.passphrase_size > LDNR_NATIVE_PASSPHRASE_MAX)
+        return LDNR_NATIVE_ERROR_INVALID;
+    decoded.security_mode = get_u16(in);
+    memcpy(decoded.passphrase, in + 0x04, sizeof(decoded.passphrase));
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_security_parameter_encode(
+    const ldnr_security_parameter *value, uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
