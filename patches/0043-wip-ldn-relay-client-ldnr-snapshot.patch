+#ifndef LDNR_NATIVE_H
+#define LDNR_NATIVE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Public nn::ldn layouts, expressed without compiler packing extensions. */
+#define LDNR_NATIVE_INTENT_ID_SIZE 0x18u
+#define LDNR_NATIVE_NETWORK_ID_SIZE 0x28u
+#define LDNR_NATIVE_SSID_SIZE 0x22u
+#define LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE 0x30u
+#define LDNR_NATIVE_NODE_INFO_SIZE 0x40u
+#define LDNR_NATIVE_NETWORK_INFO_SIZE 0x480u
+#define LDNR_NATIVE_USER_CONFIG_SIZE 0x30u
+#define LDNR_NATIVE_SECURITY_CONFIG_SIZE 0x44u
+#define LDNR_NATIVE_SECURITY_PARAMETER_SIZE 0x20u
+#define LDNR_NATIVE_NETWORK_CONFIG_SIZE 0x28u
+#define LDNR_NATIVE_SCAN_FILTER_SIZE 0x68u
+#define LDNR_NATIVE_ADDRESS_ENTRY_SIZE 0x0cu
+#define LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE 0x08u
+
+#define LDNR_NATIVE_ADVERTISE_DATA_MAX 0x180u
+#define LDNR_NATIVE_NODE_COUNT_MAX 8u
+#define LDNR_NATIVE_SSID_MAX 32u
+#define LDNR_NATIVE_PASSPHRASE_MAX 64u
+
+typedef struct ldnr_intent_id {
+    int64_t local_communication_id;
+    uint16_t reserved_08;
+    uint16_t scene_id;
+    uint8_t reserved_0c[0x0c];
+} ldnr_intent_id;
+
+typedef struct ldnr_network_id {
+    ldnr_intent_id intent_id;
+    uint8_t session_id[0x10];
+} ldnr_network_id;
+
+typedef struct ldnr_ssid {
+    uint8_t length;
+    uint8_t string[0x21];
+} ldnr_ssid;
+
+typedef struct ldnr_common_network_info {
+    uint8_t bssid[6];
+    ldnr_ssid ssid;
+    int16_t channel;
+    int8_t link_level;
+    uint8_t network_type;
+    uint8_t reserved_2c[4];
+} ldnr_common_network_info;
+
+typedef struct ldnr_node_info {
+    uint32_t ipv4_address;
+    uint8_t mac_address[6];
+    int8_t node_id;
+    uint8_t is_connected;
+    uint8_t user_name[0x21];
+    uint8_t platform;
+    int16_t local_communication_version;
+    uint8_t reserved_30[0x10];
+} ldnr_node_info;
+
+typedef struct ldnr_network_info {
+    ldnr_network_id network_id;
+    ldnr_common_network_info common;
+    uint8_t server_random[0x10];
+    uint16_t security_mode;
+    uint8_t station_accept_policy;
+    uint8_t version;
+    uint8_t reserved_6c[2];
+    int8_t node_count_max;
+    uint8_t node_count;
+    ldnr_node_info nodes[LDNR_NATIVE_NODE_COUNT_MAX];
+    uint8_t reserved_270[2];
+    uint16_t advertise_data_size;
+    uint8_t advertise_data[LDNR_NATIVE_ADVERTISE_DATA_MAX];
+    uint8_t reserved_3f4[0x8c];
+} ldnr_network_info;
+
+typedef struct ldnr_user_config {
+    uint8_t user_name[0x21];
+    uint8_t reserved_21[0x0f];
+} ldnr_user_config;
+
+typedef struct ldnr_security_config {
+    uint16_t security_mode;
+    uint16_t passphrase_size;
+    uint8_t passphrase[LDNR_NATIVE_PASSPHRASE_MAX];
+} ldnr_security_config;
+
+typedef struct ldnr_security_parameter {
+    uint8_t server_random[0x10];
+    uint8_t session_id[0x10];
+} ldnr_security_parameter;
+
+typedef struct ldnr_network_config {
+    ldnr_intent_id intent_id;
+    int16_t channel;
+    int8_t node_count_max;
+    uint8_t reserved_1b;
+    int16_t local_communication_version;
+    uint8_t reserved_1e[0x0a];
+} ldnr_network_config;
+
+typedef struct ldnr_scan_filter {
+    ldnr_network_id network_id;
+    uint32_t network_type;
+    uint8_t bssid[6];
+    ldnr_ssid ssid;
+    uint8_t reserved_54[0x10];
+    uint32_t flags;
+} ldnr_scan_filter;
+
+typedef struct ldnr_address_entry {
+    uint32_t ipv4_address;
+    uint8_t mac_address[6];
+    uint8_t reserved_0a[2];
+} ldnr_address_entry;
+
+typedef struct ldnr_node_latest_update {
+    uint8_t state_change;
+    uint8_t reserved_01[7];
+} ldnr_node_latest_update;
+
+_Static_assert(sizeof(ldnr_intent_id) == LDNR_NATIVE_INTENT_ID_SIZE, "intent id size");
+_Static_assert(offsetof(ldnr_intent_id, scene_id) == 0x0a, "intent id scene offset");
+_Static_assert(sizeof(ldnr_network_id) == LDNR_NATIVE_NETWORK_ID_SIZE, "network id size");
+_Static_assert(offsetof(ldnr_network_id, session_id) == 0x18, "network id session offset");
+_Static_assert(sizeof(ldnr_ssid) == LDNR_NATIVE_SSID_SIZE, "ssid size");
+_Static_assert(offsetof(ldnr_ssid, string) == 0x01, "ssid string offset");
+_Static_assert(sizeof(ldnr_common_network_info) == LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE, "common info size");
+_Static_assert(offsetof(ldnr_common_network_info, ssid) == 0x06, "common info ssid offset");
+_Static_assert(offsetof(ldnr_common_network_info, channel) == 0x28, "common info channel offset");
+_Static_assert(offsetof(ldnr_common_network_info, network_type) == 0x2b, "common info type offset");
+_Static_assert(sizeof(ldnr_node_info) == LDNR_NATIVE_NODE_INFO_SIZE, "node info size");
+_Static_assert(offsetof(ldnr_node_info, mac_address) == 0x04, "node info MAC offset");
+_Static_assert(offsetof(ldnr_node_info, node_id) == 0x0a, "node info id offset");
+_Static_assert(offsetof(ldnr_node_info, user_name) == 0x0c, "node info name offset");
+_Static_assert(offsetof(ldnr_node_info, platform) == 0x2d, "node info platform offset");
+_Static_assert(offsetof(ldnr_node_info, local_communication_version) == 0x2e, "node info version offset");
+_Static_assert(sizeof(ldnr_network_info) == LDNR_NATIVE_NETWORK_INFO_SIZE, "network info size");
+_Static_assert(offsetof(ldnr_network_info, common) == 0x28, "network info common offset");
+_Static_assert(offsetof(ldnr_network_info, server_random) == 0x58, "network info random offset");
+_Static_assert(offsetof(ldnr_network_info, security_mode) == 0x68, "network info security offset");
+_Static_assert(offsetof(ldnr_network_info, station_accept_policy) == 0x6a, "network info policy offset");
+_Static_assert(offsetof(ldnr_network_info, version) == 0x6b, "network info version offset");
+_Static_assert(offsetof(ldnr_network_info, node_count_max) == 0x6e, "network info max nodes offset");
+_Static_assert(offsetof(ldnr_network_info, node_count) == 0x6f, "network info nodes offset");
+_Static_assert(offsetof(ldnr_network_info, nodes) == 0x70, "network info node array offset");
+_Static_assert(offsetof(ldnr_network_info, advertise_data_size) == 0x272, "network info advertise size offset");
+_Static_assert(offsetof(ldnr_network_info, advertise_data) == 0x274, "network info advertise offset");
+_Static_assert(sizeof(ldnr_user_config) == LDNR_NATIVE_USER_CONFIG_SIZE, "user config size");
+_Static_assert(sizeof(ldnr_security_config) == LDNR_NATIVE_SECURITY_CONFIG_SIZE, "security config size");
+_Static_assert(offsetof(ldnr_security_config, passphrase_size) == 0x02, "passphrase size offset");
+_Static_assert(offsetof(ldnr_security_config, passphrase) == 0x04, "passphrase offset");
+_Static_assert(sizeof(ldnr_security_parameter) == LDNR_NATIVE_SECURITY_PARAMETER_SIZE, "security parameter size");
+_Static_assert(offsetof(ldnr_security_parameter, session_id) == 0x10, "security parameter session offset");
+_Static_assert(sizeof(ldnr_network_config) == LDNR_NATIVE_NETWORK_CONFIG_SIZE, "network config size");
+_Static_assert(offsetof(ldnr_network_config, channel) == 0x18, "network config channel offset");
+_Static_assert(offsetof(ldnr_network_config, node_count_max) == 0x1a, "network config max nodes offset");
+_Static_assert(offsetof(ldnr_network_config, local_communication_version) == 0x1c, "network config version offset");
+_Static_assert(sizeof(ldnr_scan_filter) == LDNR_NATIVE_SCAN_FILTER_SIZE, "scan filter size");
+_Static_assert(offsetof(ldnr_scan_filter, network_type) == 0x28, "scan filter type offset");
+_Static_assert(offsetof(ldnr_scan_filter, bssid) == 0x2c, "scan filter BSSID offset");
+_Static_assert(offsetof(ldnr_scan_filter, ssid) == 0x32, "scan filter SSID offset");
+_Static_assert(offsetof(ldnr_scan_filter, flags) == 0x64, "scan filter flags offset");
+_Static_assert(sizeof(ldnr_address_entry) == LDNR_NATIVE_ADDRESS_ENTRY_SIZE, "address entry size");
+_Static_assert(offsetof(ldnr_address_entry, mac_address) == 0x04, "address entry MAC offset");
+_Static_assert(sizeof(ldnr_node_latest_update) == LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE, "node update size");
+
+typedef enum ldnr_native_status {
+    LDNR_NATIVE_OK = 0,
+    LDNR_NATIVE_ERROR_ARGUMENT = -1,
+    LDNR_NATIVE_ERROR_LENGTH = -2,
+    LDNR_NATIVE_ERROR_INVALID = -3
+} ldnr_native_status;
+
+/* Every buffer length is exact. Decoding validates before changing the output. */
+#define LDNR_NATIVE_CODEC(type)                                                        \
+    ldnr_native_status ldnr_native_##type##_encode(                                   \
+        const ldnr_##type *value, uint8_t *out, size_t out_size);                      \
+    ldnr_native_status ldnr_native_##type##_decode(                                   \
+        ldnr_##type *value, const uint8_t *in, size_t in_size)
+
+LDNR_NATIVE_CODEC(intent_id);
+LDNR_NATIVE_CODEC(network_id);
+LDNR_NATIVE_CODEC(ssid);
+LDNR_NATIVE_CODEC(common_network_info);
+LDNR_NATIVE_CODEC(node_info);
+LDNR_NATIVE_CODEC(network_info);
+LDNR_NATIVE_CODEC(user_config);
+LDNR_NATIVE_CODEC(security_config);
+LDNR_NATIVE_CODEC(security_parameter);
+LDNR_NATIVE_CODEC(network_config);
+LDNR_NATIVE_CODEC(scan_filter);
+LDNR_NATIVE_CODEC(address_entry);
+LDNR_NATIVE_CODEC(node_latest_update);
+
+#undef LDNR_NATIVE_CODEC
+
+#endif
diff --git a/dm/host/ldnr/ldnr_protocol.c b/dm/host/ldnr/ldnr_protocol.c
new file mode 100644
index 0000000..4e5a8e8
--- /dev/null
+++ b/dm/host/ldnr/ldnr_protocol.c
@@ -0,0 +1,466 @@
+// ldn-relay-server protocol 1.1. The Go package pkg/protocol is the reference
+// while the relay repository's v1.0 document is being revised concurrently.
+#include "ldnr_internal.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define LDNR_WIRE_VERSION 1
+#define LDNR_WIRE_MINOR 1
+#define LDNR_WIRE_HEADER 16
+#define LDNR_WIRE_MAX_STRING 1024
+#define LDNR_WIRE_CAPS 0x1fu
+
+static _Thread_local char ldnr_protocol_error_text[192];
+const char *ldnr_protocol_error(void) { return ldnr_protocol_error_text; }
+static int ldnr_wire_fail(const char *format, ...) {
+    va_list ap;
+    va_start(ap, format);
+    vsnprintf(ldnr_protocol_error_text, sizeof ldnr_protocol_error_text, format, ap);
+    va_end(ap);
+    return -1;
+}
+
+typedef struct { uint8_t *data; size_t size, offset; int failed; } ldnr_writer;
+typedef struct { const uint8_t *data; size_t size, offset; int failed; } ldnr_reader;
+
+static void ldnr_put(ldnr_writer *w, const void *data, size_t size) {
+    if (w->failed) return;
+    if (size > w->size - w->offset) { w->failed = 1; return; }
+    if (size) memcpy(w->data + w->offset, data, size);
+    w->offset += size;
+}
+static void ldnr_u8w(ldnr_writer *w, uint8_t v) { ldnr_put(w, &v, 1); }
+static void ldnr_u16w(ldnr_writer *w, uint16_t v) {
+    uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)}; ldnr_put(w, b, 2);
+}
+static void ldnr_u32w(ldnr_writer *w, uint32_t v) {
+    uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+    ldnr_put(w, b, 4);
+}
+static void ldnr_u64w(ldnr_writer *w, uint64_t v) {
+    ldnr_u32w(w, (uint32_t)v); ldnr_u32w(w, (uint32_t)(v >> 32));
+}
+static void ldnr_blobw(ldnr_writer *w, const void *data, size_t size, size_t maximum) {
+    if (size > maximum || size > 0xffff) { w->failed = 1; return; }
+    ldnr_u16w(w, (uint16_t)size); ldnr_put(w, data, size);
+}
+static void ldnr_strw(ldnr_writer *w, const char *s, size_t maximum) {
+    size_t size = s ? strlen(s) : 0;
+    ldnr_blobw(w, s, size, maximum);
+}
+static int ldnr_get(ldnr_reader *r, void *out, size_t size) {
+    if (r->failed) return 0;
+    if (size > r->size - r->offset) { r->failed = 1; return 0; }
+    if (size && out) memcpy(out, r->data + r->offset, size);
+    r->offset += size;
+    return 1;
+}
+static uint8_t ldnr_u8r(ldnr_reader *r) { uint8_t v = 0; ldnr_get(r, &v, 1); return v; }
+static uint16_t ldnr_u16r(ldnr_reader *r) {
+    uint8_t b[2] = {0}; ldnr_get(r, b, 2); return (uint16_t)(b[0] | (uint16_t)b[1] << 8);
+}
+static uint32_t ldnr_u32r(ldnr_reader *r) {
+    uint8_t b[4] = {0}; ldnr_get(r, b, 4);
+    return (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+}
+static uint64_t ldnr_u64r(ldnr_reader *r) {
+    uint64_t low = ldnr_u32r(r), high = ldnr_u32r(r); return low | high << 32;
+}
+static ldnr_reader ldnr_record_read(ldnr_reader *r) {
+    ldnr_reader body = {0};
+    uint16_t size = ldnr_u16r(r);
+    if (r->failed || size > r->size - r->offset) { r->failed = 1; return body; }
+    body.data = r->data + r->offset; body.size = size; r->offset += size;
+    return body;
+}
+static size_t ldnr_blobr(ldnr_reader *r, uint8_t *out, size_t capacity, size_t maximum) {
+    uint16_t size = ldnr_u16r(r);
+    if (size > maximum || size > capacity) { r->failed = 1; return 0; }
+    ldnr_get(r, out, size); return r->failed ? 0 : size;
+}
+static void ldnr_strr(ldnr_reader *r, char *out, size_t capacity) {
+    uint16_t size = ldnr_u16r(r);
+    if (size > LDNR_WIRE_MAX_STRING || !capacity) { r->failed = 1; return; }
+    const uint8_t *at = r->data + r->offset;
+    if (!ldnr_get(r, NULL, size)) return;
+    size_t copy = size < capacity - 1 ? size : capacity - 1;
+    if (copy) memcpy(out, at, copy);
+    out[copy] = 0;
+}
+
+static int ldnr_frame_finish(ldnr_writer *w, uint8_t type, uint64_t request_id,
+                             size_t *size) {
+    if (w->failed || w->offset < LDNR_WIRE_HEADER)
+        return ldnr_wire_fail("encoded frame exceeds capacity or field limit");
+    size_t payload = w->offset - LDNR_WIRE_HEADER;
+    if (payload > 0xffffffffu) return ldnr_wire_fail("frame payload is too large");
+    uint8_t header[LDNR_WIRE_HEADER] = {'L', 'D', 'N', 'R', LDNR_WIRE_VERSION, type};
+    header[8] = (uint8_t)payload; header[9] = (uint8_t)(payload >> 8);
+    header[10] = (uint8_t)(payload >> 16); header[11] = (uint8_t)(payload >> 24);
+    uint32_t id = (uint32_t)request_id;
+    header[12] = (uint8_t)id; header[13] = (uint8_t)(id >> 8);
+    header[14] = (uint8_t)(id >> 16); header[15] = (uint8_t)(id >> 24);
+    memcpy(w->data, header, sizeof header); *size = w->offset; return 0;
+}
+
+static void ldnr_encode_hello(ldnr_writer *w, const ldnr_operation *op) {
+    ldnr_u8w(w, 1); ldnr_u8w(w, 1); ldnr_u8w(w, LDNR_WIRE_MINOR);
+    ldnr_u32w(w, LDNR_WIRE_CAPS);
+    ldnr_strw(w, op && op->player_name && *op->player_name ? op->player_name : "NX2Apple", 64);
+    ldnr_strw(w, "NX2Apple", 16);
+}
+
+static void ldnr_encode_create(ldnr_writer *w, const ldnr_operation *op) {
+    if (!op || !op->network_config || !op->security_config || !op->user_config) {
+        w->failed = 1; return;
+    }
+    const ldnr_network_config *config = op->network_config;
+    const ldnr_security_config *security = op->security_config;
+    const char *password = op->room_password ? op->room_password : "";
+    size_t password_size = strlen(password);
+    if (config->node_count_max < 1 || config->node_count_max > 8 ||
+        (security->passphrase_size && (security->passphrase_size < 16 || security->passphrase_size > 64)) ||
+        password_size > 64) { w->failed = 1; return; }
+    ldnr_u64w(w, (uint64_t)config->intent_id.local_communication_id);
+    ldnr_u16w(w, config->intent_id.scene_id); ldnr_u16w(w, (uint16_t)config->channel);
+    ldnr_u8w(w, (uint8_t)config->node_count_max); ldnr_u16w(w, security->security_mode);
+    ldnr_blobw(w, security->passphrase, security->passphrase_size, 64);
+    ldnr_u8w(w, 0); // The initial accept policy is changed through its own call.
+    uint8_t mac[6] = {0};
+    if (op->addresses && op->address_count > 0) memcpy(mac, op->addresses[0].mac_address, 6);
+    ldnr_put(w, mac, 6); ldnr_put(w, op->user_config->user_name, 33);
+    ldnr_u8w(w, *password != 0); ldnr_strw(w, password, 64);
+    ldnr_u16w(w, (uint16_t)config->local_communication_version);
+    ldnr_blobw(w, op->data, op->data_size, 384);
+    char fallback_name[33] = {0};
+    memcpy(fallback_name, op->user_config->user_name, 32);
+    const char *room = op->player_name && *op->player_name ? op->player_name :
+        (*fallback_name ? fallback_name : "NX2Apple");
+    ldnr_strw(w, room, 64); ldnr_strw(w, "NX2Apple", 64);
+    ldnr_u8w(w, !op->private_operation);
+    uint8_t parameter[32] = {0};
+    if (op->security_parameter) memcpy(parameter, op->security_parameter, 32);
+    ldnr_put(w, parameter, 32);
+}
+
+static int ldnr_session_is_zero(const uint8_t session[16]) {
+    uint8_t value = 0;
+    for (unsigned i = 0; i < 16; i++) value |= session[i];
+    return value == 0;
+}
+
+static void ldnr_encode_scan(ldnr_writer *w, const ldnr_operation *op) {
+    const ldnr_scan_filter *filter = op ? op->scan_filter : NULL;
+    uint8_t flags = 0;
+    if (filter) {
+        if (filter->flags & 0x01) flags |= 0x01;
+        if (filter->flags & 0x02) flags |= 0x02;
+        if (filter->flags & 0x40) flags |= 0x04; // native SessionId
+        if (filter->flags & 0x10) flags |= 0x08; // native Ssid
+        if (op->private_operation && !ldnr_session_is_zero(filter->network_id.session_id)) flags |= 0x04;
+    }
+    ldnr_u8w(w, flags);
+    ldnr_u64w(w, filter ? (uint64_t)filter->network_id.intent_id.local_communication_id : 0);
+    ldnr_u16w(w, filter ? filter->network_id.intent_id.scene_id : 0);
+    uint8_t session[16] = {0};
+    if (filter) memcpy(session, filter->network_id.session_id, 16);
+    ldnr_put(w, session, 16);
+    char ssid[33] = {0};
+    if (filter && filter->ssid.length <= 32) memcpy(ssid, filter->ssid.string, filter->ssid.length);
+    ldnr_strw(w, ssid, 32);
+}
+
+static void ldnr_encode_connect(ldnr_writer *w, const ldnr_message *message,
+                                const ldnr_operation *op) {
+    if (!op || !op->security_config || !op->user_config) { w->failed = 1; return; }
+    const ldnr_security_config *security = op->security_config;
+    if (security->passphrase_size && (security->passphrase_size < 16 || security->passphrase_size > 64)) {
+        w->failed = 1; return;
+    }
+    uint8_t session[16] = {0};
+    if (message && message->has_network_info)
+        memcpy(session, message->network_info.network_id.session_id, 16);
+    if (op->security_parameter) memcpy(session, op->security_parameter->session_id, 16);
+    ldnr_put(w, session, 16); ldnr_strw(w, op->room_password ? op->room_password : "", 64);
+    ldnr_blobw(w, security->passphrase, security->passphrase_size, 64);
+    ldnr_put(w, op->user_config->user_name, 33);
+    ldnr_u16w(w, op->network_config ? (uint16_t)op->network_config->local_communication_version : 0);
+    uint8_t mac[6] = {0}; ldnr_put(w, mac, 6);
+    uint8_t parameter[32] = {0};
+    if (op->security_parameter) memcpy(parameter, op->security_parameter, 32);
+    ldnr_put(w, parameter, 32);
+}
+
+int ldnr_protocol_encode_auth(uint8_t *out, size_t capacity, size_t *size,
+                              const char *room_password, const char *player_name) {
+    ldnr_operation op = {0}; op.room_password = room_password; op.player_name = player_name;
+    return ldnr_protocol_encode(out, capacity, size, LDNR_MSG_AUTH_OK, 1, 0, NULL, &op);
+}
+
+int ldnr_protocol_encode(uint8_t *out, size_t capacity, size_t *size,
+                         ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                         const ldnr_message *message, const ldnr_operation *operation) {
+    (void)network_id;
+    if (!out || !size || capacity < LDNR_WIRE_HEADER) return ldnr_wire_fail("invalid encode buffer");
+    ldnr_protocol_error_text[0] = 0;
+    ldnr_writer writer = {out, capacity, LDNR_WIRE_HEADER, 0};
+    ldnr_writer *w = &writer;
+    uint8_t wire_type = 0;
+    switch (type) {
+    case LDNR_MSG_AUTH_OK: wire_type = 0x01; ldnr_encode_hello(w, operation); break;
+    case LDNR_MSG_CREATE_ACK: wire_type = 0x10; ldnr_encode_create(w, operation); break;
+    case LDNR_MSG_DESTROY_ACK:
+        wire_type = 0x12;
+        if (!message || !message->has_network_info) w->failed = 1;
+        else ldnr_put(w, message->network_info.network_id.session_id, 16);
+        break;
+    case LDNR_MSG_SCAN_ACK: wire_type = 0x13; ldnr_encode_scan(w, operation); break;
+    case LDNR_MSG_CONNECT_ACK: wire_type = 0x15; ldnr_encode_connect(w, message, operation); break;
+    case LDNR_MSG_DISCONNECTED: wire_type = 0x17; break;
+    case LDNR_MSG_ADVERTISE_ACK:
+        wire_type = 0x18;
+        if (!operation) w->failed = 1;
+        else ldnr_blobw(w, operation->data, operation->data_size, 384);
+        break;
+    case LDNR_MSG_POLICY_ACK:
+        wire_type = 0x19;
+        if (!operation || operation->option < 0 || operation->option > 3) w->failed = 1;
+        else ldnr_u8w(w, (uint8_t)operation->option);
+        break;
+    case LDNR_MSG_FILTER_ACK:
+        wire_type = 0x1b;
+        if (!operation) w->failed = 1; else ldnr_put(w, operation->mac, 6);
+        break;
+    case LDNR_MSG_REJECT_ACK:
+        wire_type = 0x1a;
+        if (!message || message->node_id < 0 || message->node_id > 255) w->failed = 1;
+        else ldnr_u8w(w, (uint8_t)message->node_id);
+        break;
+    case LDNR_MSG_UDP:
+        wire_type = 0x30;
+        if (!message || message->udp.size > LDNR_UDP_MTU) { w->failed = 1; break; }
+        ldnr_u32w(w, message->udp.source_address); ldnr_u16w(w, message->udp.source_port);
+        ldnr_u32w(w, message->udp.destination_address); ldnr_u16w(w, message->udp.destination_port);
+        ldnr_u8w(w, 17); ldnr_u32w(w, 0); ldnr_blobw(w, message->udp.data, message->udp.size, 65472);
+        break;
+    case LDNR_MSG_PROXY_CONNECT:
+        wire_type = 0x31;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_u32w(w, message->proxy.source_address); ldnr_u16w(w, message->proxy.source_port);
+        ldnr_u32w(w, message->proxy.destination_address); ldnr_u16w(w, message->proxy.destination_port);
+        break;
+    case LDNR_MSG_PROXY_CONNECT_ACK:
+        wire_type = 0x32;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        uint32_t acceptor = message->proxy.source_address ? message->proxy.source_address : message->proxy.destination_address;
+        ldnr_u32w(w, acceptor); // server also overwrites it
+        ldnr_u8w(w, message->status == 0);
+        break;
+    case LDNR_MSG_PROXY_DATA:
+        wire_type = 0x30;
+        if (!message || message->proxy.size > LDNR_TCP_CHUNK) { w->failed = 1; break; }
+        ldnr_u32w(w, message->proxy.source_address); ldnr_u16w(w, message->proxy.source_port);
+        ldnr_u32w(w, message->proxy.destination_address); ldnr_u16w(w, message->proxy.destination_port);
+        ldnr_u8w(w, 6); ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_blobw(w, message->proxy.data, message->proxy.size, 65472);
+        break;
+    case LDNR_MSG_PROXY_DISCONNECT:
+        wire_type = 0x33;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_u32w(w, message->proxy.source_address); ldnr_u8w(w, (uint8_t)message->status);
+        ldnr_u8w(w, (uint8_t)message->reason);
+        break;
+    case LDNR_MSG_PING: case LDNR_MSG_PONG:
+        wire_type = type == LDNR_MSG_PING ? 0x03 : 0x04;
+        ldnr_u64w(w, message ? message->timestamp : 0);
+        break;
+    default: return ldnr_wire_fail("message type %d cannot be encoded", type);
+    }
+    return ldnr_frame_finish(w, wire_type, request_id, size);
+}
+
+static int ldnr_decode_network(ldnr_reader *r, ldnr_network_info *info, uint64_t *network_id) {
+    ldnr_reader body = ldnr_record_read(r);
+    if (r->failed) return -1;
+    ldnr_network_info value;
+    memset(&value, 0, sizeof value);
+    *network_id = ldnr_u64r(&body);
+    value.network_id.intent_id.local_communication_id = (int64_t)ldnr_u64r(&body);
+    value.network_id.intent_id.scene_id = ldnr_u16r(&body);
+    ldnr_get(&body, value.network_id.session_id, 16); ldnr_get(&body, value.server_random, 16);
+    ldnr_get(&body, value.common.bssid, 6);
+    uint8_t ssid_size = ldnr_u8r(&body);
+    if (ssid_size > 32) return -1;
+    value.common.ssid.length = ssid_size; ldnr_get(&body, value.common.ssid.string, ssid_size);
+    value.common.channel = (int16_t)ldnr_u16r(&body);
+    value.common.link_level = (int8_t)ldnr_u8r(&body); value.common.network_type = ldnr_u8r(&body);
+    value.security_mode = ldnr_u16r(&body); value.station_accept_policy = ldnr_u8r(&body);
+    uint8_t maximum = ldnr_u8r(&body), count = ldnr_u8r(&body);
+    if (maximum > 8 || count > maximum || body.failed) return -1;
+    value.node_count_max = (int8_t)maximum; value.node_count = count; value.version = 1;
+    for (unsigned i = 0; i < 8; i++) {
+        ldnr_reader node = ldnr_record_read(&body);
+        if (body.failed) return -1;
+        value.nodes[i].ipv4_address = ldnr_u32r(&node);
+        ldnr_get(&node, value.nodes[i].mac_address, 6);
+        value.nodes[i].node_id = (int8_t)ldnr_u8r(&node); value.nodes[i].is_connected = ldnr_u8r(&node);
+        ldnr_get(&node, value.nodes[i].user_name, 33);
+        value.nodes[i].local_communication_version = (int16_t)ldnr_u16r(&node);
+        (void)ldnr_u8r(&node);
+        if (node.failed) return -1;
+    }
+    value.advertise_data_size = (uint16_t)ldnr_blobr(&body, value.advertise_data, 384, 384);
+    if (body.failed) return -1;
+    *info = value; return 0;
+}
+
+static int ldnr_decode_scan(ldnr_reader *r, ldnr_message *message) {
+    uint16_t count = ldnr_u16r(r); (void)ldnr_u16r(r); (void)ldnr_u8r(r);
+    if (r->failed) return -1;
+    int retained = count > LDNR_MAX_NETWORKS ? LDNR_MAX_NETWORKS : count;
+    if (retained) {
+        message->networks = calloc((size_t)retained, sizeof *message->networks);
+        if (!message->networks) return ldnr_wire_fail("out of memory for scan results");
+    }
+    for (uint16_t i = 0; i < count; i++) {
+        ldnr_reader entry = ldnr_record_read(r);
+        if (r->failed) return -1;
+        ldnr_network_result result;
+        memset(&result, 0, sizeof result);
+        if (ldnr_decode_network(&entry, &result.info, &result.network_id)) return -1;
+        (void)ldnr_u8r(&entry); (void)ldnr_u8r(&entry);
+        char ignored[2]; ldnr_strr(&entry, ignored, sizeof ignored);
+        ldnr_strr(&entry, ignored, sizeof ignored);
+        if (entry.failed) return -1;
+        if (i < retained) message->networks[i] = result;
+    }
+    message->network_count = retained; return 0;
+}
+
+static int ldnr_decode_error(ldnr_reader *r, ldnr_message *message) {
+    uint16_t code = ldnr_u16r(r); char detail[192] = {0}; ldnr_strr(r, detail, sizeof detail);
+    if (r->failed) return -1;
+    snprintf(message->text, sizeof message->text, "relay error %u: %s", code, detail);
+    switch (code) {
+    case 5: case 6: case 12: case 15: message->status = LDNR_ECONNREFUSED; break;
+    case 9: message->status = LDNR_EAGAIN; break;
+    default: message->status = LDNR_ENETDOWN; break;
+    }
+    return 0;
+}
+
+int ldnr_protocol_decode(const uint8_t *frame, size_t size, ldnr_message *message) {
+    if (!frame || !message) return ldnr_wire_fail("invalid decode arguments");
+    ldnr_protocol_error_text[0] = 0;
+    if (size < LDNR_WIRE_HEADER) return ldnr_wire_fail("short frame header");
+    if (memcmp(frame, "LDNR", 4)) return ldnr_wire_fail("bad frame magic");
+    if (frame[4] != LDNR_WIRE_VERSION) return ldnr_wire_fail("unsupported frame version %u", frame[4]);
+    uint32_t payload_size = (uint32_t)frame[8] | (uint32_t)frame[9] << 8 |
+        (uint32_t)frame[10] << 16 | (uint32_t)frame[11] << 24;
+    if (payload_size != size - LDNR_WIRE_HEADER) return ldnr_wire_fail("frame length mismatch");
+    if (payload_size > 65536) return ldnr_wire_fail("frame payload exceeds 64 KiB");
+    ldnr_message decoded;
+    memset(&decoded, 0, sizeof decoded);
+    decoded.request_id = (uint32_t)frame[12] | (uint32_t)frame[13] << 8 |
+        (uint32_t)frame[14] << 16 | (uint32_t)frame[15] << 24;
+    ldnr_reader reader = {frame + LDNR_WIRE_HEADER, payload_size, 0, 0};
+    ldnr_reader *r = &reader;
+    uint8_t type = frame[5];
+    int result = 0;
+    switch (type) {
+    case 0x01: decoded.type = LDNR_MSG_AUTH_ERROR; result = ldnr_wire_fail("unexpected client HELLO"); break;
+    case 0x02: {
+        decoded.type = LDNR_MSG_AUTH_OK;
+        uint8_t major = ldnr_u8r(r), minor = ldnr_u8r(r);
+        (void)ldnr_u8r(r); (void)ldnr_u8r(r);
+        uint32_t capabilities = ldnr_u32r(r);
+        uint8_t connection_id[16]; ldnr_get(r, connection_id, 16);
+        ldnr_strr(r, decoded.text, sizeof decoded.text);
+        (void)ldnr_u32r(r); (void)ldnr_u32r(r);
+        decoded.reason = capabilities;
+        if (major != 1 || minor < 1 || (capabilities & 0x1e) != 0x1e) {
+            decoded.type = LDNR_MSG_AUTH_ERROR; decoded.status = LDNR_ENETDOWN;
+            snprintf(decoded.text, sizeof decoded.text, "relay lacks protocol 1.1 proxy capabilities");
+        }
+        break;
+    }
+    case 0x03: case 0x04:
+        decoded.type = type == 0x03 ? LDNR_MSG_PING : LDNR_MSG_PONG;
+        decoded.timestamp = ldnr_u64r(r); break;
+    case 0x05: decoded.type = LDNR_MSG_ERROR; result = ldnr_decode_error(r, &decoded); break;
+    case 0x11:
+        decoded.type = LDNR_MSG_CREATE_ACK; decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id); break;
+    case 0x12: decoded.type = LDNR_MSG_DESTROY_ACK; break;
+    case 0x14: decoded.type = LDNR_MSG_SCAN_ACK; result = ldnr_decode_scan(r, &decoded); break;
+    case 0x16:
+        decoded.type = LDNR_MSG_CONNECT_ACK; decoded.node_id = ldnr_u8r(r);
+        decoded.ipv4 = ldnr_u32r(r); ldnr_get(r, NULL, 6); decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id);
+        { const uint8_t mask[4] = {255, 255, 0, 0}; memcpy(&decoded.subnet_mask, mask, 4); } break;
+    case 0x17: decoded.type = LDNR_MSG_DISCONNECTED; break;
+    case 0x18: decoded.type = LDNR_MSG_ADVERTISE_ACK; break;
+    case 0x19: decoded.type = LDNR_MSG_POLICY_ACK; break;
+    case 0x1a: decoded.type = LDNR_MSG_REJECT_ACK; break;
+    case 0x1b: case 0x1c: decoded.type = LDNR_MSG_FILTER_ACK; break;
+    case 0x20:
+        decoded.type = LDNR_MSG_NETWORK_UPDATED; decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id); break;
+    case 0x21:
+        decoded.type = LDNR_MSG_DISCONNECTED;
+        { uint8_t session[16]; ldnr_get(r, session, 16); decoded.reason = ldnr_u32r(r); }
+        break;
+    case 0x22: decoded.type = LDNR_MSG_NONE; (void)ldnr_u8r(r); (void)ldnr_u8r(r); break;
+    case 0x30: {
+        decoded.proxy.source_address = ldnr_u32r(r); decoded.proxy.source_port = ldnr_u16r(r);
+        decoded.proxy.destination_address = ldnr_u32r(r); decoded.proxy.destination_port = ldnr_u16r(r);
+        uint8_t protocol = ldnr_u8r(r); decoded.proxy.connection_id = ldnr_u32r(r);
+        uint16_t length = ldnr_u16r(r);
+        if (length > r->size - r->offset) { r->failed = 1; break; }
+        const uint8_t *data = r->data + r->offset; ldnr_get(r, NULL, length);
+        if (protocol == 17) {
+            decoded.type = LDNR_MSG_UDP;
+            if (length > LDNR_UDP_MTU) { r->failed = 1; break; }
+            decoded.udp.source_address = decoded.proxy.source_address;
+            decoded.udp.source_port = decoded.proxy.source_port;
+            decoded.udp.destination_address = decoded.proxy.destination_address;
+            decoded.udp.destination_port = decoded.proxy.destination_port;
+            decoded.udp.size = length; if (length) memcpy(decoded.udp.data, data, length);
+        } else if (protocol == 6) {
+            decoded.type = LDNR_MSG_PROXY_DATA;
+            if (length > LDNR_TCP_CHUNK) { r->failed = 1; break; }
+            decoded.proxy.size = length; if (length) memcpy(decoded.proxy.data, data, length);
+        } else decoded.type = LDNR_MSG_NONE;
+        break;
+    }
+    case 0x31:
+        decoded.type = LDNR_MSG_PROXY_CONNECT; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r); decoded.proxy.source_port = ldnr_u16r(r);
+        decoded.proxy.destination_address = ldnr_u32r(r); decoded.proxy.destination_port = ldnr_u16r(r); break;
+    case 0x32:
+        decoded.type = LDNR_MSG_PROXY_CONNECT_ACK; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r);
+        decoded.status = ldnr_u8r(r) ? 0 : LDNR_ECONNREFUSED; break;
+    case 0x33:
+        decoded.type = LDNR_MSG_PROXY_DISCONNECT; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r); decoded.status = ldnr_u8r(r);
+        decoded.reason = ldnr_u8r(r); break;
+    default:
+        if (!(frame[6] & 1)) result = ldnr_wire_fail("unsupported message type 0x%02x", type);
+        else decoded.type = LDNR_MSG_NONE;
+        break;
+    }
+    if (!result && reader.failed) result = ldnr_wire_fail("malformed or truncated payload type 0x%02x", type);
+    if (result) { ldnr_protocol_message_free(&decoded); return result; }
+    ldnr_protocol_message_free(message); *message = decoded; return 0;
+}
+
+void ldnr_protocol_message_free(ldnr_message *message) {
+    if (!message) return;
+    free(message->networks); message->networks = NULL; message->network_count = 0;
+}
diff --git a/dm/host/ldnr/ldnr_protocol.h b/dm/host/ldnr/ldnr_protocol.h
new file mode 100644
index 0000000..79a49d6
--- /dev/null
+++ b/dm/host/ldnr/ldnr_protocol.h
@@ -0,0 +1,96 @@
+// Protocol-neutral messages exchanged between the codec and the LDN core.
+// The wire representation lives only in ldnr_protocol.c.
+#pragma once
+#include "ldnr_native.h"
+
+#define LDNR_UDP_MTU 1500
+#define LDNR_TCP_CHUNK 16384
+#define LDNR_MAX_NETWORKS 32
+
+typedef enum {
+    LDNR_MSG_NONE = 0,
+    LDNR_MSG_AUTH_OK,
+    LDNR_MSG_AUTH_ERROR,
+    LDNR_MSG_CREATE_ACK,
+    LDNR_MSG_SCAN_ACK,
+    LDNR_MSG_CONNECT_ACK,
+    LDNR_MSG_NETWORK_UPDATED,
+    LDNR_MSG_DISCONNECTED,
+    LDNR_MSG_DESTROY_ACK,
+    LDNR_MSG_ADVERTISE_ACK,
+    LDNR_MSG_POLICY_ACK,
+    LDNR_MSG_FILTER_ACK,
+    LDNR_MSG_REJECT_ACK,
+    LDNR_MSG_UDP,
+    LDNR_MSG_PROXY_CONNECT,
+    LDNR_MSG_PROXY_CONNECT_ACK,
+    LDNR_MSG_PROXY_DATA,
+    LDNR_MSG_PROXY_DISCONNECT,
+    LDNR_MSG_PING,
+    LDNR_MSG_PONG,
+    LDNR_MSG_ERROR,
+} ldnr_message_type;
+
+typedef struct {
+    uint64_t network_id;
+    ldnr_network_info info;
+} ldnr_network_result;
+
+typedef struct {
+    ldnr_message_type type;
+    uint64_t request_id;
+    uint64_t network_id;
+    uint64_t timestamp;
+    uint32_t status;
+    uint32_t reason;
+    uint32_t ipv4;
+    int node_id;
+    uint32_t subnet_mask;
+    int has_network_info;
+    ldnr_network_info network_info;
+    ldnr_network_result *networks;
+    int network_count;
+    struct {
+        uint32_t source_address, destination_address;
+        uint16_t source_port, destination_port;
+        size_t size;
+        uint8_t data[LDNR_UDP_MTU];
+    } udp;
+    struct {
+        uint64_t connection_id;
+        uint32_t source_address, destination_address;
+        uint16_t source_port, destination_port;
+        size_t size;
+        uint8_t data[LDNR_TCP_CHUNK];
+    } proxy;
+    char text[256];
+} ldnr_message;
+
+// Outgoing operations use an explicit message plus the immutable call inputs.
+typedef struct {
+    const ldnr_network_config *network_config;
+    const ldnr_security_config *security_config;
+    const ldnr_user_config *user_config;
+    const ldnr_security_parameter *security_parameter;
+    const ldnr_scan_filter *scan_filter;
+    const ldnr_address_entry *addresses;
+    const void *data;
+    size_t data_size;
+    const char *room_password;
+    const char *player_name;
+    int address_count;
+    int channel;
+    int option;
+    int private_operation;
+    int backlog;
+    uint8_t mac[6];
+} ldnr_operation;
+
+int ldnr_protocol_encode_auth(uint8_t *out, size_t capacity, size_t *size,
+                              const char *room_password, const char *player_name);
+int ldnr_protocol_encode(uint8_t *out, size_t capacity, size_t *size,
+                         ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                         const ldnr_message *message, const ldnr_operation *operation);
+int ldnr_protocol_decode(const uint8_t *frame, size_t size, ldnr_message *message);
+void ldnr_protocol_message_free(ldnr_message *message);
+const char *ldnr_protocol_error(void);
diff --git a/dm/host/ldnr/ldnr_tcp.c b/dm/host/ldnr/ldnr_tcp.c
new file mode 100644
index 0000000..4a11f3e
--- /dev/null
+++ b/dm/host/ldnr/ldnr_tcp.c
@@ -0,0 +1,174 @@
+// POSIX stream transport for LDNR frames. TLS is deliberately not implicit:
+// use a TLS endpoint/tunnel until this small transport gains certificate verification.
+#include "ldnr_transport.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define LDNR_TCP_HEADER 16
+
+typedef struct {
+    pthread_mutex_t mutex;
+    int fd, retired_fd;
+} ldnr_tcp;
+
+static void ldnr_tcp_error(char *out, size_t size, const char *text) {
+    if (out && size) snprintf(out, size, "%s", text);
+}
+
+static int ldnr_tcp_split(const char *server, char **host, char **port,
+                          char *error, size_t error_size) {
+    if (!server || !*server) { ldnr_tcp_error(error, error_size, "empty relay address"); return -1; }
+    const char *port_at = NULL;
+    size_t host_size;
+    if (server[0] == '[') {
+        const char *end = strchr(server, ']');
+        if (!end || (end[1] && end[1] != ':')) {
+            ldnr_tcp_error(error, error_size, "invalid bracketed relay address"); return -1;
+        }
+        *host = strndup(server + 1, (size_t)(end - server - 1));
+        port_at = end[1] == ':' ? end + 2 : NULL;
+        host_size = (size_t)(end - server - 1);
+    } else {
+        const char *colon = strrchr(server, ':');
+        if (colon && strchr(server, ':') == colon) port_at = colon + 1;
+        host_size = port_at ? (size_t)(port_at - server - 1) : strlen(server);
+        *host = strndup(server, host_size);
+    }
+    *port = strdup(port_at && *port_at ? port_at : "11470");
+    if (!*host || !*port || !host_size || !**port) {
+        free(*host); free(*port); *host = *port = NULL;
+        ldnr_tcp_error(error, error_size, "invalid or unallocatable relay address"); return -1;
+    }
+    return 0;
+}
+
+static int ldnr_tcp_connect(void *ctx, const char *server, char *error, size_t error_size) {
+    ldnr_tcp *tcp = ctx;
+    // The core joins its receive thread after close(), so an earlier retired
+    // descriptor can now be released without racing a blocked recv().
+    pthread_mutex_lock(&tcp->mutex);
+    int retired = tcp->retired_fd; tcp->retired_fd = -1;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (retired >= 0) close(retired);
+    char *host = NULL, *port = NULL;
+    if (ldnr_tcp_split(server, &host, &port, error, error_size)) return -1;
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM; hints.ai_protocol = IPPROTO_TCP;
+    struct addrinfo *addresses = NULL;
+    int gai = getaddrinfo(host, port, &hints, &addresses);
+    free(host); free(port);
+    if (gai) { ldnr_tcp_error(error, error_size, gai_strerror(gai)); return -1; }
+    int fd = -1, saved = ECONNREFUSED;
+    for (struct addrinfo *at = addresses; at; at = at->ai_next) {
+        fd = socket(at->ai_family, at->ai_socktype, at->ai_protocol);
+        if (fd < 0) { saved = errno; continue; }
+        int one = 1;
+        (void)setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+#ifdef SO_NOSIGPIPE
+        (void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+        if (connect(fd, at->ai_addr, at->ai_addrlen) == 0) break;
+        saved = errno; close(fd); fd = -1;
+    }
+    freeaddrinfo(addresses);
+    if (fd < 0) { ldnr_tcp_error(error, error_size, strerror(saved)); return -1; }
+    pthread_mutex_lock(&tcp->mutex);
+    int old = tcp->fd; tcp->fd = fd;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (old >= 0) { shutdown(old, SHUT_RDWR); close(old); }
+    return 0;
+}
+
+static ssize_t ldnr_tcp_read(int fd, uint8_t *out, size_t size) {
+    size_t done = 0;
+    while (done < size) {
+        ssize_t n = recv(fd, out + done, size - done, 0);
+        if (n > 0) { done += (size_t)n; continue; }
+        if (n < 0 && errno == EINTR) continue;
+        return n == 0 && done == 0 ? 0 : -1;
+    }
+    return (ssize_t)done;
+}
+
+static ssize_t ldnr_tcp_recv(void *ctx, void *frame, size_t capacity) {
+    ldnr_tcp *tcp = ctx;
+    pthread_mutex_lock(&tcp->mutex); int fd = tcp->fd; pthread_mutex_unlock(&tcp->mutex);
+    if (fd < 0 || capacity < LDNR_TCP_HEADER) return -1;
+    uint8_t *out = frame;
+    if (ldnr_tcp_read(fd, out, LDNR_TCP_HEADER) != LDNR_TCP_HEADER) return -1;
+    if (memcmp(out, "LDNR", 4)) return -1;
+    uint32_t payload = (uint32_t)out[8] | (uint32_t)out[9] << 8 |
+        (uint32_t)out[10] << 16 | (uint32_t)out[11] << 24;
+    if (payload > capacity - LDNR_TCP_HEADER) return -1;
+    if (ldnr_tcp_read(fd, out + LDNR_TCP_HEADER, payload) != (ssize_t)payload) return -1;
+    return (ssize_t)(LDNR_TCP_HEADER + payload);
+}
+
+static int ldnr_tcp_send(void *ctx, const void *frame, size_t size) {
+    ldnr_tcp *tcp = ctx;
+    const uint8_t *data = frame;
+    pthread_mutex_lock(&tcp->mutex);
+    int fd = tcp->fd, result = 0;
+    size_t done = 0;
+    while (fd >= 0 && done < size) {
+#ifdef MSG_NOSIGNAL
+        ssize_t n = send(fd, data + done, size - done, MSG_NOSIGNAL);
+#else
+        ssize_t n = send(fd, data + done, size - done, 0);
+#endif
+        if (n > 0) { done += (size_t)n; continue; }
+        if (n < 0 && errno == EINTR) continue;
+        result = -1; break;
+    }
+    if (fd < 0 || (size == 0 && fd < 0)) result = -1;
+    pthread_mutex_unlock(&tcp->mutex);
+    return result;
+}
+
+static void ldnr_tcp_close(void *ctx) {
+    ldnr_tcp *tcp = ctx;
+    pthread_mutex_lock(&tcp->mutex);
+    int fd = tcp->fd; tcp->fd = -1;
+    if (fd >= 0) {
+        // shutdown() wakes recv(), but close() could let the kernel reuse this
+        // descriptor before that recv() returns. The core joins the receive
+        // thread before connect/destroy, which are the retirement points.
+        if (tcp->retired_fd < 0) tcp->retired_fd = fd;
+    }
+    pthread_mutex_unlock(&tcp->mutex);
+    if (fd >= 0) shutdown(fd, SHUT_RDWR);
+}
+
+static void ldnr_tcp_destroy(void *ctx) {
+    ldnr_tcp *tcp = ctx;
+    if (!tcp) return;
+    ldnr_tcp_close(tcp);
+    pthread_mutex_lock(&tcp->mutex);
+    int retired = tcp->retired_fd; tcp->retired_fd = -1;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (retired >= 0) close(retired);
+    pthread_mutex_destroy(&tcp->mutex); free(tcp);
+}
+
+const ldnr_transport *ldnr_tcp_transport_create(void) {
+    ldnr_transport *transport = calloc(1, sizeof *transport);
+    ldnr_tcp *tcp = calloc(1, sizeof *tcp);
+    if (!transport || !tcp || pthread_mutex_init(&tcp->mutex, NULL)) {
+        free(transport); free(tcp); return NULL;
+    }
+    tcp->fd = tcp->retired_fd = -1; transport->ctx = tcp;
+    transport->connect = ldnr_tcp_connect; transport->recv = ldnr_tcp_recv;
+    transport->send = ldnr_tcp_send; transport->close = ldnr_tcp_close;
+    transport->destroy = ldnr_tcp_destroy;
+    return transport;
+}
diff --git a/dm/host/ldnr/ldnr_transport.h b/dm/host/ldnr/ldnr_transport.h
new file mode 100644
index 0000000..4883014
--- /dev/null
+++ b/dm/host/ldnr/ldnr_transport.h
@@ -0,0 +1,17 @@
+// Frame transport contract. recv returns exactly one protocol frame and blocks
+// until one arrives. close must wake a concurrent recv. Implementations may be
+// in-memory, which keeps the state machine and vnet tests independent of TCP.
+#pragma once
+#include <stddef.h>
+#include <sys/types.h>
+
+typedef struct ldnr_transport {
+    void *ctx;
+    int (*connect)(void *ctx, const char *server, char *error, size_t error_size);
+    ssize_t (*recv)(void *ctx, void *frame, size_t capacity);
+    int (*send)(void *ctx, const void *frame, size_t size);
+    void (*close)(void *ctx);
+    void (*destroy)(void *ctx);
+} ldnr_transport;
+
+const ldnr_transport *ldnr_tcp_transport_create(void);
diff --git a/dm/host/ldnr/ldnr_vnet.c b/dm/host/ldnr/ldnr_vnet.c
new file mode 100644
index 0000000..578ce9b
--- /dev/null
+++ b/dm/host/ldnr/ldnr_vnet.c
@@ -0,0 +1,748 @@
+// Virtual BSD sockets on the LDN subnet. No host socket descriptor escapes:
+// readiness and datagram queues are entirely under this layer's control.
+#include "ldnr_internal.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint16_t ldnr_htons(uint16_t v) { return (uint16_t)((v << 8) | (v >> 8)); }
+uint32_t ldnr_htonl(uint32_t v) {
+    return (v << 24) | ((v & 0xff00u) << 8) | ((v >> 8) & 0xff00u) | (v >> 24);
+}
+uint32_t ldnr_ipv4(unsigned a, unsigned b, unsigned c, unsigned d) {
+    return ldnr_htonl((a << 24) | (b << 16) | (c << 8) | d);
+}
+
+void ldnr_vnet_init(ldnr *l) {
+    memset(&l->vnet, 0, sizeof l->vnet);
+    pthread_mutex_init(&l->vnet.mutex, NULL);
+    pthread_cond_init(&l->vnet.condition, NULL);
+    l->vnet.subnet_mask = ldnr_htonl(0xffff0000u);
+    l->vnet.wait_ctx = l->config.callback_ctx;
+    l->vnet.native_wait = l->config.native_wait;
+}
+
+static void ldnr_free_packets(ldnr_packet *packet) {
+    while (packet) {
+        ldnr_packet *next = packet->next;
+        free(packet);
+        packet = next;
+    }
+}
+
+static void ldnr_socket_clear(ldnr_vsock *s) {
+    ldnr_free_packets(s->head);
+    memset(s, 0, sizeof *s);
+}
+
+void ldnr_vnet_reset(ldnr *l) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) ldnr_socket_clear(&l->vnet.sockets[i]);
+    l->vnet.local_address = 0;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+void ldnr_vnet_destroy(ldnr *l) {
+    ldnr_vnet_reset(l);
+    pthread_mutex_destroy(&l->vnet.mutex);
+    pthread_cond_destroy(&l->vnet.condition);
+}
+
+void ldnr_vnet_set_address(ldnr *l, uint32_t address, uint32_t mask) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.local_address = address;
+    if (mask) l->vnet.subnet_mask = mask;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+static ldnr_vsock *ldnr_socket_at(ldnr *l, int fd) {
+    unsigned index = (unsigned)(fd - LDNR_FD_BASE);
+    if (index >= LDNR_MAX_SOCKETS) return NULL;
+    ldnr_vsock *s = &l->vnet.sockets[index];
+    return s->used && s->fd == fd ? s : NULL;
+}
+
+static ldnr_vsock *ldnr_socket_alloc(ldnr *l, int type) {
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s->used) continue;
+        memset(s, 0, sizeof *s);
+        s->used = 1;
+        s->type = type;
+        s->fd = LDNR_FD_BASE + (int)i;
+        s->recv_timeout_ms = s->send_timeout_ms = -1;
+        return s;
+    }
+    return NULL;
+}
+
+int ldnr_socket(ldnr *l, int family, int type, int protocol) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    if (family != 2 || (type != 1 && type != 2) || (protocol && protocol != (type == 1 ? 6 : 17)))
+        return ldnr_fail(LDNR_EAFNOSUPPORT);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_alloc(l, type);
+    int fd = s ? s->fd : -1;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return s ? fd : ldnr_fail(LDNR_ENOBUFS);
+}
+
+static int ldnr_port_in_use(ldnr *l, int type, uint16_t port, const ldnr_vsock *except) {
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        const ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s != except && s->used && s->type == type && s->bound && s->local.port == port && !s->reuse_address)
+            return 1;
+    }
+    return 0;
+}
+
+static int ldnr_bind_locked(ldnr *l, ldnr_vsock *s, const ldnr_sockaddr *address) {
+    if (s->bound) return ldnr_fail(LDNR_EINVAL);
+    uint32_t ip = address ? address->address : 0;
+    if (ip && ip != l->vnet.local_address) return ldnr_fail(LDNR_EADDRNOTAVAIL);
+    uint16_t port = address ? address->port : 0;
+    if (!port) {
+        uint32_t start = 49152 + ((unsigned)ldnr_monotonic_ms() & 0x3fff);
+        for (uint32_t i = 0; i < 16384; i++) {
+            uint16_t candidate = ldnr_htons((uint16_t)(49152 + ((start - 49152 + i) & 0x3fff)));
+            if (!ldnr_port_in_use(l, s->type, candidate, s)) { port = candidate; break; }
+        }
+        if (!port) return ldnr_fail(LDNR_EADDRINUSE);
+    } else if (ldnr_port_in_use(l, s->type, port, s)) {
+        return ldnr_fail(LDNR_EADDRINUSE);
+    }
+    s->local.address = ip;
+    s->local.port = port;
+    s->bound = 1;
+    return 0;
+}
+
+int ldnr_bind(ldnr *l, int fd, const ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    int result = s ? ldnr_bind_locked(l, s, address) : ldnr_fail(LDNR_EBADF);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_get_sock_name(ldnr *l, int fd, ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    *address = s->local;
+    if (!address->address) address->address = l->vnet.local_address;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+int ldnr_get_peer_name(ldnr *l, int fd, ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (!s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *address = s->peer;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+static int ldnr_destination_valid(ldnr *l, uint32_t address) {
+    if (address == 0xffffffffu) return 1;
+    if (!l->vnet.local_address || !address) return 0;
+    uint32_t mask = l->vnet.subnet_mask;
+    return (address & mask) == (l->vnet.local_address & mask);
+}
+
+int ldnr_vnet_send_udp(ldnr *l, ldnr_vsock *s, const ldnr_sockaddr *destination,
+                       const void *data, size_t size) {
+    ldnr_message message;
+    memset(&message, 0, sizeof message);
+    message.udp.source_address = l->vnet.local_address;
+    message.udp.source_port = s->local.port;
+    message.udp.destination_address = destination->address;
+    message.udp.destination_port = destination->port;
+    message.udp.size = size;
+    if (size) memcpy(message.udp.data, data, size);
+    return ldnr_client_send(l, LDNR_MSG_UDP, 0, &message, NULL);
+}
+
+ssize_t ldnr_sendto(ldnr *l, int fd, const void *data, size_t size, int flags,
+                    const ldnr_sockaddr *destination) {
+    (void)flags;
+    if (!l || (size && !data) || !destination) return ldnr_fail(LDNR_EINVAL);
+    if (size > LDNR_UDP_MTU) return ldnr_fail(LDNR_EMSGSIZE);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 2 || s->shut_write) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EPIPE); }
+    if (!l->vnet.local_address || !ldnr_destination_valid(l, destination->address) || !destination->port) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    int result = s->bound ? 0 : ldnr_bind_locked(l, s, NULL);
+    if (!result) result = ldnr_vnet_send_udp(l, s, destination, data, size);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result ? -1 : (ssize_t)size;
+}
+
+static int ldnr_packet_queue(ldnr *l, ldnr_vsock *s, const ldnr_sockaddr *source,
+                             const void *data, size_t size) {
+    if (s->queued >= LDNR_QUEUE_MAX) {
+        ldnr_packet *old = s->head;
+        if (old) {
+            s->head = old->next;
+            if (!s->head) s->tail = NULL;
+            free(old);
+            s->queued--;
+        }
+    }
+    ldnr_packet *packet = malloc(sizeof *packet + size);
+    if (!packet) return -1;
+    packet->next = NULL;
+    packet->source = *source;
+    packet->size = size;
+    packet->offset = 0;
+    if (size) memcpy(packet->data, data, size);
+    if (s->tail) s->tail->next = packet;
+    else s->head = packet;
+    s->tail = packet;
+    s->queued++;
+    pthread_cond_broadcast(&l->vnet.condition);
+    return 0;
+}
+
+void ldnr_vnet_udp(ldnr *l, const ldnr_message *message) {
+    if (message->udp.size > LDNR_UDP_MTU) return;
+    pthread_mutex_lock(&l->vnet.mutex);
+    int broadcast = message->udp.destination_address == 0xffffffffu ||
+        (message->udp.destination_address | l->vnet.subnet_mask) == 0xffffffffu;
+    if (!broadcast && message->udp.destination_address != l->vnet.local_address) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return;
+    }
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || s->type != 2 || !s->bound || s->shut_read || s->local.port != message->udp.destination_port)
+            continue;
+        if (s->local.address && s->local.address != message->udp.destination_address &&
+            s->local.address != l->vnet.local_address) continue;
+        ldnr_sockaddr source = {message->udp.source_address, message->udp.source_port};
+        ldnr_packet_queue(l, s, &source, message->udp.data, message->udp.size);
+        if (!broadcast) break;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+int ldnr_inject_udp(ldnr *l, uint32_t source_address, uint16_t source_port,
+                    uint32_t destination_address, uint16_t destination_port,
+                    const void *data, size_t size) {
+    if (!l || (size && !data) || size > LDNR_UDP_MTU) return ldnr_fail(LDNR_EINVAL);
+    ldnr_message message;
+    memset(&message, 0, sizeof message);
+    message.udp.source_address = source_address;
+    message.udp.source_port = source_port;
+    message.udp.destination_address = destination_address;
+    message.udp.destination_port = destination_port;
+    message.udp.size = size;
+    if (size) memcpy(message.udp.data, data, size);
+    ldnr_vnet_udp(l, &message);
+    return 0;
+}
+
+static int64_t ldnr_socket_deadline(const ldnr_vsock *s, int timeout_ms) {
+    if (timeout_ms == -2) timeout_ms = s->nonblocking ? 0 : s->recv_timeout_ms;
+    if (s->nonblocking) timeout_ms = 0;
+    return timeout_ms < 0 ? -1 : ldnr_monotonic_ms() + timeout_ms;
+}
+
+static int ldnr_vnet_wait(ldnr *l, int64_t deadline) {
+    return ldnr_wait_until(l, &l->vnet.condition, &l->vnet.mutex, l->vnet.wait_ctx,
+                           l->vnet.native_wait, deadline);
+}
+
+ssize_t ldnr_recvfrom(ldnr *l, int fd, void *data, size_t capacity, int flags,
+                      ldnr_sockaddr *source, int timeout_ms) {
+    if (!l || (capacity && !data)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 2) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms);
+    while (!s->head) {
+        if (s->shut_read || !l->vnet.local_address) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENETDOWN); }
+        if ((s->nonblocking || timeout_ms == 0) ||
+            (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_at(l, fd);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    ldnr_packet *packet = s->head;
+    size_t copied = packet->size < capacity ? packet->size : capacity;
+    if (copied) memcpy(data, packet->data + packet->offset, copied);
+    if (source) *source = packet->source;
+    if (!(flags & 2)) {
+        s->head = packet->next;
+        if (!s->head) s->tail = NULL;
+        s->queued--;
+        free(packet);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return (ssize_t)copied;
+}
+
+static int ldnr_stream_can_read(const ldnr_vsock *s) {
+    return s->head || s->remote_eof || s->shut_read || s->connect_error;
+}
+
+ssize_t ldnr_recv(ldnr *l, int fd, void *data, size_t capacity, int flags, int timeout_ms) {
+    if (!l || (capacity && !data)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 1 || (!s->connected && !s->connect_error)) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_ENOTCONN);
+    }
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms);
+    while (!ldnr_stream_can_read(s)) {
+        if ((s->nonblocking || timeout_ms == 0) || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_at(l, fd);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    if (s->connect_error && !s->head) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ECONNRESET); }
+    if (!s->head) { pthread_mutex_unlock(&l->vnet.mutex); return 0; }
+    ldnr_packet *packet = s->head;
+    size_t available = packet->size - packet->offset;
+    size_t copied = available < capacity ? available : capacity;
+    if (copied) memcpy(data, packet->data + packet->offset, copied);
+    if (!(flags & 2)) {
+        packet->offset += copied;
+        if (packet->offset == packet->size) {
+            s->head = packet->next;
+            if (!s->head) s->tail = NULL;
+            s->queued--;
+            free(packet);
+        }
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return (ssize_t)copied;
+}
+
+int ldnr_vnet_send_proxy(ldnr *l, ldnr_message_type type, ldnr_vsock *s,
+                         const void *data, size_t size) {
+    ldnr_message message;
+    memset(&message, 0, sizeof message);
+    message.proxy.connection_id = s->connection_id;
+    message.proxy.source_address = l->vnet.local_address;
+    message.proxy.destination_address = s->peer.address;
+    message.proxy.source_port = s->local.port;
+    message.proxy.destination_port = s->peer.port;
+    message.proxy.size = size;
+    if (size) memcpy(message.proxy.data, data, size);
+    return ldnr_client_send(l, type, 0, &message, NULL);
+}
+
+ssize_t ldnr_send(ldnr *l, int fd, const void *data, size_t size, int flags) {
+    (void)flags;
+    if (!l || (size && !data)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type == 2) {
+        if (size > LDNR_UDP_MTU) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EMSGSIZE); }
+        ldnr_sockaddr peer = s->peer;
+        if (!s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+        int result = ldnr_vnet_send_udp(l, s, &peer, data, size);
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return result ? -1 : (ssize_t)size;
+    }
+    if (!s->connected || s->shut_write || s->remote_eof) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_EPIPE);
+    }
+    size_t sent = 0;
+    while (sent < size) {
+        size_t chunk = size - sent;
+        if (chunk > LDNR_TCP_CHUNK) chunk = LDNR_TCP_CHUNK;
+        if (ldnr_vnet_send_proxy(l, LDNR_MSG_PROXY_DATA, s, (const uint8_t *)data + sent, chunk)) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return sent ? (ssize_t)sent : -1;
+        }
+        sent += chunk;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return (ssize_t)sent;
+}
+
+int ldnr_connect_socket(ldnr *l, int fd, const ldnr_sockaddr *destination, int timeout_ms) {
+    if (!l || !destination) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type == 2) {
+        if (!ldnr_destination_valid(l, destination->address)) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENETDOWN); }
+        if (!s->bound && ldnr_bind_locked(l, s, NULL)) { pthread_mutex_unlock(&l->vnet.mutex); return -1; }
+        s->peer = *destination;
+        s->connected = 1;
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return 0;
+    }
+    if (s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EISCONN); }
+    if (s->connecting) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EALREADY); }
+    if (!l->vnet.local_address || !ldnr_destination_valid(l, destination->address) || !destination->port) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    if (!s->bound && ldnr_bind_locked(l, s, NULL)) { pthread_mutex_unlock(&l->vnet.mutex); return -1; }
+    s->peer = *destination;
+    s->connection_id = ldnr_next_connection_id(l);
+    s->connecting = 1;
+    s->connect_error = 0;
+    if (ldnr_vnet_send_proxy(l, LDNR_MSG_PROXY_CONNECT, s, NULL, 0)) {
+        s->connecting = 0;
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return -1;
+    }
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms);
+    if (deadline == ldnr_monotonic_ms() || s->nonblocking) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_EINPROGRESS);
+    }
+    while (s->connecting && !s->connect_error) {
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ETIMEDOUT);
+        }
+        s = ldnr_socket_at(l, fd);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    int result = s->connect_error ? ldnr_fail(s->connect_error) : 0;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_listen(ldnr *l, int fd, int backlog) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 1 || s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EINVAL); }
+    if (!s->bound && ldnr_bind_locked(l, s, NULL)) { pthread_mutex_unlock(&l->vnet.mutex); return -1; }
+    s->listening = 1;
+    s->backlog = backlog > 0 ? backlog : 1;
+    if (s->backlog > LDNR_ACCEPT_MAX) s->backlog = LDNR_ACCEPT_MAX;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+int ldnr_accept(ldnr *l, int fd, ldnr_sockaddr *source, int timeout_ms) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (!s->listening) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EINVAL); }
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms);
+    while (!s->accept_count) {
+        if (s->nonblocking || timeout_ms == 0 || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_at(l, fd);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    int index = s->accept_head;
+    int newfd = s->accept_fds[index];
+    s->accept_head = (index + 1) % LDNR_ACCEPT_MAX;
+    s->accept_count--;
+    if (source) {
+        ldnr_vsock *peer = ldnr_socket_at(l, newfd);
+        if (peer) *source = peer->local;
+        if (peer) *source = peer->peer;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return newfd;
+}
+
+void ldnr_vnet_proxy_connect(ldnr *l, const ldnr_message *message) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *listener = NULL;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s->used && s->type == 1 && s->listening && s->local.port == message->proxy.destination_port &&
+            (!s->local.address || s->local.address == message->proxy.destination_address) &&
+            s->accept_count < s->backlog) { listener = s; break; }
+    }
+    ldnr_vsock *accepted = listener ? ldnr_socket_alloc(l, 1) : NULL;
+    if (accepted) {
+        accepted->bound = accepted->connected = 1;
+        accepted->local.address = message->proxy.destination_address;
+        accepted->local.port = message->proxy.destination_port;
+        accepted->peer.address = message->proxy.source_address;
+        accepted->peer.port = message->proxy.source_port;
+        accepted->connection_id = message->proxy.connection_id;
+        int index = (listener->accept_head + listener->accept_count) % LDNR_ACCEPT_MAX;
+        listener->accept_fds[index] = accepted->fd;
+        listener->accept_count++;
+        pthread_cond_broadcast(&l->vnet.condition);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    ldnr_message reply;
+    memset(&reply, 0, sizeof reply);
+    reply.proxy = message->proxy;
+    reply.status = accepted ? 0 : LDNR_ECONNREFUSED;
+    ldnr_client_send(l, LDNR_MSG_PROXY_CONNECT_ACK, 0, &reply, NULL);
+}
+
+void ldnr_vnet_proxy_ack(ldnr *l, const ldnr_message *message) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || s->connection_id != message->proxy.connection_id) continue;
+        s->connecting = 0;
+        if (message->status) s->connect_error = (int)message->status;
+        else s->connected = 1;
+        pthread_cond_broadcast(&l->vnet.condition);
+        break;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+void ldnr_vnet_proxy_data(ldnr *l, const ldnr_message *message) {
+    if (message->proxy.size > LDNR_TCP_CHUNK) return;
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || !s->connected || s->connection_id != message->proxy.connection_id) continue;
+        ldnr_packet_queue(l, s, &s->peer, message->proxy.data, message->proxy.size);
+        break;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+void ldnr_vnet_proxy_disconnect(ldnr *l, const ldnr_message *message) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || s->connection_id != message->proxy.connection_id) continue;
+        s->remote_eof = 1;
+        if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ECONNREFUSED; }
+        pthread_cond_broadcast(&l->vnet.condition);
+        break;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+int ldnr_close_socket(ldnr *l, int fd) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    uint64_t connection_id = s->connection_id;
+    int notify = s->type == 1 && connection_id && !s->listening;
+    ldnr_socket_clear(s);
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (notify) {
+        ldnr_message message;
+        memset(&message, 0, sizeof message);
+        message.proxy.connection_id = connection_id;
+        ldnr_client_send(l, LDNR_MSG_PROXY_DISCONNECT, 0, &message, NULL);
+    }
+    return 0;
+}
+
+int ldnr_shutdown(ldnr *l, int fd, int how) {
+    if (!l || how < 0 || how > 2) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (how == 0 || how == 2) s->shut_read = 1;
+    if (how == 1 || how == 2) s->shut_write = 1;
+    if (s->shut_read) ldnr_free_packets(s->head);
+    if (s->shut_read) { s->head = s->tail = NULL; s->queued = 0; }
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if ((how == 1 || how == 2) && s->connection_id)
+        ldnr_vnet_send_proxy(l, LDNR_MSG_PROXY_DISCONNECT, s, NULL, 0);
+    return 0;
+}
+
+void ldnr_vnet_network_down(ldnr *l) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.local_address = 0;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used) continue;
+        if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ENETDOWN; }
+        if (s->connected) s->remote_eof = 1;
+    }
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+int ldnr_fcntl(ldnr *l, int fd, int command, long argument) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int result;
+    if (command == 3) result = s->nonblocking ? 4 : 0;
+    else if (command == 4) { s->nonblocking = !!(argument & 4); pthread_cond_broadcast(&l->vnet.condition); result = 0; }
+    else result = ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+static int ldnr_option_time(const void *value, uint32_t size) {
+    if (!value) return -1;
+    if (size == 16) {
+        const int64_t *tv = value;
+        if (tv[0] < 0 || tv[1] < 0) return -1;
+        int64_t ms = tv[0] * 1000 + tv[1] / 1000;
+        return ms > 0x7fffffff ? 0x7fffffff : (int)ms;
+    }
+    if (size == 8) {
+        const int32_t *tv = value;
+        if (tv[0] < 0 || tv[1] < 0) return -1;
+        return tv[0] * 1000 + tv[1] / 1000;
+    }
+    if (size == 4) return *(const int32_t *)value;
+    return -1;
+}
+
+int ldnr_setsockopt(ldnr *l, int fd, int level, int option, const void *value, uint32_t size) {
+    (void)level;
+    if (!l || !value) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int result = 0;
+    if ((option == 0x20 || option == 4) && size >= 4) {
+        int enabled = *(const int32_t *)value != 0;
+        if (option == 0x20) s->broadcast = enabled;
+        else s->reuse_address = enabled;
+    } else if (option == 0x1005 || option == 0x1006) {
+        int timeout = ldnr_option_time(value, size);
+        if (timeout < 0) result = ldnr_fail(LDNR_EINVAL);
+        else if (option == 0x1005) s->send_timeout_ms = timeout;
+        else s->recv_timeout_ms = timeout;
+    } else result = ldnr_fail(LDNR_ENOPROTOOPT);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_getsockopt(ldnr *l, int fd, int level, int option, void *value, uint32_t *size) {
+    (void)level;
+    if (!l || !value || !size || *size < 4) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int32_t v;
+    if (option == 0x1007) { v = s->connect_error; s->connect_error = 0; }
+    else if (option == 0x1008) v = s->type;
+    else if (option == 0x20) v = s->broadcast;
+    else if (option == 4) v = s->reuse_address;
+    else { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOPROTOOPT); }
+    memcpy(value, &v, 4);
+    *size = 4;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+static int ldnr_poll_events(ldnr *l, ldnr_vsock *s, int events) {
+    if (!s) return LDNR_POLLNVAL;
+    int result = 0;
+    if (s->type == 2) {
+        if (s->head) result |= LDNR_POLLIN;
+        if (l->vnet.local_address && !s->shut_write) result |= LDNR_POLLOUT;
+    } else {
+        if (s->listening ? s->accept_count : ldnr_stream_can_read(s)) result |= LDNR_POLLIN;
+        if (s->connected && !s->shut_write) result |= LDNR_POLLOUT;
+    }
+    if (s->connect_error) result |= LDNR_POLLERR;
+    if (s->remote_eof || s->shut_read) result |= LDNR_POLLHUP;
+    return result & (events | LDNR_POLLERR | LDNR_POLLHUP | LDNR_POLLNVAL);
+}
+
+int ldnr_poll(ldnr *l, ldnr_pollfd *fds, size_t count, int timeout_ms) {
+    if (!l || (count && !fds)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    int64_t deadline = timeout_ms < 0 ? -1 : ldnr_monotonic_ms() + timeout_ms;
+    // An infinite wait with no descriptors would never be wakeable. Match the
+    // host's existing offline guard so a guest thread cannot strand its core.
+    if (!count && timeout_ms < 0) deadline = ldnr_monotonic_ms() + 100;
+    for (;;) {
+        int ready = 0;
+        for (size_t i = 0; i < count; i++) {
+            if (fds[i].fd < 0) { fds[i].revents = 0; continue; }
+            ldnr_vsock *s = ldnr_socket_at(l, fds[i].fd);
+            fds[i].revents = (int16_t)ldnr_poll_events(l, s, fds[i].events);
+            if (fds[i].revents) ready++;
+        }
+        if (ready || timeout_ms == 0 || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ready;
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return 0;
+        }
+    }
+}
+
+int ldnr_select(ldnr *l, int nfds, uint64_t *readfds, uint64_t *writefds,
+                uint64_t *exceptfds, int timeout_ms) {
+    if (!l || nfds < 0 || nfds > 1024) return ldnr_fail(LDNR_EINVAL);
+    ldnr_pollfd *fds = calloc((size_t)nfds, sizeof *fds);
+    if (!fds && nfds) return ldnr_fail(LDNR_ENOBUFS);
+    for (int fd = 0; fd < nfds; fd++) {
+        fds[fd].fd = fd;
+        uint64_t bit = 1ull << (fd & 63);
+        if (readfds && (readfds[fd >> 6] & bit)) fds[fd].events |= LDNR_POLLIN;
+        if (writefds && (writefds[fd >> 6] & bit)) fds[fd].events |= LDNR_POLLOUT;
+        if (exceptfds && (exceptfds[fd >> 6] & bit)) fds[fd].events |= LDNR_POLLPRI;
+    }
+    int result = ldnr_poll(l, fds, (size_t)nfds, timeout_ms);
+    if (result >= 0) {
+        uint64_t r[16] = {0}, w[16] = {0}, e[16] = {0};
+        int ready = 0;
+        for (int fd = 0; fd < nfds; fd++) {
+            uint64_t bit = 1ull << (fd & 63);
+            int descriptor_ready = 0;
+            if (fds[fd].revents & LDNR_POLLIN) { r[fd >> 6] |= bit; descriptor_ready = 1; }
+            if (fds[fd].revents & LDNR_POLLOUT) { w[fd >> 6] |= bit; descriptor_ready = 1; }
+            if (fds[fd].revents & (LDNR_POLLPRI | LDNR_POLLERR | LDNR_POLLHUP)) {
+                e[fd >> 6] |= bit; descriptor_ready = 1;
+            }
+            if (descriptor_ready) ready++;
+        }
+        if (readfds) memcpy(readfds, r, sizeof r);
+        if (writefds) memcpy(writefds, w, sizeof w);
+        if (exceptfds) memcpy(exceptfds, e, sizeof e);
+        result = ready;
+    }
+    free(fds);
+    return result;
+}
diff --git a/dm/host/ldnr/tests/Makefile b/dm/host/ldnr/tests/Makefile
new file mode 100644
index 0000000..f7cf73f
--- /dev/null
+++ b/dm/host/ldnr/tests/Makefile
@@ -0,0 +1,42 @@
+CC ?= cc
+BUILD_DIR ?= /tmp/nx2apple-ldnr-tests
+CPPFLAGS += -D_POSIX_C_SOURCE=200809L -I..
+CFLAGS ?= -O2 -g
+CFLAGS += -std=c11 -Wall -Wextra -Werror -pedantic
+LDLIBS += -pthread
+
+CORE := ../ldnr_native.c ../ldnr_protocol.c ../ldnr_tcp.c \
+        ../ldnr_vnet.c ../ldnr_client.c ../ldnr.c
+TESTS := t_native t_protocol t_state t_vnet t_ldnr_e2e
+BINARIES := $(addprefix $(BUILD_DIR)/,$(TESTS))
+
+.PHONY: all run glue-check clean
+all: $(BINARIES) glue-check
+
+$(BUILD_DIR):
+	mkdir -p $@
+
+$(BUILD_DIR)/t_native: t_native.c ../ldnr_native.c | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) ../ldnr_native.c $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_protocol: t_protocol.c ../ldnr_protocol.c | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) ../ldnr_protocol.c $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_state: t_state.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_vnet: t_vnet.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_ldnr_e2e: t_ldnr_e2e.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+glue-check:
+	$(CC) -std=c11 -D_POSIX_C_SOURCE=200809L -DLDNR_GLUE_SYNTAX_TEST \
+		-Wall -Wextra -Werror -fsyntax-only -I../.. -I.. ../../hle_ldnr.c
+
+run: all
+	@set -e; for test in $(BINARIES); do $$test; done
+
+clean:
+	rm -rf $(BUILD_DIR)
