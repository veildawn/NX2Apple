+++ b/dm/host/ldnr/tests/t_native.c
@@ -0,0 +1,322 @@
+#include "ldnr_native.h"
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static void fill_bytes(uint8_t *bytes, size_t size, uint8_t seed)
+{
+    size_t i;
+
+    for (i = 0; i < size; ++i)
+        bytes[i] = (uint8_t)(seed + i * 17u);
+}
+
+#define CHECK_ROUND_TRIP(source, kind, size)                                          \
+    do {                                                                              \
+        uint8_t bytes_[size];                                                         \
+        ldnr_##kind decoded_ = {0};                                                   \
+        assert(ldnr_native_##kind##_encode(&(source), bytes_, sizeof(bytes_)) ==      \
+               LDNR_NATIVE_OK);                                                       \
+        assert(ldnr_native_##kind##_decode(&decoded_, bytes_, sizeof(bytes_)) ==      \
+               LDNR_NATIVE_OK);                                                       \
+        assert(memcmp(&(source), &decoded_, sizeof(source)) == 0);                    \
+    } while (0)
+
+static void test_layouts(void)
+{
+    assert(sizeof(ldnr_intent_id) == 0x18);
+    assert(offsetof(ldnr_intent_id, scene_id) == 0x0a);
+    assert(sizeof(ldnr_network_id) == 0x28);
+    assert(offsetof(ldnr_network_id, session_id) == 0x18);
+    assert(sizeof(ldnr_ssid) == 0x22);
+    assert(offsetof(ldnr_ssid, string) == 0x01);
+    assert(sizeof(ldnr_common_network_info) == 0x30);
+    assert(offsetof(ldnr_common_network_info, ssid) == 0x06);
+    assert(offsetof(ldnr_common_network_info, channel) == 0x28);
+    assert(sizeof(ldnr_node_info) == 0x40);
+    assert(offsetof(ldnr_node_info, node_id) == 0x0a);
+    assert(offsetof(ldnr_node_info, user_name) == 0x0c);
+    assert(offsetof(ldnr_node_info, platform) == 0x2d);
+    assert(sizeof(ldnr_network_info) == 0x480);
+    assert(offsetof(ldnr_network_info, common) == 0x28);
+    assert(offsetof(ldnr_network_info, security_mode) == 0x68);
+    assert(offsetof(ldnr_network_info, nodes) == 0x70);
+    assert(offsetof(ldnr_network_info, advertise_data_size) == 0x272);
+    assert(offsetof(ldnr_network_info, advertise_data) == 0x274);
+    assert(sizeof(ldnr_user_config) == 0x30);
+    assert(sizeof(ldnr_security_config) == 0x44);
+    assert(offsetof(ldnr_security_config, passphrase) == 0x04);
+    assert(sizeof(ldnr_security_parameter) == 0x20);
+    assert(offsetof(ldnr_security_parameter, session_id) == 0x10);
+    assert(sizeof(ldnr_network_config) == 0x28);
+    assert(offsetof(ldnr_network_config, channel) == 0x18);
+    assert(offsetof(ldnr_network_config, local_communication_version) == 0x1c);
+    assert(sizeof(ldnr_scan_filter) == 0x68);
+    assert(offsetof(ldnr_scan_filter, ssid) == 0x32);
+    assert(offsetof(ldnr_scan_filter, flags) == 0x64);
+    assert(sizeof(ldnr_address_entry) == 0x0c);
+    assert(sizeof(ldnr_node_latest_update) == 0x08);
+}
+
+static void test_identifier_and_node_round_trips(void)
+{
+    ldnr_intent_id intent = {0};
+    ldnr_network_id network = {0};
+    ldnr_ssid ssid = {0};
+    ldnr_common_network_info common = {0};
+    ldnr_node_info node = {0};
+
+    intent.local_communication_id = INT64_C(-0x123456789abcdef);
+    intent.scene_id = 0xf123;
+    CHECK_ROUND_TRIP(intent, intent_id, LDNR_NATIVE_INTENT_ID_SIZE);
+
+    network.intent_id = intent;
+    fill_bytes(network.session_id, sizeof(network.session_id), 3);
+    CHECK_ROUND_TRIP(network, network_id, LDNR_NATIVE_NETWORK_ID_SIZE);
+
+    ssid.length = LDNR_NATIVE_SSID_MAX;
+    fill_bytes(ssid.string, sizeof(ssid.string), 7);
+    ssid.string[LDNR_NATIVE_SSID_MAX] = 0;
+    CHECK_ROUND_TRIP(ssid, ssid, LDNR_NATIVE_SSID_SIZE);
+
+    fill_bytes(common.bssid, sizeof(common.bssid), 11);
+    common.ssid = ssid;
+    common.channel = -1234;
+    common.link_level = -5;
+    common.network_type = 2;
+    CHECK_ROUND_TRIP(common, common_network_info,
+                     LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE);
+
+    node.ipv4_address = UINT32_C(0x89abcdef);
+    fill_bytes(node.mac_address, sizeof(node.mac_address), 19);
+    node.node_id = -7;
+    node.is_connected = 1;
+    fill_bytes(node.user_name, sizeof(node.user_name), 23);
+    node.platform = 1;
+    node.local_communication_version = -2345;
+    CHECK_ROUND_TRIP(node, node_info, LDNR_NATIVE_NODE_INFO_SIZE);
+}
+
+static void test_network_info_round_trip(void)
+{
+    ldnr_network_info info = {0};
+    uint8_t bytes[LDNR_NATIVE_NETWORK_INFO_SIZE];
+    ldnr_network_info decoded = {0};
+    size_t i;
+
+    info.network_id.intent_id.local_communication_id = INT64_C(0x102030405060708);
+    info.network_id.intent_id.scene_id = 42;
+    fill_bytes(info.network_id.session_id, sizeof(info.network_id.session_id), 29);
+    fill_bytes(info.common.bssid, sizeof(info.common.bssid), 31);
+    info.common.ssid.length = 5;
+    memcpy(info.common.ssid.string, "relay", 5);
+    info.common.channel = 11;
+    info.common.link_level = 3;
+    info.common.network_type = 1;
+    fill_bytes(info.server_random, sizeof(info.server_random), 37);
+    info.security_mode = 2;
+    info.station_accept_policy = 1;
+    info.version = 3;
+    info.node_count_max = 8;
+    info.node_count = 2;
+    for (i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; ++i) {
+        info.nodes[i].ipv4_address = UINT32_C(0xc0a80001) + (uint32_t)i;
+        fill_bytes(info.nodes[i].mac_address, sizeof(info.nodes[i].mac_address),
+                   (uint8_t)(41 + i));
+        info.nodes[i].node_id = (int8_t)i;
+        info.nodes[i].is_connected = i < info.node_count;
+        fill_bytes(info.nodes[i].user_name, sizeof(info.nodes[i].user_name),
+                   (uint8_t)(53 + i));
+        info.nodes[i].local_communication_version = (int16_t)(100 + i);
+    }
+    info.advertise_data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX;
+    fill_bytes(info.advertise_data, sizeof(info.advertise_data), 67);
+
+    assert(ldnr_native_network_info_encode(&info, bytes, sizeof(bytes)) == LDNR_NATIVE_OK);
+    assert(bytes[0x272] == 0x80 && bytes[0x273] == 0x01);
+    assert(bytes[0x70] == 0x01 && bytes[0x71] == 0x00 && bytes[0x72] == 0xa8 &&
+           bytes[0x73] == 0xc0);
+    assert(ldnr_native_network_info_decode(&decoded, bytes, sizeof(bytes)) == LDNR_NATIVE_OK);
+    assert(memcmp(&info, &decoded, sizeof(info)) == 0);
+}
+
+static void test_config_round_trips(void)
+{
+    ldnr_user_config user = {0};
+    ldnr_security_config security = {0};
+    ldnr_security_parameter parameter = {0};
+    ldnr_network_config network = {0};
+    ldnr_scan_filter filter = {0};
+    ldnr_node_latest_update update = {0};
+
+    fill_bytes(user.user_name, sizeof(user.user_name), 71);
+    CHECK_ROUND_TRIP(user, user_config, LDNR_NATIVE_USER_CONFIG_SIZE);
+
+    security.security_mode = 0x1234;
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX;
+    fill_bytes(security.passphrase, sizeof(security.passphrase), 73);
+    CHECK_ROUND_TRIP(security, security_config, LDNR_NATIVE_SECURITY_CONFIG_SIZE);
+
+    fill_bytes(parameter.server_random, sizeof(parameter.server_random), 79);
+    fill_bytes(parameter.session_id, sizeof(parameter.session_id), 83);
+    CHECK_ROUND_TRIP(parameter, security_parameter, LDNR_NATIVE_SECURITY_PARAMETER_SIZE);
+
+    network.intent_id.local_communication_id = INT64_C(-9000000000);
+    network.intent_id.scene_id = 0xabcd;
+    network.channel = -161;
+    network.node_count_max = 8;
+    network.local_communication_version = -2;
+    CHECK_ROUND_TRIP(network, network_config, LDNR_NATIVE_NETWORK_CONFIG_SIZE);
+
+    filter.network_id.intent_id = network.intent_id;
+    fill_bytes(filter.network_id.session_id, sizeof(filter.network_id.session_id), 89);
+    filter.network_type = UINT32_C(0xf0e0d0c0);
+    fill_bytes(filter.bssid, sizeof(filter.bssid), 97);
+    filter.ssid.length = 8;
+    memcpy(filter.ssid.string, "ldn-test", 8);
+    filter.flags = UINT32_C(0x89abcdef);
+    CHECK_ROUND_TRIP(filter, scan_filter, LDNR_NATIVE_SCAN_FILTER_SIZE);
+
+    update.state_change = 0xa5;
+    CHECK_ROUND_TRIP(update, node_latest_update, LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE);
+}
+
+static void test_address_fixture(void)
+{
+    static const uint8_t fixture[LDNR_NATIVE_ADDRESS_ENTRY_SIZE] = {
+        0x78, 0x56, 0x34, 0x12,
+        0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
+        0x00, 0x00
+    };
+    ldnr_address_entry decoded = {0};
+    uint8_t encoded[LDNR_NATIVE_ADDRESS_ENTRY_SIZE];
+
+    assert(ldnr_native_address_entry_decode(&decoded, fixture, sizeof(fixture)) ==
+           LDNR_NATIVE_OK);
+    assert(decoded.ipv4_address == UINT32_C(0x12345678));
+    assert(memcmp(decoded.mac_address, fixture + 4, sizeof(decoded.mac_address)) == 0);
+    assert(ldnr_native_address_entry_encode(&decoded, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_OK);
+    assert(memcmp(encoded, fixture, sizeof(fixture)) == 0);
+}
+
+static void test_malformed_lengths_and_arguments(void)
+{
+    ldnr_network_info info = {0};
+    ldnr_network_config network = {0};
+    ldnr_security_config security = {0};
+    ldnr_scan_filter filter = {0};
+    ldnr_address_entry address = {0};
+    uint8_t network_bytes[LDNR_NATIVE_NETWORK_INFO_SIZE] = {0};
+    uint8_t small[LDNR_NATIVE_SCAN_FILTER_SIZE] = {0};
+
+    assert(ldnr_native_network_info_decode(&info, network_bytes,
+                                           sizeof(network_bytes) - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_network_info_encode(&info, network_bytes,
+                                           sizeof(network_bytes) + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_network_config_decode(&network, small,
+                                             LDNR_NATIVE_NETWORK_CONFIG_SIZE - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_security_config_encode(&security, small,
+                                              LDNR_NATIVE_SECURITY_CONFIG_SIZE + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_scan_filter_decode(&filter, small, sizeof(small) - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_address_entry_decode(&address, small,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_address_entry_decode(NULL, small,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE) ==
+           LDNR_NATIVE_ERROR_ARGUMENT);
+    assert(ldnr_native_address_entry_encode(&address, NULL,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE) ==
+           LDNR_NATIVE_ERROR_ARGUMENT);
+}
+
+static void test_validation(void)
+{
+    ldnr_ssid ssid = {0};
+    ldnr_network_info info = {0};
+    ldnr_network_config network = {0};
+    ldnr_security_config security = {0};
+    ldnr_scan_filter filter = {0};
+    uint8_t ssid_bytes[LDNR_NATIVE_SSID_SIZE] = {0};
+    uint8_t info_bytes[LDNR_NATIVE_NETWORK_INFO_SIZE] = {0};
+    uint8_t network_bytes[LDNR_NATIVE_NETWORK_CONFIG_SIZE] = {0};
+    uint8_t security_bytes[LDNR_NATIVE_SECURITY_CONFIG_SIZE] = {0};
+    uint8_t filter_bytes[LDNR_NATIVE_SCAN_FILTER_SIZE] = {0};
+    uint8_t encoded[LDNR_NATIVE_NETWORK_INFO_SIZE];
+
+    ssid.length = LDNR_NATIVE_SSID_MAX + 1;
+    ssid_bytes[0] = ssid.length;
+    assert(ldnr_native_ssid_encode(&ssid, ssid_bytes, sizeof(ssid_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    assert(ldnr_native_ssid_decode(&ssid, ssid_bytes, sizeof(ssid_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    info.node_count = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info.node_count = 0;
+    info.node_count_max = -1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info.node_count_max = 0;
+    info.advertise_data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX + 1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    info_bytes[0x2e] = LDNR_NATIVE_SSID_MAX + 1;
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info_bytes[0x2e] = 0;
+    info_bytes[0x6f] = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info_bytes[0x6f] = 0;
+    info_bytes[0x272] = 0x81;
+    info_bytes[0x273] = 0x01;
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    network.node_count_max = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_config_encode(&network, network_bytes,
+                                             sizeof(network_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    network_bytes[0x1a] = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_config_decode(&network, network_bytes,
+                                             sizeof(network_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    assert(ldnr_native_security_config_encode(&security, security_bytes,
+                                              sizeof(security_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    security_bytes[2] = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    assert(ldnr_native_security_config_decode(&security, security_bytes,
+                                              sizeof(security_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    filter.ssid.length = LDNR_NATIVE_SSID_MAX + 1;
+    assert(ldnr_native_scan_filter_encode(&filter, filter_bytes, sizeof(filter_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    filter_bytes[0x32] = LDNR_NATIVE_SSID_MAX + 1;
+    assert(ldnr_native_scan_filter_decode(&filter, filter_bytes, sizeof(filter_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+}
+
+int main(void)
+{
+    test_layouts();
+    test_identifier_and_node_round_trips();
+    test_network_info_round_trip();
+    test_config_round_trips();
+    test_address_fixture();
+    test_malformed_lengths_and_arguments();
+    test_validation();
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_protocol.c b/dm/host/ldnr/tests/t_protocol.c
