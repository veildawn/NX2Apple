+static void test_udp(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr name;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr source;
+    ldnr_message sent;
+    ldnr_pollfd pollfd;
+    uint64_t readfds[16];
+    char buffer[32];
+    int32_t option;
+    uint32_t option_size;
+    int fd;
+    int other;
+    int ephemeral;
+    int entered;
+    int exited;
+    ssize_t size;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    other = ldnr_socket(context, 2, 2, 17);
+    ephemeral = ldnr_socket(context, 2, 2, 0);
+    CHECK(fd >= 0 && other >= 0 && ephemeral >= 0);
+
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+    CHECK(ldnr_get_sock_name(context, fd, &name) == 0);
+    CHECK(name.address == address.address && name.port == address.port);
+    CHECK(ldnr_bind(context, other, &address) == -1);
+    CHECK(ldnr_last_errno() == TEST_EADDRINUSE);
+    address.address = ldnr_ipv4(192, 168, 44, 99);
+    CHECK(ldnr_bind(context, other, &address) == -1);
+    CHECK(ldnr_last_errno() == TEST_EADDRNOTAVAIL);
+    address.address = 0;
+    address.port = ldnr_htons(TEST_OTHER_UDP_PORT);
+    CHECK(ldnr_bind(context, other, &address) == 0);
+    CHECK(ldnr_get_peer_name(context, other, &peer) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOTCONN);
+
+    address.address = 0;
+    address.port = 0;
+    CHECK(ldnr_bind(context, ephemeral, &address) == 0);
+    CHECK(ldnr_get_sock_name(context, ephemeral, &name) == 0);
+    CHECK(name.address == ldnr_ipv4(192, 168, 44, 10));
+    CHECK(ldnr_htons(name.port) >= 49152 && ldnr_htons(name.port) <= 65535);
+
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(5000);
+    CHECK(ldnr_sendto(context, fd, "unicast", 7, 0, &peer) == 7);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.source_address == ldnr_ipv4(192, 168, 44, 10));
+    CHECK(sent.udp.source_port == ldnr_htons(TEST_UDP_PORT));
+    CHECK(sent.udp.destination_address == peer.address);
+    CHECK(sent.udp.destination_port == peer.port);
+    CHECK(sent.udp.size == 7 && memcmp(sent.udp.data, "unicast", 7) == 0);
+
+    option = 1;
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x20, &option, sizeof(option)) == 0);
+    option = 0;
+    option_size = sizeof(option);
+    CHECK(ldnr_getsockopt(context, fd, 0, 0x20, &option, &option_size) == 0);
+    CHECK(option_size == sizeof(option) && option == 1);
+    peer.address = UINT32_C(0xffffffff);
+    CHECK(ldnr_sendto(context, fd, "broadcast", 9, 0, &peer) == 9);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.destination_address == UINT32_C(0xffffffff));
+    CHECK(sent.udp.destination_port == ldnr_htons(5000));
+    CHECK(sent.udp.size == 9 && memcmp(sent.udp.data, "broadcast", 9) == 0);
+
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    CHECK(ldnr_connect_socket(context, other, &peer, 0) == 0);
+    CHECK(ldnr_get_peer_name(context, other, &peer) == 0);
+    CHECK(peer.address == ldnr_ipv4(192, 168, 44, 20));
+    CHECK(peer.port == ldnr_htons(5000));
+    CHECK(ldnr_send(context, other, "connected", 9, 0) == 9);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.destination_address == peer.address);
+    CHECK(sent.udp.destination_port == peer.port);
+    CHECK(sent.udp.source_port == ldnr_htons(TEST_OTHER_UDP_PORT));
+
+    CHECK(ldnr_inject_udp(context, peer.address, peer.port,
+                          ldnr_ipv4(192, 168, 44, 10), ldnr_htons(TEST_OTHER_UDP_PORT),
+                          "datagram", 8) == 0);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recvfrom(context, other, buffer, sizeof(buffer), 2, &source, 0);
+    CHECK(size == 8 && memcmp(buffer, "datagram", 8) == 0);
+    CHECK(source.address == peer.address && source.port == peer.port);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recvfrom(context, other, buffer, sizeof(buffer), 0, &source, 0);
+    CHECK(size == 8 && memcmp(buffer, "datagram", 8) == 0);
+
+    CHECK(ldnr_fcntl(context, fd, 3, 0) == 0);
+    CHECK(ldnr_fcntl(context, fd, 4, 4) == 0);
+    CHECK(ldnr_fcntl(context, fd, 3, 0) == 4);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(ldnr_fcntl(context, fd, 4, 0) == 0);
+    option = 10;
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x1006, &option, sizeof(option)) == 0);
+    entered = atomic_load(&waits.entered);
+    exited = atomic_load(&waits.exited);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) > entered);
+    CHECK(atomic_load(&waits.exited) > exited);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+
+    pollfd.fd = fd;
+    pollfd.events = LDNR_POLLIN | LDNR_POLLOUT;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLOUT);
+    memset(readfds, 0, sizeof(readfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    CHECK(ldnr_select(context, fd + 1, readfds, NULL, NULL, 0) == 0);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) == 0);
+
+    CHECK(ldnr_inject_udp(context, ldnr_ipv4(192, 168, 44, 30), ldnr_htons(6000),
+                          UINT32_C(0xffffffff), ldnr_htons(TEST_UDP_PORT),
+                          "b-in", 4) == 0);
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 1000) == 1);
+    CHECK((pollfd.revents & LDNR_POLLIN) != 0);
+    memset(readfds, 0, sizeof(readfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    CHECK(ldnr_select(context, fd + 1, readfds, NULL, NULL, 1000) == 1);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) != 0);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, &source, 0) == 4);
+    CHECK(memcmp(buffer, "b-in", 4) == 0);
+    CHECK(source.address == ldnr_ipv4(192, 168, 44, 30));
+
+    CHECK(ldnr_close_socket(context, ephemeral) == 0);
+    CHECK(ldnr_close_socket(context, other) == 0);
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
