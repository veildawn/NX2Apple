+#define _POSIX_C_SOURCE 200809L
+
+#include "../ldnr.h"
+#include "../ldnr_protocol.h"
+#include "../ldnr_transport.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define TEST_FRAME_CAPACITY 65536u
+#define TEST_QUEUE_DEPTH 32u
+
+#define CHECK(expression)                                                           \
+    do {                                                                            \
+        if (!(expression)) {                                                        \
+            fprintf(stderr, "CHECK failed at %s:%d: %s\n", __FILE__, __LINE__,    \
+                    #expression);                                                   \
+            abort();                                                                \
+        }                                                                           \
+    } while (0)
+
+enum {
+    TEST_STATE_NONE = 0,
+    TEST_STATE_INITIALIZED = 1,
+    TEST_STATE_AP_OPEN = 2,
+    TEST_STATE_STATION_OPEN = 3,
+    TEST_STATE_AP_CREATED = 4,
+    TEST_STATE_STATION_CONNECTED = 5,
+};
+
+enum {
+    TEST_EINVAL = 22,
+    TEST_EISCONN = 56,
+    TEST_ENOTCONN = 57,
+    TEST_ENETDOWN = 50,
+    TEST_ECONNREFUSED = 61,
+};
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_frame;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    test_frame queue[TEST_QUEUE_DEPTH];
+    size_t head;
+    size_t count;
+    int connected;
+    int connect_count;
+    int fail_connect;
+    int auth_error;
+    uint32_t create_status;
+    uint32_t connect_status;
+} test_transport;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    int changes;
+} test_changes;
+
+static ldnr_network_info test_network_info(void)
+{
+    ldnr_network_info info;
+    memset(&info, 0, sizeof(info));
+    info.network_id.intent_id.local_communication_id = INT64_C(0x102030405);
+    info.network_id.intent_id.scene_id = 7;
+    info.network_id.session_id[0] = 0x42;
+    info.network_id.session_id[15] = 0x24;
+    info.common.ssid.length = 8;
+    memcpy(info.common.ssid.string, "ldnr-tst", 8);
+    info.common.channel = 11;
+    info.common.network_type = 1;
+    info.server_random[0] = 0xa5;
+    info.server_random[15] = 0x5a;
+    info.node_count_max = 8;
+    info.node_count = 1;
+    info.nodes[0].ipv4_address = ldnr_ipv4(192, 168, 44, 10);
+    info.nodes[0].is_connected = 1;
+    return info;
+}
+
+static void test_enqueue_locked(test_transport *transport, const uint8_t *bytes,
+                                size_t size)
+{
+    size_t index;
+    CHECK(size <= TEST_FRAME_CAPACITY);
+    CHECK(transport->count < TEST_QUEUE_DEPTH);
+    index = (transport->head + transport->count) % TEST_QUEUE_DEPTH;
+    memcpy(transport->queue[index].bytes, bytes, size);
+    transport->queue[index].size = size;
+    transport->count++;
+    pthread_cond_broadcast(&transport->condition);
+}
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_writer;
+
+static void test_put(test_writer *writer, const void *data, size_t size)
+{
+    CHECK(size <= sizeof(writer->bytes) - writer->size);
+    if (size)
+        memcpy(writer->bytes + writer->size, data, size);
+    writer->size += size;
+}
+
+static void test_u8(test_writer *writer, uint8_t value)
+{
+    test_put(writer, &value, 1);
+}
+
+static void test_u16(test_writer *writer, uint16_t value)
+{
+    uint8_t bytes[2] = {(uint8_t)value, (uint8_t)(value >> 8)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u32(test_writer *writer, uint32_t value)
+{
+    uint8_t bytes[4] = {(uint8_t)value, (uint8_t)(value >> 8),
+                        (uint8_t)(value >> 16), (uint8_t)(value >> 24)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u64(test_writer *writer, uint64_t value)
+{
+    test_u32(writer, (uint32_t)value);
+    test_u32(writer, (uint32_t)(value >> 32));
+}
+
+static size_t test_record_start(test_writer *writer)
+{
+    size_t start = writer->size;
+    test_u16(writer, 0);
+    return start;
+}
+
+static void test_record_end(test_writer *writer, size_t start)
+{
+    size_t size = writer->size - start - 2;
+    CHECK(size <= 0xffff);
+    writer->bytes[start] = (uint8_t)size;
+    writer->bytes[start + 1] = (uint8_t)(size >> 8);
+}
+
+static void test_put_network(test_writer *writer, const ldnr_network_info *info)
+{
+    size_t network = test_record_start(writer);
+    unsigned i;
+    test_u64(writer, UINT64_C(0x1122334455667788));
+    test_u64(writer, (uint64_t)info->network_id.intent_id.local_communication_id);
+    test_u16(writer, info->network_id.intent_id.scene_id);
+    test_put(writer, info->network_id.session_id, 16);
+    test_put(writer, info->server_random, 16);
+    test_put(writer, info->common.bssid, 6);
+    test_u8(writer, info->common.ssid.length);
+    test_put(writer, info->common.ssid.string, info->common.ssid.length);
+    test_u16(writer, (uint16_t)info->common.channel);
+    test_u8(writer, (uint8_t)info->common.link_level);
+    test_u8(writer, info->common.network_type);
+    test_u16(writer, info->security_mode);
+    test_u8(writer, info->station_accept_policy);
+    test_u8(writer, (uint8_t)info->node_count_max);
+    test_u8(writer, info->node_count);
+    for (i = 0; i < 8; i++) {
+        size_t node = test_record_start(writer);
+        test_u32(writer, info->nodes[i].ipv4_address);
+        test_put(writer, info->nodes[i].mac_address, 6);
+        test_u8(writer, (uint8_t)info->nodes[i].node_id);
+        test_u8(writer, info->nodes[i].is_connected);
+        test_put(writer, info->nodes[i].user_name, 33);
+        test_u16(writer, (uint16_t)info->nodes[i].local_communication_version);
+        test_u8(writer, info->nodes[i].platform);
+        test_record_end(writer, node);
+    }
+    test_u16(writer, info->advertise_data_size);
+    test_put(writer, info->advertise_data, info->advertise_data_size);
+    test_record_end(writer, network);
+}
+
+static void test_finish(test_writer *writer, uint8_t type, uint32_t request_id)
+{
+    size_t payload = writer->size - 16;
+    memset(writer->bytes, 0, 16);
+    memcpy(writer->bytes, "LDNR", 4);
+    writer->bytes[4] = 1;
+    writer->bytes[5] = type;
+    writer->bytes[8] = (uint8_t)payload;
+    writer->bytes[9] = (uint8_t)(payload >> 8);
+    writer->bytes[10] = (uint8_t)(payload >> 16);
+    writer->bytes[11] = (uint8_t)(payload >> 24);
+    writer->bytes[12] = (uint8_t)request_id;
+    writer->bytes[13] = (uint8_t)(request_id >> 8);
+    writer->bytes[14] = (uint8_t)(request_id >> 16);
+    writer->bytes[15] = (uint8_t)(request_id >> 24);
+}
+
+static void test_error_reply_locked(test_transport *transport, uint32_t request_id,
+                                    uint16_t code)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_u16(&writer, code);
+    test_u16(&writer, 0);
+    test_finish(&writer, 0x05, request_id);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+}
+
+static void test_reply_locked(test_transport *transport, uint8_t type,
+                              uint32_t request_id)
+{
+    test_writer writer;
+    ldnr_network_info info;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+
+    switch (type) {
+    case 0x01:
+        if (transport->auth_error) {
+            test_error_reply_locked(transport, request_id, 1);
+            return;
+        }
+        test_u8(&writer, 1);
+        test_u8(&writer, 1);
+        test_u8(&writer, 0);
+        test_u8(&writer, 0);
+        test_u32(&writer, UINT32_C(0x1f));
+        test_u64(&writer, 0);
+        test_u64(&writer, 0);
+        test_u16(&writer, 0);
+        test_u32(&writer, 0);
+        test_u32(&writer, 0);
+        test_finish(&writer, 0x02, request_id);
+        break;
+    case 0x10:
+        if (transport->create_status) {
+            test_error_reply_locked(transport, request_id, 5);
+            return;
+        }
+        info = test_network_info();
+        test_put_network(&writer, &info);
+        test_finish(&writer, 0x11, request_id);
+        break;
+    case 0x15:
+        if (transport->connect_status) {
+            test_error_reply_locked(transport, request_id, 5);
+            return;
+        }
+        info = test_network_info();
+        test_u8(&writer, 0);
+        test_u32(&writer, ldnr_ipv4(192, 168, 44, 10));
+        static const uint8_t mac[6] = {0};
+        test_put(&writer, mac, sizeof(mac));
+        test_put_network(&writer, &info);
+        test_finish(&writer, 0x16, request_id);
+        break;
+    case 0x12:
+        test_finish(&writer, 0x12, request_id);
+        break;
+    case 0x17:
+        test_finish(&writer, 0x17, request_id);
+        break;
+    default:
+        test_error_reply_locked(transport, request_id, 1);
+        return;
+    }
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+}
+
+static int test_connect(void *ctx, const char *server, char *error, size_t error_size)
+{
+    test_transport *transport = ctx;
+    (void)server;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connect_count++;
+    if (transport->fail_connect) {
+        if (error_size)
+            snprintf(error, error_size, "intentional test connect failure");
+        pthread_mutex_unlock(&transport->mutex);
+        return -1;
+    }
+    transport->connected = 1;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+static ssize_t test_recv(void *ctx, void *frame, size_t capacity)
+{
+    test_transport *transport = ctx;
+    size_t size;
+
+    pthread_mutex_lock(&transport->mutex);
+    while (transport->connected && transport->count == 0)
+        pthread_cond_wait(&transport->condition, &transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    CHECK(transport->count != 0);
+    size = transport->queue[transport->head].size;
+    CHECK(size <= capacity);
+    memcpy(frame, transport->queue[transport->head].bytes, size);
+    transport->head = (transport->head + 1) % TEST_QUEUE_DEPTH;
+    transport->count--;
+    pthread_mutex_unlock(&transport->mutex);
+    return (ssize_t)size;
+}
+
+static int test_send(void *ctx, const void *frame, size_t size)
+{
+    test_transport *transport = ctx;
+    const uint8_t *bytes = frame;
+    uint32_t request_id;
+
+    pthread_mutex_lock(&transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return -1;
+    }
+    CHECK(size >= 16 && memcmp(bytes, "LDNR", 4) == 0 && bytes[4] == 1);
+    request_id = (uint32_t)bytes[12] | (uint32_t)bytes[13] << 8 |
+                 (uint32_t)bytes[14] << 16 | (uint32_t)bytes[15] << 24;
+    test_reply_locked(transport, bytes[5], request_id);
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+static void test_close(void *ctx)
+{
+    test_transport *transport = ctx;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connected = 0;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_transport_destroy(void *ctx)
+{
+    test_transport *transport = ctx;
+    pthread_mutex_destroy(&transport->mutex);
+    pthread_cond_destroy(&transport->condition);
+    free(transport);
+}
+
+static const ldnr_transport *test_transport_create(test_transport **out)
+{
+    test_transport *transport = calloc(1, sizeof(*transport));
+    ldnr_transport *api = calloc(1, sizeof(*api));
+    CHECK(transport != NULL && api != NULL);
+    pthread_mutex_init(&transport->mutex, NULL);
+    pthread_cond_init(&transport->condition, NULL);
+    api->ctx = transport;
+    api->connect = test_connect;
+    api->recv = test_recv;
+    api->send = test_send;
+    api->close = test_close;
+    api->destroy = test_transport_destroy;
+    *out = transport;
+    return api;
+}
+
+static void test_push_disconnect(test_transport *transport, uint32_t reason)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_u64(&writer, 0);
+    test_u64(&writer, 0);
+    test_u32(&writer, reason);
+    test_finish(&writer, 0x21, 0);
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_state_changed(void *ctx)
+{
+    test_changes *changes = ctx;
+    pthread_mutex_lock(&changes->mutex);
+    changes->changes++;
+    pthread_cond_broadcast(&changes->condition);
+    pthread_mutex_unlock(&changes->mutex);
+}
+
+static int test_change_count(test_changes *changes)
+{
+    int count;
+    pthread_mutex_lock(&changes->mutex);
+    count = changes->changes;
+    pthread_mutex_unlock(&changes->mutex);
+    return count;
+}
+
+static void test_wait_for_changes(test_changes *changes, int expected)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&changes->mutex);
+    while (changes->changes < expected) {
+        int result = pthread_cond_timedwait(&changes->condition, &changes->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+        CHECK(result == 0);
+    }
+    CHECK(changes->changes == expected);
+    pthread_mutex_unlock(&changes->mutex);
+}
+
+static void test_create_arguments(void)
+{
+    ldnr_config config;
+    ldnr *context = NULL;
+    memset(&config, 0, sizeof(config));
+    CHECK(ldnr_create(NULL, &context) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(context == NULL);
+    CHECK(ldnr_create(&config, NULL) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_initialize(NULL) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_get_state(NULL) == TEST_STATE_NONE);
+}
+
+static void test_lifecycle_and_replies(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_changes changes;
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info = test_network_info();
+    ldnr_network_info actual_info;
+    ldnr_network_config actual_network;
+    ldnr_security_parameter parameter;
+    uint32_t address = 0;
+    uint32_t mask = 0;
+    ldnr *context = NULL;
+    int expected_changes = 0;
+
+    memset(&changes, 0, sizeof(changes));
+    pthread_mutex_init(&changes.mutex, NULL);
+    pthread_cond_init(&changes.condition, NULL);
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.callback_ctx = &changes;
+    config.state_changed = test_state_changed;
+    config.connect_timeout_ms = 200;
+    config.player_name = "state-test";
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(context != NULL);
+    CHECK(ldnr_get_state(context) == TEST_STATE_NONE);
+    CHECK(ldnr_get_disconnect_reason(context) == 0);
+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_open_station(context) == -1);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOTCONN);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_INITIALIZED);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_initialize(context) == -1);
+    CHECK(ldnr_last_errno() == TEST_EISCONN);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    transport->fail_connect = 1;
+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_get_state(context) == TEST_STATE_INITIALIZED);
+    CHECK(strstr(ldnr_last_error(context), "intentional") != NULL);
+    CHECK(test_change_count(&changes) == expected_changes);
+    transport->fail_connect = 0;
+
+    transport->auth_error = 1;
+    CHECK(ldnr_open_station(context) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_get_state(context) == TEST_STATE_INITIALIZED);
+    CHECK(test_change_count(&changes) == expected_changes);
+    transport->auth_error = 0;
+
+    memset(&network, 0, sizeof(network));
+    network.intent_id.local_communication_id = INT64_C(0x102030405);
+    network.intent_id.scene_id = 7;
+    network.channel = 11;
+    network.node_count_max = 8;
+    network.local_communication_version = 1;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memcpy(user.user_name, "guest", 5);
+
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_open_access_point(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(transport->connect_count == 3);
+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_open_station(context) == -1);
+    CHECK(ldnr_close_station(context) == -1);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    transport->create_status = TEST_ECONNREFUSED;
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+    CHECK(test_change_count(&changes) == expected_changes);
+    transport->create_status = 0;
+
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_CREATED);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_get_network_info(context, &actual_info) == 0);
+    CHECK(actual_info.network_id.intent_id.local_communication_id ==
+          info.network_id.intent_id.local_communication_id);
+    CHECK(memcmp(actual_info.network_id.session_id, info.network_id.session_id, 16) == 0);
+    CHECK(ldnr_get_network_config(context, &actual_network) == 0);
+    CHECK(actual_network.channel == network.channel);
+    CHECK(actual_network.node_count_max == network.node_count_max);
+    CHECK(ldnr_get_ipv4_address(context, &address, &mask) == 0);
+    CHECK(address == ldnr_ipv4(192, 168, 44, 10));
+    CHECK(mask == ldnr_ipv4(255, 255, 0, 0));
+    CHECK(ldnr_get_security_parameter(context, &parameter) == 0);
+    CHECK(memcmp(parameter.server_random, info.server_random, 16) == 0);
+    CHECK(memcmp(parameter.session_id, info.network_id.session_id, 16) == 0);
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_open_station(context) == -1);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    CHECK(ldnr_disconnect(context) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_destroy_network(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+    CHECK(ldnr_close_access_point(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_INITIALIZED);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_close_access_point(context) == -1);
+    CHECK(ldnr_destroy_network(context) == -1);
+
+    CHECK(ldnr_open_station(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    transport->connect_status = TEST_ECONNREFUSED;
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(test_change_count(&changes) == expected_changes);
+    transport->connect_status = 0;
+
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_CONNECTED);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_get_disconnect_reason(context) == 0);
+    CHECK(ldnr_destroy_network(context) == -1);
+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_disconnect(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_disconnect(context) == -1);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0) == 0);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    test_push_disconnect(transport, 47);
+    test_wait_for_changes(&changes, expected_changes + 1);
+    expected_changes++;
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(ldnr_get_disconnect_reason(context) == 47);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+    CHECK(ldnr_get_security_parameter(context, &parameter) == -1);
+    test_push_disconnect(transport, 99);
+    CHECK(ldnr_close_station(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_INITIALIZED);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_get_disconnect_reason(context) == 47);
+
+    ldnr_finalize(context);
+    CHECK(ldnr_get_state(context) == TEST_STATE_NONE);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    ldnr_finalize(context);
+    CHECK(test_change_count(&changes) == expected_changes);
+    ldnr_destroy(context);
+    CHECK(test_change_count(&changes) == expected_changes);
+
+    pthread_mutex_destroy(&changes.mutex);
+    pthread_cond_destroy(&changes.condition);
+    free((void *)api);
+}
+
+int main(void)
+{
+    test_create_arguments();
+    test_lifecycle_and_replies();
+    puts("PASS");
+    return 0;
+}
