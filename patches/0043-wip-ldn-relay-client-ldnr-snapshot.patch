+static void test_create_network(void)
+{
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_address_entry address;
+    ldnr_operation operation;
+    ldnr_message message;
+    static const uint8_t advertise[] = {'x', 'y', 'z'};
+    uint8_t output[sizeof(create_network_frame) + 2];
+    size_t size = 0;
+    size_t i;
+
+    memset(&config, 0, sizeof(config));
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memset(&address, 0, sizeof(address));
+    memset(&operation, 0, sizeof(operation));
+    memset(&message, 0, sizeof(message));
+
+    config.intent_id.local_communication_id = INT64_C(0x0102030405060708);
+    config.intent_id.scene_id = 0x090a;
+    config.channel = 11;
+    config.node_count_max = 4;
+    config.local_communication_version = 0x0c0d;
+    security.security_mode = 1;
+    security.passphrase_size = 16;
+    for (i = 0; i < 16; ++i)
+        security.passphrase[i] = (uint8_t)(0x10 + i);
+    memcpy(user.user_name, "host", 4);
+    address.ipv4_address = UINT32_C(0x0100720a);
+    memcpy(address.mac_address, "\x02\x00\x11\x22\x33\x44", 6);
+
+    operation.network_config = &config;
+    operation.security_config = &security;
+    operation.user_config = &user;
+    operation.addresses = &address;
+    operation.address_count = 1;
+    operation.data = advertise;
+    operation.data_size = sizeof(advertise);
+
+    encode_ok(create_network_frame, sizeof(create_network_frame),
+              LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0, &message, &operation);
+
+    memset(output, 0xa5, sizeof(output));
+    CHECK(ldnr_protocol_encode(output, sizeof(create_network_frame) - 1, &size,
+                               LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0,
+                               &message, &operation) != 0);
+    CHECK(output[sizeof(create_network_frame) - 1] == 0xa5);
+    CHECK(output[sizeof(create_network_frame)] == 0xa5);
+}
