+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memcpy(out, value->server_random, sizeof(value->server_random));
+    memcpy(out + 0x10, value->session_id, sizeof(value->session_id));
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_security_parameter_decode(
+    ldnr_security_parameter *value, const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_SECURITY_PARAMETER_SIZE);
+    ldnr_security_parameter decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memcpy(decoded.server_random, in, sizeof(decoded.server_random));
+    memcpy(decoded.session_id, in + 0x10, sizeof(decoded.session_id));
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_network_config_encode(
+    const ldnr_network_config *value, uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_NETWORK_CONFIG_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    status = validate_node_count_max(value->node_count_max);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_NETWORK_CONFIG_SIZE);
+    encode_intent_id(&value->intent_id, out);
+    put_u16(out + 0x18, (uint16_t)value->channel);
+    out[0x1a] = (uint8_t)value->node_count_max;
+    put_u16(out + 0x1c, (uint16_t)value->local_communication_version);
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_network_config_decode(
+    ldnr_network_config *value, const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_NETWORK_CONFIG_SIZE);
+    ldnr_network_config decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_intent_id(&decoded.intent_id, in);
+    decoded.channel = get_i16(in + 0x18);
+    decoded.node_count_max = get_i8(in + 0x1a);
+    status = validate_node_count_max(decoded.node_count_max);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.local_communication_version = get_i16(in + 0x1c);
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_scan_filter_encode(const ldnr_scan_filter *value,
+                                                  uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_SCAN_FILTER_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
