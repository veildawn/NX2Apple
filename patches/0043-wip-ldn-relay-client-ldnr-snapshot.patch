+    encode_network_id(&value->network_id, out);
+    put_u32(out + 0x28, value->network_type);
+    memcpy(out + 0x2c, value->bssid, sizeof(value->bssid));
+    encode_ssid(&value->ssid, out + 0x32);
+    put_u32(out + 0x64, value->flags);
