+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0200720a);
+    message.status = 0;
+    encode_ok(tcp_connect_reply_frame, sizeof(tcp_connect_reply_frame),
+              LDNR_MSG_PROXY_CONNECT_ACK, UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_connect_reply_frame, sizeof(tcp_connect_reply_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_CONNECT_ACK);
+    CHECK(message.proxy.connection_id == UINT64_C(0x11223344));
+    CHECK(message.proxy.source_address == UINT32_C(0x0200720a));
+    CHECK(message.status == 0);
+    ldnr_protocol_message_free(&message);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0100720a);
+    message.proxy.source_port = 40000;
+    message.proxy.destination_address = UINT32_C(0x0200720a);
+    message.proxy.destination_port = 40001;
+    message.proxy.size = 3;
+    message.proxy.data[0] = 1;
+    message.proxy.data[1] = 2;
+    message.proxy.data[2] = 3;
+    encode_ok(tcp_data_frame, sizeof(tcp_data_frame), LDNR_MSG_PROXY_DATA,
+              UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_data_frame, sizeof(tcp_data_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_DATA);
+    check_tcp_tuple(&message);
+    CHECK(message.proxy.size == 3);
+    CHECK(message.proxy.data[0] == 1 && message.proxy.data[1] == 2 &&
+          message.proxy.data[2] == 3);
+    ldnr_protocol_message_free(&message);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0100720a);
+    message.status = 1;
+    message.reason = 2;
+    encode_ok(tcp_disconnect_frame, sizeof(tcp_disconnect_frame),
+              LDNR_MSG_PROXY_DISCONNECT, UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_disconnect_frame, sizeof(tcp_disconnect_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(message.proxy.connection_id == UINT64_C(0x11223344));
+    CHECK(message.proxy.source_address == UINT32_C(0x0100720a));
+    CHECK(message.status != 0);
+    CHECK(message.reason == 2);
+    ldnr_protocol_message_free(&message);
+}
+
+static void test_record_trailing_extensions(void)
+{
+    uint8_t extended[sizeof(scan_result_frame) + 2];
+    ldnr_message message;
+
+    /* Extra bytes at the end of a Ping payload are left for a newer minor. */
+    memcpy(extended, ping_frame, sizeof(ping_frame));
+    extended[sizeof(ping_frame)] = 0xa5;
+    put32(extended + 8, 9);
+    decode_ok(extended, sizeof(ping_frame) + 1, &message);
+    CHECK(message.request_id == UINT64_C(0x11121314));
+    CHECK(message.timestamp == UINT64_C(0x0102030405060708));
+    ldnr_protocol_message_free(&message);
+
+    /* ConnectAck ends in NetworkInfo, so growing that record appends an
+     * extension without changing any outer record. */
+    memcpy(extended, connect_ack_frame, sizeof(connect_ack_frame));
+    extended[sizeof(connect_ack_frame)] = 0xde;
+    extended[sizeof(connect_ack_frame) + 1] = 0xad;
+    put16(extended + 27, 475);
+    put32(extended + 8, 488);
+    decode_ok(extended, sizeof(connect_ack_frame) + 2, &message);
+    CHECK(message.network_id == UINT64_C(0x1122334455667788));
+    check_network_info(&message.network_info);
+    ldnr_protocol_message_free(&message);
+
+    /* ScanEntry is independently length-delimited. */
+    memcpy(extended, scan_result_frame, sizeof(scan_result_frame));
+    extended[sizeof(scan_result_frame)] = 0xbe;
+    extended[sizeof(scan_result_frame) + 1] = 0xef;
+    put16(extended + 21, 483);
+    put32(extended + 8, 490);
+    decode_ok(extended, sizeof(scan_result_frame) + 2, &message);
+    CHECK(message.network_count == 1);
+    check_network_info(&message.networks[0].info);
+    ldnr_protocol_message_free(&message);
+
+    /* Extend node zero inside both enclosing records. Offsets are from the
+     * fixed fixture above: frame 16, scan prefix 5, entry prefix 2, network
+     * prefix 2, and 69 NetworkInfo body bytes before the node records. */
+    memcpy(extended, scan_result_frame, 144);
+    extended[144] = 0x11;
+    extended[145] = 0x22;
+    memcpy(extended + 146, scan_result_frame + 144, sizeof(scan_result_frame) - 144);
+    put16(extended + 94, 50);
+    put16(extended + 23, 475);
+    put16(extended + 21, 483);
+    put32(extended + 8, 490);
+    decode_ok(extended, sizeof(scan_result_frame) + 2, &message);
+    CHECK(message.network_count == 1);
+    check_network_info(&message.networks[0].info);
+    ldnr_protocol_message_free(&message);
+}
+
+static void test_bad_frames_and_truncation(void)
+{
+    uint8_t bad[sizeof(scan_result_frame)];
+    uint8_t header[16] = {
+        'L', 'D', 'N', 'R', 0x01, 0x03, 0x00, 0x00,
+        0x08, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00
+    };
+    uint8_t *oversize;
+    size_t i;
+
+    decode_bad(NULL, 0);
+    decode_bad(ping_frame, 1);
+    decode_bad(ping_frame, 15);
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[0] = 'X';
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[4] = 2;
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[5] = 0x7f;
+    decode_bad(bad, sizeof(ping_frame));
+
+    decode_bad(ping_frame, sizeof(ping_frame) - 1);
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    put32(bad + 8, 7);
+    decode_bad(bad, sizeof(ping_frame));
+    decode_bad(bad, sizeof(ping_frame) - 1);
+    put32(bad + 8, 9);
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, header, sizeof(header));
+    put32(bad + 8, 0);
+    decode_bad(bad, sizeof(bad) < sizeof(header) ? sizeof(bad) : sizeof(header));
+
+    /* The decoder accepts exactly one frame, not bytes outside its length. */
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[sizeof(ping_frame)] = 0;
+    decode_bad(bad, sizeof(ping_frame) + 1);
+
+    oversize = malloc(16 + 65537);
+    CHECK(oversize != NULL);
+    memset(oversize, 0, 16 + 65537);
+    memcpy(oversize, header, sizeof(header));
+    put32(oversize + 8, 65537);
+    decode_bad(oversize, 16 + 65537);
+    free(oversize);
+
+    /* Adjust the outer length as well, so these exercise payload truncation,
+     * not only the frame-length consistency check. */
+    for (i = 0; i < sizeof(scan_result_frame); ++i) {
+        memcpy(bad, scan_result_frame, i);
+        if (i >= 16)
+            put32(bad + 8, (uint32_t)(i - 16));
+        decode_bad(bad, i);
+    }
+    for (i = 0; i < sizeof(connect_ack_frame); ++i) {
+        memcpy(bad, connect_ack_frame, i);
+        if (i >= 16)
+            put32(bad + 8, (uint32_t)(i - 16));
+        decode_bad(bad, i);
+    }
+}
+
+static void test_invalid_lengths(void)
+{
+    uint8_t bad[sizeof(scan_result_frame)];
+    uint8_t blob[16 + 17 + 2 + 1501];
+    ldnr_message message;
+    ldnr_operation operation;
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_address_entry address;
+    uint8_t output[2048];
+    size_t size;
+    char long_name[1025 + 1];
+
+    /* PROXY_DATA's u16 blob length exceeds the remaining payload. */
+    memcpy(bad, udp_data_frame, sizeof(udp_data_frame));
+    put16(bad + 33, 4);
+    decode_bad(bad, sizeof(udp_data_frame));
+
+    /* The native UDP destination is bounded even though ProxyData itself has
+     * a much larger protocol-wide limit. */
+    memset(blob, 0, sizeof(blob));
+    memcpy(blob, udp_data_frame, 35);
+    put32(blob + 8, (uint32_t)(sizeof(blob) - 16));
+    put16(blob + 33, 1501);
+    decode_bad(blob, sizeof(blob));
+
+    /* SCAN_RESULT count cannot exceed the entries actually present. */
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 16, 2);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    /* Outer entry, NetworkInfo, and node record lengths are all checked. */
+    put16(bad + 21, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 23, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 23, 474);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 94, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    /* SSID, native node count, advertise length, and generic string limits. */
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    bad[25 + 56] = 33;
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    bad[25 + 68] = 9;
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 494, 385);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 500, 1025);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    memset(&message, 0, sizeof(message));
+    message.udp.size = LDNR_UDP_MTU + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_UDP, 1, 0,
+                               &message, NULL) != 0);
+    memset(&message, 0, sizeof(message));
+    message.proxy.size = LDNR_TCP_CHUNK + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_PROXY_DATA,
+                               1, 0, &message, NULL) != 0);
+
+    memset(long_name, 'a', sizeof(long_name));
+    long_name[sizeof(long_name) - 1] = '\0';
+    CHECK(ldnr_protocol_encode_auth(output, sizeof(output), &size, "", long_name) != 0);
+
+    memset(&operation, 0, sizeof(operation));
+    memset(&config, 0, sizeof(config));
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memset(&address, 0, sizeof(address));
+    config.node_count_max = 1;
+    operation.network_config = &config;
+    operation.security_config = &security;
+    operation.user_config = &user;
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_CREATE_ACK,
+                               1, 0, &message, &operation) != 0);
+    security.passphrase_size = 0;
+    operation.data = output;
+    operation.data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_CREATE_ACK,
+                               1, 0, &message, &operation) != 0);
+}
+
+int main(void)
+{
+    _Static_assert(sizeof(hello_frame) == 41, "HELLO fixture size");
+    _Static_assert(sizeof(create_network_frame) == 148, "CREATE_NETWORK fixture size");
+    _Static_assert(sizeof(scan_result_frame) == 504, "SCAN_RESULT fixture size");
+    _Static_assert(sizeof(connect_ack_frame) == 502, "CONNECT_ACK fixture size");
+
+    test_auth_ping_and_pong();
+    test_create_network();
+    test_control_requests_and_empty_acks();
+    test_scan_result_and_message_free();
+    test_connect_ack();
+    test_udp_proxy_data();
+    test_tcp_proxy_messages();
+    test_record_trailing_extensions();
+    test_bad_frames_and_truncation();
+    test_invalid_lengths();
+
+    puts("PASS");
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_state.c b/dm/host/ldnr/tests/t_state.c
