+    ldnr_scan_filter decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_network_id(&decoded.network_id, in);
+    decoded.network_type = get_u32(in + 0x28);
+    memcpy(decoded.bssid, in + 0x2c, sizeof(decoded.bssid));
+    status = decode_ssid(&decoded.ssid, in + 0x32);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.flags = get_u32(in + 0x64);
