+static void test_control_requests_and_empty_acks(void)
+{
+    ldnr_operation operation;
+    ldnr_message message;
+    static const uint8_t advertise[] = {0xaa, 0xbb, 0xcc};
+    size_t i;
+    static const struct {
+        const uint8_t *frame;
+        size_t size;
+        ldnr_message_type type;
+    } acks[] = {
+        {advertise_ack_frame, sizeof(advertise_ack_frame), LDNR_MSG_ADVERTISE_ACK},
+        {policy_ack_frame, sizeof(policy_ack_frame), LDNR_MSG_POLICY_ACK},
+        {reject_ack_frame, sizeof(reject_ack_frame), LDNR_MSG_REJECT_ACK},
+        {filter_ack_frame, sizeof(filter_ack_frame), LDNR_MSG_FILTER_ACK},
+        {clear_filter_ack_frame, sizeof(clear_filter_ack_frame), LDNR_MSG_FILTER_ACK}
+    };
+
+    memset(&operation, 0, sizeof(operation));
+    memset(&message, 0, sizeof(message));
+    operation.data = advertise;
+    operation.data_size = sizeof(advertise);
+    encode_ok(advertise_frame, sizeof(advertise_frame), LDNR_MSG_ADVERTISE_ACK,
+              UINT64_C(0x10203040), UINT64_C(0x1122334455667788), &message, &operation);
+
+    operation.data = NULL;
+    operation.data_size = 0;
+    operation.option = 3;
+    encode_ok(policy_frame, sizeof(policy_frame), LDNR_MSG_POLICY_ACK,
+              UINT64_C(0x10203040), UINT64_C(0x1122334455667788), &message, &operation);
+
+    memcpy(operation.mac, "\x02\x4c\x44\x4e\x00\x07", 6);
+    encode_ok(accept_filter_frame, sizeof(accept_filter_frame), LDNR_MSG_FILTER_ACK,
+              UINT64_C(0x10203040), UINT64_C(0x1122334455667788), &message, &operation);
+
+    /* The public enum names replies, but encoding one emits its request.
+     * Their successful replies are asymmetric: an empty payload, not an echo. */
+    for (i = 0; i < ARRAY_SIZE(acks); ++i) {
+        decode_ok(acks[i].frame, acks[i].size, &message);
+        CHECK(message.type == acks[i].type);
+        CHECK(message.request_id == UINT64_C(0x12345678));
+        ldnr_protocol_message_free(&message);
+    }
+}
