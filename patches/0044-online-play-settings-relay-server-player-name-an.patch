+    // MARK: the launch environment
+
+    /// 6. A launcher shown again in the same process (Play pressed before the game data exists) must not take the DM_LDNR* values its own apply()
+    /// wrote for an env file's. standard() reads a snapshot taken once, before any apply().
+    static func launchEnvironment() {
+        for key in ["DM_LDNR", "DM_LDNR_SERVER", "DM_LDNR_NAME", "DM_LDNR_ROOM_PASSWORD", "DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"] {
+            unsetenv(key)
+        }
+        let snapshot = OnlinePlayModel.launchEnvironmentSnapshot   // taken now: nothing called standard() before this point
+        setenv("DM_LDNR", "1", 1)
+        setenv("DM_LDNR_SERVER", "probe.example.com:9", 1)
+        defer { unsetenv("DM_LDNR"); unsetenv("DM_LDNR_SERVER") }
+        let standard = OnlinePlayModel.standard(defaultName: "iPhone")
+        check(standard.fixedValue("DM_LDNR") == nil && standard.fixedValue("DM_LDNR_SERVER") == nil,
+              "a model from standard() does not take the launcher's own DM_LDNR for env.txt's")
+        check(OnlinePlayModel.launchEnvironmentSnapshot == snapshot, "the launch environment is read once")
+    }
