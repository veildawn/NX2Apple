+    static func applyToProcess() {
+        let m = model()
+        m.enabled = true
+        _ = m.addServer(name: "", address: "relay.example.com:9")
+        m.playerName = "Ana"
+        m.password = "topsecret"
+        m.plaintextConsent = true
+        for key in ["DM_LDNR", "DM_LDNR_SERVER", "DM_LDNR_NAME", "DM_LDNR_ROOM_PASSWORD", "DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"] {
+            unsetenv(key)
+        }
+        m.apply()
+        check(getenvString("DM_LDNR") == "1" && getenvString("DM_LDNR_SERVER") == "relay.example.com:9", "apply sets DM_LDNR and the server")
+        check(getenvString("DM_LDNR_NAME") == "Ana" && getenvString("DM_LDNR_ROOM_PASSWORD") == "topsecret", "apply sets the name and password")
+        check(getenvString("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD") == "1", "apply sets the plaintext consent")
+        // 1. without the consent apply writes nothing, and says why
+        m.plaintextConsent = false
+        m.apply()
+        check(getenvString("DM_LDNR") == nil && getenvString("DM_LDNR_ROOM_PASSWORD") == nil,
+              "apply unsets every variable when the password waits for consent")
+        check(stderrLog { m.apply() }.contains("launcher: online play waits for the password consent"),
+              "apply says that online play waits for the password consent")
+        m.plaintextConsent = true
+        m.enabled = false
+        m.apply()
+        check(getenvString("DM_LDNR") == nil && getenvString("DM_LDNR_SERVER") == nil && getenvString("DM_LDNR_ROOM_PASSWORD") == nil,
+              "apply unsets every variable when online play is off")
+        m.enabled = true
+        m.apply()
+        setenv("DM_LDNR", "0", 1)   // the file wins
+        let fixed = OnlinePlayModel(game: m.game, shared: m.shared, environment: ["DM_LDNR": "0"], defaultName: "iPhone")
+        fixed.apply()
+        check(getenvString("DM_LDNR") == "0" && getenvString("DM_LDNR_SERVER") != nil, "a fixed DM_LDNR is not touched, and nothing else is either")
+        unsetenv("DM_LDNR")
+    }
