diff --git a/dm/ios/tests/test_online_play.py b/dm/ios/tests/test_online_play.py
new file mode 100644
index 0000000..29b7b4c
--- /dev/null
+++ b/dm/ios/tests/test_online_play.py
@@ -0,0 +1,48 @@
+"""Compile and run the online play model (dm/ios/Sources/OnlinePlay.swift) with its checks; no simulator or UI required. Runs on macOS with Xcode and on
+Linux when a Swift toolchain is installed."""
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[3]
+SOURCES = REPO / 'dm/ios/Sources/OnlinePlay.swift'
+CHECK = Path(__file__).with_name('online_play_check.swift')
+SWIFT_DIRS = ('/opt/swift/usr/bin',)
+
+
+def swiftc():
+    """The Swift compiler this machine has: Xcode's on macOS, else one on PATH (then /opt/swift/usr/bin, where a PM-installed toolchain lives)."""
+    if shutil.which('xcrun'):
+        r = subprocess.run(['xcrun', '-sdk', 'macosx', '--find', 'swiftc'], capture_output=True, text=True)
+        if r.returncode == 0 and r.stdout.strip():
+            return ['xcrun', '-sdk', 'macosx', 'swiftc']
+    found = shutil.which('swiftc')
+    if found:
+        return [found]
+    for d in SWIFT_DIRS:
+        candidate = Path(d) / 'swiftc'
+        if candidate.is_file() and os.access(candidate, os.X_OK):
+            return [str(candidate)]
+    return None
+
+
+@unittest.skipUnless(swiftc(), 'needs a Swift toolchain (Xcode, or swiftc on PATH)')
+class OnlinePlayTests(unittest.TestCase):
+    def test_online_play_checks(self):
+        compiler = swiftc()
+        with tempfile.TemporaryDirectory() as tmp:
+            tmp = Path(tmp)
+            exe = tmp / 'online_play_check'
+            compile_result = subprocess.run(compiler + ['-swift-version', '5', '-parse-as-library', '-module-cache-path', str(tmp / 'module-cache'),
+                                                        '-o', str(exe), str(SOURCES), str(CHECK)], capture_output=True, text=True, timeout=300)
+            self.assertEqual(compile_result.returncode, 0, compile_result.stdout + compile_result.stderr)
+            r = subprocess.run([str(exe)], capture_output=True, text=True, timeout=120)
+            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+            self.assertIn('online play: 0 failed', r.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
