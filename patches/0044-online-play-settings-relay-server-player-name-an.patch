+    static func serverList() {
+        let m = model()
+        check(m.addServer(name: "One", address: "a.example.com:11470") == nil, "a server is added")
+        check(m.selected == "a.example.com:11470", "an added server is chosen")
+        check(m.addServer(name: "Bad", address: "ho st") == .invalidCharacters, "an invalid address is refused")
+        check(m.addServer(name: "Again", address: "ldnr://a.example.com:11470/") == nil && m.servers.count == 1,
+              "the same address is not added twice")
+        check(m.servers.first?.name == "Again", "adding an existing address updates its name")
+        _ = m.addServer(name: "Two", address: "b.example.com")
+        check(m.servers.map(\.address) == ["a.example.com:11470", "b.example.com"], "the list keeps its order")
+        check(m.selected == "b.example.com" && m.selectedServer?.address == "b.example.com", "the newest server is chosen")
+        check(m.updateServer(old: "b.example.com", name: "Bee", address: "c.example.com:11470") == nil, "a server is edited")
+        check(m.servers.map(\.address) == ["a.example.com:11470", "c.example.com:11470"] && m.selected == "c.example.com:11470",
+              "an edited address is chosen again")
+        check(m.servers.last?.name == "Bee", "the edited name is kept")
+        check(m.updateServer(old: "c.example.com:11470", name: "", address: "x y") == .invalidCharacters, "an invalid edit is refused")
+        check(m.servers.last?.address == "c.example.com:11470", "a refused edit changes nothing")
+        m.removeServer(address: "c.example.com:11470")
+        check(m.selected == "a.example.com:11470" && m.selectedServer?.address == "a.example.com:11470",
+              "removing the chosen server chooses the first one left")
+        m.removeServer(address: "a.example.com:11470")
+        check(m.selected.isEmpty && m.selectedServer == nil && m.servers.isEmpty, "the last server removed leaves no choice")
+        let chosen = model()
+        _ = chosen.addServer(name: "", address: "kept.example.com")
+        _ = chosen.addServer(name: "", address: "other.example.com")
+        chosen.selected = "other.example.com"
+        chosen.removeServer(address: "kept.example.com")
+        check(chosen.selected == "other.example.com", "removing another server keeps the chosen one")
+        let fixed = model(["DM_LDNR_SERVER": "env.example.com:9"])
+        check(fixed.selectedServer?.address == "env.example.com:9", "an address fixed by the environment is the chosen server")
+
+        // a pasted invite adds and chooses its server, fills in the password, asks again for the consent and leaves the toggle alone
+        let invited = model()
+        invited.plaintextConsent = true
+        invited.applyInvite(OnlineInvite(server: "ldnr://friend.example.com/", password: "pw", name: "Friend"))
+        check(invited.servers == [RelayServer(name: "Friend", address: "friend.example.com")], "an invite adds its server")
+        check(invited.selected == "friend.example.com" && invited.selectedServer?.address == "friend.example.com", "an invite chooses its server")
+        check(invited.password == "pw" && !invited.plaintextConsent, "an invite fills in the password and asks again for the consent")
+        check(!invited.enabled, "an invite does not turn online play on")
+        invited.enabled = true
+        invited.applyInvite(OnlineInvite(server: "friend.example.com", password: "other", name: ""))
+        check(invited.servers == [RelayServer(name: "Friend", address: "friend.example.com")],
+              "an invite for a saved server keeps the name its player gave it")
+        let mine = model()
+        _ = mine.addServer(name: "", address: "shared.example.com")
+        check(mine.invite() == OnlineInvite(server: "shared.example.com", password: "", name: ""), "the invite carries the chosen server")
+        check(model().invite() == nil, "no chosen server, no invite")
+
+        // 3. an invite cannot move a fixed server or a fixed DM_LDNR, and it keeps a fixed password
+        let fixedServerInvite = model(["DM_LDNR_SERVER": "env.example.com:9"])
+        check(!fixedServerInvite.applyInvite(OnlineInvite(server: "friend.example.com", password: "pw", name: "")),
+              "an invite for another server is refused when env.txt fixes the server")
+        check(fixedServerInvite.servers.isEmpty && fixedServerInvite.selected.isEmpty && fixedServerInvite.password.isEmpty,
+              "a refused invite changes nothing")
+        check(fixedServerInvite.applyInvite(OnlineInvite(server: "ldnr://env.example.com:9/", password: "pw", name: "")),
+              "an invite for the fixed server itself is accepted")
+        check(fixedServerInvite.password == "pw" && fixedServerInvite.selected == "env.example.com:9",
+              "the fixed server's invite fills in the password")
+
+        let fixedLDNInvite = model(["DM_LDNR": "1"])
+        check(!fixedLDNInvite.applyInvite(OnlineInvite(server: "friend.example.com", password: "pw", name: "")),
+              "an invite changes nothing when env.txt fixes DM_LDNR")
+        check(fixedLDNInvite.servers.isEmpty && fixedLDNInvite.password.isEmpty, "the refused invite with a fixed DM_LDNR changes nothing")
+
+        let fixedPasswordInvite = model(["DM_LDNR_ROOM_PASSWORD": "filepw"])
+        check(fixedPasswordInvite.applyInvite(OnlineInvite(server: "friend.example.com", password: "invited", name: "")),
+              "an invite is accepted when only the password is fixed")
+        check(fixedPasswordInvite.selected == "friend.example.com" && fixedPasswordInvite.password.isEmpty,
+              "an invite does not change a fixed password")
+
+        let clampedInvite = model()
+        check(clampedInvite.applyInvite(OnlineInvite(server: "friend.example.com", password: String(repeating: "汉", count: 30), name: "")),
+              "an invite with a long password is accepted")
+        check(clampedInvite.password == String(repeating: "汉", count: 21),
+              "an invite's password is cut to 64 bytes at a character boundary")
+    }
