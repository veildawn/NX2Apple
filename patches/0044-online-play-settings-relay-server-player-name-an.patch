+// MARK: the checks
+
+@main struct OnlinePlayCheck {
+    static var failed = 0
+    static func check(_ ok: Bool, _ what: String) {
+        print((ok ? "PASS " : "FAIL ") + what)
+        if !ok { failed += 1 }
+    }
+
+    static func main() {
+        OnlineText.chineseOverride = nil
+        print("system language Chinese: \(OnlineText.chinese)")   // informational: the rest of the checks pin English, and the invite check pins Chinese
+        OnlineText.chineseOverride = false
+        addresses()
+        names()
+        passwords()
+        invites()
+        persistence()
+        serverList()
+        environments()
+        applyToProcess()
+        launchEnvironment()
+        frames()
+        probes()
+        print("online play: \(failed) failed")
+        exit(failed == 0 ? 0 : 1)
+    }
+
+    // MARK: addresses
+
+    static func addresses() {
+        for good in ["relay.example.com", "relay.example.com:11470", "1.2.3.4:11470", "[::1]:9", "[::1]", "::1", "2001:db8::1",
+                     "host:1", "host:65535", "a:b:c", "ldnr://x:1/"] {
+            check(RelayAddress.validate(good) == nil, "valid address \(good)")
+        }
+        let bad: [(String, RelayAddressError)] = [
+            ("", .empty), ("   ", .empty), ("host:0", .badPort), ("host:65536", .badPort), ("host:abc", .badPort),
+            ("host:", .badPort), ("ho st", .invalidCharacters), ("http://x/y", .invalidCharacters),
+            ("host:1/path", .invalidCharacters), ("user@host:1", .invalidCharacters), ("host?x", .invalidCharacters),
+            ("host#x", .invalidCharacters), ("[]", .badBrackets), ("[::1", .badBrackets), ("[zz]:1", .badBrackets),
+            ("[::1]x", .badBrackets), ("[::1]:", .badPort), ("[::1]:0", .badPort), ("[::1]:70000", .badPort),
+            (String(repeating: "a", count: 254), .tooLong), (":" , .empty),
+        ]
+        for (text, want) in bad {
+            check(RelayAddress.validate(text) == want, "invalid address \"\(text)\" -> \(want)")
+        }
+        check(RelayAddress.normalize("  ldnr://x:1/ ") == "x:1" && RelayAddress.normalize("LDNR://X:1") == "X:1", "normalize trims, strips the scheme and one slash")
+        check(RelayAddress.normalize("x:1//") == "x:1/", "normalize strips one trailing slash only")
+        check(RelayAddress.validate(String(repeating: "a", count: 253)) == nil, "a 253-byte host is accepted")
+        let s1 = RelayAddress.split("relay.example.com")
+        check(s1?.host == "relay.example.com" && s1?.port == 11470, "a bare host takes port 11470")
+        let s2 = RelayAddress.split("host:9")
+        check(s2?.host == "host" && s2?.port == 9, "host:port splits")
+        let s3 = RelayAddress.split("[::1]:9")
+        check(s3?.host == "::1" && s3?.port == 9, "[IPv6]:port splits")
+        let s4 = RelayAddress.split("[::1]")
+        check(s4?.host == "::1" && s4?.port == 11470, "[IPv6] takes the default port")
+        let s5 = RelayAddress.split("::1")
+        check(s5?.host == "::1" && s5?.port == 11470, "a bare IPv6 literal is the host")
+        check(RelayAddress.split("a:b:c")?.host == "a:b:c", "a bare string with two colons is an IPv6-style host")
+        check(RelayAddress.split("host:0") == nil, "an invalid address does not split")
+    }
+
+    // MARK: names
+
+    static func names() {
+        check(PlayerName.maxBytes == 32, "the name field is 32 bytes")
+        let han = String(repeating: "汉", count: 11)   // 33 bytes
+        check(PlayerName.clamp(han) == String(repeating: "汉", count: 10), "33 bytes of Chinese cut to 10 characters, never inside one")
+        check(PlayerName.bytesLeft(han) == 0 && PlayerName.bytesLeft(String(repeating: "汉", count: 10)) == 2, "bytes left of the 32-byte field")
+        // an emoji with a skin tone is one Character and several scalars: 4 + 4 bytes
+        let emoji = "👍🏽"   // thumb up + skin tone modifier
+        let twelve = String(repeating: emoji, count: 4)   // 32 bytes
+        check(PlayerName.clamp(twelve) == twelve, "a multi-scalar character that fits stays whole")
+        check(PlayerName.clamp(twelve + "x") == twelve, "the character that would overflow is dropped whole")
+        check(PlayerName.clamp("  Bob  ") == "Bob", "the name is trimmed")
+        check(PlayerName.bytesLeft("") == 32, "an empty name leaves the whole field")
+        // 5. what the field holds while it is typed: cut, never trimmed, so a space is not removed at once
+        check(PlayerName.limit("  Bob  ") == "  Bob  ", "limit keeps the spaces while typing")
+        check(PlayerName.limit("Bo b") == "Bo b", "a space inside the name survives typing")
+        check(PlayerName.limit(String(repeating: "汉", count: 11)) == String(repeating: "汉", count: 10),
+              "limit cuts at 32 bytes, never inside a character")
+        check(PlayerName.limit(String(repeating: " ", count: 40)) == String(repeating: " ", count: 32),
+              "limit counts the whitespace toward the field")
+        check(PlayerName.clamp(PlayerName.limit("  Bob  ")) == "Bob", "what is written is still trimmed and cut")
+    }
+
+    // MARK: the room password
+
+    static func passwords() {
+        check(RoomPassword.maxBytes == 64, "the room password field is 64 bytes")
+        check(RoomPassword.clamp(String(repeating: "a", count: 70)) == String(repeating: "a", count: 64),
+              "a long password is cut to 64 bytes")
+        check(RoomPassword.bytesLeft(String(repeating: "a", count: 60)) == 4, "bytes left of the 64-byte field")
+        check(RoomPassword.clamp(String(repeating: "汉", count: 22)) == String(repeating: "汉", count: 21),
+              "a Chinese password is cut at a character boundary")
+        check(RoomPassword.clamp("  two words  ") == "  two words  ", "spaces are part of a password and are kept")
+        let emoji = "👍🏽"   // 8 bytes, one Character
+        check(RoomPassword.clamp(String(repeating: emoji, count: 16)) == String(repeating: emoji, count: 8),
+              "a multi-scalar character is kept whole")
+        check(RoomPassword.bytesLeft("") == 64, "an empty password leaves the whole field")
+    }
