+    // MARK: the frames
+
+    static func frames() {
+        // HELLO: 16-byte header + major_min, major_max, minor, capabilities u32, "NX2Apple launcher" (17 bytes), "1"
+        let expected: [UInt8] = [0x4C, 0x44, 0x4E, 0x52, 1, 0x01, 0, 0,
+                                 29, 0, 0, 0,   // payload length: 3 + 4 + 2 + 17 + 2 + 1
+                                 1, 0, 0, 0,    // request id
+                                 1, 1, 2, 0x1F, 0, 0, 0,   // the game client's capabilities
+                                 17, 0] + Array("NX2Apple launcher".utf8) + [1, 0] + Array("1".utf8)
+        check(RelayProbe.helloFrame(requestID: 1) == expected, "the HELLO frame, byte for byte")
+        let ping = RelayProbe.pingFrame(major: 1, requestID: 7, timestampMs: 0x0102030405060708)
+        let expectedPing: [UInt8] = [0x4C, 0x44, 0x4E, 0x52, 1, 0x03, 0, 0, 8, 0, 0, 0, 7, 0, 0, 0,
+                                     8, 7, 6, 5, 4, 3, 2, 1]
+        check(ping == expectedPing, "the PING frame, byte for byte, little-endian")
+        let hello = RelayProbe.helloFrame(requestID: 42)
+        check(RelayProbe.parseFrame(Array(hello.prefix(15))) == nil, "a frame cut short does not parse")
+        check(RelayProbe.parseFrame(Array(hello.prefix(20))) == nil, "a frame without its whole payload does not parse")
+        if let parsed = RelayProbe.parseFrame(hello) {
+            check(parsed.type == 0x01 && parsed.version == 1 && parsed.requestID == 42 && parsed.consumed == hello.count,
+                  "a whole frame parses")
+        } else {
+            check(false, "a whole frame parses")
+        }
+        let ack = helloAck(requestID: 42)
+        check(RelayProbe.parseFrame(Array(ack.dropFirst(16))) == nil, "a payload without its header does not parse")
+        let ackPayload = Array(helloAck(requestID: 1).dropFirst(16))
+        let decoded = RelayProbe.parseHelloAck(ackPayload)
+        check(decoded?.major == 1 && decoded?.minor == 2 && decoded?.capabilities == 0x1F && decoded?.serverName == "test relay", "HELLO_ACK decodes")
+        check(RelayProbe.parseHelloAck(Array(ackPayload.prefix(10))) == nil, "a short HELLO_ACK does not decode")
+    }
+
+    // MARK: the connection test
+
+    static func probes() {
+        // (a) a good relay
+        if let relay = FakeRelay({ fd in
+            guard let hello = readFrame(fd), hello.type == 0x01 else { return }
+            writeAll(fd, helloAck(requestID: hello.requestID))
+            answerPing(fd)
+        }) {
+            let result = RelayProbe.run(address: relay.address, timeout: 5)
+            check(result.kind == .ok, "a relay that answers HELLO and PONG is ready")
+            check(result.protocolVersion == "1.2" && result.serverName == "test relay", "the version and the server name are read")
+            check(result.latencyMs != nil, "the PING round trip is timed")
+            relay.stop()
+        } else {
+            check(false, "a fake relay can be started")
+        }
+        // (b) VERSION_UNSUPPORTED
+        if let relay = FakeRelay({ fd in
+            guard let hello = readFrame(fd) else { return }
+            writeAll(fd, errorFrame(requestID: hello.requestID, code: 17, message: "protocol 1.2 required"))
+        }) {
+            let result = RelayProbe.run(address: relay.address, timeout: 5)
+            check(result.kind == .oldProtocol, "VERSION_UNSUPPORTED (17) is an older protocol")
+            relay.stop()
+        }
+        // (c) an old minor
+        if let relay = FakeRelay({ fd in
+            guard let hello = readFrame(fd) else { return }
+            writeAll(fd, helloAck(requestID: hello.requestID, minor: 1))
+        }) {
+            check(RelayProbe.run(address: relay.address, timeout: 5).kind == .oldProtocol, "a HELLO_ACK minor below 2 is an older protocol")
+            relay.stop()
+        }
+        // (c2) a relay without the features the game needs: the game refuses it, so the test does too
+        if let relay = FakeRelay({ fd in
+            guard let hello = readFrame(fd) else { return }
+            writeAll(fd, helloAck(requestID: hello.requestID, capabilities: 0x01))
+        }) {
+            check(RelayProbe.run(address: relay.address, timeout: 5).kind == .oldProtocol, "a HELLO_ACK without capabilities 0x1e is refused, as the game does")
+            relay.stop()
+        }
+        // (d) not a relay
+        if let relay = FakeRelay({ fd in
+            _ = readExact(fd, 16)
+            writeAll(fd, Array("HTTP/1.1 400 Bad Request\r\n\r\n".utf8))
+        }) {
+            check(RelayProbe.run(address: relay.address, timeout: 5).kind == .notRelay, "HTTP for a HELLO is not an LDN relay server")
+            relay.stop()
+        }
+        // (e) silence until the deadline
+        if let relay = FakeRelay({ fd in
+            _ = readExact(fd, 16)
+            Thread.sleep(forTimeInterval: 4)   // holds the connection open, answers nothing
+        }) {
+            let started = Date()
+            let result = RelayProbe.run(address: relay.address, timeout: 1)
+            let elapsed = Date().timeIntervalSince(started)
+            check(result.kind == .unreachable, "a silent relay is not reachable")
+            check(elapsed < 3, "the test gives up at its deadline (\(String(format: "%.1f", elapsed)) s)")
+            relay.stop()
+        }
+        // (f) a closed port
+        if let relay = FakeRelay({ _ in }) {
+            let address = relay.address
+            relay.stop()
+            check(RelayProbe.run(address: address, timeout: 2).kind == .unreachable, "a closed port is not reachable")
+        }
+        // (g) a name that does not resolve. A label longer than DNS allows cannot resolve anywhere, not even through a resolver that answers every name.
+        let nonexistent = RelayProbe.run(address: String(repeating: "a", count: 64) + ".invalid:1", timeout: 2)
+        check(nonexistent.kind == .unreachable, "a name that does not resolve is not reachable")
+        // the same name this suite usually runs with, the reserved .invalid TLD: always an answer or a failure, never a relay
+        check(RelayProbe.run(address: "nonexistent.invalid:1", timeout: 2).kind != .ok, "the reserved .invalid name never reaches a relay")
+        // an address the field would refuse
+        check(RelayProbe.run(address: "ho st", timeout: 2).kind == .unreachable, "an invalid address is not reachable")
+        // a server that answers a PING it did not send first, before the handshake: an O(n) prefix of a large payload must not end the test early
+        if let relay = FakeRelay({ fd in
+            _ = readExact(fd, 16)
+            var payload = [UInt8](repeating: 0, count: 65536)   // at the announced frame limit
+            payload[0] = 0x01
+            writeAll(fd, makeFrame(0x03, requestID: 0, payload: payload))
+        }) {
+            let result = RelayProbe.run(address: relay.address, timeout: 1)
+            check(result.kind == .notRelay || result.kind == .unreachable, "a 64 KiB server PING is parsed, then the deadline ends the test")
+            relay.stop()
+        }
+    }
+}
+
+func getenvString(_ key: String) -> String? {
+    getenv(key).map { String(cString: $0) }
+}
+
+/// What a block writes to stderr (the launcher log), captured through a temporary file and put back afterwards.
+func stderrLog(_ body: () -> Void) -> String {
+    let path = NSTemporaryDirectory() + "online-play-stderr-\(UUID().uuidString)"
+    let saved = dup(2)
+    freopen(path, "w", stderr)
+    body()
+    fflush(stderr)
+    if saved >= 0 { dup2(saved, 2); close(saved) }
+    let log = (try? String(contentsOfFile: path, encoding: .utf8)) ?? ""
+    try? FileManager.default.removeItem(atPath: path)
+    return log
+}
