+++ b/dm/ios/tests/online_play_check.swift
@@ -0,0 +1,711 @@
+// The online play model (OnlinePlay.swift), run by test_online_play.py: address validation and splitting, name truncation, the invite round trip,
+// persistence through a private UserDefaults suite, the environment Play writes for every combination, and the connection test's frames and
+// behaviour against a fake relay on loopback. Compiles with OnlinePlay.swift alone (-parse-as-library), on macOS or Linux.
+import Foundation
+#if canImport(Darwin)
+import Darwin
+#else
+import Glibc
+#endif
+
+#if canImport(Darwin)
+let streamSocketType: Int32 = SOCK_STREAM
+#else
+let streamSocketType: Int32 = Int32(SOCK_STREAM.rawValue)
+#endif
+
+// MARK: a fake relay
+
+/// A listening socket on 127.0.0.1, answered by a thread with `serve` per connection. The test owns its lifetime: stop() stops it.
+final class FakeRelay {
+    let fd: Int32
+    let port: UInt16
+    private let serve: (Int32) -> Void
+    private var thread: Thread?
+    private var stopped = false
+
+    /// Binds to an ephemeral port; `serve` runs on a thread per accepted connection. A connection that `serve` ignores is closed when the test ends.
+    init?(_ serve: @escaping (Int32) -> Void) {
+        self.serve = serve
+        let fd = socket(AF_INET, streamSocketType, 0)
+        if fd < 0 { return nil }
+        var one: Int32 = 1
+        setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, socklen_t(MemoryLayout<Int32>.size))
+        var address = sockaddr_in()
+        address.sin_family = sa_family_t(AF_INET)
+        address.sin_port = 0
+        address.sin_addr.s_addr = inet_addr("127.0.0.1")
+        let bound = withUnsafePointer(to: &address) { p in
+            p.withMemoryRebound(to: sockaddr.self, capacity: 1) { bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size)) }
+        }
+        if bound != 0 || listen(fd, 8) != 0 { close(fd); return nil }
+        var size = socklen_t(MemoryLayout<sockaddr_in>.size)
+        var assigned = sockaddr_in()
+        _ = withUnsafeMutablePointer(to: &assigned) { p in
+            p.withMemoryRebound(to: sockaddr.self, capacity: 1) { getsockname(fd, $0, &size) }
+        }
+        self.fd = fd
+        self.port = UInt16(bigEndian: assigned.sin_port)
+        let t = Thread { [weak self] in self?.acceptLoop() }
+        t.start()
+        thread = t
+    }
+
+    var address: String { "127.0.0.1:\(port)" }
+
+    private func acceptLoop() {
+        while !stopped {
+            let client = accept(fd, nil, nil)
+            if client < 0 { return }   // the listener is closed
+            let handle = serve
+            let t = Thread { handle(client); close(client) }
+            t.start()
+        }
+    }
+
+    /// Stops the listener: accept returns and the thread ends. An accepted connection is closed by its own handler.
+    func stop() {
+        stopped = true
+        shutdown(fd, Int32(SHUT_RDWR))
+        close(fd)
+    }
+}
+
+// MARK: frames over a socket
+
+func readExact(_ fd: Int32, _ count: Int) -> [UInt8]? {
+    var out: [UInt8] = []
+    while out.count < count {
+        var chunk = [UInt8](repeating: 0, count: count - out.count)
+        let n = read(fd, &chunk, chunk.count)
+        if n <= 0 { return nil }
+        out.append(contentsOf: chunk[0..<n])
+    }
+    return out
+}
+
+/// The header and payload of one client frame, or nil when the client went away.
+func readFrame(_ fd: Int32) -> (type: UInt8, requestID: UInt32, payload: [UInt8])? {
+    guard let header = readExact(fd, 16) else { return nil }
+    let length = Int(header[8]) | Int(header[9]) << 8 | Int(header[10]) << 16 | Int(header[11]) << 24
+    let requestID = UInt32(header[12]) | UInt32(header[13]) << 8 | UInt32(header[14]) << 16 | UInt32(header[15]) << 24
+    guard let payload = length > 0 ? readExact(fd, length) : [] else { return nil }
+    return (header[5], requestID, payload)
+}
+
+func makeFrame(_ type: UInt8, requestID: UInt32, payload: [UInt8], version: UInt8 = 1) -> [UInt8] {
+    var out: [UInt8] = [0x4C, 0x44, 0x4E, 0x52, version, type, 0, 0]
+    let n = UInt32(payload.count)
+    out += [UInt8(n & 0xFF), UInt8((n >> 8) & 0xFF), UInt8((n >> 16) & 0xFF), UInt8((n >> 24) & 0xFF)]
+    out += [UInt8(requestID & 0xFF), UInt8((requestID >> 8) & 0xFF), UInt8((requestID >> 16) & 0xFF), UInt8((requestID >> 24) & 0xFF)]
+    return out + payload
+}
+
+func helloAck(requestID: UInt32, major: UInt8 = 1, minor: UInt8 = 2, capabilities: UInt8 = 0x1F, name: String = "test relay") -> [UInt8] {
+    var payload: [UInt8] = [major, minor, 1, 1]
+    payload += [capabilities, 0, 0, 0]   // capabilities, the AND of both sides
+    payload += [UInt8](repeating: 7, count: 16)   // conn_id
+    let utf8 = Array(name.utf8)
+    payload += [UInt8(utf8.count & 0xFF), UInt8((utf8.count >> 8) & 0xFF)] + utf8
+    payload += [0x00, 0x00, 0x01, 0x00]   // max_frame 65536
+    payload += [0x98, 0x3A, 0, 0]         // keepalive 15000 ms
+    return makeFrame(0x02, requestID: requestID, payload: payload)
+}
+
+func errorFrame(requestID: UInt32, code: UInt16, message: String) -> [UInt8] {
+    let utf8 = Array(message.utf8)
+    var payload: [UInt8] = [UInt8(code & 0xFF), UInt8((code >> 8) & 0xFF), UInt8(utf8.count & 0xFF), UInt8((utf8.count >> 8) & 0xFF)]
+    payload += utf8
+    return makeFrame(0x05, requestID: requestID, payload: payload)
+}
+
+func writeAll(_ fd: Int32, _ bytes: [UInt8]) {
+    _ = bytes.withUnsafeBytes { write(fd, $0.baseAddress, $0.count) }
+}
+
+/// Reads the PING and answers it, for a relay that completed the handshake.
+func answerPing(_ fd: Int32) {
+    guard let ping = readFrame(fd), ping.type == 0x03 else { return }
+    writeAll(fd, makeFrame(0x04, requestID: ping.requestID, payload: ping.payload))
+}
