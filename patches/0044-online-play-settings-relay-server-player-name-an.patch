+    // MARK: invites
+
+    static func invites() {
+        let invite = OnlineInvite(server: "relay.example.com:11470", password: "p&=?#汉 room", name: "Zelda Den")
+        let parsed = OnlineInvite.parse(invite.text())
+        check(parsed == invite, "an invite round-trips through its text, with &=?# and Chinese in the password")
+        let chat = "hey, join me tonight\n\(invite.link())\nsee you at 8"
+        check(OnlineInvite.parse(chat) == invite, "the link is found in surrounding chat text")
+        check(OnlineInvite.parse("no invite here") == nil, "text without a link is no invite")
+        check(OnlineInvite.parse("nx2apple-ldn://join?server=ho%20st") == nil, "an invalid server is no invite")
+        check(OnlineInvite.parse("nx2apple-ldn://join") == nil, "a link without a server is no invite")
+        let plain = OnlineInvite(server: "host:9", password: "", name: "")
+        check(!plain.text().contains("password=") && !plain.text().contains("name="), "an empty password and name are left out of the link")
+        check(OnlineInvite.parse(plain.text()) == plain, "an invite without a password or name round-trips")
+        check(plain.text().hasPrefix("Online play"), "the text has an English label line")
+        OnlineText.chineseOverride = true
+        check(invite.text().contains("房间密码"), "the Chinese text names the room password")
+        OnlineText.chineseOverride = false
+        check(RelayAddressError.empty.message == "Enter a server address", "the error message is in the chosen language")
+        OnlineText.chineseOverride = true
+        check(RelayAddressError.empty.message == "请输入服务器地址", "the Chinese error message")
+        OnlineText.chineseOverride = false
+        check(invite.text().contains("ldnr://") == false && invite.text().contains("nx2apple-ldn://join?server="), "the text carries the join link")
+    }
