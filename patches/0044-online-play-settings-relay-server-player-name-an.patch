+/// The add and edit sheet: Name and Address, the address checked as it is typed, Save disabled until it passes.
+private struct ServerEditor: View {
+    @ObservedObject var state: OnlinePlayState
+    let original: String?
+    let isNew: Bool
+    @Environment(\.dismiss) private var dismiss
+    @State private var name: String
+    @State private var address: String   // what was typed, not normalized: the error line must not fight the typing
+
+    init(state: OnlinePlayState, original: String?, name: String, address: String, isNew: Bool) {
+        self.state = state
+        self.original = original
+        self.isNew = isNew
+        _name = State(initialValue: name)
+        _address = State(initialValue: address)
+    }
+
+    private var error: RelayAddressError? { RelayAddress.validate(address) }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack {
+                Button(OnlineText.t("Cancel", "取消")) { dismiss() }
+                Spacer()
+                Text(isNew ? OnlineText.t("Add server", "添加服务器") : OnlineText.t("Edit server", "编辑服务器"))
+                    .font(.headline)
+                Spacer()
+                Button(OnlineText.t("Save", "保存")) { save() }
+                    .disabled(error != nil)
+            }
+            .padding()
+            #if os(macOS)
+            Divider()
+            #endif
+            Form {
+                TextField(OnlineText.t("Name (optional)", "名称（可选）"), text: $name)
+                    #if os(iOS)
+                    .textInputAutocapitalization(.never)
+                    #endif
+                    .autocorrectionDisabled()
+                TextField(OnlineText.t("Address", "地址"), text: $address, prompt: Text("relay.example.com:11470"))
+                    #if os(iOS)
+                    .textInputAutocapitalization(.never)
+                    #endif
+                    .autocorrectionDisabled()
+                    #if os(iOS)
+                    .keyboardType(.URL)
+                    #endif
+                if let error = error {
+                    Text(error.message).font(.footnote).foregroundStyle(.red)
+                } else {
+                    Text(OnlineText.t("host, host:port or [IPv6]:port. A missing port means 11470.",
+                                      "host、host:port 或 [IPv6]:port。省略端口时使用 11470。"))
+                        .font(.footnote).foregroundStyle(.secondary)
+                }
+            }
+            #if os(macOS)
+            .formStyle(.grouped)
+            #endif
+        }
+        #if os(iOS)
+        .presentationDetents([.medium])
+        #endif
+        .frame(minWidth: 320)
+    }
+
+    private func save() {
+        let failure: RelayAddressError?
+        if let original = original {
+            failure = state.updateServer(old: original, name: name, address: address)
+        } else {
+            failure = state.addServer(name: name, address: address)
+        }
+        if failure == nil { dismiss() }
+    }
+}
