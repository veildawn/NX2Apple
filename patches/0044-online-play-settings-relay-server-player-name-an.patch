+    // MARK: the environment
+
+    static let badKey = "DM_LDNR_SERVER"
+
+    static func environments() {
+        let off = model()
+        _ = off.addServer(name: "", address: "relay.example.com")
+        off.enabled = false
+        check(off.environment().values.allSatisfy { $0 == nil } && off.environment().count == 5,
+              "off: every variable is unset")
+        check(off.readiness == .off, "off: the section says so")
+
+        let noServer = model()
+        noServer.enabled = true
+        check(noServer.environment()[badKey]! == nil && noServer.environment().count == 5, "on without a server: every variable is unset")
+        check(noServer.readiness == .noServer, "on without a server: choose a server")
+
+        let on = model()
+        on.enabled = true
+        _ = on.addServer(name: "", address: "ldnr://relay.example.com/")
+        let env = on.environment()
+        check(env["DM_LDNR"]! == "1", "on: DM_LDNR=1")
+        check(env["DM_LDNR_SERVER"]! == "relay.example.com", "on: the chosen address, normalized")
+        check(env["DM_LDNR_NAME"]! == "iPhone", "an empty player name falls back to the device name")
+        check(env["DM_LDNR_ROOM_PASSWORD"]! == nil && env["DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"]! == nil, "no password: no password and no consent")
+        check(on.readiness == .ready, "on with a server, no password: ready")
+
+        on.playerName = "Player One"
+        check(on.environment()["DM_LDNR_NAME"]! == "Player One", "the player name is written")
+        on.playerName = ""
+        let noName = OnlinePlayModel(game: on.game, shared: on.shared, environment: [:], defaultName: "")
+        noName.enabled = true
+        _ = noName.addServer(name: "", address: "relay.example.com")
+        check(noName.environment()["DM_LDNR_NAME"]! == nil, "an empty name and no device name leaves the name unset")
+
+        let withPassword = model()
+        withPassword.enabled = true
+        _ = withPassword.addServer(name: "", address: "relay.example.com")
+        withPassword.password = "pw"
+        check(withPassword.environment()["DM_LDNR_ROOM_PASSWORD"]! == nil, "without consent the password is not written")
+        check(withPassword.environment()["DM_LDNR"]! == nil && withPassword.environment().count == 5,
+              "without consent every variable is unset, so online play does not start")
+        check(withPassword.readiness == .needsConsent, "without consent the section says online play will not start")
+        withPassword.plaintextConsent = true
+        check(withPassword.environment()["DM_LDNR_ROOM_PASSWORD"]! == "pw", "with consent the password is written")
+        check(withPassword.environment()["DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"]! == "1", "with consent the password is allowed")
+        check(withPassword.readiness == .ready, "with consent and a password: ready")
+
+        // 1. the consent that counts: an env.txt value decides when the variable is fixed, else the toggle
+        let fileConsent = model(["DM_LDNR_ALLOW_PLAINTEXT_PASSWORD": "1"])
+        fileConsent.enabled = true
+        _ = fileConsent.addServer(name: "", address: "relay.example.com")
+        fileConsent.password = "pw"
+        check(fileConsent.effectiveConsent && fileConsent.readiness == .ready,
+              "env.txt's DM_LDNR_ALLOW_PLAINTEXT_PASSWORD=1 counts as consent, without the toggle")
+        check(fileConsent.environment()["DM_LDNR_ROOM_PASSWORD"]! == "pw",
+              "with env.txt's consent the password is written")
+        check(!fileConsent.environment().keys.contains("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"),
+              "a consent fixed by env.txt is left to the file")
+
+        let fileRefusal = model(["DM_LDNR_ALLOW_PLAINTEXT_PASSWORD": "0"])
+        fileRefusal.enabled = true
+        _ = fileRefusal.addServer(name: "", address: "relay.example.com")
+        fileRefusal.password = "pw"
+        fileRefusal.plaintextConsent = true   // the toggle cannot consent for the file
+        check(!fileRefusal.effectiveConsent && fileRefusal.readiness == .needsConsent,
+              "env.txt's consent=0 waits for consent even with the toggle on")
+        let refusalEnv = fileRefusal.environment()
+        check(refusalEnv.values.allSatisfy { $0 == nil } && refusalEnv["DM_LDNR"]! == nil && refusalEnv["DM_LDNR_ROOM_PASSWORD"]! == nil,
+              "waiting for consent: every variable it may write is unset, so the password is not written")
+
+        // 1. and 2. a password fixed by env.txt is the one that counts, and it is never waiting for the toggle's consent
+        let fixedPassword = model(["DM_LDNR_ROOM_PASSWORD": "filepw"])
+        fixedPassword.enabled = true
+        _ = fixedPassword.addServer(name: "", address: "relay.example.com")
+        fixedPassword.password = "typed"
+        check(fixedPassword.effectivePassword == "filepw", "the password fixed by env.txt is the one that counts")
+        check(fixedPassword.readiness == .ready, "a fixed password is never waiting for the toggle's consent")
+        check(!fixedPassword.environment().keys.contains("DM_LDNR_ROOM_PASSWORD"), "a fixed password is left to the file")
+        check(fixedPassword.invite() == OnlineInvite(server: "relay.example.com", password: "filepw", name: ""),
+              "the invite carries the fixed password")
+
+        // the toggle's consent was for the field's password: it does not allow a password env.txt fixes later
+        let carried = model(["DM_LDNR_ROOM_PASSWORD": "filepw"])
+        carried.enabled = true
+        _ = carried.addServer(name: "", address: "relay.example.com")
+        carried.password = "typed"
+        carried.plaintextConsent = true
+        let carriedEnv = carried.environment()
+        check(carriedEnv.keys.contains("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD") && carriedEnv["DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"]! == nil,
+              "a fixed password is not allowed by the toggle: only env.txt can allow it")
+        let fileAllows = model(["DM_LDNR_ROOM_PASSWORD": "filepw", "DM_LDNR_ALLOW_PLAINTEXT_PASSWORD": "1"])
+        fileAllows.enabled = true
+        _ = fileAllows.addServer(name: "", address: "relay.example.com")
+        check(!fileAllows.environment().keys.contains("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"), "env.txt's own consent is left to the file")
+
+        // a fixed server is tested and shared exactly as the host gets it
+        let rawFixed = model(["DM_LDNR_SERVER": "ldnr://relay.example.com/"])
+        check(rawFixed.selectedServer == nil && rawFixed.invite() == nil,
+              "a fixed address the host would not read as written is neither tested nor shared")
+
+        // 2. an invite carries the fixed server and the fixed password
+        let fixedBoth = model(["DM_LDNR_SERVER": "env.example.com:9", "DM_LDNR_ROOM_PASSWORD": "filepw"])
+        fixedBoth.password = "typed"
+        check(fixedBoth.invite() == OnlineInvite(server: "env.example.com:9", password: "filepw", name: ""),
+              "an invite carries the fixed server and the fixed password")
+
+        let fixedAll = model(["DM_LDNR": "0", "DM_LDNR_SERVER": "x.example.com", "DM_LDNR_NAME": "N",
+                              "DM_LDNR_ROOM_PASSWORD": "p", "DM_LDNR_ALLOW_PLAINTEXT_PASSWORD": "1"])
+        fixedAll.enabled = true
+        _ = fixedAll.addServer(name: "", address: "relay.example.com")
+        check(fixedAll.environment().isEmpty, "a fixed DM_LDNR leaves the whole environment to the file")
+        check(fixedAll.fixedKeys.count == 5 && fixedAll.fixedValue("DM_LDNR") == "0", "every fixed variable is listed with its value")
+
+        let fixedServer = model(["DM_LDNR_SERVER": "env.example.com:9"])
+        fixedServer.enabled = true
+        _ = fixedServer.addServer(name: "", address: "relay.example.com")
+        let envFixed = fixedServer.environment()
+        check(envFixed["DM_LDNR_SERVER"] == nil && !envFixed.keys.contains("DM_LDNR_SERVER"), "a fixed server is left out of the environment")
+        check(envFixed["DM_LDNR"]! == "1" && envFixed.count == 4, "the other variables are still written")
+
+        let fixedName = model(["DM_LDNR_NAME": "From File"])
+        fixedName.enabled = true
+        _ = fixedName.addServer(name: "", address: "relay.example.com")
+        fixedName.playerName = "Typed"
+        check(!fixedName.environment().keys.contains("DM_LDNR_NAME") && fixedName.fixedValue("DM_LDNR_NAME") == "From File",
+              "a fixed player name is kept")
+    }
