+    // MARK: the server list
+
+    static func model(_ environment: [String: String] = [:]) -> OnlinePlayModel {
+        let name = suite()
+        let d = UserDefaults(suiteName: name)!
+        d.removePersistentDomain(forName: name)   // a fresh suite: nothing saved
+        return OnlinePlayModel(game: d, shared: d, environment: environment, defaultName: "iPhone")
+    }
