+// The Online play section of the game launchers (docs/LDN-SETTINGS.md): the toggle, the server menu and its add/edit sheet, Test connection, the player name,
+// the room password with its plaintext consent, and Copy/Paste invite. It is placed inside the iOS launcher's List and the Mac window's Form as Sections;
+// the model (OnlinePlay.swift) does the rest. Values fixed by an env file or the launch environment are shown and locked.
+import Combine
+import Foundation
+import SwiftUI
+#if os(iOS)
+import UIKit
+#elseif os(macOS)
+import AppKit
+#endif
+
+/// The view's state: the model and the connection test, which runs off the main thread and is dropped when the chosen server changes under it.
+final class OnlinePlayState: ObservableObject {
+    let model: OnlinePlayModel
+    @Published var enabled: Bool
+    @Published var servers: [RelayServer]
+    @Published var selected: String
+    @Published var playerName: String
+    @Published var password: String
+    @Published var consent: Bool
+    @Published var probe: ProbeResult?
+    @Published var testing = false
+
+    private var probeToken = 0
+
+    init(_ model: OnlinePlayModel) {
+        self.model = model
+        self.enabled = model.enabled
+        self.servers = model.servers
+        self.selected = model.selected
+        self.playerName = model.playerName
+        self.password = model.password
+        self.consent = model.plaintextConsent
+    }
+
+    func setEnabled(_ v: Bool) {
+        enabled = v
+        model.enabled = v
+        resetProbe()
+    }
+    func setSelected(_ v: String) {
+        selected = v
+        model.selected = v
+        resetProbe()
+    }
+    func setPlayerName(_ v: String) {
+        playerName = v
+        model.playerName = v
+    }
+    func setPassword(_ v: String) {
+        password = v
+        model.password = v
+        consent = model.plaintextConsent
+    }
+    func setConsent(_ v: Bool) {
+        consent = v
+        model.plaintextConsent = v
+    }
+
+    @discardableResult
+    func addServer(name: String, address: String) -> RelayAddressError? {
+        let error = model.addServer(name: name, address: address)
+        servers = model.servers
+        selected = model.selected
+        if error == nil { resetProbe() }
+        return error
+    }
+
+    @discardableResult
+    func updateServer(old: String, name: String, address: String) -> RelayAddressError? {
+        let error = model.updateServer(old: old, name: name, address: address)
+        servers = model.servers
+        selected = model.selected
+        if error == nil { resetProbe() }
+        return error
+    }
+
+    func removeServer(address: String) {
+        model.removeServer(address: address)
+        servers = model.servers
+        selected = model.selected
+        resetProbe()
+    }
+
+    @discardableResult
+    func applyInvite(_ invite: OnlineInvite) -> Bool {
+        guard model.applyInvite(invite) else { return false }
+        servers = model.servers
+        selected = model.selected
+        password = model.password
+        consent = model.plaintextConsent
+        resetProbe()
+        return true
+    }
+
+    var invite: OnlineInvite? { model.invite() }
+
+    /// Test connection: a background queue does the blocking socket work, the result comes back on the main thread. A test that a newer one replaced is dropped.
+    func test() {
+        guard let server = model.selectedServer else { return }
+        probeToken += 1
+        let token = probeToken
+        let address = server.address
+        probe = nil
+        testing = true
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let result = RelayProbe.run(address: address)
+            DispatchQueue.main.async {
+                guard let self = self, token == self.probeToken else { return }
+                self.testing = false
+                self.probe = result
+            }
+        }
+    }
+
+    private func resetProbe() {
+        probeToken += 1
+        testing = false
+        probe = nil
+    }
+
+    static var deviceName: String {
+        #if os(iOS)
+        return UIDevice.current.name
+        #elseif os(macOS)
+        return Host.current().localizedName ?? ProcessInfo.processInfo.hostName
+        #else
+        return ProcessInfo.processInfo.hostName
+        #endif
+    }
+}
+
+/// The Online play section of docs/LDN-SETTINGS.md, items 1 to 7.
+struct OnlinePlaySection: View {
+    @ObservedObject var state: OnlinePlayState
+    @State private var sheet: ServerSheet?
+    @State private var note = ""
+
+    /// nil stops the add/edit sheet. `old` is the address the entry had before an edit.
+    private struct ServerSheet: Identifiable {
+        let id = UUID()
+        var old: String?
+        var name: String
+        var address: String
+    }
+
+    private var fixedLDN: String? { state.model.fixedValue("DM_LDNR") }
+    private var fixedServer: String? { state.model.fixedValue("DM_LDNR_SERVER") }
+    private var fixedName: String? { state.model.fixedValue("DM_LDNR_NAME") }
+    private var fixedPassword: String? { state.model.fixedValue("DM_LDNR_ROOM_PASSWORD") }
+    private var fixedConsent: String? { state.model.fixedValue("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD") }
+
+    var body: some View {
+        Section {
+            if let fixedLDN = fixedLDN {
+                LabeledContent(OnlineText.t("Online play", "联机游戏")) {
+                    Text(fixedLDN == "1" ? OnlineText.t("On (env.txt)", "开（env.txt）") : OnlineText.t("Off (env.txt)", "关（env.txt）"))
+                        .foregroundStyle(.secondary)
+                }
+            } else {
+                Toggle(OnlineText.t("Online play", "联机游戏"), isOn: Binding(get: { state.enabled }, set: state.setEnabled))
+            }
+            if fixedLDN == nil && state.enabled {
+                serverRows
+                testRow
+                nameRow
+                passwordRows
+                inviteRows
+            }
+        } footer: {
+            VStack(alignment: .leading, spacing: 8) {
+                if fixedLDN != nil {
+                    Text(OnlineText.t("Online play is set by env.txt. Remove the DM_LDNR lines there to choose it here.",
+                                      "联机游戏由 env.txt 设置。删除其中的 DM_LDNR 行即可在这里选择。"))
+                } else {
+                    Text(OnlineText.t("Local wireless play reaches friends over the internet through a relay server. Everyone picks the same server, and the same room password when one is set.",
+                                      "本地联机通过中继服务器，让朋友之间经互联网连接。每个人选择同一个服务器，设置了房间密码时还要用同一个密码。"))
+                }
+                // 7. the status line during play
+                Text(OnlineText.t("Status during play is in the game's log (lines starting with ldnr).",
+                                  "游戏过程中的状态记录在游戏日志中（以 ldnr 开头的行）。"))
+            }
+        }
+    }
+
+    // 2. Server: the menu of saved servers, Add server…, and Edit and Remove for the chosen one. The sheet sits on this one row, not on the
+    // Section: SwiftUI hands a Section's modifiers to every row, and one tap then presents a sheet per row (the same trap as the document picker).
+    @ViewBuilder private var serverRows: some View {
+        if let fixedServer = fixedServer {
+            LabeledContent(OnlineText.t("Server", "服务器")) {
+                Text("\(fixedServer) \(OnlineText.t("(env.txt)", "(env.txt)"))")   // as the host gets it
+                    .foregroundStyle(.secondary).lineLimit(1).truncationMode(.middle)
+            }
+        } else {
+            Picker(selection: Binding(get: { state.selected }, set: state.setSelected)) {
+                Text(OnlineText.t("None", "无")).tag("")
+                ForEach(state.servers) { server in
+                    Text(server.name.isEmpty ? server.address : "\(server.name) — \(server.address)").tag(server.address)
+                }
+            } label: {
+                Text(OnlineText.t("Server", "服务器"))
+            }
+            .pickerStyle(.menu)
+            HStack {
+                Button(OnlineText.t("Add server…", "添加服务器…")) {
+                    sheet = ServerSheet(old: nil, name: "", address: "")
+                }
+                Spacer()
+                if let chosen = state.servers.first(where: { $0.address == state.selected }) {
+                    Button(OnlineText.t("Edit", "编辑")) {
+                        sheet = ServerSheet(old: chosen.address, name: chosen.name, address: chosen.address)
+                    }
+                    Button(OnlineText.t("Remove", "移除"), role: .destructive) {
+                        state.removeServer(address: chosen.address)
+                    }
+                }
+            }
+            .buttonStyle(.borderless)   // two buttons in one List row: without it a tap on the row fires both (iOS)
+            .sheet(item: $sheet) { s in
+                ServerEditor(state: state, original: s.old, name: s.name, address: s.address, isNew: s.old == nil)
+            }
+            if state.model.readiness == .noServer {
+                Text(OnlineText.t("Choose a server to play online", "请选择一个服务器以便联机"))
