+    private func paste() {
+        guard let text = clipboard(), let invite = OnlineInvite.parse(text) else {
+            note = OnlineText.t("The clipboard has no invite", "剪贴板中没有邀请")
+            return
+        }
+        if !state.applyInvite(invite) {
+            // nil means the environment keeps the server (or online play itself), so the invite cannot change it
+            note = OnlineText.t("This invite is for another server, set by env.txt",
+                                "此邀请属于另一个服务器（由 env.txt 设置）")
+            return
+        }
+        note = OnlineText.t("Invite read.", "已读取邀请。")
+    }
+
+    private func summary(_ result: ProbeResult) -> String {
+        switch result.kind {
+        case .ok:
+            var parts = [OnlineText.t("Connected", "已连接")]
+            if let ms = result.latencyMs { parts.append("\(ms) ms") }
+            if let v = result.protocolVersion { parts.append(OnlineText.t("protocol \(v)", "协议 \(v)")) }
+            if let name = result.serverName, !name.isEmpty { parts.append(name) }
+            return parts.joined(separator: " · ")
+        case .unreachable:
+            return OnlineText.t("Not reachable: \(result.detail)", "无法连接：\(result.detail)")
+        case .notRelay:
+            return OnlineText.t("This is not an LDN relay server", "这不是 LDN 中继服务器")
+        case .oldProtocol:
+            return OnlineText.t("The server speaks an older protocol", "服务器使用的是较旧的协议")
+        }
+    }
+
+    private func color(_ result: ProbeResult) -> Color {
+        switch result.kind {
+        case .ok: return .green
+        case .unreachable: return .red
+        case .notRelay, .oldProtocol: return .orange
+        }
+    }
+
+    // MARK: the clipboard
+
+    private func setClipboard(_ text: String) {
+        #if os(iOS)
+        UIPasteboard.general.string = text
+        #elseif os(macOS)
+        let pasteboard = NSPasteboard.general
+        pasteboard.clearContents()
+        pasteboard.setString(text, forType: .string)
+        #endif
+    }
+
+    private func clipboard() -> String? {
+        #if os(iOS)
+        return UIPasteboard.general.string
+        #elseif os(macOS)
+        return NSPasteboard.general.string(forType: .string)
+        #endif
+    }
+}
