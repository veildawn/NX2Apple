index 0000000..9fbbe05
--- /dev/null
+++ b/dm/ios/Sources/OnlinePlay.swift
@@ -0,0 +1,682 @@
+// Online play: the LDN relay settings the game launchers collect and write into the environment the host reads (docs/LDN-SETTINGS.md). Foundation only
+// (POSIX sockets for the connection test come from Darwin or Glibc), so the same file builds for the iPhone app, for the Mac launcher and for the regression
+// tests. The host still reads only the DM_LDNR* variables: nothing here changes the relay client.
+import Foundation
+#if canImport(Darwin)
+import Darwin
+#else
+import Glibc
+#endif
+
+// SOCK_STREAM is an enum on Linux and an Int32 constant on Darwin; the socket calls want the number.
+#if canImport(Darwin)
+let dmStreamSocket: Int32 = SOCK_STREAM
+#else
+let dmStreamSocket: Int32 = Int32(SOCK_STREAM.rawValue)
+#endif
+
+/// The strings of the section, in the system language: English, or Simplified Chinese when the system asks for it. Tests pin the choice.
+enum OnlineText {
+    static var chineseOverride: Bool?
+    static var chinese: Bool {
+        if let o = chineseOverride { return o }
+        return Locale.preferredLanguages.first?.hasPrefix("zh") ?? false
+    }
+    static func t(_ en: String, _ zh: String) -> String { chinese ? zh : en }
+}
+
+enum RelayAddressError: Error, Equatable {
+    case empty, invalidCharacters, badPort, badBrackets, tooLong
+
+    var message: String {
+        switch self {
+        case .empty: return OnlineText.t("Enter a server address", "请输入服务器地址")
+        case .invalidCharacters: return OnlineText.t("An address has no spaces, /, @, ? or #", "地址中不能有空格、/、@、? 或 #")
+        case .badPort: return OnlineText.t("The port must be a number from 1 to 65535", "端口必须是 1 到 65535 之间的数字")
+        case .badBrackets: return OnlineText.t("Brackets hold an IPv6 address, for example [::1]:11470", "方括号内是 IPv6 地址，例如 [::1]:11470")
+        case .tooLong: return OnlineText.t("The address is too long", "地址太长")
+        }
+    }
+}
+
+/// One saved relay server: its display name (may be empty) and the address the client is given.
+struct RelayServer: Codable, Equatable, Identifiable {
+    var name: String
+    var address: String
+    var id: String { address }
+}
+
+/// The relay address rules of the client (`ldnr_tcp_split`, dm/host/ldnr/ldnr_tcp.c): `host`, `host:port`, `[IPv6]`, `[IPv6]:port`, or a bare IPv6 literal.
+/// The port defaults to 11470 when it is missing.
+enum RelayAddress {
+    static let defaultPort: UInt16 = 11470
+    static let maxHostBytes = 253
+
+    /// What the field shows and what is stored: trimmed, without a pasted `ldnr://` prefix and without one trailing `/`.
+    static func normalize(_ s: String) -> String {
+        var out = s.trimmingCharacters(in: .whitespacesAndNewlines)
+        if out.lowercased().hasPrefix("ldnr://") { out = String(out.dropFirst("ldnr://".count)) }
+        if out.hasSuffix("/") { out.removeLast() }
+        return out
+    }
+
+    /// nil when the address can be used. The rules are the client's, so an address the field accepts is one the host can split.
+    static func validate(_ s: String) -> RelayAddressError? {
+        let text = normalize(s)
+        if text.isEmpty { return .empty }
+        if text.contains(where: { $0.isWhitespace || "/@?#".contains($0) }) { return .invalidCharacters }
+        if text.hasPrefix("[") {
+            guard let close = text.firstIndex(of: "]") else { return .badBrackets }
+            let host = text[text.index(after: text.startIndex)..<close]
+            let rest = text[text.index(after: close)...]
+            guard !host.isEmpty, host.allSatisfy({ $0.isHexDigit || $0 == ":" || $0 == "." }) else { return .badBrackets }
+            guard host.utf8.count <= maxHostBytes else { return .tooLong }
+            if rest.isEmpty { return nil }
+            guard rest.hasPrefix(":") else { return .badBrackets }
+            return port(rest.dropFirst()) == nil ? .badPort : nil
+        }
+        let colons = text.reduce(into: 0) { if $1 == ":" { $0 += 1 } }
+        if colons >= 2 { return text.utf8.count <= maxHostBytes ? nil : .tooLong }   // a bare IPv6 literal, no port
+        if colons == 1 {
+            let parts = text.split(separator: ":", omittingEmptySubsequences: false)
+            let host = parts[0]
+            if host.isEmpty { return .empty }
+            guard host.utf8.count <= maxHostBytes else { return .tooLong }
+            return port(parts[1]) == nil ? .badPort : nil
+        }
+        return text.utf8.count <= maxHostBytes ? nil : .tooLong
+    }
+
+    /// The host and port the connection test connects to, with the client's default port when the address has none.
+    static func split(_ s: String) -> (host: String, port: UInt16)? {
+        guard validate(s) == nil else { return nil }
+        let text = normalize(s)
+        if text.hasPrefix("[") {
+            let close = text.firstIndex(of: "]")!
+            let host = String(text[text.index(after: text.startIndex)..<close])
+            let rest = text[text.index(after: close)...]
+            return (host, rest.hasPrefix(":") ? (port(rest.dropFirst()) ?? defaultPort) : defaultPort)
+        }
+        let colons = text.reduce(into: 0) { if $1 == ":" { $0 += 1 } }
+        if colons >= 2 { return (text, defaultPort) }
+        if colons == 1 {
+            let parts = text.split(separator: ":", omittingEmptySubsequences: false)
+            return (String(parts[0]), port(parts[1]) ?? defaultPort)
+        }
+        return (text, defaultPort)
+    }
+
+    private static func port(_ s: Substring) -> UInt16? {
+        guard !s.isEmpty, s.allSatisfy({ $0.isASCII && $0.isNumber }), let n = UInt16(s), n >= 1 else { return nil }
+        return n
+    }
+}
+
+/// The first `max` bytes of a string, cut at a character boundary and never inside one.
+private func cutToBytes(_ s: String, _ max: Int) -> String {
+    var out = ""
+    var used = 0
+    for c in s {
+        let n = String(c).utf8.count
+        if used + n > max { break }
+        out.append(c)
+        used += n
+    }
+    return out
+}
+
+/// The player name: the host's 32-byte field, cut at a character boundary and never inside one.
+enum PlayerName {
+    static let maxBytes = 32
+
+    /// What the field holds while it is typed: cut at the field's bytes, never trimmed, so a space stays where it was typed.
+    static func limit(_ s: String) -> String { cutToBytes(s, maxBytes) }
+
+    /// What is handed to the host: trimmed, then cut. An empty name falls back to the device name.
+    static func clamp(_ s: String) -> String { limit(s.trimmingCharacters(in: .whitespacesAndNewlines)) }
+
+    /// What is left of the field for what was typed: 0 once the name no longer fits.
+    static func bytesLeft(_ s: String) -> Int {
+        max(0, maxBytes - s.trimmingCharacters(in: .whitespacesAndNewlines).utf8.count)
+    }
+}
+
+/// The room password: the host's passphrase field (LDNR_NATIVE_PASSPHRASE_MAX in dm/host/ldnr/ldnr_native.h), cut at a character boundary.
+/// Whitespace is part of a password, so it is never trimmed.
+enum RoomPassword {
+    static let maxBytes = 64
+
+    static func clamp(_ s: String) -> String { cutToBytes(s, maxBytes) }
+
+    /// What is left of the field for what was typed: 0 once the password no longer fits.
+    static func bytesLeft(_ s: String) -> Int { max(0, maxBytes - s.utf8.count) }
+}
+
+/// An invite: the text one player sends another, and the `nx2apple-ldn://join` link inside it that carries the same fields.
+struct OnlineInvite: Equatable {
+    var server: String
+    var password: String
+    var name: String
+
+    /// The text Copy invite puts on the clipboard: two label lines and the link, so it reads in a chat and a client can pick the link out.
+    func text() -> String {
+        var lines = [OnlineText.t("Online play (LDN relay)", "联机游戏（LDN 中继）")]
+        let shown = name.isEmpty ? server : "\(name) (\(server))"
+        lines.append(OnlineText.t("Server", "服务器") + ": " + shown)
+        if !password.isEmpty { lines.append(OnlineText.t("Room password", "房间密码") + ": " + password) }
+        lines.append(link())
+        return lines.joined(separator: "\n")
+    }
+
+    /// The link: the server, and the password and name only when they are set. URLComponents percent-encodes the values (a password may hold `&=?#`).
+    func link() -> String {
+        var components = URLComponents()
+        components.scheme = "nx2apple-ldn"
+        components.host = "join"
+        var items = [URLQueryItem(name: "server", value: server)]
+        if !password.isEmpty { items.append(URLQueryItem(name: "password", value: password)) }
+        if !name.isEmpty { items.append(URLQueryItem(name: "name", value: name)) }
+        components.queryItems = items
+        return components.url?.absoluteString ?? "nx2apple-ldn://join?server=\(server)"
+    }
+
+    /// The first `nx2apple-ldn://join` link anywhere in a pasted text (a chat line, a note, the copied invite itself). nil when there is none or its server is invalid.
+    static func parse(_ text: String) -> OnlineInvite? {
+        let marker = "nx2apple-ldn://join"
+        guard let found = text.range(of: marker, options: [.caseInsensitive]) else { return nil }
+        let link = String(text[found.lowerBound...].prefix { !$0.isWhitespace })
+        guard let components = URLComponents(string: link), let items = components.queryItems,
+              let server = items.first(where: { $0.name == "server" })?.value else { return nil }
+        let address = RelayAddress.normalize(server)
+        guard RelayAddress.validate(address) == nil else { return nil }
+        return OnlineInvite(server: address,
+                            password: items.first { $0.name == "password" }?.value ?? "",
+                            name: items.first { $0.name == "name" }?.value ?? "")
+    }
+}
+
+/// The settings model: the keys, the server list, the invite and the environment Play writes. No SwiftUI, so the tests build it on any platform.
+final class OnlinePlayModel {
+    private enum Keys {
+        static let enabled = "online.enabled"
+        static let servers = "online.servers"
+        static let selected = "online.server"
+        static let name = "online.name"
+        static let password = "online.password"
+        static let consent = "online.plaintextConsent"
+        static let ldn = "DM_LDNR"
+        static let server = "DM_LDNR_SERVER"
+        static let ldnName = "DM_LDNR_NAME"
+        static let roomPassword = "DM_LDNR_ROOM_PASSWORD"
+        static let allowPlaintext = "DM_LDNR_ALLOW_PLAINTEXT_PASSWORD"
+        /// Every variable this section owns, in the order the log lists them.
+        static let all = [ldn, server, ldnName, roomPassword, allowPlaintext]
+    }
+
+    let game: UserDefaults      // this game's app: whether it plays online
+    let shared: UserDefaults    // the servers, the chosen one, the name, the password (on the Mac every game app: com.nx2apple.online)
+    let launchEnvironment: [String: String]
+    let defaultName: String     // the device name an empty player name falls back to
+    let fixedKeys: Set<String>  // the DM_LDNR* variables an env file or the launch environment set: shown, never replaced
+
+    var enabled: Bool { didSet { game.set(enabled, forKey: Keys.enabled) } }
+    var playerName: String { didSet { shared.set(playerName, forKey: Keys.name) } }
+    var password: String {
+        didSet {
+            shared.set(password, forKey: Keys.password)
+            if password != oldValue { plaintextConsent = false }   // a new password is not the one that was allowed
+        }
+    }
+    var plaintextConsent: Bool { didSet { shared.set(plaintextConsent, forKey: Keys.consent) } }
+    var servers: [RelayServer] { didSet { storeServers() } }
+    var selected: String { didSet { shared.set(selected, forKey: Keys.selected) } }
+
+    init(game: UserDefaults, shared: UserDefaults, environment: [String: String] = ProcessInfo.processInfo.environment, defaultName: String) {
+        self.game = game
+        self.shared = shared
+        self.launchEnvironment = environment
+        self.defaultName = defaultName
+        self.fixedKeys = Set(Keys.all.filter { environment[$0] != nil })
+        self.enabled = game.bool(forKey: Keys.enabled)
+        self.playerName = shared.string(forKey: Keys.name) ?? ""
+        self.password = shared.string(forKey: Keys.password) ?? ""
+        self.plaintextConsent = shared.bool(forKey: Keys.consent)
+        self.servers = Self.loadServers(shared)
+        self.selected = shared.string(forKey: Keys.selected) ?? ""
+    }
+
+    /// The model a launcher uses: this game's preferences, and on the Mac the shared `com.nx2apple.online` suite the game apps read together.
+    /// The environment is the one the process started with (launchEnvironmentSnapshot), not the one Play writes.
+    static func standard(defaultName: String) -> OnlinePlayModel {
+        #if os(macOS)
+        let shared = UserDefaults(suiteName: "com.nx2apple.online") ?? .standard
+        #else
+        let shared = UserDefaults.standard
+        #endif
+        return OnlinePlayModel(game: .standard, shared: shared, environment: launchEnvironmentSnapshot, defaultName: defaultName)
+    }
+
+    /// The environment this process started with, read once the first time a launcher makes a model. A launcher shown again in the same process
+    /// (the game data was not there yet) must not take the DM_LDNR* values its own apply() wrote for an env file's.
+    static let launchEnvironmentSnapshot: [String: String] = ProcessInfo.processInfo.environment
+
+    /// The value an env file or the launch environment set for one of this section's variables, or nil when it is the player's to choose.
+    func fixedValue(_ key: String) -> String? {
+        fixedKeys.contains(key) ? launchEnvironment[key] ?? "" : nil
+    }
+
+    /// The plaintext consent that counts: an env file's DM_LDNR_ALLOW_PLAINTEXT_PASSWORD decides, else the toggle.
+    var effectiveConsent: Bool {
+        if let fixed = fixedValue(Keys.allowPlaintext) { return fixed == "1" }
+        return plaintextConsent
+    }
+
+    /// The room password that counts: the env file's when it fixes one (which may be empty), else the field's.
+    var effectivePassword: String { fixedValue(Keys.roomPassword) ?? password }
+
+    // MARK: servers
+
+    /// Adds a server (or updates the name of one that is already saved under this address) and chooses it.
+    @discardableResult
+    func addServer(name: String, address: String) -> RelayAddressError? {
+        let normalized = RelayAddress.normalize(address)
+        if let error = RelayAddress.validate(normalized) { return error }
+        let label = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        if let i = servers.firstIndex(where: { $0.address == normalized }) {
+            servers[i].name = label
+        } else {
+            servers.append(RelayServer(name: label, address: normalized))
+        }
+        selected = normalized
+        return nil
+    }
+
+    /// Rewrites one saved server. An address another entry already holds wins over that entry, so the list keeps one entry per address.
+    @discardableResult
+    func updateServer(old: String, name: String, address: String) -> RelayAddressError? {
+        let normalized = RelayAddress.normalize(address)
+        if let error = RelayAddress.validate(normalized) { return error }
+        guard servers.contains(where: { $0.address == old }) else { return addServer(name: name, address: address) }
+        let keepsSelection = selected == old
+        if let other = servers.firstIndex(where: { $0.address == normalized && $0.address != old }) { servers.remove(at: other) }
+        if let i = servers.firstIndex(where: { $0.address == old }) {
+            servers[i] = RelayServer(name: name.trimmingCharacters(in: .whitespacesAndNewlines), address: normalized)
+        }
+        if keepsSelection { selected = normalized }
+        return nil
+    }
+
+    func removeServer(address: String) {
+        servers.removeAll { $0.address == address }
+        if selected == address { selected = servers.first?.address ?? "" }
+    }
+
+    /// The chosen server: the one the environment fixes, else the saved choice, else a valid address that is no longer in the list.
+    var selectedServer: RelayServer? {
+        if let fixed = fixedValue(Keys.server) {   // the environment's address is the one the host will use: show it, and nothing else
+            // exactly the string the host gets: a value the host would not read as written (an ldnr:// prefix, a trailing /) is not tested or shared
+            return RelayAddress.validate(fixed) == nil && RelayAddress.normalize(fixed) == fixed ? RelayServer(name: "", address: fixed) : nil
+        }
+        if let saved = servers.first(where: { $0.address == selected }) { return saved }
+        guard !selected.isEmpty, RelayAddress.validate(selected) == nil else { return nil }
+        return RelayServer(name: "", address: selected)
+    }
+
+    // MARK: invite
+
+    /// Adds and chooses the invite's server, and fills in its room password, which asks again for the plaintext consent. Online play itself is left as it is.
+    /// A rejected invite returns false and changes nothing: DM_LDNR is fixed by the environment, the invite is for another server than a fixed
+    /// DM_LDNR_SERVER, or it has no valid server at all. A fixed DM_LDNR_ROOM_PASSWORD is kept as it is, so only the server part of the invite is used.
+    @discardableResult
+    func applyInvite(_ invite: OnlineInvite) -> Bool {
+        guard !fixedKeys.contains(Keys.ldn) else { return false }
+        guard RelayAddress.validate(invite.server) == nil else { return false }
+        let normalized = RelayAddress.normalize(invite.server)
+        if let fixed = fixedValue(Keys.server), RelayAddress.normalize(fixed) != normalized { return false }
+        if servers.contains(where: { $0.address == normalized }) {
+            selected = normalized   // a server already saved keeps the name its player gave it
+        } else {
+            addServer(name: invite.name, address: normalized)
+        }
+        if fixedKeys.contains(Keys.roomPassword) { return true }   // the password stays the file's, and with it the consent
+        password = RoomPassword.clamp(invite.password)   // set after the server: a new password is not the one that was allowed
+        plaintextConsent = false
+        return true
+    }
+
+    func invite() -> OnlineInvite? {
+        guard let server = selectedServer else { return nil }
+        return OnlineInvite(server: server.address, password: effectivePassword, name: server.name)
+    }
+
+    // MARK: what Play writes
+
+    enum Readiness: Equatable { case off, noServer, needsConsent, ready }
+
+    var readiness: Readiness {
+        if !enabled { return .off }
+        guard selectedServer != nil else { return .noServer }
+        // a password the environment fixes is the file's to allow: the toggle cannot consent for it
+        if fixedValue(Keys.roomPassword) == nil && !password.isEmpty && !effectiveConsent { return .needsConsent }
+        return .ready
+    }
+
+    /// The environment Play writes, as a value per variable (nil to unset it), so the rules can be tested without touching the process. A variable an env
+    /// file set is left out: the environment wins. With DM_LDNR fixed the whole environment is the file's, and nothing is returned. When the password waits
+    /// for its consent every variable that is not fixed is unset: online play does not start, and the password is never written without the consent.
+    func environment() -> [String: String?] {
+        if fixedKeys.contains(Keys.ldn) { return [:] }
+        var out: [String: String?] = [:]
+        // updateValue, not the subscript: a subscript assignment of nil removes the key, and a key that must be unset has to be listed
+        func put(_ key: String, _ value: String?) {
+            guard !fixedKeys.contains(key) else { return }
+            out.updateValue(value, forKey: key)
+        }
+        guard readiness == .ready, let server = selectedServer else {
+            for key in Keys.all { put(key, nil) }   // DM_LDNR unset is off, and the host then uses its defaults
+            return out
+        }
+        put(Keys.ldn, "1")
+        put(Keys.server, server.address)
+        let name = PlayerName.clamp(playerName.isEmpty ? defaultName : playerName)
+        put(Keys.ldnName, name.isEmpty ? nil : name)
+        let password = effectivePassword
+        put(Keys.roomPassword, password.isEmpty ? nil : password)
+        // the toggle consents only for the field's password: a password env.txt fixes is sent only when env.txt allows it too
+        put(Keys.allowPlaintext, fixedValue(Keys.roomPassword) == nil && !password.isEmpty && effectiveConsent ? "1" : nil)
+        return out
+    }
+
+    /// Puts the settings into this process's environment, which the host inherits. The room password is never logged.
+    func apply() {
+        if fixedKeys.contains(Keys.ldn) { fputs("launcher: online play kept from env.txt\n", stderr); return }
+        if !enabled { fputs("launcher: online play off\n", stderr) }
+        if readiness == .needsConsent { fputs("launcher: online play waits for the password consent\n", stderr) }
+        for (key, value) in environment().sorted(by: { $0.key < $1.key }) {
+            if let value {
+                setenv(key, value, 1)
+                fputs("launcher: online \(key)=\(key == Keys.roomPassword ? "<set>" : value)\n", stderr)
+            } else {
+                unsetenv(key)
+                fputs("launcher: online \(key) unset\n", stderr)
+            }
+        }
+    }
+
+    private func storeServers() {
+        guard let data = try? JSONEncoder().encode(servers) else { return }
+        shared.set(data, forKey: Keys.servers)
+    }
+
+    private static func loadServers(_ shared: UserDefaults) -> [RelayServer] {
+        if let data = shared.data(forKey: Keys.servers), let list = try? JSONDecoder().decode([RelayServer].self, from: data) { return list }
+        if let text = shared.string(forKey: Keys.servers), let data = text.data(using: .utf8),
+           let list = try? JSONDecoder().decode([RelayServer].self, from: data) { return list }
+        return []
+    }
+}
+
+/// The result of Test connection: what the server answered, and how long the round trip took.
+struct ProbeResult: Equatable {
+    enum Kind: Equatable { case ok, unreachable, notRelay, oldProtocol }
+    var kind: Kind
+    var latencyMs: Int?
+    var protocolVersion: String?   // "1.2"
+    var serverName: String?
+    var detail: String             // a short reason, for a failure
+}
+
+/// The connection test: HELLO, HELLO_ACK, one PING, one PONG (docs/PROTOCOL.md 1, 3.1, 3.2, 3.3). It sends no password and no game data.
+enum RelayProbe {
+    static let maxPayload = 65536
+    static let version = 1
+
+    /// HELLO: major 1 only, minor 2, no capability bits, this launcher's name.
+    /// The capabilities the game's relay client asks for (LDNR_WIRE_CAPS in dm/host/ldnr/ldnr_protocol.c) and the ones it cannot play without.
+    /// The server answers the AND of both sides, so the test asks for the same set and checks the same bits as the game.
+    static let clientCapabilities: UInt32 = 0x1F
+    static let requiredCapabilities: UInt32 = 0x1E
+
+    static func helloFrame(requestID: UInt32) -> [UInt8] {
+        var payload: [UInt8] = [1, 1, 2]
+        append(&payload, clientCapabilities)
+        append(&payload, "NX2Apple launcher")
+        append(&payload, "1")
+        return frame(type: 0x01, requestID: requestID, payload: payload)
+    }
+
+    /// PING: the sender's unix time in milliseconds; the server echoes it in PONG.
+    static func pingFrame(major: UInt8, requestID: UInt32, timestampMs: UInt64) -> [UInt8] {
+        var payload: [UInt8] = []
+        append(&payload, timestampMs)
+        return frame(type: 0x03, requestID: requestID, payload: payload)
+    }
+
+    /// One frame of the stream, or nil while it is incomplete. `consumed` is how many bytes the frame took.
+    static func parseFrame(_ bytes: [UInt8]) -> (type: UInt8, version: UInt8, requestID: UInt32, payload: [UInt8], consumed: Int)? {
+        guard bytes.count >= 16, hasMagic(bytes) else { return nil }
+        let length = Int(u32(bytes, 8))
+        guard bytes.count >= 16 + length else { return nil }
+        return (bytes[5], bytes[4], u32(bytes, 12), Array(bytes[16..<(16 + length)]), 16 + length)
+    }
+
+    static func hasMagic(_ bytes: [UInt8]) -> Bool {
+        bytes.count >= 4 && bytes[0] == 0x4C && bytes[1] == 0x44 && bytes[2] == 0x4E && bytes[3] == 0x52
+    }
+
+    /// HELLO_ACK's major, minor and server name. A payload too short for its own fields is malformed.
+    /// major, minor, the server's major range and the capabilities come first (8 bytes), then the 16-byte conn_id (docs/PROTOCOL.md 3.1).
+    static func parseHelloAck(_ payload: [UInt8]) -> (major: UInt8, minor: UInt8, capabilities: UInt32, serverName: String)? {
+        guard payload.count >= 34 else { return nil }   // through max_frame and keepalive, after an empty name
+        let length = Int(u16(payload, 24))
+        guard payload.count >= 26 + length + 8 else { return nil }
+        return (payload[0], payload[1], u32(payload, 4), String(decoding: payload[26..<(26 + length)], as: UTF8.self))
+    }
+
+    /// Connects, shakes hands and times one PING. Never throws: every failure is an unreachable result with a short reason.
+    static func run(address: String, timeout: TimeInterval = 5) -> ProbeResult {
+        guard let parts = RelayAddress.split(address) else {
+            return failure(.unreachable, RelayAddress.validate(address)?.message ?? "invalid address")
+        }
+        let deadline = monotonicMs() + Int64(max(0.05, timeout) * 1000)
+        var hints = addrinfo()
+        hints.ai_family = AF_UNSPEC
+        hints.ai_socktype = dmStreamSocket
+        hints.ai_protocol = Int32(IPPROTO_TCP)
+        var list: UnsafeMutablePointer<addrinfo>?
+        let gai = parts.host.withCString { host in String(parts.port).withCString { port in getaddrinfo(host, port, &hints, &list) } }
+        guard gai == 0, let first = list else {
+            let detail = gai == 0 ? "name not found" : String(cString: gai_strerror(gai))
+            return failure(.unreachable, detail)
+        }
+        defer { freeaddrinfo(first) }
+        // A name can answer with several addresses (IPv6 and IPv4): the first one that connects is the relay's.
+        var saved: Int32 = 0
+        var ranOut = false
+        var at: UnsafeMutablePointer<addrinfo>? = first
+        while let address = at {
+            defer { at = address.pointee.ai_next }
+            if monotonicMs() >= deadline { ranOut = true; break }
+            let result = attempt(address, deadline: deadline, saved: &saved, ranOut: &ranOut)
+            if let result { return result }
+        }
+        return failure(.unreachable, ranOut ? "timed out" : describe(saved))
+    }
+
+    /// One address of the name: its handshake result, or nil when the address did not connect and the next one is worth a try.
+    private static func attempt(_ address: UnsafeMutablePointer<addrinfo>, deadline: Int64, saved: inout Int32, ranOut: inout Bool) -> ProbeResult? {
+        let fd = socket(address.pointee.ai_family, address.pointee.ai_socktype, address.pointee.ai_protocol)
+        if fd < 0 { saved = errno; return nil }
+        defer { close(fd) }
+        let flags = fcntl(fd, F_GETFL, 0)
+        _ = fcntl(fd, F_SETFL, flags | O_NONBLOCK)   // the wait is poll's, so a connect and every read end at the deadline
+        if connect(fd, address.pointee.ai_addr, address.pointee.ai_addrlen) != 0 {
+            let error = errno
+            if error != EINPROGRESS && error != EINTR && error != EALREADY { saved = error; return nil }
+            if !wait(fd, POLLOUT, deadline) { ranOut = true; return nil }
+            var soError: Int32 = 0
+            var size = socklen_t(MemoryLayout<Int32>.size)
+            if getsockopt(fd, SOL_SOCKET, SO_ERROR, &soError, &size) < 0 { saved = errno; return nil }
+            if soError != 0 { saved = soError; return nil }
+        }
+        #if canImport(Darwin)
+        var one: Int32 = 1
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout<Int32>.size))
+        #endif
+        return handshake(fd, deadline: deadline)
+    }
+
+    // MARK: the handshake
+
+    private static func handshake(_ fd: Int32, deadline: Int64) -> ProbeResult {
+        guard sendAll(fd, helloFrame(requestID: 1), deadline: deadline) else { return failure(.unreachable, "timed out") }
+        var buffer: [UInt8] = []
+        var serverName: String?
+        var version: String?
+        let pingID: UInt32 = 2
+        var pingSentAt: Int64 = 0
+        while monotonicMs() < deadline {
+            if buffer.count >= 16 {
+                if !hasMagic(buffer) { return failure(.notRelay, "bad frame") }
+                if u32(buffer, 8) > UInt32(maxPayload) { return failure(.notRelay, "oversized frame") }
+            }
+            if let frame = parseFrame(buffer) {
+                buffer.removeFirst(frame.consumed)
+                switch frame.type {
+                case 0x02:   // HELLO_ACK
+                    guard let ack = parseHelloAck(frame.payload) else { return failure(.notRelay, "bad HELLO_ACK") }
+                    if ack.minor < 2 { return failure(.oldProtocol, "protocol 1.\(ack.minor)") }
+                    if ack.capabilities & requiredCapabilities != requiredCapabilities {   // the game would refuse this relay at its handshake
+                        return failure(.oldProtocol, "missing features (capabilities 0x\(String(ack.capabilities, radix: 16)))")
+                    }
+                    serverName = ack.serverName
+                    version = "\(ack.major).\(ack.minor)"
+                    pingSentAt = monotonicMs()
+                    let stamp = UInt64(max(0, Date().timeIntervalSince1970) * 1000)
+                    guard sendAll(fd, pingFrame(major: ack.major, requestID: pingID, timestampMs: stamp), deadline: deadline) else {
+                        return failure(.unreachable, "timed out")
+                    }
+                case 0x04:   // PONG
+                    if pingSentAt != 0 && frame.requestID == pingID {
+                        return ProbeResult(kind: .ok, latencyMs: Int(max(0, monotonicMs() - pingSentAt)), protocolVersion: version,
+                                           serverName: serverName, detail: "")
+                    }
+                case 0x05:   // ERROR
+                    let code = frame.payload.count >= 2 ? u16(frame.payload, 0) : 0
+                    let message = errorMessage(frame.payload)
+                    if code == 17 { return failure(.oldProtocol, message.isEmpty ? "protocol 1.2 required" : message) }
+                    return failure(.notRelay, message.isEmpty ? "server error \(code)" : "\(message) (\(code))")
+                case 0x03:   // a server PING: not this test's business
+                    break
+                default:     // a frame a relay does not send during a handshake
+                    return failure(.notRelay, "unexpected frame \(frame.type)")
+                }
+                continue
+            }
+            let remaining = deadline - monotonicMs()
+            if remaining <= 0 { break }
+            if !wait(fd, POLLIN, deadline) { break }
+            var chunk = [UInt8](repeating: 0, count: 4096)
+            let n = read(fd, &chunk, chunk.count)
+            if n < 0 {
+                if errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK { continue }
+                return failure(.unreachable, describe(errno))
+            }
+            if n == 0 { return failure(.unreachable, "connection closed") }
+            buffer.append(contentsOf: chunk[0..<n])
+            if buffer.count > maxPayload + 16 { return failure(.notRelay, "oversized frame") }   // nothing the test waits for is this long
+        }
+        return failure(.unreachable, "timed out")
+    }
+
+    // MARK: frames and sockets
+
+    private static func frame(type: UInt8, requestID: UInt32, payload: [UInt8]) -> [UInt8] {
+        var out: [UInt8] = [0x4C, 0x44, 0x4E, 0x52, UInt8(version), type, 0, 0]
+        append(&out, UInt32(payload.count))
+        append(&out, requestID)
+        return out + payload
+    }
+
+    private static func append(_ bytes: inout [UInt8], _ value: UInt32) {
+        bytes.append(contentsOf: [UInt8(value & 0xFF), UInt8((value >> 8) & 0xFF), UInt8((value >> 16) & 0xFF), UInt8((value >> 24) & 0xFF)])
+    }
+
+    private static func append(_ bytes: inout [UInt8], _ value: UInt64) {
+        for shift in stride(from: 0, through: 56, by: 8) { bytes.append(UInt8((value >> UInt64(shift)) & 0xFF)) }
+    }
+
+    private static func append(_ bytes: inout [UInt8], _ text: String) {   // str: u16 byte length + UTF-8
+        let utf8 = Array(text.utf8)
+        bytes.append(UInt8(utf8.count & 0xFF))
+        bytes.append(UInt8((utf8.count >> 8) & 0xFF))
+        bytes.append(contentsOf: utf8)
+    }
+
+    private static func u16(_ bytes: [UInt8], _ at: Int) -> UInt16 {
+        UInt16(bytes[at]) | (UInt16(bytes[at + 1]) << 8)
+    }
+
+    private static func u32(_ bytes: [UInt8], _ at: Int) -> UInt32 {
+        UInt32(bytes[at]) | (UInt32(bytes[at + 1]) << 8) | (UInt32(bytes[at + 2]) << 16) | (UInt32(bytes[at + 3]) << 24)
+    }
+
+    private static func errorMessage(_ payload: [UInt8]) -> String {
+        guard payload.count >= 4 else { return "" }
+        let length = Int(u16(payload, 2))
+        guard payload.count >= 4 + length else { return "" }
+        return String(decoding: payload[4..<(4 + length)], as: UTF8.self)
+    }
+
+    private static func wait(_ fd: Int32, _ events: Int32, _ deadline: Int64) -> Bool {
+        while true {
+            let remaining = deadline - monotonicMs()
+            if remaining <= 0 { return false }
+            var item = pollfd(fd: fd, events: Int16(events), revents: 0)
+            let ready = poll(&item, 1, Int32(remaining))
+            if ready > 0 { return true }
+            if ready == 0 { return false }
+            if errno != EINTR { return false }
+        }
+    }
+
+    private static func sendAll(_ fd: Int32, _ bytes: [UInt8], deadline: Int64) -> Bool {
+        var offset = 0
+        while offset < bytes.count {
+            if !wait(fd, POLLOUT, deadline) { return false }
+            let slice = Array(bytes[offset...])
+            #if canImport(Darwin)
+            let n = slice.withUnsafeBytes { write(fd, $0.baseAddress, $0.count) }
+            #else
+            let n = slice.withUnsafeBytes { send(fd, $0.baseAddress, $0.count, Int32(MSG_NOSIGNAL)) }   // no SIGPIPE: Linux has no SO_NOSIGPIPE
+            #endif
+            if n < 0 {
+                if errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK { continue }
+                return false
+            }
+            offset += n
+        }
+        return true
+    }
+
+    private static func monotonicMs() -> Int64 {
+        var now = timespec()
+        clock_gettime(CLOCK_MONOTONIC, &now)
+        return Int64(now.tv_sec) * 1000 + Int64(now.tv_nsec) / 1_000_000
+    }
+
+    private static func describe(_ error: Int32) -> String {
+        switch error {
+        case 0: return "timed out"
+        case ECONNREFUSED: return "connection refused"
+        case ETIMEDOUT: return "timed out"
+        case EHOSTUNREACH: return "no route to host"
+        case ENETUNREACH: return "network is unreachable"
+        default: return String(cString: strerror(error))
+        }
+    }
+
+    private static func failure(_ kind: ProbeResult.Kind, _ detail: String) -> ProbeResult {
+        ProbeResult(kind: kind, latencyMs: nil, protocolVersion: nil, serverName: nil, detail: detail)
+    }
+}
