+    // MARK: persistence
+
+    static func suite() -> String { "nx2apple.test." + UUID().uuidString }
+
+    static func persistence() {
+        let name = suite()
+        let defaults = UserDefaults(suiteName: name)!
+        defer { defaults.removePersistentDomain(forName: name) }
+        let m = OnlinePlayModel(game: defaults, shared: defaults, environment: [:], defaultName: "iPhone")
+        m.enabled = true
+        m.playerName = "Ana"
+        m.addServer(name: "Home", address: " relay.example.com:11470 ")
+        m.password = "secret"
+        m.plaintextConsent = true
+        let again = OnlinePlayModel(game: UserDefaults(suiteName: name)!, shared: UserDefaults(suiteName: name)!, environment: [:], defaultName: "iPhone")
+        check(again.enabled && again.playerName == "Ana" && again.password == "secret" && again.plaintextConsent,
+              "the settings are stored as they are changed")
+        check(again.servers == [RelayServer(name: "Home", address: "relay.example.com:11470")], "the server list is stored")
+        check(again.selected == "relay.example.com:11470", "the chosen server is stored")
+        // the split of the two suites: whether this game plays online is the game's, everything else is shared (on the Mac by every game app)
+        let gameOnly = suite(), sharedSuite = suite()
+        let gameDefaults = UserDefaults(suiteName: gameOnly)!, sharedDefaults = UserDefaults(suiteName: sharedSuite)!
+        defer { gameDefaults.removePersistentDomain(forName: gameOnly); sharedDefaults.removePersistentDomain(forName: sharedSuite) }
+        let split = OnlinePlayModel(game: gameDefaults, shared: sharedDefaults, environment: [:], defaultName: "iPhone")
+        split.enabled = true
+        split.playerName = "Ana"
+        split.password = "shared"
+        split.addServer(name: "S", address: "shared.example.com")
+        check(gameDefaults.bool(forKey: "online.enabled") && !gameDefaults.bool(forKey: "online.plaintextConsent")
+              && gameDefaults.string(forKey: "online.name") == nil, "the toggle is the game's own setting")
+        let fromShared = OnlinePlayModel(game: UserDefaults(suiteName: gameOnly)!, shared: UserDefaults(suiteName: sharedSuite)!, environment: [:], defaultName: "iPhone")
+        check(fromShared.playerName == "Ana" && fromShared.password == "shared"
+              && fromShared.servers.map(\.address) == ["shared.example.com"] && fromShared.selected == "shared.example.com",
+              "the name, the password and the servers are shared")
+        // a game that never turned online play on reads the sharing game's off state, not a stored true
+        let sharing = OnlinePlayModel(game: UserDefaults(suiteName: gameOnly)!, shared: UserDefaults(suiteName: sharedSuite)!, environment: [:], defaultName: "iPhone")
+        check(sharing.enabled && fromShared.enabled, "the game's own toggle is read back")
+        again.password = "other"
+        check(!again.plaintextConsent, "a different password resets the plaintext consent")
+        again.plaintextConsent = true
+        again.password = ""
+        check(!again.plaintextConsent, "clearing the password clears the consent")
+        let fresh = UserDefaults(suiteName: suite())!
+        let empty = OnlinePlayModel(game: fresh, shared: fresh, environment: [:], defaultName: "iPhone")
+        check(!empty.enabled && empty.servers.isEmpty && empty.selected.isEmpty && empty.password.isEmpty && !empty.plaintextConsent,
+              "a new suite starts with online play off and nothing saved")
+    }
