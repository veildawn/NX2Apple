+// LDN service state and the public lifecycle API. Relay I/O and virtual
+// sockets are separate so illegal transitions can be tested without a server.
+#include "ldnr_internal.h"
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static _Thread_local int ldnr_errno_value;
+void ldnr_set_errno(int error) { ldnr_errno_value = error; }
+int ldnr_last_errno(void) { return ldnr_errno_value; }
+int ldnr_fail(int error) { ldnr_set_errno(error); return -1; }
+const char *ldnr_last_error(const ldnr *l) {
+    static _Thread_local char text[256];
+    if (!l) return "no LDNR context";
+    ldnr *mutable_l = (ldnr *)l;
+    pthread_mutex_lock(&mutable_l->error_mutex);
+    memcpy(text, mutable_l->error, sizeof text);
+    pthread_mutex_unlock(&mutable_l->error_mutex);
+    text[sizeof text - 1] = 0;
+    return text;
+}
+
+static char *ldnr_strdup(const char *s) {
+    if (!s) return NULL;
+    size_t n = strlen(s) + 1;
+    char *copy = malloc(n);
+    if (copy) memcpy(copy, s, n);
+    return copy;
+}
+
+void ldnr_log(ldnr *l, const char *format, ...) {
+    if (!l->config.log) return;
+    char text[512];
+    va_list ap;
+    va_start(ap, format);
+    vsnprintf(text, sizeof text, format, ap);
+    va_end(ap);
+    if (l->config.log_message) l->config.log_message(l->config.callback_ctx, text);
+    else fprintf(stderr, "ldnr: %s\n", text);
+}
+
+void ldnr_set_error(ldnr *l, const char *format, ...) {
+    // The message is formatted into a local buffer: the shared text is read
+    // by other threads, and the log must not print a half written line.
+    char text[256];
+    va_list ap;
+    va_start(ap, format);
+    vsnprintf(text, sizeof text, format, ap);
+    va_end(ap);
+    pthread_mutex_lock(&l->error_mutex);
+    memcpy(l->error, text, sizeof text);
+    pthread_mutex_unlock(&l->error_mutex);
+    ldnr_log(l, "%s", text);
+}
+
+// The last error is dropped: the shared buffer is only written under its
+// own lock.
+void ldnr_clear_error(ldnr *l) {
+    if (!l) return;
+    pthread_mutex_lock(&l->error_mutex);
+    l->error[0] = 0;
+    pthread_mutex_unlock(&l->error_mutex);
+}
+
+int64_t ldnr_monotonic_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+int ldnr_wait_until(ldnr *l, pthread_cond_t *condition, pthread_mutex_t *mutex,
+                    void *wait_ctx, void (*native_wait)(void *, int), int64_t deadline) {
+    int result;
+    if (l && atomic_load(&l->cancelled)) return ECANCELED;
+    if (native_wait) native_wait(wait_ctx, 1);
+    if (deadline < 0) {
+        result = pthread_cond_wait(condition, mutex);
+    } else {
+        int64_t remaining = deadline - ldnr_monotonic_ms();
+        if (remaining <= 0) {
+            if (native_wait) native_wait(wait_ctx, 0);
+            return ETIMEDOUT;
+        }
+        struct timespec now, ts;
+        clock_gettime(CLOCK_REALTIME, &now);
+        ts = now;
+        ts.tv_sec += (time_t)(remaining / 1000);
+        ts.tv_nsec += (long)(remaining % 1000) * 1000000;
+        if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+        result = pthread_cond_timedwait(condition, mutex, &ts);
+    }
+    if (native_wait) native_wait(wait_ctx, 0);
+    // A cancellation ends the wait even when the deadline has not passed.
+    if (l && atomic_load(&l->cancelled)) return ECANCELED;
+    return result;
+}
+
+void ldnr_state_set(ldnr *l, int state) {
+    if (l->state == state) return;
+    l->state = state;
+    ldnr_log(l, "state %d", state);
+    if (l->config.state_changed) l->config.state_changed(l->config.callback_ctx);
+}
+
+void ldnr_notify(ldnr *l) {
+    // The room changed in a way the guest can observe (a node joined or left,
+    // the advertisement or the accept policy changed): the event that the
+    // game waits on is signalled even when the state itself did not move.
+    if (l->config.state_changed) l->config.state_changed(l->config.callback_ctx);
+}
+
+int ldnr_create(const ldnr_config *config, ldnr **out) {
+    if (!out || !config) return ldnr_fail(LDNR_EINVAL);
+    *out = NULL;
+    ldnr *l = calloc(1, sizeof *l);
+    if (!l) return ldnr_fail(LDNR_ENOBUFS);
+    l->config = *config;
+    atomic_init(&l->stop, 0); atomic_init(&l->transport_open, 0);
+    atomic_init(&l->cancelled, 0);
+    atomic_init(&l->protocol_major, LDNR_PROTOCOL_MAJOR);
+    l->subnet_mask = ldnr_htonl(0xffff0000u);
+    l->disconnect_reason = 0;
+    l->local_communication_id = config->local_communication_id;
+    pthread_mutex_init(&l->mutex, NULL);
+    pthread_mutex_init(&l->control, NULL);
+    pthread_mutex_init(&l->error_mutex, NULL);
+    pthread_mutex_init(&l->proxy_mutex, NULL);
+    pthread_cond_init(&l->condition, NULL);
+    ldnr_vnet_init(l);
+    l->server = ldnr_strdup(config->server);
+    l->room_password = ldnr_strdup(config->room_password);
+    l->player_name = ldnr_strdup(config->player_name);
+    if ((config->server && !l->server) || (config->room_password && !l->room_password) ||
+        (config->player_name && !l->player_name)) {
+        ldnr_destroy(l);
+        return ldnr_fail(LDNR_ENOBUFS);
+    }
+    l->transport = config->transport;
+    if (!l->transport) {
+        l->transport = ldnr_tcp_transport_create();
+        l->owns_transport = 1;
+    }
+    if (!l->transport) {
+        ldnr_destroy(l);
+        return ldnr_fail(LDNR_ENOBUFS);
+    }
+    // The capabilities of the transport are asked for once: what the host
+    // knows comes first, the transport itself answers the rest.
+    l->transport_caps = config->transport_caps ? config->transport_caps
+                                                : ldnr_transport_caps_of(l->transport);
+    l->next_request_id = 1;
+    atomic_init(&l->node_id, 0);
+    atomic_init(&l->connection_id_seq, 1);
+    atomic_init(&l->proxy_request_seq, 0);
+    *out = l;
+    return 0;
+}
+
+int ldnr_initialize(ldnr *l) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_NONE) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_EISCONN); }
+    if ((!l->transport || !l->transport->connect) || (!l->config.transport && (!l->server || !*l->server))) {
+        ldnr_set_error(l, "DM_LDNR_SERVER is required when LDNR is enabled");
+        pthread_mutex_unlock(&l->mutex);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    l->initialized = 1;
+    ldnr_state_set(l, LDNR_STATE_INITIALIZED);
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+// The membership of the relay is gone: its identity, its flags and its
+// cached answers are cleared together, so that a getter cannot answer with
+// a network that does not exist any more.
+static void ldnr_clear_membership(ldnr *l) {
+    l->has_network = l->has_network_config = l->has_security = 0;
+    l->network_id = 0;
+    l->ipv4 = 0;
+    l->subnet_mask = ldnr_htonl(0xffff0000u);
+    memset(&l->network, 0, sizeof l->network);
+    memset(&l->security, 0, sizeof l->security);
+    memset(&l->network_config, 0, sizeof l->network_config);
+    l->latest_update.state_change = 0;
+    memset(l->history, 0, sizeof l->history);
+}
+
+// The membership ends without the guest asking for it: the relay is gone.
+// The membership is cleared, the sockets that belong to it are marked down
+// and their waiters are woken, and the guest sees the open state with the
+// reason of the loss. The caller holds the core lock.
+void ldnr_membership_retire(ldnr *l, int reason) {
+    if (!l) return;
+    ldnr_clear_membership(l);
+    l->disconnect_reason = reason;
+    // The relay is gone: no descriptor of the membership may wait for a
+    // connection, a datagram or data that can no longer arrive.
+    ldnr_vnet_network_down(l);
+    // The membership is over: no open of it can be answered any more, and the
+    // table must not keep its entries for a room that does not exist.
+    ldnr_proxy_open_clear_all(l);
+    // The room does not exist any more: the guest sees the open state.
+    if (l->state == LDNR_STATE_AP_CREATED) ldnr_state_set(l, LDNR_STATE_AP_OPEN);
+    else if (l->state == LDNR_STATE_STATION_CONNECTED) ldnr_state_set(l, LDNR_STATE_STATION_OPEN);
+}
+
+void ldnr_finalize(ldnr *l) {
+    if (!l) return;
+    ldnr_client_close(l);
+    pthread_mutex_lock(&l->mutex);
+    ldnr_vnet_reset(l);
+    l->initialized = 0;
+    // The cached addressing belongs to the membership that just ended.
+    ldnr_clear_membership(l);
+    l->scan_count = 0;
+    memset(l->pending_advertise, 0, sizeof l->pending_advertise);
+    l->pending_advertise_size = 0;
+    l->pending_filter_count = 0;
+    ldnr_protocol_message_free(&l->reply);
+    ldnr_state_set(l, LDNR_STATE_NONE);
+    pthread_mutex_unlock(&l->mutex);
+}
+
+// Ends every wait of this context: the relay connection is closed, the
+// socket layer is woken and the control requests fail. It is the
+// cancellation path of a teardown: the caller does not have to wait for a
+// request that would never be answered.
+void ldnr_cancel(ldnr *l) {
+    if (!l) return;
+    // The cancellation is published atomically: the waiters of the control
+    // operations and of the socket layer read it under different locks.
+    atomic_store(&l->cancelled, 1);
+    atomic_store(&l->stop, 1);
+    if (l->transport && l->transport->close) l->transport->close(l->transport->ctx);
+    atomic_store(&l->transport_open, 0);
+    ldnr_vnet_cancel(l);
+    pthread_mutex_lock(&l->mutex);
+    pthread_cond_broadcast(&l->condition);
+    pthread_mutex_unlock(&l->mutex);
+}
+
+void ldnr_destroy(ldnr *l) {
+    if (!l) return;
+    ldnr_finalize(l);
+    ldnr_vnet_destroy(l);
+    if (l->transport && l->transport->destroy) l->transport->destroy(l->transport->ctx);
+    if (l->owns_transport) free((void *)l->transport);
+    pthread_mutex_destroy(&l->mutex);
+    pthread_mutex_destroy(&l->control);
+    pthread_mutex_destroy(&l->error_mutex);
+    pthread_mutex_destroy(&l->proxy_mutex);
+    pthread_cond_destroy(&l->condition);
+    free(l->server);
+    free(l->room_password);
+    free(l->player_name);
+    free(l);
+}
+
+int ldnr_get_state(const ldnr *l) {
+    if (!l) return LDNR_STATE_NONE;
+    ldnr *mutable_l = (ldnr *)l;
+    pthread_mutex_lock(&mutable_l->mutex);
+    int state = l->state;
+    pthread_mutex_unlock(&mutable_l->mutex);
+    return state;
+}
+
+int ldnr_get_disconnect_reason(const ldnr *l) {
+    if (!l) return 0;
+    ldnr *mutable_l = (ldnr *)l;
+    pthread_mutex_lock(&mutable_l->mutex);
+    int reason = l->disconnect_reason;
+    pthread_mutex_unlock(&mutable_l->mutex);
+    return reason;
+}
+
+static int ldnr_open(ldnr *l, int station) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    // The whole operation is serialized: the state check, the handshake and
+    // the state change belong to one caller.
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    int valid = l->state == LDNR_STATE_INITIALIZED;
+    pthread_mutex_unlock(&l->mutex);
+    if (!valid) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_EINVAL); }
+    if (ldnr_client_open(l)) { pthread_mutex_unlock(&l->control); return -1; }
+    pthread_mutex_lock(&l->mutex);
+    ldnr_state_set(l, station ? LDNR_STATE_STATION_OPEN : LDNR_STATE_AP_OPEN);
+    pthread_mutex_unlock(&l->mutex);
+    pthread_mutex_unlock(&l->control);
+    return 0;
+}
+int ldnr_open_access_point(ldnr *l) { return ldnr_open(l, 0); }
+int ldnr_open_station(ldnr *l) { return ldnr_open(l, 1); }
+
+static int ldnr_close(ldnr *l, int station) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    // Native: CloseAccessPoint works in AccessPoint and AccessPointCreated,
+    // CloseStation in Station and StationConnected.
+    int valid = station ? (l->state == LDNR_STATE_STATION_OPEN ||
+                            l->state == LDNR_STATE_STATION_CONNECTED)
+                        : (l->state == LDNR_STATE_AP_OPEN ||
+                           l->state == LDNR_STATE_AP_CREATED);
+    pthread_mutex_unlock(&l->mutex);
+    if (!valid) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_EINVAL); }
+    ldnr_client_close(l);
+    pthread_mutex_lock(&l->mutex);
+    ldnr_vnet_reset(l);
+    // The closed membership is gone: the getters must not answer with it
+    // any more, not even with the network it left behind.
+    ldnr_clear_membership(l);
+    ldnr_state_set(l, LDNR_STATE_INITIALIZED);
+    pthread_mutex_unlock(&l->mutex);
+    pthread_mutex_unlock(&l->control);
+    return 0;
+}
+int ldnr_close_access_point(ldnr *l) { return ldnr_close(l, 0); }
+int ldnr_close_station(ldnr *l) { return ldnr_close(l, 1); }
+
+static void ldnr_apply_user(ldnr *l, const ldnr_user_config *input, ldnr_user_config *out) {
+    memset(out, 0, sizeof *out);
+    if (input) memcpy(out, input, sizeof *out);
+    if (l->player_name && *l->player_name) {
+        memset(out->user_name, 0, sizeof out->user_name);
+        size_t n = strlen(l->player_name);
+        if (n > sizeof out->user_name - 1) n = sizeof out->user_name - 1;
+        memcpy(out->user_name, l->player_name, n);
+    }
+}
+
+// Installs the network identity of a create or connect acknowledgement. The
+// local address is taken from this acknowledgement only: the address of an
+// earlier membership must never be reused. When config_in is given, the
+// membership's network configuration is already fully staged and is
+// installed (with its validity) here, under the core lock, so that it is
+// readable before the caller publishes the new state and signals the event.
+// Returns 0 on success.
+int ldnr_apply_network(ldnr *l, const ldnr_message *reply,
+                       const ldnr_network_config *config_in) {
+    if (!reply->has_network_info) {
+        ldnr_set_error(l, "relay reply has no NetworkInfo");
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    l->network = reply->network_info;
+    l->network_id = reply->network_id;
+    l->has_network = 1;
+    memcpy(l->security.server_random, l->network.server_random, 16);
+    memcpy(l->security.session_id, l->network.network_id.session_id, 16);
+    l->has_security = 1;
+    atomic_store(&l->node_id, reply->node_id);
+    atomic_store(&l->connection_id_seq, 1);
+    l->ipv4 = 0;
+    if (reply->ipv4) l->ipv4 = reply->ipv4;
+    if (!l->ipv4 && l->network.node_count) {
+        // The host is normally node zero. A joiner gets its address explicitly.
+        for (unsigned i = 0; i < l->network.node_count && i < LDNR_NATIVE_NODE_COUNT_MAX; i++)
+            if (l->network.nodes[i].is_connected) {
+                l->ipv4 = ldnr_ipv4_from_native(l->network.nodes[i].ipv4_address);
+                break;
+            }
+    }
+    if (reply->subnet_mask) l->subnet_mask = reply->subnet_mask;
+    ldnr_vnet_set_address(l, l->ipv4, l->subnet_mask);
+    if (config_in) {
+        // The configuration the membership reports is valid as soon as the
+        // membership exists: an event consumer that reacts to the connected
+        // state must be able to read it. It is installed under the core lock,
+        // before the state change and the event that follows it.
+        l->network_config = *config_in;
+        l->has_network_config = 1;
+    }
+    return 0;
+}
+
+// The native id -1 means "take the id of the game's NACP". The host cannot
+// read the NACP, so the core falls back to the id it was given.
+static int64_t ldnr_communication_id(const ldnr *l, int64_t id) {
+    if (id != -1) return id;
+    return l->local_communication_id;
+}
+
+// The relay room password is a user secret: it grants access to the room.
+// The built-in transport is a plaintext stream, so a create or a connect
+// that carries the password is refused here, before anything is sent, unless
+// the caller accepts the risk explicitly. The game's own LDN passphrase is
+// not covered by this rule: it is a per-title constant, not a user secret.
+static int ldnr_room_password_allowed(const ldnr *l) {
+    if (!l->room_password || !*l->room_password) return 1;
+    if (l->config.allow_plaintext_password) return 1;
+    // The bytes are protected only when the transport says so: a transport
+    // that says nothing may well be a plaintext stream, and the built-in
+    // one says that it is.
+    return l->transport_caps && !l->transport_caps->plaintext;
+}
+
+// The room was created but its configuration failed: it is removed, so that
+// no station joins a room whose filters are not in place.
+static void ldnr_create_rollback(ldnr *l) {
+    pthread_mutex_lock(&l->mutex);
+    uint64_t id = l->network_id;
+    ldnr_network_info network = l->network;
+    int created = l->has_network;
+    pthread_mutex_unlock(&l->mutex);
+    // The room was never created: there is nothing to remove.
+    if (!created) return;
+    // The error of the operation that failed is the one the caller sees:
+    // the rollback is not that operation, and its own failure must not
+    // replace its error.
+    int error = ldnr_last_errno();
+    ldnr_message *message = ldnr_message_new();
+    int destroyed = 0;
+    if (message) {
+        message->network_info = network;
+        message->has_network_info = 1;
+        // The room ends for the data plane before its removal goes out: a
+        // frame that was prepared for it must not reach the room that a
+        // later create or connect joins.
+        ldnr_vnet_membership_leave(l);
+        destroyed = ldnr_client_request(l, LDNR_MSG_DESTROY_ACK, LDNR_MSG_DESTROY_ACK, id,
+                                        message, NULL, NULL, l->config.connect_timeout_ms) == 0;
+        ldnr_message_delete(message);
+    }
+    if (!destroyed) {
+        // The relay still owns the room: the removal was not confirmed.
+        // The connection is what holds the membership, so it is retired
+        // before the local membership is cleared. A room that the relay
+        // kept would refuse the next create with "already in a room".
+        ldnr_client_close(l);
+    }
+    pthread_mutex_lock(&l->mutex);
+    ldnr_vnet_reset(l);
+    ldnr_clear_membership(l);
+    ldnr_state_set(l, LDNR_STATE_AP_OPEN);
+    pthread_mutex_unlock(&l->mutex);
+    // The error of the operation is kept.
+    ldnr_set_errno(error);
+}
+
+int ldnr_create_network(ldnr *l, const ldnr_network_config *config,
+                        const ldnr_security_config *security, const ldnr_user_config *user,
+                        const ldnr_security_parameter *private_security,
+                        const ldnr_address_entry *addresses, int address_count) {
+    if (!l || !config || !security || address_count < 0) return ldnr_fail(LDNR_EINVAL);
+    // A control operation runs from end to end: the inputs it sends and the
+    // state it changes belong to this call alone.
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_AP_OPEN) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    // The room password may not travel in clear: the refusal is local and
+    // happens before the create request is sent.
+    if (!ldnr_room_password_allowed(l)) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        ldnr_set_error(l, "the relay room password would travel in clear");
+        return ldnr_fail(LDNR_ETLSREQUIRED);
+    }
+    l->network_config = *config;
+    l->network_config.intent_id.local_communication_id =
+        ldnr_communication_id(l, config->intent_id.local_communication_id);
+    l->security_config = *security;
+    ldnr_apply_user(l, user, &l->user_config);
+    if (private_security) l->security = *private_security;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_operation operation = {0};
+    operation.network_config = &l->network_config;
+    operation.security_config = &l->security_config;
+    operation.user_config = &l->user_config;
+    operation.security_parameter = private_security;
+    operation.addresses = addresses;
+    operation.address_count = address_count;
+    // Native: CreateNetworkPrivate with zero addresses creates a network that
+    // is not private, exactly like CreateNetwork does.
+    operation.private_operation = address_count > 0;
+    // The settings the host may change before the room exists go out with
+    // the create request (native allows them in AccessPoint state).
+    int requested_policy = l->pending_policy;
+    int filter_count = l->pending_filter_count;
+    uint8_t filters[16][6];
+    memcpy(filters, l->pending_filters, sizeof filters);
+    // The staged filters stay staged until the room holds them: a create
+    // that fails must leave the configuration for the next attempt.
+    // A room with a filter list must not admit a station before the list is
+    // complete: the room is created with a policy that refuses everybody
+    // and gets the wanted one once the filters are in place.
+    int staged = filter_count > 0;
+    operation.option = staged ? LDNR_POLICY_REJECT_ALL : requested_policy;
+    operation.data = l->pending_advertise;
+    operation.data_size = l->pending_advertise_size;
+    operation.room_password = l->room_password;
+    operation.player_name = l->player_name;
+    ldnr_message *reply = ldnr_message_new();
+    if (!reply) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_ENOBUFS); }
+    int result = ldnr_client_request(l, LDNR_MSG_CREATE_ACK, LDNR_MSG_CREATE_ACK, 0,
+                                     NULL, &operation, reply, l->config.connect_timeout_ms);
+    ldnr_message_delete(reply);
+    pthread_mutex_lock(&l->mutex);
+    // The room can be gone again before the caller looks at the result.
+    if (!result && !l->has_network) result = ldnr_fail(LDNR_ENETDOWN);
+    // The configuration and its validity were installed with the membership,
+    // under the core lock, before the created state was published. They are
+    // only reaffirmed here when the membership is still the one this call
+    // created: a loss that raced the reply already cleared them.
+    if (!result && l->has_network) l->has_network_config = 1;
+    pthread_mutex_unlock(&l->mutex);
+    // The filter entries are not part of the create request: they are sent
+    // to the room that exists now.
+    for (int i = 0; !result && i < filter_count; i++) {
+        ldnr_operation filter = {0};
+        memcpy(filter.mac, filters[i], 6);
+        result = ldnr_client_request(l, LDNR_MSG_FILTER_ACK, LDNR_MSG_FILTER_ACK,
+                                     l->network_id, NULL, &filter, NULL,
+                                     l->config.connect_timeout_ms);
+    }
+    if (!result && staged && requested_policy != LDNR_POLICY_REJECT_ALL) {
+        // The room holds its whole filter list now: it may admit the
+        // stations that the host wants.
+        ldnr_operation policy = {0};
+        policy.option = requested_policy;
+        result = ldnr_client_request(l, LDNR_MSG_POLICY_ACK, LDNR_MSG_POLICY_ACK,
+                                     l->network_id, NULL, &policy, NULL,
+                                     l->config.connect_timeout_ms);
+    }
+    if (result) {
+        // The staged configuration is kept: a retry must create the room
+        // with the filters the host asked for, or a blacklisted station
+        // would be admitted by the room that replaces it.
+        pthread_mutex_lock(&l->mutex);
+        memcpy(l->pending_filters, filters, sizeof filters);
+        l->pending_filter_count = filter_count;
+        pthread_mutex_unlock(&l->mutex);
+        // The room exists but its configuration failed: it is removed, so
+        // that no station joins a room that is not the one the host asked for.
+        ldnr_create_rollback(l);
+    } else {
+        // The room holds the filters now: they are not staged any more.
+        pthread_mutex_lock(&l->mutex);
+        l->pending_filter_count = 0;
+        pthread_mutex_unlock(&l->mutex);
+    }
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+// The relay does not know the network type or the BSSID of a room, so those
+// filters are applied here, before a result is kept.
+static int ldnr_scan_filter_valid(const ldnr_scan_filter *filter) {
+    if (!filter) return 1;
+    if (filter->flags & 0x04 && filter->network_type > 0xffu) return 0;
+    if (filter->flags & 0x08) {
+        uint8_t zero[6] = {0};
+        if (!memcmp(filter->bssid, zero, sizeof zero)) return 0;
+    }
+    return 1;
+}
+
+static int ldnr_scan_matches(const ldnr_scan_filter *filter, int channel,
+                              const ldnr_network_info *info) {
+    if (!filter) return 1;
+    if ((filter->flags & 0x04) && (uint32_t)info->common.network_type != filter->network_type)
+        return 0;
+    if ((filter->flags & 0x08) && memcmp(info->common.bssid, filter->bssid, sizeof filter->bssid))
+        return 0;
+    if (channel > 0 && info->common.channel != (int16_t)channel) return 0;
+    return 1;
+}
+
+int ldnr_scan(ldnr *l, ldnr_network_info *out, int *count, int max_count,
+              const ldnr_scan_filter *filter, int channel, int private_scan) {
+    if (count) *count = 0;
+    if (!l || !count || max_count < 0 || (max_count && !out)) return ldnr_fail(LDNR_EINVAL);
+    if (!ldnr_scan_filter_valid(filter)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    // Native: a scan is allowed in AccessPointCreated, Station and
+    // StationConnected.
+    int valid = l->state == LDNR_STATE_STATION_OPEN ||
+                l->state == LDNR_STATE_STATION_CONNECTED ||
+                l->state == LDNR_STATE_AP_CREATED;
+    if (!valid) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_scan_filter empty_filter;
+    if (!filter) { memset(&empty_filter, 0, sizeof empty_filter); filter = &empty_filter; }
+    // The native id -1 is resolved before the filter goes to the relay.
+    ldnr_scan_filter resolved = *filter;
+    resolved.network_id.intent_id.local_communication_id =
+        ldnr_communication_id(l, resolved.network_id.intent_id.local_communication_id);
+    filter = &resolved;
+    ldnr_operation operation = {0};
+    operation.scan_filter = filter;
+    operation.channel = channel;
+    operation.private_operation = private_scan;
+    ldnr_message *reply = ldnr_message_new();
+    if (!reply) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_ENOBUFS); }
+    int result = ldnr_client_request(l, LDNR_MSG_SCAN_ACK, LDNR_MSG_SCAN_ACK, 0,
+                                     NULL, &operation, reply, l->config.scan_timeout_ms);
+    if (result) {
+        ldnr_message_delete(reply);
+        pthread_mutex_unlock(&l->control);
+        return result;
+    }
+    pthread_mutex_lock(&l->mutex);
+    int found = reply->network_count;
+    if (found < 0 || found > LDNR_MAX_NETWORKS) found = LDNR_MAX_NETWORKS;
+    l->scan_count = 0;
+    int kept = 0;
+    for (int i = 0; i < found; i++) {
+        if (!ldnr_scan_matches(filter, channel, &reply->networks[i].info)) continue;
+        l->scan_ids[l->scan_count] = reply->networks[i].network_id;
+        memcpy(l->scan_sessions[l->scan_count], reply->networks[i].info.network_id.session_id, 16);
+        l->scan_count++;
+        if (kept < max_count) out[kept] = reply->networks[i].info;
+        kept++;
+    }
+    *count = kept < max_count ? kept : max_count;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_message_delete(reply);
+    pthread_mutex_unlock(&l->control);
+    return 0;
+}
+
+static uint64_t ldnr_find_network_id(const ldnr *l, const ldnr_network_info *info) {
+    if (!info) return 0;
+    for (int i = 0; i < l->scan_count; i++)
+        if (!memcmp(l->scan_sessions[i], info->network_id.session_id, 16)) return l->scan_ids[i];
+    return 0;
+}
+
+int ldnr_connect_network(ldnr *l, const ldnr_network_info *info,
+                         const ldnr_network_config *private_config,
+                         const ldnr_security_config *security, const ldnr_user_config *user,
+                         const ldnr_security_parameter *private_security, int option,
+                         int version) {
+    if (!l || !security || (!info && !private_config)) return ldnr_fail(LDNR_EINVAL);
+    // The local communication version is a number of its own (0x0-0x7FFF).
+    if (version < 0 || version > 0x7fff) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_STATION_OPEN) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    // The room password may not travel in clear: the refusal is local and
+    // happens before the connect request is sent.
+    if (!ldnr_room_password_allowed(l)) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        ldnr_set_error(l, "the relay room password would travel in clear");
+        return ldnr_fail(LDNR_ETLSREQUIRED);
+    }
+    ldnr_apply_user(l, user, &l->user_config);
+    if (security) l->security_config = *security;
+    if (private_security) l->security = *private_security;
+    if (private_config) l->network_config = *private_config;
+    l->network_config.intent_id.local_communication_id =
+        ldnr_communication_id(l, l->network_config.intent_id.local_communication_id);
+    // The version the request will carry is staged before it goes out: the
+    // acknowledgement publishes the complete configuration under the core
+    // lock, so an event consumer can never observe it as zero.
+    l->staged_connect_version = (int16_t)version;
+    uint64_t id = ldnr_find_network_id(l, info);
+    if (info && !id) {
+        // A game may reconnect from a saved NetworkInfo after a new scan. The
+        // session identity remains sufficient for the relay to resolve it.
+        id = 0;
+    }
+    pthread_mutex_unlock(&l->mutex);
+    // The version argument is the local communication version of this
+    // connection. Zero is a valid value, so the argument always wins over
+    // the value of the network configuration.
+    ldnr_network_config out_config;
+    if (private_config) out_config = l->network_config;
+    else memset(&out_config, 0, sizeof out_config);
+    out_config.local_communication_version = (int16_t)version;
+    ldnr_operation operation = {0};
+    operation.network_config = &out_config;
+    operation.security_config = &l->security_config;
+    operation.user_config = &l->user_config;
+    operation.security_parameter = private_security;
+    operation.option = option;
+    operation.private_operation = private_config != NULL;
+    operation.room_password = l->room_password;
+    operation.player_name = l->player_name;
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_ENOBUFS); }
+    if (info) { message->network_info = *info; message->has_network_info = 1; }
+    int result = ldnr_client_request(l, LDNR_MSG_CONNECT_ACK, LDNR_MSG_CONNECT_ACK, id,
+                                     message, &operation, NULL, l->config.connect_timeout_ms);
+    ldnr_message_delete(message);
+    pthread_mutex_lock(&l->mutex);
+    if (!result && !l->has_network) result = ldnr_fail(LDNR_ENETDOWN);
+    if (!result && l->has_network) {
+        // The connected state, the membership and a complete configuration
+        // were published under the core lock before the event was signalled.
+        // The private path carries its own configuration; the plain path
+        // reports the network it joined. Both record the version that was
+        // actually used. This only runs while the membership is still the
+        // one this call joined: a loss that raced the reply already cleared
+        // the configuration again.
+        if (private_config) {
+            l->network_config = *private_config;
+            l->network_config.intent_id.local_communication_id =
+                ldnr_communication_id(l, private_config->intent_id.local_communication_id);
+        } else {
+            memset(&l->network_config, 0, sizeof l->network_config);
+            l->network_config.intent_id = l->network.network_id.intent_id;
+            l->network_config.channel = l->network.common.channel;
+            l->network_config.node_count_max = l->network.node_count_max;
+        }
+        // The version that was used is the one the configuration reports.
+        l->network_config.local_communication_version = out_config.local_communication_version;
+        l->has_network_config = 1;
+        l->disconnect_reason = 0;
+    }
+    pthread_mutex_unlock(&l->mutex);
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+static int ldnr_leave(ldnr *l, int destroy) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    int valid = l->state == (destroy ? LDNR_STATE_AP_CREATED : LDNR_STATE_STATION_CONNECTED);
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    if (!valid) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_EINVAL); }
+    ldnr_message_type type = destroy ? LDNR_MSG_DESTROY_ACK : LDNR_MSG_DISCONNECTED;
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_ENOBUFS); }
+    pthread_mutex_lock(&l->mutex);
+    if (destroy) { message->network_info = l->network; message->has_network_info = 1; }
+    pthread_mutex_unlock(&l->mutex);
+    // The membership ends for the data plane before the leave goes out: a
+    // frame that was prepared for this room must not reach the room that a
+    // later create or connect joins. The lock is released again before the
+    // reply is awaited, so a stalled reply cannot stall the socket layer.
+    ldnr_vnet_membership_leave(l);
+    int result = ldnr_client_request(l, type, type,
+                                     id, message, NULL, NULL, l->config.connect_timeout_ms);
+    ldnr_message_delete(message);
+    if (result) { pthread_mutex_unlock(&l->control); return result; }
+    pthread_mutex_lock(&l->mutex);
+    ldnr_vnet_reset(l);
+    ldnr_clear_membership(l);
+    // The membership is over: no open of it can be answered any more, so the
+    // correlation table must not keep its entries. A later error of the relay
+    // would otherwise reach a socket of a membership that does not exist.
+    ldnr_proxy_open_clear_all(l);
+    // The local leave is a disconnect by the user (native reason).
+    l->disconnect_reason = destroy ? LDNR_REASON_DESTROYED_BY_USER
+                                   : LDNR_REASON_DISCONNECTED_BY_USER;
+    ldnr_state_set(l, destroy ? LDNR_STATE_AP_OPEN : LDNR_STATE_STATION_OPEN);
+    pthread_mutex_unlock(&l->mutex);
+    pthread_mutex_unlock(&l->control);
+    return 0;
+}
+int ldnr_disconnect(ldnr *l) { return ldnr_leave(l, 0); }
+int ldnr_destroy_network(ldnr *l) { return ldnr_leave(l, 1); }
+
+int ldnr_get_network_info(ldnr *l, ldnr_network_info *out) {
+    if (!l || !out) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_network) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *out = l->network;
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_get_ipv4_address(ldnr *l, uint32_t *address, uint32_t *mask) {
+    if (!l || !address || !mask) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_network) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    // nn::ldn keeps the address in host order.
+    *address = ldnr_ipv4_to_native(l->ipv4);
+    *mask = ldnr_ipv4_to_native(l->subnet_mask);
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_get_network_info_latest_update(ldnr *l, ldnr_node_latest_update *out) {
+    if (!l || !out) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_network) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *out = l->latest_update;
+    // The state is cleared once it has been read.
+    l->latest_update.state_change = 0;
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_get_network_info_and_history(ldnr *l, ldnr_network_info *out,
+                                      ldnr_node_latest_update *nodes, int count) {
+    if (!l || !out || !nodes || count != LDNR_NATIVE_NODE_COUNT_MAX)
+        return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_network) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    // The network information and the histories are one snapshot: they are
+    // read under the same lock, so they cannot disagree.
+    *out = l->network;
+    memcpy(nodes, l->history, sizeof l->history);
+    // The histories are cleared only now: they were handed over.
+    memset(l->history, 0, sizeof l->history);
+    l->latest_update.state_change = 0;
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_get_security_parameter(ldnr *l, ldnr_security_parameter *out) {
+    if (!l || !out) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_security) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *out = l->security;
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_get_network_config(ldnr *l, ldnr_network_config *out) {
+    if (!l || !out) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->mutex);
+    if (!l->has_network_config) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *out = l->network_config;
+    pthread_mutex_unlock(&l->mutex);
+    return 0;
+}
+
+int ldnr_set_advertise_data(ldnr *l, const void *data, size_t size) {
+    if (!l || (size && !data) || size > 0x180) return ldnr_fail(size > 0x180 ? LDNR_EMSGSIZE : LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    // Native: the advertisement may be set in AccessPoint and in
+    // AccessPointCreated. Before the room exists the data is kept and sent
+    // with the create request.
+    if (l->state != LDNR_STATE_AP_OPEN && l->state != LDNR_STATE_AP_CREATED) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    if (l->state == LDNR_STATE_AP_OPEN) {
+        memset(l->pending_advertise, 0, sizeof l->pending_advertise);
+        if (size) memcpy(l->pending_advertise, data, size);
+        l->pending_advertise_size = (uint16_t)size;
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return 0;
+    }
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_operation operation = {0};
+    operation.data = data;
+    operation.data_size = size;
+    int result = ldnr_client_request(l, LDNR_MSG_ADVERTISE_ACK, LDNR_MSG_ADVERTISE_ACK,
+                                     id, NULL, &operation, NULL, l->config.connect_timeout_ms);
+    if (!result) {
+        pthread_mutex_lock(&l->mutex);
+        memset(l->network.advertise_data, 0, sizeof l->network.advertise_data);
+        if (size) memcpy(l->network.advertise_data, data, size);
+        l->network.advertise_data_size = (uint16_t)size;
+        pthread_mutex_unlock(&l->mutex);
+    }
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+int ldnr_set_station_accept_policy(ldnr *l, int policy) {
+    if (!l || policy < 0 || policy > 3) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_AP_OPEN && l->state != LDNR_STATE_AP_CREATED) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    if (l->state == LDNR_STATE_AP_OPEN) {
+        l->pending_policy = (uint8_t)policy;
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return 0;
+    }
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_operation operation = {0};
+    operation.option = policy;
+    int result = ldnr_client_request(l, LDNR_MSG_POLICY_ACK, LDNR_MSG_POLICY_ACK,
+                                     id, NULL, &operation, NULL, l->config.connect_timeout_ms);
+    if (!result) {
+        pthread_mutex_lock(&l->mutex);
+        l->network.station_accept_policy = (uint8_t)policy;
+        pthread_mutex_unlock(&l->mutex);
+    }
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+int ldnr_add_accept_filter_entry(ldnr *l, const uint8_t mac[6]) {
+    if (!l || !mac) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_AP_OPEN && l->state != LDNR_STATE_AP_CREATED) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    if (l->state == LDNR_STATE_AP_OPEN) {
+        // The filter list belongs to the room that does not exist yet: it is
+        // sent as soon as the room is created.
+        if (l->pending_filter_count < (int)(sizeof l->pending_filters / sizeof l->pending_filters[0]))
+            memcpy(l->pending_filters[l->pending_filter_count++], mac, 6);
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return 0;
+    }
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_operation operation = {0};
+    memcpy(operation.mac, mac, 6);
+    int result = ldnr_client_request(l, LDNR_MSG_FILTER_ACK, LDNR_MSG_FILTER_ACK, id,
+                                     NULL, &operation, NULL, l->config.connect_timeout_ms);
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+int ldnr_clear_accept_filter(ldnr *l) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_AP_OPEN && l->state != LDNR_STATE_AP_CREATED) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    if (l->state == LDNR_STATE_AP_OPEN) {
+        l->pending_filter_count = 0;
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return 0;
+    }
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    int result = ldnr_client_request(l, LDNR_MSG_CLEAR_FILTER_ACK, LDNR_MSG_CLEAR_FILTER_ACK,
+                                     id, NULL, NULL, NULL, l->config.connect_timeout_ms);
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
+
+int ldnr_reject(ldnr *l, uint32_t address) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->control);
+    pthread_mutex_lock(&l->mutex);
+    if (l->state != LDNR_STATE_AP_CREATED) {
+        pthread_mutex_unlock(&l->mutex);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    // The address is the host-order value of nn::ldn; the node list holds
+    // the same form, so the two can be compared directly.
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { pthread_mutex_unlock(&l->mutex); pthread_mutex_unlock(&l->control); return ldnr_fail(LDNR_ENOBUFS); }
+    message->node_id = -1;
+    for (unsigned i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; i++)
+        if (l->network.nodes[i].is_connected && l->network.nodes[i].ipv4_address == address)
+            message->node_id = l->network.nodes[i].node_id;
+    uint64_t id = l->network_id;
+    pthread_mutex_unlock(&l->mutex);
+    if (message->node_id < 0) {
+        ldnr_message_delete(message);
+        pthread_mutex_unlock(&l->control);
+        return ldnr_fail(LDNR_EINVAL);
+    }
+    int result = ldnr_client_request(l, LDNR_MSG_REJECT_ACK, LDNR_MSG_REJECT_ACK, id,
+                                     message, NULL, NULL, l->config.connect_timeout_ms);
+    ldnr_message_delete(message);
+    pthread_mutex_unlock(&l->control);
+    return result;
+}
diff --git a/dm/host/ldnr/ldnr.h b/dm/host/ldnr/ldnr.h
new file mode 100644
index 0000000..d82f463
--- /dev/null
+++ b/dm/host/ldnr/ldnr.h
@@ -0,0 +1,131 @@
+// Public, host-independent LDN relay core. All IP addresses and ports in the
+// socket API are in network byte order, as in BSD sockaddr_in.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+#include "ldnr_native.h"
+
+typedef struct ldnr ldnr;
+typedef struct ldnr_transport ldnr_transport;
+typedef struct ldnr_transport_caps ldnr_transport_caps;
+
+typedef struct {
+    const char *server;             // host:port, required for relay transport
+    const char *room_password;      // relay room password, not the game's LDN passphrase
+    // The relay room password is a user secret and the built-in transport is
+    // a plaintext stream: a create or a connect that carries the password is
+    // refused locally unless this flag accepts the risk explicitly. The
+    // game's own LDN passphrase is not covered by this rule.
+    int allow_plaintext_password;
+    const char *player_name;        // overrides UserConfig when non-empty
+    int log;
+    int connect_timeout_ms;         // 0 selects the core default
+    int scan_timeout_ms;            // 0 selects the core default
+    // The local communication id of this game. It resolves the native id -1
+    // (the game asks the NACP for the id); zero means "unknown".
+    int64_t local_communication_id;
+    const ldnr_transport *transport; // NULL selects the built-in TCP transport
+    // What the host knows about the transport it supplies: a transport that
+    // protects the bytes says so here. A transport that says nothing is
+    // treated as one that does not protect them.
+    const ldnr_transport_caps *transport_caps;
+    void *callback_ctx;
+    void (*state_changed)(void *callback_ctx);
+    // Called with the relevant core mutex held, immediately around a blocking
+    // condition wait. The Apple glue releases the guest core here.
+    void (*native_wait)(void *callback_ctx, int entering);
+    void (*log_message)(void *callback_ctx, const char *message);
+} ldnr_config;
+
+int ldnr_create(const ldnr_config *config, ldnr **out);
+void ldnr_destroy(ldnr *l);
+int ldnr_initialize(ldnr *l);
+void ldnr_finalize(ldnr *l);
+int ldnr_get_state(const ldnr *l);
+int ldnr_open_access_point(ldnr *l);
+int ldnr_close_access_point(ldnr *l);
+int ldnr_open_station(ldnr *l);
+int ldnr_close_station(ldnr *l);
+int ldnr_create_network(ldnr *l, const ldnr_network_config *config,
+                        const ldnr_security_config *security, const ldnr_user_config *user,
+                        const ldnr_security_parameter *private_security,
+                        const ldnr_address_entry *addresses, int address_count);
+int ldnr_scan(ldnr *l, ldnr_network_info *out, int *count, int max_count,
+              const ldnr_scan_filter *filter, int channel, int private_scan);
+int ldnr_connect_network(ldnr *l, const ldnr_network_info *info,
+                         const ldnr_network_config *private_config,
+                         const ldnr_security_config *security, const ldnr_user_config *user,
+                         const ldnr_security_parameter *private_security, int option,
+                         int version);
+int ldnr_disconnect(ldnr *l);
+int ldnr_destroy_network(ldnr *l);
+int ldnr_get_network_info(ldnr *l, ldnr_network_info *out);
+int ldnr_get_network_info_latest_update(ldnr *l, ldnr_node_latest_update *out);
+// The network information and the eight node histories are one snapshot:
+// they are read under a single lock and the histories are cleared only
+// after they were handed over.
+int ldnr_get_network_info_and_history(ldnr *l, ldnr_network_info *out,
+                                      ldnr_node_latest_update *nodes, int count);
+// Ends every wait of this context: the transport is closed and the socket
+// layer is woken. It is the cancellation path of a teardown.
+void ldnr_cancel(ldnr *l);
+int ldnr_get_ipv4_address(ldnr *l, uint32_t *address, uint32_t *mask);
+int ldnr_get_security_parameter(ldnr *l, ldnr_security_parameter *out);
+int ldnr_get_network_config(ldnr *l, ldnr_network_config *out);
+int ldnr_set_advertise_data(ldnr *l, const void *data, size_t size);
+int ldnr_set_station_accept_policy(ldnr *l, int policy);
+int ldnr_add_accept_filter_entry(ldnr *l, const uint8_t mac[6]);
+int ldnr_clear_accept_filter(ldnr *l);
+int ldnr_reject(ldnr *l, uint32_t address);
+int ldnr_get_disconnect_reason(const ldnr *l);
+
+// Socket errors use Horizon/FreeBSD numbers, not the host platform's errno.
+int ldnr_last_errno(void);
+const char *ldnr_last_error(const ldnr *l);
+
+enum {
+    LDNR_POLLIN = 0x0001, LDNR_POLLPRI = 0x0002, LDNR_POLLOUT = 0x0004,
+    LDNR_POLLERR = 0x0008, LDNR_POLLHUP = 0x0010, LDNR_POLLNVAL = 0x0020,
+};
+typedef struct { int32_t fd; int16_t events, revents; } ldnr_pollfd;
+typedef struct { uint32_t address; uint16_t port; } ldnr_sockaddr;
+
+int ldnr_socket(ldnr *l, int family, int type, int protocol);
+int ldnr_close_socket(ldnr *l, int fd);
+int ldnr_shutdown(ldnr *l, int fd, int how);
+int ldnr_bind(ldnr *l, int fd, const ldnr_sockaddr *address);
+int ldnr_get_sock_name(ldnr *l, int fd, ldnr_sockaddr *address);
+int ldnr_get_peer_name(ldnr *l, int fd, ldnr_sockaddr *address);
+ssize_t ldnr_sendto(ldnr *l, int fd, const void *data, size_t size, int flags,
+                    const ldnr_sockaddr *destination);
+ssize_t ldnr_recvfrom(ldnr *l, int fd, void *data, size_t capacity, int flags,
+                      ldnr_sockaddr *source, int timeout_ms);
+ssize_t ldnr_send(ldnr *l, int fd, const void *data, size_t size, int flags);
+ssize_t ldnr_recv(ldnr *l, int fd, void *data, size_t capacity, int flags, int timeout_ms);
+int ldnr_connect_socket(ldnr *l, int fd, const ldnr_sockaddr *destination, int timeout_ms);
+int ldnr_listen(ldnr *l, int fd, int backlog);
