+    decode_ok(filter_ack_frame, sizeof(filter_ack_frame), &message);
+    CHECK(message.type == LDNR_MSG_FILTER_ACK);
+    ldnr_protocol_message_free(&message);
+    decode_ok(clear_filter_ack_frame, sizeof(clear_filter_ack_frame), &message);
+    CHECK(message.type == LDNR_MSG_CLEAR_FILTER_ACK);
