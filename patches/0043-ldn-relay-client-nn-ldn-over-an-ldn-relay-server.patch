+/* The accept policy of the room belongs to the create request: the relay
+ * enforces it before it admits the first station. */
+static void test_create_carries_the_accept_policy(void)
+{
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_operation operation;
+    ldnr_message message;
+    uint8_t always[512], blacklist[512];
+    size_t always_size = 0, blacklist_size = 0;
+    size_t difference = 0;
+    size_t i;
+    int differences = 0;
+
+    memset(&config, 0, sizeof(config));
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memset(&operation, 0, sizeof(operation));
+    memset(&message, 0, sizeof(message));
+    config.node_count_max = 4;
+    memcpy(user.user_name, "host", 4);
+    operation.network_config = &config;
+    operation.security_config = &security;
+    operation.user_config = &user;
+
+    operation.option = 0;   /* always accept */
+    CHECK(ldnr_protocol_encode(always, sizeof(always), &always_size,
+                               LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0,
+                               &message, &operation) == 0);
+    operation.option = 2;   /* blacklist */
+    CHECK(ldnr_protocol_encode(blacklist, sizeof(blacklist), &blacklist_size,
+                               LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0,
+                               &message, &operation) == 0);
+    CHECK(always_size == blacklist_size);
+    /* The policy is the only field that changes. */
+    for (i = 0; i < always_size; ++i) {
+        if (always[i] == blacklist[i]) continue;
+        differences++;
+        difference = i;
+    }
+    CHECK(differences == 1);
+    CHECK(difference > LDNR_WIRE_HEADER);
+    CHECK(blacklist[difference] == 2);
+
+    /* A policy the native enum does not have is refused: the room would
+     * otherwise be created with a policy nobody understands. */
+    operation.option = 4;
+    CHECK(ldnr_protocol_encode(always, sizeof(always), &always_size,
+                               LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0,
+                               &message, &operation) != 0);
+    operation.option = -1;
+    CHECK(ldnr_protocol_encode(always, sizeof(always), &always_size,
+                               LDNR_MSG_CREATE_ACK, UINT64_C(0x01020304), 0,
+                               &message, &operation) != 0);
+}
