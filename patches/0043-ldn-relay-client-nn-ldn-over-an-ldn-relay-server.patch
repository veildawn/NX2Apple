diff --git a/dm/host/ldnr/ldnr_protocol.c b/dm/host/ldnr/ldnr_protocol.c
new file mode 100644
index 0000000..9c9ea55
--- /dev/null
+++ b/dm/host/ldnr/ldnr_protocol.c
@@ -0,0 +1,645 @@
+// ldn-relay-server protocol 1.2. The Go package pkg/protocol and the relay
+// repository's PROTOCOL.md are the reference.
+#include "ldnr_internal.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define LDNR_WIRE_VERSION LDNR_PROTOCOL_MAJOR
+#define LDNR_WIRE_MINOR LDNR_PROTOCOL_MINOR
+#define LDNR_WIRE_MAX_STRING 1024
+#define LDNR_WIRE_CAPS 0x1fu
+
+// The relay writes an address as the four network octets in one word
+// (10.114.0.1 -> 0x0100720A) while nn::ldn keeps the host-order value
+// (10.114.0.1 -> 0x0A720001): the two differ by one byte swap.
+uint32_t ldnr_ipv4_to_native(uint32_t wire) {
+    return ((wire & 0xffu) << 24) | ((wire & 0xff00u) << 8) |
+           ((wire >> 8) & 0xff00u) | ((wire >> 24) & 0xffu);
+}
+uint32_t ldnr_ipv4_from_native(uint32_t native) { return ldnr_ipv4_to_native(native); }
+// Socket ports are in network byte order; the relay carries plain numbers.
+uint16_t ldnr_port_to_host(uint16_t network_order) {
+    return (uint16_t)((network_order << 8) | (network_order >> 8));
+}
+uint16_t ldnr_port_from_host(uint16_t host_order) { return ldnr_port_to_host(host_order); }
+
+static _Thread_local char ldnr_protocol_error_text[192];
+const char *ldnr_protocol_error(void) { return ldnr_protocol_error_text; }
+static int ldnr_wire_fail(const char *format, ...) {
+    va_list ap;
+    va_start(ap, format);
+    vsnprintf(ldnr_protocol_error_text, sizeof ldnr_protocol_error_text, format, ap);
+    va_end(ap);
+    return -1;
+}
+
+typedef struct { uint8_t *data; size_t size, offset; int failed; } ldnr_writer;
+typedef struct { const uint8_t *data; size_t size, offset; int failed; } ldnr_reader;
+
+static void ldnr_put(ldnr_writer *w, const void *data, size_t size) {
+    if (w->failed) return;
+    if (size > w->size - w->offset) { w->failed = 1; return; }
+    // A payload without a buffer is a broken frame, not a frame with holes.
+    if (size && !data) { w->failed = 1; return; }
+    if (size) memcpy(w->data + w->offset, data, size);
+    w->offset += size;
+}
+static void ldnr_u8w(ldnr_writer *w, uint8_t v) { ldnr_put(w, &v, 1); }
+static void ldnr_u16w(ldnr_writer *w, uint16_t v) {
+    uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)}; ldnr_put(w, b, 2);
+}
+static void ldnr_u32w(ldnr_writer *w, uint32_t v) {
+    uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+    ldnr_put(w, b, 4);
+}
+static void ldnr_u64w(ldnr_writer *w, uint64_t v) {
+    ldnr_u32w(w, (uint32_t)v); ldnr_u32w(w, (uint32_t)(v >> 32));
+}
+static void ldnr_blobw(ldnr_writer *w, const void *data, size_t size, size_t maximum) {
+    if (size > maximum || size > 0xffff) { w->failed = 1; return; }
+    ldnr_u16w(w, (uint16_t)size); ldnr_put(w, data, size);
+}
+static void ldnr_strw(ldnr_writer *w, const char *s, size_t maximum) {
+    size_t size = s ? strlen(s) : 0;
+    ldnr_blobw(w, s, size, maximum);
+}
+static int ldnr_get(ldnr_reader *r, void *out, size_t size) {
+    if (r->failed) return 0;
+    if (size > r->size - r->offset) { r->failed = 1; return 0; }
+    if (size && out) memcpy(out, r->data + r->offset, size);
+    r->offset += size;
+    return 1;
+}
+static uint8_t ldnr_u8r(ldnr_reader *r) { uint8_t v = 0; ldnr_get(r, &v, 1); return v; }
+static uint16_t ldnr_u16r(ldnr_reader *r) {
+    uint8_t b[2] = {0}; ldnr_get(r, b, 2); return (uint16_t)(b[0] | (uint16_t)b[1] << 8);
+}
+static uint32_t ldnr_u32r(ldnr_reader *r) {
+    uint8_t b[4] = {0}; ldnr_get(r, b, 4);
+    return (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+}
+static uint64_t ldnr_u64r(ldnr_reader *r) {
+    uint64_t low = ldnr_u32r(r), high = ldnr_u32r(r); return low | high << 32;
+}
+static ldnr_reader ldnr_record_read(ldnr_reader *r) {
+    ldnr_reader body = {0};
+    uint16_t size = ldnr_u16r(r);
+    if (r->failed || size > r->size - r->offset) { r->failed = 1; return body; }
+    body.data = r->data + r->offset; body.size = size; r->offset += size;
+    return body;
+}
+static size_t ldnr_blobr(ldnr_reader *r, uint8_t *out, size_t capacity, size_t maximum) {
+    uint16_t size = ldnr_u16r(r);
+    if (size > maximum || size > capacity) { r->failed = 1; return 0; }
+    ldnr_get(r, out, size); return r->failed ? 0 : size;
+}
+static void ldnr_strr(ldnr_reader *r, char *out, size_t capacity) {
+    uint16_t size = ldnr_u16r(r);
+    if (size > LDNR_WIRE_MAX_STRING || !capacity) { r->failed = 1; return; }
+    const uint8_t *at = r->data + r->offset;
+    if (!ldnr_get(r, NULL, size)) return;
+    size_t copy = size < capacity - 1 ? size : capacity - 1;
+    if (copy) memcpy(out, at, copy);
+    out[copy] = 0;
+}
+
+static int ldnr_frame_finish(ldnr_writer *w, uint8_t type, uint64_t request_id,
+                             size_t *size, uint8_t major) {
+    if (w->failed || w->offset < LDNR_WIRE_HEADER)
+        return ldnr_wire_fail("encoded frame exceeds capacity or field limit");
+    size_t payload = w->offset - LDNR_WIRE_HEADER;
+    if (payload > 0xffffffffu) return ldnr_wire_fail("frame payload is too large");
+    uint8_t header[LDNR_WIRE_HEADER] = {'L', 'D', 'N', 'R', major, type};
+    header[8] = (uint8_t)payload; header[9] = (uint8_t)(payload >> 8);
+    header[10] = (uint8_t)(payload >> 16); header[11] = (uint8_t)(payload >> 24);
+    uint32_t id = (uint32_t)request_id;
+    header[12] = (uint8_t)id; header[13] = (uint8_t)(id >> 8);
+    header[14] = (uint8_t)(id >> 16); header[15] = (uint8_t)(id >> 24);
+    memcpy(w->data, header, sizeof header); *size = w->offset; return 0;
+}
+
+static void ldnr_encode_hello(ldnr_writer *w, const ldnr_operation *op) {
+    ldnr_u8w(w, 1); ldnr_u8w(w, 1); ldnr_u8w(w, LDNR_WIRE_MINOR);
+    ldnr_u32w(w, LDNR_WIRE_CAPS);
+    ldnr_strw(w, op && op->player_name && *op->player_name ? op->player_name : "NX2Apple", 64);
+    ldnr_strw(w, "NX2Apple", 16);
+}
+
+static void ldnr_encode_create(ldnr_writer *w, const ldnr_operation *op) {
+    if (!op || !op->network_config || !op->security_config || !op->user_config) {
+        w->failed = 1; return;
+    }
+    const ldnr_network_config *config = op->network_config;
+    const ldnr_security_config *security = op->security_config;
+    const char *password = op->room_password ? op->room_password : "";
+    size_t password_size = strlen(password);
+    if (config->node_count_max < 1 || config->node_count_max > 8 ||
+        (security->passphrase_size && (security->passphrase_size < 16 || security->passphrase_size > 64)) ||
+        password_size > 64) { w->failed = 1; return; }
+    ldnr_u64w(w, (uint64_t)config->intent_id.local_communication_id);
+    ldnr_u16w(w, config->intent_id.scene_id); ldnr_u16w(w, (uint16_t)config->channel);
+    ldnr_u8w(w, (uint8_t)config->node_count_max); ldnr_u16w(w, security->security_mode);
+    ldnr_blobw(w, security->passphrase, security->passphrase_size, 64);
+    // The accept policy belongs to the create request: the relay enforces it
+    // before it admits the first station.
+    if (op->option < 0 || op->option > 3) { w->failed = 1; return; }
+    ldnr_u8w(w, (uint8_t)op->option);
+    uint8_t mac[6] = {0};
+    if (op->addresses && op->address_count > 0) memcpy(mac, op->addresses[0].mac_address, 6);
+    ldnr_put(w, mac, 6); ldnr_put(w, op->user_config->user_name, 33);
+    ldnr_u8w(w, *password != 0); ldnr_strw(w, password, 64);
+    ldnr_u16w(w, (uint16_t)config->local_communication_version);
+    ldnr_blobw(w, op->data, op->data_size, 384);
+    char fallback_name[33] = {0};
+    memcpy(fallback_name, op->user_config->user_name, 32);
+    const char *room = op->player_name && *op->player_name ? op->player_name :
+        (*fallback_name ? fallback_name : "NX2Apple");
+    ldnr_strw(w, room, 64); ldnr_strw(w, "NX2Apple", 64);
+    ldnr_u8w(w, !op->private_operation);
+    uint8_t parameter[32] = {0};
+    if (op->security_parameter) memcpy(parameter, op->security_parameter, 32);
+    ldnr_put(w, parameter, 32);
+}
+
+static int ldnr_session_is_zero(const uint8_t session[16]) {
+    uint8_t value = 0;
+    for (unsigned i = 0; i < 16; i++) value |= session[i];
+    return value == 0;
+}
+
+static void ldnr_encode_scan(ldnr_writer *w, const ldnr_operation *op) {
+    const ldnr_scan_filter *filter = op ? op->scan_filter : NULL;
+    // The native filter flags (nn::ldn) and the relay flags are different
+    // bit assignments: LocalCommunicationId 0x01, SessionId 0x02,
+    // NetworkType 0x04, Bssid 0x08, Ssid 0x10, SceneId 0x20 map to the
+    // relay's CommID 0x01, SceneID 0x02, Session 0x04, SSID 0x08,
+    // BSSID 0x10 and NetworkType 0x20 (the last two arrived with protocol
+    // 1.2). The relay filters on the BSSID and the network type itself;
+    // the caller still checks them locally.
+    uint8_t flags = 0;
+    uint8_t bssid[6] = {0};
+    uint32_t network_type = 0;
+    if (filter) {
+        if (filter->flags & 0x01) flags |= 0x01; // LocalCommunicationId
+        if (filter->flags & 0x20) flags |= 0x02; // SceneId
+        if (filter->flags & 0x02) flags |= 0x04; // SessionId
+        if (filter->flags & 0x10) flags |= 0x08; // Ssid
+        if (filter->flags & 0x08) { flags |= 0x10; memcpy(bssid, filter->bssid, 6); }
+        if (filter->flags & 0x04) { flags |= 0x20; network_type = filter->network_type; }
+        if (op->private_operation && !ldnr_session_is_zero(filter->network_id.session_id)) flags |= 0x04;
+    }
+    ldnr_u8w(w, flags);
+    ldnr_u64w(w, filter ? (uint64_t)filter->network_id.intent_id.local_communication_id : 0);
+    ldnr_u16w(w, filter ? filter->network_id.intent_id.scene_id : 0);
+    uint8_t session[16] = {0};
+    if (filter) memcpy(session, filter->network_id.session_id, 16);
+    ldnr_put(w, session, 16);
+    char ssid[33] = {0};
+    if (filter && filter->ssid.length <= 32) memcpy(ssid, filter->ssid.string, filter->ssid.length);
+    ldnr_strw(w, ssid, 32);
+    // Protocol 1.2 appended the two trailing filter fields: they are always
+    // sent, the flags alone decide whether they are used.
+    ldnr_put(w, bssid, 6);
+    ldnr_u32w(w, network_type);
+}
+
+static void ldnr_encode_connect(ldnr_writer *w, const ldnr_message *message,
+                                const ldnr_operation *op) {
+    if (!op || !op->security_config || !op->user_config) { w->failed = 1; return; }
+    const ldnr_security_config *security = op->security_config;
+    if (security->passphrase_size && (security->passphrase_size < 16 || security->passphrase_size > 64)) {
+        w->failed = 1; return;
+    }
+    uint8_t session[16] = {0};
+    if (message && message->has_network_info)
+        memcpy(session, message->network_info.network_id.session_id, 16);
+    if (op->security_parameter) memcpy(session, op->security_parameter->session_id, 16);
+    ldnr_put(w, session, 16); ldnr_strw(w, op->room_password ? op->room_password : "", 64);
+    ldnr_blobw(w, security->passphrase, security->passphrase_size, 64);
+    ldnr_put(w, op->user_config->user_name, 33);
+    ldnr_u16w(w, op->network_config ? (uint16_t)op->network_config->local_communication_version : 0);
+    uint8_t mac[6] = {0}; ldnr_put(w, mac, 6);
+    uint8_t parameter[32] = {0};
+    if (op->security_parameter) memcpy(parameter, op->security_parameter, 32);
+    ldnr_put(w, parameter, 32);
+}
+
+int ldnr_protocol_encode_auth(uint8_t *out, size_t capacity, size_t *size,
+                              const char *room_password, const char *player_name) {
+    ldnr_operation op = {0}; op.room_password = room_password; op.player_name = player_name;
+    return ldnr_protocol_encode_ex(out, capacity, size, LDNR_MSG_AUTH_OK, 1, 0, NULL, &op,
+                                   LDNR_PROTOCOL_MAJOR);
+}
+
+int ldnr_protocol_encode(uint8_t *out, size_t capacity, size_t *size,
+                         ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                         const ldnr_message *message, const ldnr_operation *operation) {
+    return ldnr_protocol_encode_ex(out, capacity, size, type, request_id, network_id,
+                                   message, operation, LDNR_PROTOCOL_MAJOR);
+}
+
+int ldnr_protocol_encode_ex(uint8_t *out, size_t capacity, size_t *size,
+                            ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                            const ldnr_message *message, const ldnr_operation *operation,
+                            uint8_t major) {
+    (void)network_id;
+    if (!out || !size || capacity < LDNR_WIRE_HEADER) return ldnr_wire_fail("invalid encode buffer");
+    ldnr_protocol_error_text[0] = 0;
+    ldnr_writer writer = {out, capacity, LDNR_WIRE_HEADER, 0};
+    ldnr_writer *w = &writer;
+    uint8_t wire_type = 0;
+    switch (type) {
+    case LDNR_MSG_AUTH_OK: wire_type = 0x01; ldnr_encode_hello(w, operation); break;
+    case LDNR_MSG_CREATE_ACK: wire_type = 0x10; ldnr_encode_create(w, operation); break;
+    case LDNR_MSG_DESTROY_ACK:
+        wire_type = 0x12;
+        if (!message || !message->has_network_info) w->failed = 1;
+        else ldnr_put(w, message->network_info.network_id.session_id, 16);
+        break;
+    case LDNR_MSG_SCAN_ACK: wire_type = 0x13; ldnr_encode_scan(w, operation); break;
+    case LDNR_MSG_CONNECT_ACK: wire_type = 0x15; ldnr_encode_connect(w, message, operation); break;
+    case LDNR_MSG_DISCONNECTED: wire_type = 0x17; break;
+    case LDNR_MSG_ADVERTISE_ACK:
+        wire_type = 0x18;
+        if (!operation) w->failed = 1;
+        else ldnr_blobw(w, operation->data, operation->data_size, 384);
+        break;
+    case LDNR_MSG_POLICY_ACK:
+        wire_type = 0x19;
+        if (!operation || operation->option < 0 || operation->option > 3) w->failed = 1;
+        else ldnr_u8w(w, (uint8_t)operation->option);
+        break;
+    case LDNR_MSG_FILTER_ACK:
+        wire_type = 0x1b;
+        if (!operation) w->failed = 1; else ldnr_put(w, operation->mac, 6);
+        break;
+    case LDNR_MSG_CLEAR_FILTER_ACK:
+        wire_type = 0x1c;
+        break;
+    case LDNR_MSG_REJECT_ACK:
+        wire_type = 0x1a;
+        if (!message || message->node_id < 0 || message->node_id > 255) w->failed = 1;
+        else ldnr_u8w(w, (uint8_t)message->node_id);
+        break;
+    case LDNR_MSG_UDP:
+        wire_type = 0x30;
+        if (!message || message->udp.size > LDNR_UDP_MTU) { w->failed = 1; break; }
+        ldnr_u32w(w, message->udp.source_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->udp.source_port));
+        ldnr_u32w(w, message->udp.destination_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->udp.destination_port));
+        ldnr_u8w(w, 17); ldnr_u32w(w, 0); ldnr_blobw(w, message->udp.data, message->udp.size, 65472);
+        break;
+    case LDNR_MSG_PROXY_CONNECT:
+        wire_type = 0x31;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_u32w(w, message->proxy.source_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->proxy.source_port));
+        ldnr_u32w(w, message->proxy.destination_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->proxy.destination_port));
+        break;
+    case LDNR_MSG_PROXY_CONNECT_ACK:
+        wire_type = 0x32;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        uint32_t acceptor = message->proxy.source_address ? message->proxy.source_address : message->proxy.destination_address;
+        ldnr_u32w(w, acceptor); // server also overwrites it
+        ldnr_u8w(w, message->status == 0);
+        break;
+    case LDNR_MSG_PROXY_DATA:
+        wire_type = 0x30;
+        if (!message || (message->proxy.size && !message->proxy.data) ||
+            message->proxy.size > 65472) { w->failed = 1; break; }
+        ldnr_u32w(w, message->proxy.source_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->proxy.source_port));
+        ldnr_u32w(w, message->proxy.destination_address);
+        ldnr_u16w(w, ldnr_port_to_host(message->proxy.destination_port));
+        ldnr_u8w(w, 6); ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_blobw(w, message->proxy.data, message->proxy.size, 65472);
+        break;
+    case LDNR_MSG_PROXY_DISCONNECT:
+        wire_type = 0x33;
+        if (!message) { w->failed = 1; break; }
+        ldnr_u32w(w, (uint32_t)message->proxy.connection_id);
+        ldnr_u32w(w, message->proxy.source_address); ldnr_u8w(w, (uint8_t)message->status);
+        ldnr_u8w(w, (uint8_t)message->reason);
+        break;
+    case LDNR_MSG_PING: case LDNR_MSG_PONG:
+        wire_type = type == LDNR_MSG_PING ? 0x03 : 0x04;
+        ldnr_u64w(w, message ? message->timestamp : 0);
+        break;
+    case LDNR_MSG_ERROR:
+        // The client answers a message it cannot read with an error that
+        // names the request it belongs to.
+        wire_type = 0x05;
+        ldnr_u16w(w, (uint16_t)(message ? message->error_code : 0));
+        ldnr_strw(w, message ? message->text : "", 256);
+        break;
+    default: return ldnr_wire_fail("message type %d cannot be encoded", type);
+    }
+    return ldnr_frame_finish(w, wire_type, request_id, size, major);
+}
+
+static int ldnr_decode_network(ldnr_reader *r, ldnr_network_info *info, uint64_t *network_id) {
+    ldnr_reader body = ldnr_record_read(r);
+    if (r->failed) return -1;
+    ldnr_network_info value;
+    memset(&value, 0, sizeof value);
+    *network_id = ldnr_u64r(&body);
+    value.network_id.intent_id.local_communication_id = (int64_t)ldnr_u64r(&body);
+    value.network_id.intent_id.scene_id = ldnr_u16r(&body);
+    ldnr_get(&body, value.network_id.session_id, 16); ldnr_get(&body, value.server_random, 16);
+    ldnr_get(&body, value.common.bssid, 6);
+    uint8_t ssid_size = ldnr_u8r(&body);
+    if (ssid_size > 32) return -1;
+    value.common.ssid.length = ssid_size; ldnr_get(&body, value.common.ssid.string, ssid_size);
+    value.common.channel = (int16_t)ldnr_u16r(&body);
+    value.common.link_level = (int8_t)ldnr_u8r(&body); value.common.network_type = ldnr_u8r(&body);
+    value.security_mode = ldnr_u16r(&body); value.station_accept_policy = ldnr_u8r(&body);
+    uint8_t maximum = ldnr_u8r(&body), count = ldnr_u8r(&body);
+    if (maximum > 8 || count > maximum || body.failed) return -1;
+    value.node_count_max = (int8_t)maximum; value.node_count = count; value.version = 1;
+    for (unsigned i = 0; i < 8; i++) {
+        ldnr_reader node = ldnr_record_read(&body);
+        if (body.failed) return -1;
+        // The relay carries the address as the four network octets in one
+        // word; nn::ldn keeps the host order value.
+        value.nodes[i].ipv4_address = ldnr_ipv4_to_native(ldnr_u32r(&node));
+        ldnr_get(&node, value.nodes[i].mac_address, 6);
+        value.nodes[i].node_id = (int8_t)ldnr_u8r(&node); value.nodes[i].is_connected = ldnr_u8r(&node);
+        ldnr_get(&node, value.nodes[i].user_name, 33);
+        value.nodes[i].local_communication_version = (int16_t)ldnr_u16r(&node);
+        (void)ldnr_u8r(&node);
+        if (node.failed) return -1;
+    }
+    value.advertise_data_size = (uint16_t)ldnr_blobr(&body, value.advertise_data, 384, 384);
+    if (body.failed) return -1;
+    *info = value; return 0;
+}
+
+static int ldnr_decode_scan(ldnr_reader *r, ldnr_message *message,
+                            ldnr_decode_status *status) {
+    uint16_t count = ldnr_u16r(r); (void)ldnr_u16r(r); (void)ldnr_u8r(r);
+    if (r->failed) return -1;
+    int retained = count > LDNR_MAX_NETWORKS ? LDNR_MAX_NETWORKS : count;
+    if (retained) {
+        message->networks = calloc((size_t)retained, sizeof *message->networks);
+        if (!message->networks) {
+            if (status) status->kind = LDNR_DECODE_MEMORY;
+            return ldnr_wire_fail("out of memory for scan results");
+        }
+    }
+    for (uint16_t i = 0; i < count; i++) {
+        ldnr_reader entry = ldnr_record_read(r);
+        if (r->failed) return -1;
+        ldnr_network_result result;
+        memset(&result, 0, sizeof result);
+        if (ldnr_decode_network(&entry, &result.info, &result.network_id)) return -1;
+        (void)ldnr_u8r(&entry); (void)ldnr_u8r(&entry);
+        char ignored[2]; ldnr_strr(&entry, ignored, sizeof ignored);
+        ldnr_strr(&entry, ignored, sizeof ignored);
+        if (entry.failed) return -1;
+        if (i < retained) message->networks[i] = result;
+    }
+    message->network_count = retained; return 0;
+}
+
+static int ldnr_decode_error(ldnr_reader *r, ldnr_message *message) {
+    uint16_t code = ldnr_u16r(r); char detail[192] = {0}; ldnr_strr(r, detail, sizeof detail);
+    if (r->failed) return -1;
+    snprintf(message->text, sizeof message->text, "relay error %u: %s", code, detail);
+    // The relay's own classes are kept apart: the guest can tell a missing
+    // room from a full one, a wrong password from a rejection.
+    message->error_code = code;
+    switch (code) {
+    case 1: message->status = LDNR_EBADFRAME; break;
+    case 2: message->status = LDNR_EUNSUPPORTED; break;
+    case 3: message->status = LDNR_EVERSIONMISMATCH; break;
+    case 4: message->status = LDNR_EROOMNOTFOUND; break;
+    case 5: message->status = LDNR_EROOMFULL; break;
+    case 6: message->status = LDNR_EBADPASSWORD; break;
+    case 7: message->status = LDNR_ENOTINROOM; break;
+    case 8: message->status = LDNR_EALREADYINROOM; break;
+    case 9: message->status = LDNR_ERATELIMITED; break;
+    case 10: message->status = LDNR_ELIMITEXCEEDED; break;
+    case 11: message->status = LDNR_EINTERNAL; break;
+    case 12: message->status = LDNR_EREJECTED; break;
+    case 13: message->status = LDNR_EBADPARAM; break;
+    case 14: message->status = LDNR_ENOTHOST; break;
+    case 15: message->status = LDNR_ESECURITYMISMATCH; break;
+    case 16: message->status = LDNR_ETLSREQUIRED; break;
+    default: message->status = LDNR_ENETDOWN; break;
+    }
+    return 0;
+}
+
+int ldnr_protocol_decode_ex(const uint8_t *frame, size_t size, ldnr_message *message,
+                            uint8_t major, uint32_t limit) {
+    return ldnr_protocol_decode_status(frame, size, message, major, limit, NULL);
+}
+
+// The decoder tells the caller why a frame was refused: a lost datagram
+// leaves the transport alone, a lost TCP payload breaks the stream that
+// carried it, and a broken frame breaks the whole connection.
+int ldnr_protocol_decode_status(const uint8_t *frame, size_t size, ldnr_message *message,
+                                uint8_t major, uint32_t limit, ldnr_decode_status *status) {
+    if (status) {
+        memset(status, 0, sizeof *status);
+        status->kind = LDNR_DECODE_FORMAT;
+    }
+    if (!frame || !message) return ldnr_wire_fail("invalid decode arguments");
+    ldnr_protocol_error_text[0] = 0;
+    if (size < LDNR_WIRE_HEADER) return ldnr_wire_fail("short frame header");
+    if (memcmp(frame, "LDNR", 4)) return ldnr_wire_fail("bad frame magic");
+    // The request id of the header is kept even for a frame that cannot be
+    // read: the error answer has to name the request it belongs to.
+    uint64_t request_id = (uint32_t)frame[12] | (uint32_t)frame[13] << 8 |
+        (uint32_t)frame[14] << 16 | (uint32_t)frame[15] << 24;
+    if (status) { status->request_id = request_id; status->type = frame[5]; }
+    if (frame[4] != major) {
+        if (status) status->kind = LDNR_DECODE_VERSION;
+        return ldnr_wire_fail("unexpected frame version %u", frame[4]);
+    }
+    uint32_t payload_size = (uint32_t)frame[8] | (uint32_t)frame[9] << 8 |
+        (uint32_t)frame[10] << 16 | (uint32_t)frame[11] << 24;
+    if (payload_size != size - LDNR_WIRE_HEADER) return ldnr_wire_fail("frame length mismatch");
+    // The relay announces the payload limit it accepts; a frame above it is
+    // not a valid frame.
+    if (!limit) limit = LDNR_WIRE_DEFAULT_LIMIT;
+    if (payload_size > limit) {
+        if (status) status->kind = LDNR_DECODE_LIMIT;
+        return ldnr_wire_fail("frame payload exceeds the negotiated limit");
+    }
+    ldnr_message decoded;
+    memset(&decoded, 0, sizeof decoded);
+    decoded.request_id = request_id;
+    ldnr_reader reader = {frame + LDNR_WIRE_HEADER, payload_size, 0, 0};
+    ldnr_reader *r = &reader;
+    uint8_t type = frame[5];
+    int result = 0;
+    switch (type) {
+    case 0x01: decoded.type = LDNR_MSG_AUTH_ERROR; result = ldnr_wire_fail("unexpected client HELLO"); break;
+    case 0x02: {
+        decoded.type = LDNR_MSG_AUTH_OK;
+        uint8_t chosen = ldnr_u8r(r), minor = ldnr_u8r(r);
+        (void)ldnr_u8r(r); (void)ldnr_u8r(r);
+        uint32_t capabilities = ldnr_u32r(r);
+        uint8_t connection_id[16]; ldnr_get(r, connection_id, 16);
+        ldnr_strr(r, decoded.text, sizeof decoded.text);
+        // The relay announces the largest payload it accepts; the client
+        // keeps it and never sends a frame above it.
+        decoded.max_frame = ldnr_u32r(r);
+        (void)ldnr_u32r(r); // keepalive interval, unused for now
+        decoded.reason = capabilities;
+        decoded.protocol_major = chosen;
+        decoded.protocol_minor = minor;
+        // The client needs protocol 1.2: it always sends the extended SCAN
+        // payload, and a 1.1 relay would read the trailing fields as part of
+        // the SSID.
+        if (chosen != major || minor < LDNR_PROTOCOL_MINOR || (capabilities & 0x1e) != 0x1e) {
+            decoded.type = LDNR_MSG_AUTH_ERROR; decoded.status = LDNR_EVERSIONMISMATCH;
+            snprintf(decoded.text, sizeof decoded.text,
+                     "relay speaks protocol %u.%u, this client needs %u.%u",
+                     chosen, minor, LDNR_PROTOCOL_MAJOR, LDNR_PROTOCOL_MINOR);
+        }
+        break;
+    }
+    case 0x03: case 0x04:
+        decoded.type = type == 0x03 ? LDNR_MSG_PING : LDNR_MSG_PONG;
+        decoded.timestamp = ldnr_u64r(r); break;
+    case 0x05: decoded.type = LDNR_MSG_ERROR; result = ldnr_decode_error(r, &decoded); break;
+    case 0x11:
+        decoded.type = LDNR_MSG_CREATE_ACK; decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id); break;
+    case 0x12: decoded.type = LDNR_MSG_DESTROY_ACK; break;
+    case 0x14: decoded.type = LDNR_MSG_SCAN_ACK; result = ldnr_decode_scan(r, &decoded, status); break;
+    case 0x16:
+        decoded.type = LDNR_MSG_CONNECT_ACK; decoded.node_id = ldnr_u8r(r);
+        decoded.ipv4 = ldnr_u32r(r); ldnr_get(r, NULL, 6); decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id);
+        { const uint8_t mask[4] = {255, 255, 0, 0}; memcpy(&decoded.subnet_mask, mask, 4); } break;
+    case 0x17: decoded.type = LDNR_MSG_DISCONNECTED; break;
+    case 0x18: decoded.type = LDNR_MSG_ADVERTISE_ACK; break;
+    case 0x19: decoded.type = LDNR_MSG_POLICY_ACK; break;
+    case 0x1a: decoded.type = LDNR_MSG_REJECT_ACK; break;
+    case 0x1b: decoded.type = LDNR_MSG_FILTER_ACK; break;
+    case 0x1c: decoded.type = LDNR_MSG_CLEAR_FILTER_ACK; break;
+    case 0x20:
+        decoded.type = LDNR_MSG_NETWORK_UPDATED; decoded.has_network_info = 1;
+        result = ldnr_decode_network(r, &decoded.network_info, &decoded.network_id); break;
+    case 0x21:
+        decoded.type = LDNR_MSG_DISCONNECTED;
+        { uint8_t session[16]; ldnr_get(r, session, 16); decoded.reason = ldnr_u32r(r); }
+        break;
+    case 0x22: decoded.type = LDNR_MSG_NONE; (void)ldnr_u8r(r); (void)ldnr_u8r(r); break;
+    case 0x30: {
+        decoded.proxy.source_address = ldnr_u32r(r);
+        decoded.proxy.source_port = ldnr_port_from_host(ldnr_u16r(r));
+        decoded.proxy.destination_address = ldnr_u32r(r);
+        decoded.proxy.destination_port = ldnr_port_from_host(ldnr_u16r(r));
+        uint8_t protocol = ldnr_u8r(r); decoded.proxy.connection_id = ldnr_u32r(r);
+        uint16_t length = ldnr_u16r(r);
+        if (length > r->size - r->offset) {
+            // The frame ends before its own payload: a relayed TCP segment
+            // lost its bytes, a datagram is simply lost.
+            r->failed = 1;
+            if (status) {
+                status->kind = protocol == 6 ? LDNR_DECODE_FORMAT : LDNR_DECODE_DATAGRAM;
+                if (protocol == 6) {
+                    status->has_connection_id = 1;
+                    status->connection_id = decoded.proxy.connection_id;
+                }
+            }
+            break;
+        }
+        const uint8_t *data = r->data + r->offset; ldnr_get(r, NULL, length);
+        if (protocol == 17) {
+            decoded.type = LDNR_MSG_UDP;
+            if (length > LDNR_UDP_MTU) {
+                r->failed = 1;
+                if (status) status->kind = LDNR_DECODE_DATAGRAM;
+                break;
+            }
+            decoded.udp.source_address = decoded.proxy.source_address;
+            decoded.udp.source_port = decoded.proxy.source_port;
+            decoded.udp.destination_address = decoded.proxy.destination_address;
+            decoded.udp.destination_port = decoded.proxy.destination_port;
+            decoded.udp.size = length; if (length) memcpy(decoded.udp.data, data, length);
+        } else if (protocol == 6) {
+            decoded.type = LDNR_MSG_PROXY_DATA;
+            // A relayed TCP segment may be larger than the chunk this client
+            // sends: the payload gets its own allocation instead of a fixed
+            // buffer that would reject a valid frame.
+            if (length) {
+                decoded.proxy.data = malloc(length);
+                if (!decoded.proxy.data) {
+                    // The bytes of this segment are lost: the stream that
+                    // carried them must not deliver the ones that follow.
+                    r->failed = 1;
+                    if (status) {
+                        status->kind = LDNR_DECODE_MEMORY;
+                        status->has_connection_id = 1;
+                        status->connection_id = decoded.proxy.connection_id;
+                    }
+                    break;
+                }
+                memcpy(decoded.proxy.data, data, length);
+            }
+            decoded.proxy.size = length;
+        } else decoded.type = LDNR_MSG_NONE;
+        break;
+    }
+    case 0x31:
+        decoded.type = LDNR_MSG_PROXY_CONNECT; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r);
+        decoded.proxy.source_port = ldnr_port_from_host(ldnr_u16r(r));
+        decoded.proxy.destination_address = ldnr_u32r(r);
+        decoded.proxy.destination_port = ldnr_port_from_host(ldnr_u16r(r)); break;
+    case 0x32:
+        decoded.type = LDNR_MSG_PROXY_CONNECT_ACK; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r);
+        decoded.status = ldnr_u8r(r) ? 0 : LDNR_ECONNREFUSED; break;
+    case 0x33:
+        decoded.type = LDNR_MSG_PROXY_DISCONNECT; decoded.proxy.connection_id = ldnr_u32r(r);
+        decoded.proxy.source_address = ldnr_u32r(r); decoded.status = ldnr_u8r(r);
+        decoded.reason = ldnr_u8r(r); break;
+    default:
+        // An unknown mandatory message is answered with an error that names
+        // it; an unknown optional one is ignored by design.
+        if (!(frame[6] & 1)) {
+            result = ldnr_wire_fail("unsupported message type 0x%02x", type);
+            if (status) status->kind = LDNR_DECODE_UNSUPPORTED;
+        }
+        else decoded.type = LDNR_MSG_NONE;
+        break;
+    }
+    if (!result && reader.failed) result = ldnr_wire_fail("malformed or truncated payload type 0x%02x", type);
+    if (result) { ldnr_protocol_message_free(&decoded); return result; }
+    ldnr_protocol_message_free(message); *message = decoded; return 0;
+}
+
+int ldnr_protocol_decode(const uint8_t *frame, size_t size, ldnr_message *message) {
+    return ldnr_protocol_decode_ex(frame, size, message, LDNR_PROTOCOL_MAJOR,
+                                   LDNR_WIRE_DEFAULT_LIMIT);
+}
+
+void ldnr_protocol_message_free(ldnr_message *message) {
+    if (!message) return;
+    free(message->networks); message->networks = NULL; message->network_count = 0;
+    free(message->proxy.data); message->proxy.data = NULL; message->proxy.size = 0;
+}
+
+ldnr_message *ldnr_message_new(void) {
+    ldnr_message *message = calloc(1, sizeof *message);
+    if (!message) ldnr_wire_fail("out of memory for a relay message");
+    return message;
+}
+
+void ldnr_message_delete(ldnr_message *message) {
+    if (!message) return;
+    ldnr_protocol_message_free(message);
+    free(message);
+}
diff --git a/dm/host/ldnr/ldnr_protocol.h b/dm/host/ldnr/ldnr_protocol.h
new file mode 100644
index 0000000..cf46534
--- /dev/null
+++ b/dm/host/ldnr/ldnr_protocol.h
@@ -0,0 +1,163 @@
+// Protocol-neutral messages exchanged between the codec and the LDN core.
+// The wire representation lives only in ldnr_protocol.c.
+#pragma once
+#include "ldnr_native.h"
+
+#define LDNR_UDP_MTU 1500
+#define LDNR_TCP_CHUNK 16384
+#define LDNR_MAX_NETWORKS 32
+// The payload limit of the relay before it announces its own.
+#define LDNR_WIRE_DEFAULT_LIMIT 65536
+
+// The fixed frame header: magic, version, type, flags, payload size, request.
+#define LDNR_WIRE_HEADER 16
+// The PROXY_DATA payload fields before the payload blob: the two addresses,
+// the two ports, the protocol byte, the connection id and the blob length
+// (4 + 2 + 4 + 2 + 1 + 4 + 2).
+#define LDNR_PROXY_DATA_OVERHEAD 19
+
+// The relay protocol this client speaks. The header carries the negotiated
+// major; the minor is announced in the HELLO and comes back in the HELLO_ACK.
+#define LDNR_PROTOCOL_MAJOR 1
+#define LDNR_PROTOCOL_MINOR 2
+
+typedef enum {
+    LDNR_MSG_NONE = 0,
+    LDNR_MSG_AUTH_OK,
+    LDNR_MSG_AUTH_ERROR,
+    LDNR_MSG_CREATE_ACK,
+    LDNR_MSG_SCAN_ACK,
+    LDNR_MSG_CONNECT_ACK,
+    LDNR_MSG_NETWORK_UPDATED,
+    LDNR_MSG_DISCONNECTED,
+    LDNR_MSG_DESTROY_ACK,
+    LDNR_MSG_ADVERTISE_ACK,
+    LDNR_MSG_POLICY_ACK,
+    LDNR_MSG_FILTER_ACK,
+    LDNR_MSG_CLEAR_FILTER_ACK,
+    LDNR_MSG_REJECT_ACK,
+    LDNR_MSG_UDP,
+    LDNR_MSG_PROXY_CONNECT,
+    LDNR_MSG_PROXY_CONNECT_ACK,
+    LDNR_MSG_PROXY_DATA,
+    LDNR_MSG_PROXY_DISCONNECT,
+    LDNR_MSG_PING,
+    LDNR_MSG_PONG,
+    LDNR_MSG_ERROR,
+} ldnr_message_type;
+
+typedef struct {
+    uint64_t network_id;
+    ldnr_network_info info;
+} ldnr_network_result;
+
+typedef struct {
+    ldnr_message_type type;
+    uint64_t request_id;
+    uint64_t network_id;
+    uint64_t timestamp;
+    uint32_t status;
+    uint32_t reason;
+    uint32_t error_code;              // the relay's own error code, if any
+    uint32_t ipv4;
+    uint32_t max_frame;               // frame limit announced by the relay
+    uint8_t protocol_major;           // the major the relay selected
+    uint8_t protocol_minor;           // the minor the relay speaks
+    int node_id;
+    uint32_t subnet_mask;
+    int has_network_info;
+    ldnr_network_info network_info;
+    ldnr_network_result *networks;
+    int network_count;
+    struct {
+        uint32_t source_address, destination_address;
+        uint16_t source_port, destination_port;
+        size_t size;
+        uint8_t data[LDNR_UDP_MTU];
+    } udp;
+    struct {
+        uint64_t connection_id;
+        uint32_t source_address, destination_address;
+        uint16_t source_port, destination_port;
+        size_t size;
+        // The payload is heap allocated: a relayed TCP segment may be larger
+        // than the chunk the socket layer sends.
+        uint8_t *data;
+    } proxy;
+    char text[256];
+} ldnr_message;
+
+// Why a frame could not be decoded. The caller must not treat a lost TCP
+// payload like a lost datagram: the stream that carried it is broken.
+enum {
+    LDNR_DECODE_OK = 0,
+    LDNR_DECODE_FORMAT = 1,       // the frame is broken: the transport is broken
+    LDNR_DECODE_VERSION = 2,      // the relay speaks another protocol major
+    LDNR_DECODE_LIMIT = 3,        // the frame is above the negotiated limit
+    LDNR_DECODE_MEMORY = 4,       // the payload could not be allocated
+    LDNR_DECODE_UNSUPPORTED = 5,  // an unknown mandatory message type
+    LDNR_DECODE_DATAGRAM = 6,     // a datagram was lost: the transport is fine
+};
+
+typedef struct {
+    int kind;                      // one of the LDNR_DECODE_ classes
+    int has_connection_id;          // the frame carried a proxied TCP payload
+    uint64_t connection_id;         // the stream that lost its bytes
+    uint64_t request_id;            // the header's request id
+    uint8_t type;                   // the wire type of the frame
+} ldnr_decode_status;
+
+// Outgoing operations use an explicit message plus the immutable call inputs.
+typedef struct {
+    const ldnr_network_config *network_config;
+    const ldnr_security_config *security_config;
+    const ldnr_user_config *user_config;
+    const ldnr_security_parameter *security_parameter;
+    const ldnr_scan_filter *scan_filter;
+    const ldnr_address_entry *addresses;
+    const void *data;
+    size_t data_size;
+    const char *room_password;
+    const char *player_name;
+    int address_count;
+    int channel;
+    int option;
+    int private_operation;
+    int backlog;
+    uint8_t mac[6];
+} ldnr_operation;
+
+// The relay carries an address as the four network octets in one word
+// (10.114.0.1 -> 0x0100720A), while nn::ldn keeps the host order value
+// (10.114.0.1 -> 0x0A720001). The socket ports are in network byte order,
+// the relay carries plain numbers.
+uint32_t ldnr_ipv4_to_native(uint32_t wire);
+uint32_t ldnr_ipv4_from_native(uint32_t native);
+uint16_t ldnr_port_to_host(uint16_t network_order);
+uint16_t ldnr_port_from_host(uint16_t host_order);
+
+int ldnr_protocol_encode_auth(uint8_t *out, size_t capacity, size_t *size,
+                              const char *room_password, const char *player_name);
+int ldnr_protocol_encode(uint8_t *out, size_t capacity, size_t *size,
+                         ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                         const ldnr_message *message, const ldnr_operation *operation);
+// The variants carry the negotiated protocol major explicitly: every frame
+// after the HELLO uses the major that the relay selected, and every incoming
+// frame is checked against it.
+int ldnr_protocol_encode_ex(uint8_t *out, size_t capacity, size_t *size,
+                            ldnr_message_type type, uint64_t request_id, uint64_t network_id,
+                            const ldnr_message *message, const ldnr_operation *operation,
+                            uint8_t major);
+int ldnr_protocol_decode_ex(const uint8_t *frame, size_t size, ldnr_message *message,
+                            uint8_t major, uint32_t limit);
+// The variant that tells the caller why the frame was refused: the class of
+// the failure decides whether one stream or the whole transport ends.
+int ldnr_protocol_decode_status(const uint8_t *frame, size_t size, ldnr_message *message,
+                                uint8_t major, uint32_t limit, ldnr_decode_status *status);
+int ldnr_protocol_decode(const uint8_t *frame, size_t size, ldnr_message *message);
+void ldnr_protocol_message_free(ldnr_message *message);
+// A message carries the inline UDP and TCP payloads, so it is far too large
+// for a guest stack that can be as small as 8 KB: it is always heap allocated.
+ldnr_message *ldnr_message_new(void);
+void ldnr_message_delete(ldnr_message *message);
+const char *ldnr_protocol_error(void);
diff --git a/dm/host/ldnr/ldnr_tcp.c b/dm/host/ldnr/ldnr_tcp.c
new file mode 100644
index 0000000..68d0bab
--- /dev/null
+++ b/dm/host/ldnr/ldnr_tcp.c
@@ -0,0 +1,534 @@
+// POSIX stream transport for LDNR frames. TLS is deliberately not implicit:
+// use a TLS endpoint/tunnel until this small transport gains certificate verification.
+#include "ldnr_transport.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#define LDNR_TCP_HEADER 16
+// A write may not block forever: the relay has to answer within this time.
+#define LDNR_TCP_WRITE_TIMEOUT_MS 10000
+// The payload limit of the relay before it announces its own.
+#define LDNR_TCP_DEFAULT_LIMIT (64u * 1024u)
+// The deadline of a connect that the caller did not bound.
+#define LDNR_TCP_CONNECT_TIMEOUT_MS 5000
+// How long a connect waits between two checks of the cancellation.
+#define LDNR_TCP_POLL_SLICE_MS 50
+
+// A connection of the transport. The descriptor belongs to the connection and
+// not to the transport: a connection that is replaced is shut down at once,
+// but its descriptor is closed only when the reader and the writers that
+// still hold it are gone.
+typedef struct ldnr_tcp_conn {
+    int fd;
+    uint64_t generation;
+    int refs;                 // the owner of the descriptor and its users
+    int retired;              // no new user may take it
+    int closed;               // the descriptor is closed
+} ldnr_tcp_conn;
+
+typedef struct ldnr_tcp {
+    struct ldnr_tcp *next;              // the registry of the transports
+    pthread_mutex_t mutex;             // guards the connection and the state
+    pthread_mutex_t send_mutex;         // serializes the writers
+    ldnr_tcp_conn *current;             // the connection in use
+    // The connection of a connect that is in progress. It owns its
+    // descriptor like any other: a close that interrupts the connect shuts
+    // the descriptor down, and the worker that owns the connect closes it.
+    ldnr_tcp_conn *connecting;
+    uint64_t generation;                // identity of the connection
+    uint32_t limit;                     // the largest payload the relay accepts
+    int failed;                         // the framing stream is broken
+    int closed;                         // the transport was closed
+} ldnr_tcp;
+
+// The transports that were built here. The core asks a transport for its
+// optional capabilities; only the ones that were built here have any.
+static pthread_mutex_t ldnr_tcp_registry_mutex = PTHREAD_MUTEX_INITIALIZER;
+static ldnr_tcp *ldnr_tcp_registry;
+
+static int64_t ldnr_tcp_now_ms(void) {
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) return 0;
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static void ldnr_tcp_error(char *out, size_t size, const char *text) {
+    if (out && size) snprintf(out, size, "%s", text);
+}
+
+static int ldnr_tcp_split(const char *server, char **host, char **port,
+                          char *error, size_t error_size) {
+    if (!server || !*server) { ldnr_tcp_error(error, error_size, "empty relay address"); return -1; }
+    const char *port_at = NULL;
+    size_t host_size;
+    if (server[0] == '[') {
+        const char *end = strchr(server, ']');
+        if (!end || (end[1] && end[1] != ':')) {
+            ldnr_tcp_error(error, error_size, "invalid bracketed relay address"); return -1;
+        }
+        *host = strndup(server + 1, (size_t)(end - server - 1));
+        port_at = end[1] == ':' ? end + 2 : NULL;
+        host_size = (size_t)(end - server - 1);
+    } else {
+        const char *colon = strrchr(server, ':');
+        if (colon && strchr(server, ':') == colon) port_at = colon + 1;
+        host_size = port_at ? (size_t)(port_at - server - 1) : strlen(server);
+        *host = strndup(server, host_size);
+    }
+    *port = strdup(port_at && *port_at ? port_at : "11470");
+    if (!*host || !*port || !host_size || !**port) {
+        free(*host); free(*port); *host = *port = NULL;
+        ldnr_tcp_error(error, error_size, "invalid or unallocatable relay address"); return -1;
+    }
+    return 0;
+}
+
+// The descriptor is non-blocking: macOS ignores MSG_DONTWAIT on some
+// sockets (and hides it under a strict POSIX level), so the send deadline
+// and interruptibility cannot rely on the flag alone. Reads wait with poll.
+static void ldnr_tcp_nonblock(int fd) {
+    int fl = fcntl(fd, F_GETFL);
+    if (fl >= 0) (void)fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+}
+
+// Gives a reference back. The descriptor of a retired connection is closed
+// when its last user is gone: a writer that lost the race with a reconnect
+// must never write into a descriptor that the kernel gave to someone else.
+static void ldnr_tcp_conn_release(ldnr_tcp *tcp, ldnr_tcp_conn *conn) {
+    if (!conn) return;
+    int close_now = 0, free_now = 0;
+    pthread_mutex_lock(&tcp->mutex);
+    conn->refs--;
+    if (conn->refs == 0) {
+        if (conn->retired && !conn->closed) { conn->closed = 1; close_now = 1; }
+        free_now = 1;
+    }
+    pthread_mutex_unlock(&tcp->mutex);
+    if (close_now) close(conn->fd);
+    if (free_now) free(conn);
+}
+
+// Retires a connection: it is shut down, so that a reader that waits on it
+// returns at once, and closed when its last user is gone.
+static void ldnr_tcp_conn_retire(ldnr_tcp *tcp, ldnr_tcp_conn *conn) {
+    if (!conn) return;
+    pthread_mutex_lock(&tcp->mutex);
+    conn->retired = 1;
+    pthread_mutex_unlock(&tcp->mutex);
+    shutdown(conn->fd, SHUT_RDWR);
+    // The owner of the descriptor gives it up.
+    ldnr_tcp_conn_release(tcp, conn);
+}
+
+// Waits for the connect to finish. The descriptor is not blocking: the wait
+// ends at the deadline or when the caller cancels it.
+static int ldnr_tcp_connect_wait(int fd, const struct sockaddr *address, socklen_t length,
+                                 int64_t deadline, int (*cancelled)(void *), void *cancel_ctx,
+                                 int *error) {
+    if (connect(fd, address, length) == 0) return 1;
+    if (errno != EINPROGRESS && errno != EINTR && errno != EALREADY) {
+        *error = errno;
+        return 0;
+    }
+    for (;;) {
+        if (cancelled && cancelled(cancel_ctx)) { *error = ECANCELED; return 0; }
+        int64_t remaining = deadline - ldnr_tcp_now_ms();
+        if (remaining <= 0) { *error = ETIMEDOUT; return 0; }
+        struct pollfd waiter = {fd, POLLOUT, 0};
+        int slice = remaining > LDNR_TCP_POLL_SLICE_MS ? LDNR_TCP_POLL_SLICE_MS
+                                                       : (int)remaining;
+        int ready = poll(&waiter, 1, slice);
+        if (ready < 0) {
+            if (errno == EINTR) continue;
+            *error = errno;
+            return 0;
+        }
+        // The slice ended without an answer: the deadline and the
+        // cancellation are checked again.
+        if (!ready) continue;
+        int failure = 0;
+        socklen_t size = sizeof failure;
+        if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &failure, &size) < 0) {
+            *error = errno;
+            return 0;
+        }
+        if (failure) { *error = failure; return 0; }
+        return 1;
+    }
+}
+
+static int ldnr_tcp_connect_ex(void *ctx, const char *server, char *error, size_t error_size,
+                               int timeout_ms, int (*cancelled)(void *), void *cancel_ctx) {
+    ldnr_tcp *tcp = ctx;
+    char *host = NULL, *port = NULL;
+    // A new attempt opens the transport again: the close that preceded it
+    // was the end of the previous connection.
+    pthread_mutex_lock(&tcp->mutex);
+    tcp->closed = 0;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (ldnr_tcp_split(server, &host, &port, error, error_size)) return -1;
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM; hints.ai_protocol = IPPROTO_TCP;
+    struct addrinfo *addresses = NULL;
+    // The name lookup is not bounded: it is a call into the resolver of the
+    // host, and the resolver decides how long it takes. The connect that
+    // follows is bounded and cancellable.
+    int gai = getaddrinfo(host, port, &hints, &addresses);
+    free(host); free(port);
+    if (gai) { ldnr_tcp_error(error, error_size, gai_strerror(gai)); return -1; }
+    if (timeout_ms <= 0) timeout_ms = LDNR_TCP_CONNECT_TIMEOUT_MS;
+    int64_t deadline = ldnr_tcp_now_ms() + timeout_ms;
+    int saved = ECONNREFUSED;
+    ldnr_tcp_conn *conn = NULL;
+    for (struct addrinfo *at = addresses; at; at = at->ai_next) {
+        if (cancelled && cancelled(cancel_ctx)) { saved = ECANCELED; break; }
+        int fd = socket(at->ai_family, at->ai_socktype, at->ai_protocol);
+        if (fd < 0) { saved = errno; continue; }
+        int one = 1;
+        (void)setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof one);
+#ifdef SO_NOSIGPIPE
+        (void)setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+        ldnr_tcp_nonblock(fd);
+        // The descriptor belongs to a connection from now on: it is closed
+        // exactly once, by the worker that owns it, and a close that
+        // interrupts the connect only shuts it down. A descriptor that the
+        // kernel gave to somebody else is never touched.
+        ldnr_tcp_conn *pending = calloc(1, sizeof *pending);
+        if (!pending) { close(fd); saved = ENOMEM; break; }
+        pending->fd = fd;
+        pending->refs = 1;              // the worker owns the connect
+        // The descriptor is published before the connect: a cancellation
+        // closes it and ends the wait at once.
+        pthread_mutex_lock(&tcp->mutex);
+        pending->refs++;                // the published slot owns a reference
+        tcp->connecting = pending;
+        pthread_mutex_unlock(&tcp->mutex);
+        int connected = ldnr_tcp_connect_wait(fd, at->ai_addr, at->ai_addrlen, deadline,
+                                              cancelled, cancel_ctx, &saved);
+        pthread_mutex_lock(&tcp->mutex);
+        // The connect is over: the descriptor leaves the published slot,
+        // unless a close has taken it already.
+        int published = tcp->connecting == pending;
+        if (published) tcp->connecting = NULL;
+        pthread_mutex_unlock(&tcp->mutex);
+        if (published) ldnr_tcp_conn_release(tcp, pending);
+        if (!connected) {
+            // The attempt failed: the descriptor is closed here, once.
+            ldnr_tcp_conn_retire(tcp, pending);
+            continue;
+        }
+        conn = pending;
+        break;
+    }
+    freeaddrinfo(addresses);
+    if (!conn) {
+        ldnr_tcp_error(error, error_size, strerror(saved));
+        return -1;
+    }
+    // The connection replaces the old one. The old descriptor is shut down
+    // and closed only after the reader and the writers that still hold it
+    // are gone, so that nobody writes into a descriptor the kernel reused.
+    pthread_mutex_lock(&tcp->mutex);
+    if (tcp->closed) {
+        // The transport was closed while the connect was in progress: the
+        // connection is dropped instead of reviving a closed transport.
+        pthread_mutex_unlock(&tcp->mutex);
+        ldnr_tcp_conn_retire(tcp, conn);
+        ldnr_tcp_error(error, error_size, "the transport was closed");
+        return -1;
+    }
+    ldnr_tcp_conn *old = tcp->current;
+    tcp->current = NULL;
+    conn->generation = ++tcp->generation;
+    tcp->current = conn;
+    tcp->failed = 0;
+    pthread_mutex_unlock(&tcp->mutex);
+    ldnr_tcp_conn_retire(tcp, old);
+    return 0;
+}
+
+static int ldnr_tcp_connect(void *ctx, const char *server, char *error, size_t error_size) {
+    return ldnr_tcp_connect_ex(ctx, server, error, error_size,
+                                LDNR_TCP_CONNECT_TIMEOUT_MS, NULL, NULL);
+}
+
+// The capabilities of the built-in transport: the connect is bounded and
+// the bytes travel in the clear.
+static const ldnr_transport_caps ldnr_tcp_caps = {
+    ldnr_tcp_connect_ex,
+    1,
+};
+
+const ldnr_transport_caps *ldnr_transport_caps_of(const ldnr_transport *transport) {
+    if (!transport || !transport->ctx) return NULL;
+    ldnr_tcp *tcp = transport->ctx;
+    pthread_mutex_lock(&ldnr_tcp_registry_mutex);
+    int found = 0;
+    for (ldnr_tcp *at = ldnr_tcp_registry; at; at = at->next) {
+        if (at == tcp) { found = 1; break; }
+    }
+    pthread_mutex_unlock(&ldnr_tcp_registry_mutex);
+    return found ? &ldnr_tcp_caps : NULL;
+}
+
+static ssize_t ldnr_tcp_read(int fd, uint8_t *out, size_t size) {
+    size_t done = 0;
+    while (done < size) {
+        ssize_t n = recv(fd, out + done, size - done, 0);
+        if (n > 0) { done += (size_t)n; continue; }
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            struct pollfd waiter = {fd, POLLIN, 0};
+            if (poll(&waiter, 1, -1) < 0 && errno != EINTR) return -1;
+            continue;
+        }
+        return n == 0 && done == 0 ? 0 : -1;
+    }
+    return (ssize_t)done;
+}
+
+// A framing error ends the connection: the bytes that follow the break
+// would be read as the start of a frame. A connection that was replaced in
+// the meantime keeps its own state: the descriptor belongs to the new
+// connection now and must not be touched.
+static void ldnr_tcp_fail(ldnr_tcp *tcp, ldnr_tcp_conn *conn) {
+    pthread_mutex_lock(&tcp->mutex);
+    int current = tcp->current == conn;
+    if (current) tcp->failed = 1;
+    pthread_mutex_unlock(&tcp->mutex);
+    // The shutdown wakes the reader of the connection.
+    if (current) shutdown(conn->fd, SHUT_RDWR);
+}
+
+static ssize_t ldnr_tcp_recv(void *ctx, void *frame, size_t capacity) {
+    ldnr_tcp *tcp = ctx;
+    pthread_mutex_lock(&tcp->mutex);
+    ldnr_tcp_conn *conn = tcp->current;
+    uint32_t limit = tcp->limit;
+    int failed = tcp->failed;
+    if (conn) conn->refs++;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (!conn || failed || capacity < LDNR_TCP_HEADER) {
+        ldnr_tcp_conn_release(tcp, conn);
+        return -1;
+    }
+    if (!limit) limit = LDNR_TCP_DEFAULT_LIMIT;
+    uint8_t *out = frame;
+    ssize_t result = -1;
+    if (ldnr_tcp_read(conn->fd, out, LDNR_TCP_HEADER) != LDNR_TCP_HEADER) {
+        ldnr_tcp_fail(tcp, conn);
+    } else if (memcmp(out, "LDNR", 4)) {
+        ldnr_tcp_fail(tcp, conn);
+    } else {
+        uint32_t payload = (uint32_t)out[8] | (uint32_t)out[9] << 8 |
+            (uint32_t)out[10] << 16 | (uint32_t)out[11] << 24;
+        // The limit of the relay is checked before the payload is read: a
+        // frame above it is refused instead of being read into the buffer.
+        if (payload > limit || payload > capacity - LDNR_TCP_HEADER) {
+            ldnr_tcp_fail(tcp, conn);
+        } else if (ldnr_tcp_read(conn->fd, out + LDNR_TCP_HEADER, payload) != (ssize_t)payload) {
+            ldnr_tcp_fail(tcp, conn);
+        } else {
+            result = (ssize_t)(LDNR_TCP_HEADER + payload);
+        }
+    }
+    ldnr_tcp_conn_release(tcp, conn);
+    return result;
+}
+
+// The write is interruptible and bounded by a deadline: a relay that stops
+// reading must not keep the sender blocked, and close() has to be able to
+// interrupt it. The descriptor lock is never held while writing, so the
+// shutdown in close() always reaches the socket.
+static int ldnr_tcp_send(void *ctx, const void *frame, size_t size) {
+    ldnr_tcp *tcp = ctx;
+    const uint8_t *data = frame;
+    int flags = 0;
+#ifdef MSG_NOSIGNAL
+    flags |= MSG_NOSIGNAL;
+#endif
+#ifdef MSG_DONTWAIT
+    flags |= MSG_DONTWAIT;
+#endif
+    // The connection is pinned before the wait for the writer's lock: a
+    // submission that was made for the old connection must not continue on
+    // the one that replaced it.
+    pthread_mutex_lock(&tcp->mutex);
+    ldnr_tcp_conn *conn = tcp->current;
+    uint64_t submission = tcp->generation;
+    int failed = tcp->failed;
+    if (conn) conn->refs++;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (!conn || failed) {
+        ldnr_tcp_conn_release(tcp, conn);
+        return -1;
+    }
+    pthread_mutex_lock(&tcp->send_mutex);
+    int result = 0;
+    // The connection may have been replaced while this writer waited for the
+    // lock: the frame belongs to the old one and is not written on the new.
+    pthread_mutex_lock(&tcp->mutex);
+    int replaced = tcp->current != conn || tcp->generation != submission;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (replaced) {
+        result = -1;
+    } else {
+        int64_t deadline = ldnr_tcp_now_ms() + LDNR_TCP_WRITE_TIMEOUT_MS;
+        size_t done = 0;
+        while (done < size) {
+            // The connection is checked again: it may have been replaced
+            // while this frame was written.
+            pthread_mutex_lock(&tcp->mutex);
+            int stale = tcp->current != conn || tcp->generation != submission || tcp->failed;
+            pthread_mutex_unlock(&tcp->mutex);
+            if (stale) { result = -1; break; }
+            ssize_t n = send(conn->fd, data + done, size - done, flags);
+            if (n > 0) { done += (size_t)n; continue; }
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+                // The socket buffer is full: wait for room, but not forever.
+                int64_t remaining = deadline - ldnr_tcp_now_ms();
+                if (remaining <= 0) { result = -1; break; }
+                struct pollfd waiter = {conn->fd, POLLOUT, 0};
+                int ready = poll(&waiter, 1, (int)(remaining > 1000 ? 1000 : remaining));
+                if (ready < 0) { if (errno == EINTR) continue; result = -1; break; }
+                continue;
+            }
+            result = -1; break;
+        }
+        if (result) {
+            // A partial write leaves the framing stream broken: the
+            // connection cannot carry another frame.
+            ldnr_tcp_fail(tcp, conn);
+        }
+    }
+    pthread_mutex_unlock(&tcp->send_mutex);
+    ldnr_tcp_conn_release(tcp, conn);
+    return result;
+}
+
+// The relay announces the largest payload it accepts: a frame above it is
+// refused before its payload is read.
+static void ldnr_tcp_set_limit(void *ctx, uint32_t limit) {
+    ldnr_tcp *tcp = ctx;
+    if (!limit) limit = LDNR_TCP_DEFAULT_LIMIT;
+    pthread_mutex_lock(&tcp->mutex);
+    tcp->limit = limit;
+    pthread_mutex_unlock(&tcp->mutex);
+}
+
+static void ldnr_tcp_close(void *ctx) {
+    ldnr_tcp *tcp = ctx;
+    pthread_mutex_lock(&tcp->mutex);
+    tcp->closed = 1;
+    // A connect that is in progress is interrupted: the wait ends at once.
+    // The published slot owns a reference, so the descriptor stays alive
+    // until the shutdown below has reached it.
+    ldnr_tcp_conn *connecting = tcp->connecting;
+    tcp->connecting = NULL;
+    // The connection in use is retired: its descriptor is shut down, so that
+    // the reader returns, and closed when its last user is gone.
+    ldnr_tcp_conn *conn = tcp->current;
+    tcp->current = NULL;
+    pthread_mutex_unlock(&tcp->mutex);
+    if (connecting) {
+        // Only the shutdown happens here: the worker that owns the connect
+        // closes the descriptor when the connect is over. A descriptor that
+        // the kernel gave to somebody else is never shut down.
+        pthread_mutex_lock(&tcp->mutex);
+        connecting->retired = 1;
+        pthread_mutex_unlock(&tcp->mutex);
+        shutdown(connecting->fd, SHUT_RDWR);
+        ldnr_tcp_conn_release(tcp, connecting);
+    }
+    ldnr_tcp_conn_retire(tcp, conn);
+}
+
+static void ldnr_tcp_destroy(void *ctx) {
+    ldnr_tcp *tcp = ctx;
+    if (!tcp) return;
+    ldnr_tcp_close(tcp);
+    // The transport leaves the registry before its memory goes away.
+    pthread_mutex_lock(&ldnr_tcp_registry_mutex);
+    ldnr_tcp **link = &ldnr_tcp_registry;
+    while (*link) {
+        if (*link == tcp) { *link = tcp->next; break; }
+        link = &(*link)->next;
+    }
+    pthread_mutex_unlock(&ldnr_tcp_registry_mutex);
+    pthread_mutex_destroy(&tcp->mutex);
+    pthread_mutex_destroy(&tcp->send_mutex);
+    free(tcp);
+}
+
+const ldnr_transport *ldnr_tcp_transport_create(void) {
+    ldnr_transport *transport = calloc(1, sizeof *transport);
+    ldnr_tcp *tcp = calloc(1, sizeof *tcp);
+    if (!transport || !tcp || pthread_mutex_init(&tcp->mutex, NULL) ||
+        pthread_mutex_init(&tcp->send_mutex, NULL)) {
+        free(transport); free(tcp); return NULL;
+    }
+    tcp->limit = LDNR_TCP_DEFAULT_LIMIT;
+    transport->ctx = tcp;
+    transport->connect = ldnr_tcp_connect;
+    transport->recv = ldnr_tcp_recv;
+    transport->send = ldnr_tcp_send; transport->close = ldnr_tcp_close;
+    transport->destroy = ldnr_tcp_destroy;
+    transport->set_limit = ldnr_tcp_set_limit;
+    // The transport joins the registry: the core asks it for the optional
+    // capabilities that the plain contract does not carry.
+    pthread_mutex_lock(&ldnr_tcp_registry_mutex);
+    tcp->next = ldnr_tcp_registry;
+    ldnr_tcp_registry = tcp;
+    pthread_mutex_unlock(&ldnr_tcp_registry_mutex);
+    return transport;
+}
+
+// Test hook: the descriptor of the connect that is in progress, or -1 when
+// there is none. The descriptor belongs to the transport while it is
+// published: the tests use it to check that a close interrupts the connect
+// without reaching a descriptor of somebody else.
+int ldnr_tcp_test_connecting_fd(const ldnr_transport *transport) {
+    if (!transport || !transport->ctx) return -1;
+    ldnr_tcp *tcp = transport->ctx;
+    pthread_mutex_lock(&tcp->mutex);
+    int fd = tcp->connecting ? tcp->connecting->fd : -1;
+    pthread_mutex_unlock(&tcp->mutex);
+    return fd;
+}
+
+// Test hook: replaces the connected descriptor with one the caller owns.
+// The old descriptor is shut down and closed exactly like a reconnect does,
+// so the tests can check that a writer pinned to the old connection does not
+// continue on the new one. It is not part of the public API.
+void ldnr_tcp_test_replace(const ldnr_transport *transport, int fd) {
+    ldnr_tcp *tcp = transport->ctx;
+    if (fd >= 0) ldnr_tcp_nonblock(fd);
+    pthread_mutex_lock(&tcp->mutex);
+    ldnr_tcp_conn *conn = calloc(1, sizeof *conn);
+    if (!conn) { pthread_mutex_unlock(&tcp->mutex); return; }
+    ldnr_tcp_conn *old = tcp->current;
+    tcp->current = NULL;
+    conn->fd = fd;
+    conn->generation = ++tcp->generation;
+    conn->refs = 1;
+    tcp->current = conn;
+    tcp->failed = 0;
+    pthread_mutex_unlock(&tcp->mutex);
+    ldnr_tcp_conn_retire(tcp, old);
+}
diff --git a/dm/host/ldnr/ldnr_transport.h b/dm/host/ldnr/ldnr_transport.h
new file mode 100644
index 0000000..f158534
--- /dev/null
+++ b/dm/host/ldnr/ldnr_transport.h
@@ -0,0 +1,44 @@
+// Frame transport contract. recv returns exactly one protocol frame and blocks
+// until one arrives. close must wake a concurrent recv. Implementations may be
+// in-memory, which keeps the state machine and vnet tests independent of TCP.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+typedef struct ldnr_transport {
+    void *ctx;
+    int (*connect)(void *ctx, const char *server, char *error, size_t error_size);
+    ssize_t (*recv)(void *ctx, void *frame, size_t capacity);
+    int (*send)(void *ctx, const void *frame, size_t size);
+    void (*close)(void *ctx);
+    void (*destroy)(void *ctx);
+    // The relay announces the largest payload it accepts: a frame above it
+    // is refused before its payload is read. It may be left out.
+    void (*set_limit)(void *ctx, uint32_t limit);
+} ldnr_transport;
+
+// The optional capabilities of a transport. They live outside the contract
+// above, so that a transport that was written for the contract keeps working
+// unchanged: the core falls back to the plain contract when a transport
+// declares no capabilities.
+typedef struct ldnr_transport_caps {
+    // The connect of the transport ends at the deadline and is interrupted
+    // when the cancellation says so.
+    int (*connect_ex)(void *ctx, const char *server, char *error, size_t error_size,
+                      int timeout_ms, int (*cancelled)(void *ctx), void *cancel_ctx);
+    // The transport carries the bytes in the clear: a secret must not be
+    // given to it unless the caller accepts the risk explicitly.
+    int plaintext;
+} ldnr_transport_caps;
+
+// The capabilities of a transport, or NULL when it declares none. A
+// transport that the host supplies usually declares none: the host then
+// owns the protection of the bytes it carries.
+const ldnr_transport_caps *ldnr_transport_caps_of(const ldnr_transport *transport);
+
+const ldnr_transport *ldnr_tcp_transport_create(void);
+// Test hook only: swaps the connected descriptor for one the caller owns.
+void ldnr_tcp_test_replace(const ldnr_transport *transport, int fd);
+// Test hook only: the descriptor of the connect that is in progress, or -1.
+int ldnr_tcp_test_connecting_fd(const ldnr_transport *transport);
diff --git a/dm/host/ldnr/ldnr_vnet.c b/dm/host/ldnr/ldnr_vnet.c
new file mode 100644
index 0000000..beaf062
--- /dev/null
+++ b/dm/host/ldnr/ldnr_vnet.c
@@ -0,0 +1,1600 @@
+// Virtual BSD sockets on the LDN subnet. No host socket descriptor escapes:
+// readiness and datagram queues are entirely under this layer's control.
+#include "ldnr_internal.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+uint16_t ldnr_htons(uint16_t v) { return (uint16_t)((v << 8) | (v >> 8)); }
+uint32_t ldnr_htonl(uint32_t v) {
+    return (v << 24) | ((v & 0xff00u) << 8) | ((v >> 8) & 0xff00u) | (v >> 24);
+}
+uint32_t ldnr_ipv4(unsigned a, unsigned b, unsigned c, unsigned d) {
+    return ldnr_htonl((a << 24) | (b << 16) | (c << 8) | d);
+}
+
+void ldnr_vnet_init(ldnr *l) {
+    memset(&l->vnet, 0, sizeof l->vnet);
+    pthread_mutex_init(&l->vnet.mutex, NULL);
+    pthread_cond_init(&l->vnet.condition, NULL);
+    l->vnet.subnet_mask = ldnr_htonl(0xffff0000u);
+    l->vnet.wait_ctx = l->config.callback_ctx;
+    l->vnet.native_wait = l->config.native_wait;
+}
+
+static void ldnr_free_packets(ldnr_packet *packet) {
+    while (packet) {
+        ldnr_packet *next = packet->next;
+        free(packet);
+        packet = next;
+    }
+}
+
+static void ldnr_socket_clear(ldnr_vsock *s) {
+    ldnr_free_packets(s->head);
+    memset(s, 0, sizeof *s);
+}
+
+// The check that lets a stream frame go out and the write itself are one
+// step: a close, a shutdown or a reset that lands between them would
+// otherwise put DATA on the wire after its own FIN or RST, which is a
+// protocol violation the relay answers with a reset. Every stream frame —
+// data, FIN and RST alike — is written under this lock; the socket state is
+// only ever read under the socket mutex, which nests inside it. One lock is
+// shared by every context of the process: the ordering it adds between
+// independent sessions is harmless.
+static pthread_mutex_t ldnr_stream_send_lock = PTHREAD_MUTEX_INITIALIZER;
+
+// A frame that cannot leave the host can never reach the relay: the session
+// is closed, so that the receive path reports the loss the usual way and
+// the membership ends with it.
+static void ldnr_transport_kill(ldnr *l) {
+    if (l->transport && l->transport->close) l->transport->close(l->transport->ctx);
+    atomic_store(&l->transport_open, 0);
+}
+
+// A stream whose descriptor is closed keeps a small record: its FIN only
+// ended this side's direction, so it is reaped when the peer's close
+// arrives, or reset when the linger runs out. The records live apart from
+// the socket slots so that the descriptor number is free right away, and
+// they are shared between the contexts of the process: an entry is only
+// ever matched against the context that made it. The records are guarded
+// by the stream send lock, which every caller of these helpers holds.
+#define LDNR_STREAM_LINGER_MS 750
+#define LDNR_RETIRED_MAX 64
+typedef struct {
+    ldnr *owner;
+    uint64_t connection_id;
+    uint32_t source_address;
+    int64_t deadline;
+} ldnr_retired_stream;
+static ldnr_retired_stream ldnr_retired[LDNR_RETIRED_MAX];
+
+// The linger of a retired stream ends on its own clock, not when the
+// application makes its next socket call: a single sweeper thread wakes at
+// the earliest deadline and expires what ran out. It is started by the
+// first record of the table and retires itself when the table is empty.
+// Every record is dropped by its owner's teardown before the owner is
+// freed, and the sweeper touches an owner only under the stream send lock
+// that the teardown takes too, so a record never outlives its context.
+static pthread_cond_t ldnr_retired_condition = PTHREAD_COND_INITIALIZER;
+static int ldnr_retired_watching;
+
+// Test hook only: the next sweeper spawn is forced to fail, the way a
+// resource exhaustion would make pthread_create fail.
+int ldnr_test_sweeper_create_fails;
+
+static void *ldnr_retired_main(void *unused);
+
+// The stream is half closed: the peer's direction stays open until its own
+// close or until the linger ends it. Returns 0 when no record is free, in
+// which case the caller retires the stream with a reset instead.
+static int ldnr_stream_retire(ldnr *l, uint64_t connection_id, uint32_t source_address) {
+    for (unsigned i = 0; i < LDNR_RETIRED_MAX; i++) {
+        if (ldnr_retired[i].owner) continue;
+        ldnr_retired[i].owner = l;
+        ldnr_retired[i].connection_id = connection_id;
+        ldnr_retired[i].source_address = source_address;
+        ldnr_retired[i].deadline = ldnr_monotonic_ms() + LDNR_STREAM_LINGER_MS;
+        // The linger runs on the sweeper's clock: it is started when none
+        // runs, and woken so it learns the earliest deadline.
+        if (!ldnr_retired_watching) {
+            pthread_t thread;
+            if (!ldnr_test_sweeper_create_fails &&
+                !pthread_create(&thread, NULL, ldnr_retired_main, NULL)) {
+                ldnr_retired_watching = 1;
+                pthread_detach(thread);
+            } else {
+                // The linger cannot run without its sweeper: the record is
+                // dropped again, so the caller retires the stream with its
+                // fallback reset instead of leaving it half-open forever.
+                ldnr_retired[i].owner = NULL;
+                return 0;
+            }
+        }
+        pthread_cond_signal(&ldnr_retired_condition);
+        return 1;
+    }
+    return 0;
+}
+
+// The peer's own close reached the stream: it is reaped at both ends and
+// nothing more is sent. Returns 1 when the stream was a retired one.
+static int ldnr_retired_drop(ldnr *l, uint64_t connection_id) {
+    for (unsigned i = 0; i < LDNR_RETIRED_MAX; i++) {
+        if (ldnr_retired[i].owner != l || ldnr_retired[i].connection_id != connection_id)
+            continue;
+        ldnr_retired[i].owner = NULL;
+        return 1;
+    }
+    return 0;
+}
+
+// The membership a retired stream belonged to is gone: its record must not
+// send a close into a later membership, which numbers its streams anew.
+static void ldnr_retired_purge(ldnr *l) {
+    for (unsigned i = 0; i < LDNR_RETIRED_MAX; i++)
+        if (ldnr_retired[i].owner == l) ldnr_retired[i].owner = NULL;
+}
+
+// Every retired stream of this context (of all contexts when l is NULL)
+// that ran out its linger gets the reset that ends it on the relay; the
+// count of the expired records is returned. The caller holds the stream
+// send lock.
+static int ldnr_retired_expire(ldnr *l, int64_t now) {
+    int expired = 0;
+    for (unsigned i = 0; i < LDNR_RETIRED_MAX; i++) {
+        ldnr *owner = ldnr_retired[i].owner;
+        if (!owner || (l && owner != l) || ldnr_retired[i].deadline > now) continue;
+        ldnr_message *message = ldnr_message_new();
+        if (message) {
+            message->proxy.connection_id = ldnr_retired[i].connection_id;
+            message->proxy.source_address = ldnr_retired[i].source_address;
+            message->status = 1;   // a reset reaps the stream at both ends
+            message->reason = 0;
+            if (ldnr_client_send(owner, LDNR_MSG_PROXY_DISCONNECT, 0, message, NULL))
+                ldnr_transport_kill(owner);
+            ldnr_message_delete(message);
+            ldnr_retired[i].owner = NULL;
+            expired++;
+        }
+    }
+    return expired;
+}
+
+// The wait of the sweeper is on the realtime clock, the way the timed
+// waits of the core translate their monotonic deadlines.
+static void ldnr_retired_wait(int64_t delay_ms) {
+    struct timespec until;
+    clock_gettime(CLOCK_REALTIME, &until);
+    until.tv_sec += (time_t)(delay_ms / 1000);
+    until.tv_nsec += (long)(delay_ms % 1000) * 1000000;
+    if (until.tv_nsec >= 1000000000) { until.tv_sec++; until.tv_nsec -= 1000000000; }
+    pthread_cond_timedwait(&ldnr_retired_condition, &ldnr_stream_send_lock, &until);
+}
+
+static void *ldnr_retired_main(void *unused) {
+    (void)unused;
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    for (;;) {
+        int64_t next = 0;
+        for (unsigned i = 0; i < LDNR_RETIRED_MAX; i++) {
+            if (ldnr_retired[i].owner &&
+                (!next || ldnr_retired[i].deadline < next))
+                next = ldnr_retired[i].deadline;
+        }
+        // The table is empty: the sweeper retires, and the next record
+        // starts a new one.
+        if (!next) break;
+        int64_t now = ldnr_monotonic_ms();
+        if (next > now) {
+            ldnr_retired_wait(next - now);
+        } else if (!ldnr_retired_expire(NULL, now)) {
+            // A deadline passed but no reset could be sent: the frame
+            // allocation keeps failing. Back off briefly instead of
+            // spinning on it.
+            ldnr_retired_wait(50);
+        }
+    }
+    ldnr_retired_watching = 0;
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+    return NULL;
+}
+
+// Every retired stream of this context that ran out its linger gets the
+// reset that ends it on the relay. The caller holds no socket lock.
+static void ldnr_retired_sweep(ldnr *l) {
+    int64_t now = ldnr_monotonic_ms();
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    ldnr_retired_expire(l, now);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+void ldnr_vnet_reset(ldnr *l) {
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) ldnr_socket_clear(&l->vnet.sockets[i]);
+    ldnr_retired_purge(l);
+    // The membership is gone: a frame that was prepared for it must not
+    // reach the room that comes next.
+    l->vnet.membership_generation++;
+    l->vnet.local_address = 0;
+    l->vnet.failed = 0;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+// Every wait of the socket layer ends: the relay is gone or the context is
+// closing, so no caller may stay blocked in a wait.
+void ldnr_vnet_cancel(ldnr *l) {
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.failed = 1;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used) continue;
+        if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ECANCELED; }
+        s->remote_error = LDNR_ECANCELED;
+    }
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+void ldnr_vnet_destroy(ldnr *l) {
+    ldnr_vnet_reset(l);
+    pthread_mutex_destroy(&l->vnet.mutex);
+    pthread_cond_destroy(&l->vnet.condition);
+}
+
+void ldnr_vnet_set_address(ldnr *l, uint32_t address, uint32_t mask) {
+    // The membership that is applied belongs to a new generation: a frame
+    // that was prepared for the room before it can never reach this one.
+    // The stream send lock keeps the step ordered against a transmit that
+    // is still in flight.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.membership_generation++;
+    l->vnet.local_address = address;
+    if (mask) l->vnet.subnet_mask = mask;
+    // A membership that was just applied opens the socket layer again: the
+    // failed flag belongs to the network that was lost, not to this one.
+    // The descriptors that saw the loss keep their own terminal error, so
+    // they stay dead while new sockets and new waits work.
+    l->vnet.failed = 0;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+void ldnr_vnet_membership_leave(ldnr *l) {
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.membership_generation++;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+static ldnr_vsock *ldnr_socket_at(ldnr *l, int fd) {
+    unsigned index = (unsigned)(fd - LDNR_FD_BASE);
+    if (index >= LDNR_MAX_SOCKETS) return NULL;
+    ldnr_vsock *s = &l->vnet.sockets[index];
+    return s->used && s->fd == fd ? s : NULL;
+}
+
+// The socket of a descriptor, but only if it is still the same socket: the
+// slot of a closed socket may be reused by another one, and the number of
+// the descriptor alone does not tell them apart.
+static ldnr_vsock *ldnr_socket_of(ldnr *l, int fd, uint64_t generation) {
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) return NULL;
+    if (generation && s->generation != generation) return NULL;
+    return s;
+}
+
+static ldnr_vsock *ldnr_socket_alloc(ldnr *l, int type) {
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s->used) continue;
+        memset(s, 0, sizeof *s);
+        s->used = 1;
+        s->type = type;
+        s->fd = LDNR_FD_BASE + (int)i;
+        s->generation = ++l->vnet.socket_generation;
+        s->recv_timeout_ms = s->send_timeout_ms = -1;
+        return s;
+    }
+    return NULL;
+}
+
+int ldnr_socket(ldnr *l, int family, int type, int protocol) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    if (family != 2 || (type != 1 && type != 2) || (protocol && protocol != (type == 1 ? 6 : 17)))
+        return ldnr_fail(LDNR_EAFNOSUPPORT);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_alloc(l, type);
+    int fd = s ? s->fd : -1;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return s ? fd : ldnr_fail(LDNR_ENOBUFS);
+}
+
+static int ldnr_port_in_use(ldnr *l, int type, uint16_t port, const ldnr_vsock *except) {
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        const ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s != except && s->used && s->type == type && s->bound && s->local.port == port && !s->reuse_address)
+            return 1;
+    }
+    return 0;
+}
+
+static int ldnr_bind_locked(ldnr *l, ldnr_vsock *s, const ldnr_sockaddr *address) {
+    if (s->bound) return ldnr_fail(LDNR_EINVAL);
+    uint32_t ip = address ? address->address : 0;
+    if (ip && ip != l->vnet.local_address) return ldnr_fail(LDNR_EADDRNOTAVAIL);
+    uint16_t port = address ? address->port : 0;
+    if (!port) {
+        uint32_t start = 49152 + ((unsigned)ldnr_monotonic_ms() & 0x3fff);
+        for (uint32_t i = 0; i < 16384; i++) {
+            uint16_t candidate = ldnr_htons((uint16_t)(49152 + ((start - 49152 + i) & 0x3fff)));
+            if (!ldnr_port_in_use(l, s->type, candidate, s)) { port = candidate; break; }
+        }
+        if (!port) return ldnr_fail(LDNR_EADDRINUSE);
+    } else if (ldnr_port_in_use(l, s->type, port, s)) {
+        return ldnr_fail(LDNR_EADDRINUSE);
+    }
+    s->local.address = ip;
+    s->local.port = port;
+    s->bound = 1;
+    return 0;
+}
+
+int ldnr_bind(ldnr *l, int fd, const ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    int result = s ? ldnr_bind_locked(l, s, address) : ldnr_fail(LDNR_EBADF);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_get_sock_name(ldnr *l, int fd, ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    *address = s->local;
+    if (!address->address) address->address = l->vnet.local_address;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+int ldnr_get_peer_name(ldnr *l, int fd, ldnr_sockaddr *address) {
+    if (!l || !address) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (!s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    *address = s->peer;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+static int ldnr_destination_valid(ldnr *l, uint32_t address) {
+    if (address == 0xffffffffu) return 1;
+    if (!l->vnet.local_address || !address) return 0;
+    uint32_t mask = l->vnet.subnet_mask;
+    return (address & mask) == (l->vnet.local_address & mask);
+}
+
+// The socket layer must not hold its lock while the relay transport writes:
+// a relay that stops reading would freeze every socket in the process. The
+// frame is prepared under the lock and transmitted after it is released.
+ldnr_message *ldnr_vnet_prepare_udp(ldnr *l, const ldnr_vsock *s,
+                                    const ldnr_sockaddr *destination,
+                                    const void *data, size_t size) {
+    ldnr_message *message = ldnr_message_new();
+    if (!message) return NULL;
+    message->udp.source_address = l->vnet.local_address;
+    message->udp.source_port = s->local.port;
+    message->udp.destination_address = destination->address;
+    message->udp.destination_port = destination->port;
+    message->udp.size = size;
+    if (size) memcpy(message->udp.data, data, size);
+    return message;
+}
+
+ldnr_message *ldnr_vnet_prepare_proxy(ldnr *l, ldnr_message_type type,
+                                       const ldnr_vsock *s, uint32_t source_address,
+                                       const void *data, size_t size) {
+    (void)l; (void)type;
+    ldnr_message *message = ldnr_message_new();
+    if (!message) return NULL;
+    message->proxy.connection_id = s->connection_id;
+    message->proxy.source_address = source_address;
+    message->proxy.destination_address = s->peer.address;
+    message->proxy.source_port = s->local.port;
+    message->proxy.destination_port = s->peer.port;
+    message->proxy.size = size;
+    if (size) {
+        // The payload has its own allocation: a relayed segment may be
+        // larger than the chunk this client sends.
+        message->proxy.data = malloc(size);
+        if (!message->proxy.data) { ldnr_message_delete(message); return NULL; }
+        memcpy(message->proxy.data, data, size);
+    }
+    return message;
+}
+
+// Sends a prepared frame and releases it.
+int ldnr_vnet_transmit(ldnr *l, ldnr_message_type type, ldnr_message *message) {
+    if (!message) return ldnr_fail(LDNR_ENOBUFS);
+    int result = ldnr_client_send(l, type, 0, message, NULL);
+    ldnr_message_delete(message);
+    return result;
+}
+
+// Sends a prepared room-scoped frame and releases it. The membership that
+// prepared it is revalidated inside the stream send step: a leave or a loss
+// that ran in between moved the generation, and the frame is dropped here
+// instead of reaching the room that replaced it.
+static int ldnr_vnet_transmit_room(ldnr *l, ldnr_message_type type,
+                                   ldnr_message *message, uint64_t generation) {
+    if (!message) return ldnr_fail(LDNR_ENOBUFS);
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    int result = generation == l->vnet.membership_generation
+        ? ldnr_client_send(l, type, 0, message, NULL)
+        : ldnr_fail(LDNR_ENETDOWN);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+    ldnr_message_delete(message);
+    return result;
+}
+
+ssize_t ldnr_sendto(ldnr *l, int fd, const void *data, size_t size, int flags,
+                    const ldnr_sockaddr *destination) {
+    (void)flags;
+    if (!l || (size && !data) || !destination) return ldnr_fail(LDNR_EINVAL);
+    if (size > LDNR_UDP_MTU) return ldnr_fail(LDNR_EMSGSIZE);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 2 || s->shut_write) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EPIPE); }
+    // A descriptor that saw the network die is terminal: a membership that
+    // came later belongs to the sockets that were made for it.
+    int remote_error = s->remote_error;
+    if (remote_error) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(remote_error); }
+    if (!l->vnet.local_address || !ldnr_destination_valid(l, destination->address) || !destination->port) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    int result = s->bound ? 0 : ldnr_bind_locked(l, s, NULL);
+    // The membership that prepared the datagram is pinned for the transmit
+    // boundary: a leave or a rejoin in between must not let it reach a room
+    // it was never addressed to.
+    uint64_t generation = l->vnet.membership_generation;
+    ldnr_message *message = result ? NULL :
+        ldnr_vnet_prepare_udp(l, s, destination, data, size);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (!result) result = ldnr_vnet_transmit_room(l, LDNR_MSG_UDP, message, generation);
+    else ldnr_message_delete(message);
+    return result ? -1 : (ssize_t)size;
+}
+
+// The queue of a stream is bounded in bytes and in packets: an empty frame
+// carries no data and must not become an end-of-file for the reader.
+#define LDNR_STREAM_RESET (-2)
+
+static int ldnr_stream_fail(ldnr *l, ldnr_vsock *s) {
+    // The stream is broken from now on: the bytes that follow the gap would
+    // not belong to the data the application already read.
+    ldnr_free_packets(s->head);
+    s->head = s->tail = NULL;
+    s->queued = 0;
+    s->queued_bytes = 0;
+    s->remote_error = LDNR_ECONNRESET;
+    s->remote_eof = 1;
+    s->stream_failed = 1;
+    if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ECONNRESET; }
+    pthread_cond_broadcast(&l->vnet.condition);
+    return LDNR_STREAM_RESET;
+}
+
+static int ldnr_packet_queue(ldnr *l, ldnr_vsock *s, const ldnr_sockaddr *source,
+                             const void *data, size_t size, int stream) {
+    if (stream) {
+        if (s->stream_failed) return LDNR_STREAM_RESET;
+        // An empty frame carries no data: queuing it would look like the end
+        // of the stream to the reader.
+        if (!size) return 0;
+        // A stream must not lose bytes in the middle. Back off until the
+        // reader catches up, and reset the stream when it stays behind.
+        if (s->queued_bytes + size > LDNR_STREAM_LIMIT || s->queued >= LDNR_QUEUE_MAX)
+            return ldnr_stream_fail(l, s);
+    } else if (s->queued >= LDNR_QUEUE_MAX) {
+        // Datagrams may be dropped when the reader falls behind.
+        ldnr_packet *old = s->head;
+        if (old) {
+            s->head = old->next;
+            if (!s->head) s->tail = NULL;
+            s->queued_bytes -= old->size;
+            free(old);
+            s->queued--;
+        }
+    }
+    ldnr_packet *packet = malloc(sizeof *packet + size);
+    if (!packet) {
+        // A stream that cannot hold its data is broken: the application must
+        // not see a silent gap.
+        if (stream) return ldnr_stream_fail(l, s);
+        return -1;
+    }
+    packet->next = NULL;
+    packet->source = *source;
+    packet->size = size;
+    packet->offset = 0;
+    if (size) memcpy(packet->data, data, size);
+    if (s->tail) s->tail->next = packet;
+    else s->head = packet;
+    s->tail = packet;
+    s->queued++;
+    s->queued_bytes += size;
+    pthread_cond_broadcast(&l->vnet.condition);
+    return 0;
+}
+
+// The stream is retired at both ends with a reset: an abortive close, a
+// child its listener took down, a stream that ran out its linger. The
+// caller holds the stream send lock.
+static void ldnr_send_stream_reset(ldnr *l, uint64_t connection_id, uint32_t source_address) {
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { ldnr_transport_kill(l); return; }
+    message->proxy.connection_id = connection_id;
+    message->proxy.source_address = source_address;
+    message->status = 1;    // flags bit0: reset, the stream is reaped at both ends
+    message->reason = 0;    // ProxyClose: none (user close)
+    if (ldnr_client_send(l, LDNR_MSG_PROXY_DISCONNECT, 0, message, NULL))
+        ldnr_transport_kill(l);
+    ldnr_message_delete(message);
+}
+
+// The orderly close of this side's direction: the peer may keep sending
+// until its own close. The caller holds the stream send lock.
+static void ldnr_send_stream_fin(ldnr *l, uint64_t connection_id, uint32_t source_address) {
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { ldnr_transport_kill(l); return; }
+    message->proxy.connection_id = connection_id;
+    message->proxy.source_address = source_address;
+    message->status = 0;    // flags clear: an orderly FIN, not a reset
+    message->reason = 0;
+    if (ldnr_client_send(l, LDNR_MSG_PROXY_DISCONNECT, 0, message, NULL))
+        ldnr_transport_kill(l);
+    ldnr_message_delete(message);
+}
+
+// The bytes of a relayed stream are lost: the stream is failed terminally,
+// its queued data is dropped, its waiters are woken, and the relay is told
+// with a reset. A reset that cannot leave the host retires the transport,
+// or the relay would keep a stream this client already buried.
+void ldnr_vnet_stream_fail(ldnr *l, uint64_t connection_id) {
+    // The mark and the reset stay one step under the stream send lock: no
+    // send that was still in flight may put DATA behind it on the wire.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || s->type != 1 || s->connection_id != connection_id) continue;
+        ldnr_stream_fail(l, s);
+        break;
+    }
+    uint32_t source_address = l->vnet.local_address;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    ldnr_message *message = ldnr_message_new();
+    if (!message) {
+        ldnr_transport_kill(l);
+    } else {
+        message->proxy.connection_id = connection_id;
+        message->proxy.source_address = source_address;
+        message->status = 1;   // the relay marks a reset with the first flag
+        message->reason = 1;   // ProxyCloseDeliveryFailure
+        if (ldnr_client_send(l, LDNR_MSG_PROXY_DISCONNECT, 0, message, NULL))
+            ldnr_transport_kill(l);
+        ldnr_message_delete(message);
+    }
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+void ldnr_vnet_udp(ldnr *l, const ldnr_message *message) {
+    if (message->udp.size > LDNR_UDP_MTU) return;
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&l->vnet.mutex);
+    int broadcast = message->udp.destination_address == 0xffffffffu ||
+        (message->udp.destination_address | l->vnet.subnet_mask) == 0xffffffffu;
+    if (!broadcast && message->udp.destination_address != l->vnet.local_address) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return;
+    }
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used || s->type != 2 || !s->bound || s->shut_read || s->remote_error ||
+            s->local.port != message->udp.destination_port)
+            continue;
+        if (s->local.address && s->local.address != message->udp.destination_address &&
+            s->local.address != l->vnet.local_address) continue;
+        // A connected socket only receives the datagrams of its peer: the
+        // others are dropped, the way a connected socket drops them.
+        if (s->connected && s->peer.address &&
+            (message->udp.source_address != s->peer.address ||
+             (s->peer.port && message->udp.source_port != s->peer.port))) continue;
+        ldnr_sockaddr source = {message->udp.source_address, message->udp.source_port};
+        ldnr_packet_queue(l, s, &source, message->udp.data, message->udp.size, 0);
+        if (!broadcast) break;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+int ldnr_inject_udp(ldnr *l, uint32_t source_address, uint16_t source_port,
+                    uint32_t destination_address, uint16_t destination_port,
+                    const void *data, size_t size) {
+    if (!l || (size && !data) || size > LDNR_UDP_MTU) return ldnr_fail(LDNR_EINVAL);
+    ldnr_message message;
+    memset(&message, 0, sizeof message);
+    message.udp.source_address = source_address;
+    message.udp.source_port = source_port;
+    message.udp.destination_address = destination_address;
+    message.udp.destination_port = destination_port;
+    message.udp.size = size;
+    if (size) memcpy(message.udp.data, data, size);
+    ldnr_vnet_udp(l, &message);
+    return 0;
+}
+
+// The deadline a call gets when it blocks: an explicit call timeout wins,
+// a call with MSG_DONTWAIT or a descriptor in nonblocking mode does not
+// wait at all, and a plain call takes the socket option of its operation —
+// SO_RCVTIMEO for receives and accepts, SO_SNDTIMEO for connects.
+static int64_t ldnr_socket_deadline(const ldnr_vsock *s, int timeout_ms, int socket_ms) {
+    if (timeout_ms == -2) timeout_ms = s->nonblocking ? 0 : socket_ms;
+    if (s->nonblocking) timeout_ms = 0;
+    return timeout_ms < 0 ? -1 : ldnr_monotonic_ms() + timeout_ms;
+}
+
+static int ldnr_vnet_wait(ldnr *l, int64_t deadline) {
+    return ldnr_wait_until(l, &l->vnet.condition, &l->vnet.mutex, l->vnet.wait_ctx,
+                           l->vnet.native_wait, deadline);
+}
+
+ssize_t ldnr_recvfrom(ldnr *l, int fd, void *data, size_t capacity, int flags,
+                      ldnr_sockaddr *source, int timeout_ms) {
+    if (!l || (capacity && !data)) return ldnr_fail(LDNR_EINVAL);
+    // MSG_DONTWAIT makes this call alone nonblocking, whatever the mode of
+    // the descriptor is: with nothing queued it answers EAGAIN at once.
+    if (flags & LDNR_MSG_DONTWAIT) timeout_ms = 0;
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 2) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+    uint64_t generation = s->generation;
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms, s->recv_timeout_ms);
+    while (!s->head) {
+        if (l->cancelled) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ECANCELED);
+        }
+        // A descriptor that saw the network die is terminal: it reports the
+        // error it recorded, even after a new membership opened the layer.
+        int remote_error = s->remote_error;
+        if (remote_error) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(remote_error);
+        }
+        if (s->shut_read || !l->vnet.local_address || l->vnet.failed) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ENETDOWN);
+        }
+        if ((s->nonblocking || timeout_ms == 0) ||
+            (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_of(l, fd, generation);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    ldnr_packet *packet = s->head;
+    size_t copied = packet->size < capacity ? packet->size : capacity;
+    if (copied) memcpy(data, packet->data + packet->offset, copied);
+    if (source) *source = packet->source;
+    if (!(flags & LDNR_MSG_PEEK)) {
+        s->head = packet->next;
+        if (!s->head) s->tail = NULL;
+        s->queued--;
+        s->queued_bytes -= packet->size;
+        free(packet);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return (ssize_t)copied;
+}
+
+static int ldnr_stream_can_read(const ldnr_vsock *s) {
+    return s->head || s->remote_eof || s->shut_read || s->connect_error || s->remote_error;
+}
+
+ssize_t ldnr_recv(ldnr *l, int fd, void *data, size_t capacity, int flags, int timeout_ms) {
+    if (!l || (capacity && !data)) return ldnr_fail(LDNR_EINVAL);
+    // MSG_DONTWAIT makes this call alone nonblocking, whatever the mode of
+    // the descriptor is: with nothing queued it answers EAGAIN at once.
+    if (flags & LDNR_MSG_DONTWAIT) timeout_ms = 0;
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type == 2) {
+        // A datagram socket reads datagrams: the connected one only accepts
+        // the datagrams of its peer, which the queue already filtered.
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_recvfrom(l, fd, data, capacity, flags, NULL, timeout_ms);
+    }
+    // A descriptor that saw the network die keeps its terminal error even
+    // though its connected state was retired with the membership.
+    if (s->type != 1 || (!s->connected && !s->connect_error && !s->remote_error)) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_ENOTCONN);
+    }
+    uint64_t generation = s->generation;
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms, s->recv_timeout_ms);
+    while (!ldnr_stream_can_read(s)) {
+        if (l->cancelled) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ECANCELED);
+        }
+        if ((s->nonblocking || timeout_ms == 0) || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_of(l, fd, generation);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    // The reading direction is closed: the end of the stream is reported
+    // consistently. Payload that still arrives is dropped at the door, so
+    // the queue stays empty and the answer stays the end of the stream.
+    if (s->shut_read) { pthread_mutex_unlock(&l->vnet.mutex); return 0; }
+    int error = s->connect_error ? s->connect_error : s->remote_error;
+    if (error && !s->head) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(error); }
+    if (!s->head) { pthread_mutex_unlock(&l->vnet.mutex); return 0; }
+    ldnr_packet *packet = s->head;
+    size_t available = packet->size - packet->offset;
+    size_t copied = available < capacity ? available : capacity;
+    if (copied) memcpy(data, packet->data + packet->offset, copied);
+    if (!(flags & LDNR_MSG_PEEK)) {
+        packet->offset += copied;
+        s->queued_bytes -= copied;
+        if (packet->offset == packet->size) {
+            s->head = packet->next;
+            if (!s->head) s->tail = NULL;
+            s->queued--;
+            free(packet);
+        }
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return (ssize_t)copied;
+}
+
+
+ssize_t ldnr_send(ldnr *l, int fd, const void *data, size_t size, int flags) {
+    (void)flags;
+    if (!l || (size && !data)) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type == 2) {
+        if (size > LDNR_UDP_MTU) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EMSGSIZE); }
+        ldnr_sockaddr peer = s->peer;
+        if (!s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOTCONN); }
+        if (s->shut_write) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EPIPE); }
+        int remote_error = s->remote_error;
+        if (remote_error) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(remote_error); }
+        uint64_t generation = l->vnet.membership_generation;
+        ldnr_message *message = ldnr_vnet_prepare_udp(l, s, &peer, data, size);
+        pthread_mutex_unlock(&l->vnet.mutex);
+        int result = ldnr_vnet_transmit_room(l, LDNR_MSG_UDP, message, generation);
+        return result ? -1 : (ssize_t)size;
+    }
+    if (!s->connected || s->shut_write || s->remote_error || s->stream_failed) {
+        int error = s->remote_error ? s->remote_error : LDNR_EPIPE;
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(error);
+    }
+    // The identity of the socket is pinned for the whole call: the slot may
+    // be closed and reused by another socket while a frame is in flight, and
+    // the rest of the buffer must not go to that other stream.
+    uint64_t generation = s->generation;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    // A PROXY_DATA frame carries its fields before the payload blob: a
+    // negotiated frame limit below the chunk size moves the split point
+    // with it, or the relay refuses the frame.
+    size_t chunk_max = LDNR_TCP_CHUNK;
+    uint32_t frame_limit = atomic_load(&l->max_frame);
+    if (frame_limit > LDNR_PROXY_DATA_OVERHEAD &&
+        (size_t)(frame_limit - LDNR_PROXY_DATA_OVERHEAD) < chunk_max)
+        chunk_max = frame_limit - LDNR_PROXY_DATA_OVERHEAD;
+    size_t sent = 0;
+    while (sent < size) {
+        size_t chunk = size - sent;
+        if (chunk > chunk_max) chunk = chunk_max;
+        // The check and the write of a chunk are one step, serialized with
+        // every close and shutdown of the stream: a FIN or a RST can never
+        // reach the wire before the data that was allowed to go out. The
+        // socket mutex is still released around the write itself, so a
+        // blocked relay cannot hold the socket layer hostage.
+        pthread_mutex_lock(&ldnr_stream_send_lock);
+        pthread_mutex_lock(&l->vnet.mutex);
+        s = ldnr_socket_of(l, fd, generation);
+        if (!s) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            pthread_mutex_unlock(&ldnr_stream_send_lock);
+            return sent ? (ssize_t)sent : ldnr_fail(LDNR_EBADF);
+        }
+        // A close, a shutdown or a peer reset since the last chunk ends the
+        // stream: another chunk would go out after the FIN or be discarded
+        // after the RST, and reporting it as sent would be a lie. Only the
+        // bytes that already left are counted.
+        if (!s->connected || s->shut_write || s->remote_error || s->stream_failed || l->cancelled) {
+            int error = s->remote_error ? s->remote_error :
+                        (l->cancelled ? LDNR_ECANCELED : LDNR_EPIPE);
+            pthread_mutex_unlock(&l->vnet.mutex);
+            pthread_mutex_unlock(&ldnr_stream_send_lock);
+            return sent ? (ssize_t)sent : ldnr_fail(error);
+        }
+        // The frame is prepared under the socket lock and written after it
+        // is released, still inside the stream send step.
+        ldnr_message *message = ldnr_vnet_prepare_proxy(l, LDNR_MSG_PROXY_DATA, s,
+                                                        l->vnet.local_address,
+                                                        (const uint8_t *)data + sent, chunk);
+        pthread_mutex_unlock(&l->vnet.mutex);
+        int result = ldnr_vnet_transmit(l, LDNR_MSG_PROXY_DATA, message);
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        if (result) return sent ? (ssize_t)sent : -1;
+        sent += chunk;
+    }
+    return (ssize_t)sent;
+}
+
+int ldnr_connect_socket(ldnr *l, int fd, const ldnr_sockaddr *destination, int timeout_ms) {
+    if (!l || !destination) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    // The identity of the socket is pinned before the open: the slot may be
+    // closed and reused while the stream step is taken.
+    uint64_t generation = s->generation;
+    if (s->type == 2) {
+        int remote_error = s->remote_error;
+        if (remote_error) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(remote_error); }
+        if (!ldnr_destination_valid(l, destination->address)) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENETDOWN); }
+        if (!s->bound && ldnr_bind_locked(l, s, NULL)) { pthread_mutex_unlock(&l->vnet.mutex); return -1; }
+        s->peer = *destination;
+        s->connected = 1;
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return 0;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    // The check that lets the open go out and the write itself are one
+    // step, serialized with every close of the stream the way a data chunk
+    // is: a close that wins the race for the send lock puts its reset on
+    // the wire and the open of the dead descriptor is never sent, and a
+    // close that loses it resets the stream after the open reached the
+    // relay — never the other way around, which would leave a stream the
+    // relay keeps but no descriptor owns. The send lock is released before
+    // the wait for the acceptance, which needs only the socket mutex.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    s = ldnr_socket_of(l, fd, generation);
+    int error = 0;
+    if (!s) error = LDNR_EBADF;
+    else if (s->connected) error = LDNR_EISCONN;
+    else if (s->connecting) error = LDNR_EALREADY;
+    // A descriptor that saw the network die is terminal; a fresh membership
+    // does not resurrect it.
+    else error = s->remote_error;
+    if (!error &&
+        (!l->vnet.local_address || !ldnr_destination_valid(l, destination->address) ||
+         !destination->port))
+        error = LDNR_ENETDOWN;
+    if (error) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        return ldnr_fail(error);
+    }
+    if (!s->bound && ldnr_bind_locked(l, s, NULL)) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        return -1;
+    }
+    s->peer = *destination;
+    s->connection_id = ldnr_next_connection_id(l);
+    s->connecting = 1;
+    s->connect_error = 0;
+    ldnr_message *message = ldnr_vnet_prepare_proxy(l, LDNR_MSG_PROXY_CONNECT, s,
+                                                    l->vnet.local_address, NULL, 0);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    int sent = ldnr_vnet_transmit(l, LDNR_MSG_PROXY_CONNECT, message);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    s = ldnr_socket_of(l, fd, generation);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (sent) {
+        s->connecting = 0;
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return -1;
+    }
+    // A blocking open waits for its answer on the clock of SO_SNDTIMEO:
+    // the send timeout is the one BSD applies to connect().
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms, s->send_timeout_ms);
+    if (deadline == ldnr_monotonic_ms() || s->nonblocking) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        return ldnr_fail(LDNR_EINPROGRESS);
+    }
+    while (s->connecting && !s->connect_error) {
+        if (l->cancelled) {
+            s->connecting = 0;
+            s->connect_error = LDNR_ECANCELED;
+            break;
+        }
+        if (l->vnet.failed) {
+            s->connecting = 0;
+            s->connect_error = LDNR_ENETDOWN;
+            break;
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ETIMEDOUT);
+        }
+        s = ldnr_socket_of(l, fd, generation);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    int result = s->connect_error ? ldnr_fail(s->connect_error) : 0;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_listen(ldnr *l, int fd, int backlog) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (s->type != 1 || s->connected) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EINVAL); }
+    if (!s->bound && ldnr_bind_locked(l, s, NULL)) { pthread_mutex_unlock(&l->vnet.mutex); return -1; }
+    s->listening = 1;
+    s->backlog = backlog > 0 ? backlog : 1;
+    if (s->backlog > LDNR_ACCEPT_MAX) s->backlog = LDNR_ACCEPT_MAX;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+int ldnr_accept(ldnr *l, int fd, ldnr_sockaddr *source, int timeout_ms) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    if (!s->listening) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EINVAL); }
+    uint64_t generation = s->generation;
+    // An accept waits on the clock of SO_RCVTIMEO, the receive timeout.
+    int64_t deadline = ldnr_socket_deadline(s, timeout_ms, s->recv_timeout_ms);
+    while (!s->accept_count) {
+        // The relay is gone: a listener must not wait for a connection that
+        // can no longer arrive.
+        if (l->cancelled) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ECANCELED);
+        }
+        // A listener that saw the network die is terminal even after a new
+        // membership opened the socket layer again.
+        int remote_error = s->remote_error;
+        if (remote_error) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(remote_error);
+        }
+        if (l->vnet.failed) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ENETDOWN);
+        }
+        if (s->nonblocking || timeout_ms == 0 || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        if (ldnr_vnet_wait(l, deadline) == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_EAGAIN);
+        }
+        s = ldnr_socket_of(l, fd, generation);
+        if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    }
+    int index = s->accept_head;
+    int newfd = s->accept_fds[index];
+    s->accept_head = (index + 1) % LDNR_ACCEPT_MAX;
+    s->accept_count--;
+    if (source) {
+        ldnr_vsock *peer = ldnr_socket_at(l, newfd);
+        if (peer) *source = peer->local;
+        if (peer) *source = peer->peer;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return newfd;
+}
+
+// A stream is identified by its connection id and its peer: two clients can
+// use the same id, and the relay echoes the sender in every frame.
+static ldnr_vsock *ldnr_stream_by_connection(ldnr *l, const ldnr_message *message,
+                                             int only_connecting, int check_peer) {
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        // A descriptor that saw the network die is terminal: nothing that
+        // arrives for the streams of the lost membership may reach it.
+        if (!s->used || s->type != 1 || s->remote_error) continue;
+        if (s->connection_id != message->proxy.connection_id) continue;
+        if (only_connecting && !s->connecting) continue;
+        if (check_peer) {
+            if (message->proxy.source_address && s->peer.address &&
+                message->proxy.source_address != s->peer.address) continue;
+            if (message->proxy.source_port && s->peer.port &&
+                message->proxy.source_port != s->peer.port) continue;
+        }
+        return s;
+    }
+    return NULL;
+}
+
+void ldnr_vnet_proxy_connect(ldnr *l, const ldnr_message *message) {
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *listener = NULL;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s->used && s->type == 1 && s->listening && !s->remote_error &&
+            s->local.port == message->proxy.destination_port &&
+            (!s->local.address || s->local.address == message->proxy.destination_address) &&
+            s->accept_count < s->backlog) { listener = s; break; }
+    }
+    // An incoming id that is already in use belongs to another stream: the
+    // relay may reset such a collision, so the stream is refused here.
+    int duplicate = 0;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (s->used && s->type == 1 && s->connection_id == message->proxy.connection_id) {
+            duplicate = 1;
+            break;
+        }
+    }
+    // The child is kept unpublished until its acceptance reached the relay:
+    // an accept() that fires first would let the game send on a stream the
+    // relay still holds in SYN_SENT, which is a protocol violation.
+    ldnr_vsock *accepted = listener && !duplicate ? ldnr_socket_alloc(l, 1) : NULL;
+    uint64_t listener_generation = listener ? listener->generation : 0;
+    if (accepted) {
+        accepted->bound = accepted->connected = 1;
+        accepted->local.address = message->proxy.destination_address;
+        accepted->local.port = message->proxy.destination_port;
+        accepted->peer.address = message->proxy.source_address;
+        accepted->peer.port = message->proxy.source_port;
+        accepted->connection_id = message->proxy.connection_id;
+    }
+    // The membership that received the open is pinned for the answer: a
+    // transition in between must not let the reply, the queued child or a
+    // retire reset reach the room that replaced it.
+    uint64_t membership = l->vnet.membership_generation;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    ldnr_message *reply = ldnr_message_new();
+    int sent = -1, same_room = 1;
+    if (reply) {
+        reply->proxy = message->proxy;
+        reply->status = accepted ? 0 : LDNR_ECONNREFUSED;
+        // The generation check and the write are one stream send step, so a
+        // membership transition can never slip between them.
+        pthread_mutex_lock(&ldnr_stream_send_lock);
+        same_room = membership == l->vnet.membership_generation;
+        sent = same_room ? ldnr_client_send(l, LDNR_MSG_PROXY_CONNECT_ACK, 0, reply, NULL) : 0;
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        ldnr_message_delete(reply);
+    }
+    // The reply is required by the protocol: a session that cannot carry it
+    // is closed instead of leaving a stream half-open on the relay.
+    if (sent) ldnr_transport_kill(l);
+    if (!accepted) return;
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    uint32_t source_address = l->vnet.local_address;
+    same_room = membership == l->vnet.membership_generation;
+    // The child is published only when its acceptance went out and the
+    // listener that queued it is still alive and still has room.
+    int publish = !sent && same_room && listener->used && listener->listening &&
+        listener->generation == listener_generation &&
+        listener->accept_count < listener->backlog;
+    if (publish) {
+        int index = (listener->accept_head + listener->accept_count) % LDNR_ACCEPT_MAX;
+        listener->accept_fds[index] = accepted->fd;
+        listener->accept_count++;
+        // The id belongs to the new stream now: a stale linger for the same
+        // number must not reset it.
+        ldnr_retired_drop(l, message->proxy.connection_id);
+        pthread_cond_broadcast(&l->vnet.condition);
+    } else {
+        ldnr_socket_clear(accepted);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (!sent && !publish && same_room) {
+        // The relay admitted the stream but nothing waits for it here:
+        // retire it instead of leaving it on the relay. A room that was
+        // replaced gets no reset: its id belongs to another membership.
+        ldnr_send_stream_reset(l, message->proxy.connection_id, source_address);
+    }
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+void ldnr_vnet_proxy_ack(ldnr *l, const ldnr_message *message) {
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_stream_by_connection(l, message, 1, 0);
+    if (s) {
+        s->connecting = 0;
+        if (message->status) s->connect_error = (int)message->status;
+        else s->connected = 1;
+        pthread_cond_broadcast(&l->vnet.condition);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+}
+
+void ldnr_vnet_proxy_data(ldnr *l, const ldnr_message *message) {
+    // A relayed segment may be larger than the chunk this client sends, but
+    // it stays inside the limit of the frame.
+    if (message->proxy.size > LDNR_WIRE_DEFAULT_LIMIT) return;
+    ldnr_retired_sweep(l);
+    int reset = 0;
+    uint64_t connection_id = 0;
+    uint32_t source_address = 0;
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_stream_by_connection(l, message, 0, 1);
+    // The reading direction is closed: the segment is dropped at the door,
+    // the way a socket that was shut for reading drops what still arrives.
+    // The sending direction is untouched, so the peer's traffic is simply
+    // discarded instead of being queued or answered with a reset.
+    if (s && s->connected && !s->shut_read) {
+        int result = ldnr_packet_queue(l, s, &s->peer, message->proxy.data,
+                                       message->proxy.size, 1);
+        if (result == LDNR_STREAM_RESET) {
+            // The stream cannot hold the data: the peer must learn that the
+            // bytes are lost, or it would read them as a continuous stream.
+            reset = 1;
+            connection_id = s->connection_id;
+            source_address = l->vnet.local_address;
+        }
+    } else if (!s && ldnr_retired_drop(l, message->proxy.connection_id)) {
+        // A segment for a retired stream cannot be delivered: the record is
+        // dropped and the stream is reset, the way an undeliverable payload
+        // is.
+        reset = 1;
+        connection_id = message->proxy.connection_id;
+        source_address = l->vnet.local_address;
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (reset) {
+        ldnr_message *reply = ldnr_message_new();
+        if (!reply) {
+            ldnr_transport_kill(l);
+        } else {
+            reply->proxy.connection_id = connection_id;
+            reply->proxy.source_address = source_address;
+            reply->status = 1;          // FlagProxyReset
+            reply->reason = 1;          // ProxyCloseDeliveryFailure
+            if (ldnr_client_send(l, LDNR_MSG_PROXY_DISCONNECT, 0, reply, NULL))
+                ldnr_transport_kill(l);
+            ldnr_message_delete(reply);
+        }
+    }
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+void ldnr_vnet_proxy_disconnect(ldnr *l, const ldnr_message *message) {
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_stream_by_connection(l, message, 0, 1);
+    if (s) {
+        // The relay marks a reset with the first flag bit; a plain FIN only
+        // closes the peer's sending side.
+        if (message->status & 1) { s->remote_error = LDNR_ECONNRESET; s->remote_eof = 1; }
+        else s->remote_eof = 1;
+        if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ECONNREFUSED; }
+        pthread_cond_broadcast(&l->vnet.condition);
+    } else {
+        // The descriptor of this stream is already gone: the peer's close
+        // reaps the retired stream at both ends and needs no answer.
+        ldnr_retired_drop(l, message->proxy.connection_id);
+    }
+    pthread_mutex_unlock(&l->vnet.mutex);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+int ldnr_close_socket(ldnr *l, int fd) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    // The decision about the stream and the frame it sends stay under the
+    // stream send lock: they keep their order against the sends of the same
+    // stream.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        return ldnr_fail(LDNR_EBADF);
+    }
+    // A descriptor that waits in a listener's queue is taken out of it: a
+    // dead descriptor must not be handed to a later accept().
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *listener = &l->vnet.sockets[i];
+        if (!listener->used || !listener->listening || listener == s) continue;
+        for (int n = 0; n < listener->accept_count; n++) {
+            if (listener->accept_fds[(listener->accept_head + n) % LDNR_ACCEPT_MAX] != fd)
+                continue;
+            for (int k = n; k + 1 < listener->accept_count; k++)
+                listener->accept_fds[(listener->accept_head + k) % LDNR_ACCEPT_MAX] =
+                    listener->accept_fds[(listener->accept_head + k + 1) % LDNR_ACCEPT_MAX];
+            listener->accept_count--;
+            break;
+        }
+    }
+    // A listener takes its queued children with it: they were never handed
+    // to the application, so their streams are reset here.
+    uint64_t children[LDNR_ACCEPT_MAX];
+    int child_count = 0;
+    if (s->listening) {
+        for (int i = 0; i < s->accept_count; i++) {
+            ldnr_vsock *child = ldnr_socket_at(l, s->accept_fds[(s->accept_head + i) % LDNR_ACCEPT_MAX]);
+            if (!child) continue;
+            if (child->connection_id && child_count < LDNR_ACCEPT_MAX)
+                children[child_count++] = child->connection_id;
+            ldnr_socket_clear(child);
+        }
+    }
+    uint64_t connection_id = s->connection_id;
+    uint32_t source_address = l->vnet.local_address;
+    int fin = 0, rst = 0;
+    if (s->type == 1 && connection_id && !s->listening) {
+        if (s->connected) {
+            if (s->remote_error || s->stream_failed) {
+                // The stream is broken or was reset by the peer: the close
+                // is abortive and retires it at both ends.
+                rst = 1;
+            } else {
+                // The orderly close of this direction is a FIN; one that
+                // already went out with a shutdown is not repeated.
+                fin = !s->shut_write;
+                if (!s->remote_eof && !ldnr_stream_retire(l, connection_id, source_address)) {
+                    // The peer's direction stays open and there is no room
+                    // to watch it: the stream is aborted instead of being
+                    // left half-open on the relay.
+                    fin = 0;
+                    rst = 1;
+                }
+            }
+        } else if (!s->connect_error) {
+            // A stream that is still opening is aborted; a refused open
+            // left nothing on the relay to close.
+            rst = 1;
+        }
+    }
+    ldnr_socket_clear(s);
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (fin) ldnr_send_stream_fin(l, connection_id, source_address);
+    else if (rst) ldnr_send_stream_reset(l, connection_id, source_address);
+    for (int i = 0; i < child_count; i++) ldnr_send_stream_reset(l, children[i], source_address);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+    return 0;
+}
+
+int ldnr_shutdown(ldnr *l, int fd, int how) {
+    if (!l || how < 0 || how > 2) return ldnr_fail(LDNR_EINVAL);
+    // The flag flip and the FIN go out under the stream send lock: a DATA
+    // chunk of the same stream can never overtake the FIN on the wire.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) {
+        pthread_mutex_unlock(&l->vnet.mutex);
+        pthread_mutex_unlock(&ldnr_stream_send_lock);
+        return ldnr_fail(LDNR_EBADF);
+    }
+    if (how == 0 || how == 2) s->shut_read = 1;
+    // The FIN belongs to the transition into the write shutdown: a second
+    // shutdown must not put another one on the wire, and a dead stream has
+    // no direction left to close.
+    int fin = (how == 1 || how == 2) && !s->shut_write &&
+        s->type == 1 && s->connected && s->connection_id && !s->remote_error;
+    uint64_t connection_id = s->connection_id;
+    uint32_t source_address = l->vnet.local_address;
+    if (how == 1 || how == 2) s->shut_write = 1;
+    if (s->shut_read) ldnr_free_packets(s->head);
+    if (s->shut_read) { s->head = s->tail = NULL; s->queued = 0; s->queued_bytes = 0; }
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    if (fin) ldnr_send_stream_fin(l, connection_id, source_address);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+    return 0;
+}
+
+void ldnr_vnet_network_down(ldnr *l) {
+    // The stream send lock keeps the teardown ordered against a send that
+    // is in flight: no frame of the lost membership goes out after it.
+    pthread_mutex_lock(&ldnr_stream_send_lock);
+    pthread_mutex_lock(&l->vnet.mutex);
+    l->vnet.local_address = 0;
+    // The relay is gone: no descriptor may wait for a connection, a
+    // datagram or data that can no longer arrive.
+    l->vnet.failed = 1;
+    for (unsigned i = 0; i < LDNR_MAX_SOCKETS; i++) {
+        ldnr_vsock *s = &l->vnet.sockets[i];
+        if (!s->used) continue;
+        if (s->connecting) { s->connecting = 0; s->connect_error = LDNR_ENETDOWN; }
+        // Every descriptor gets a terminal error, a listener included: it
+        // has no peer that could report the loss.
+        s->remote_error = LDNR_ENETDOWN;
+        s->remote_eof = 1;
+        // The identities of the lost membership die with it: the next
+        // membership numbers its streams from one again, and an old
+        // descriptor must neither take the frames of the new streams nor
+        // send closes for them. The queued children of a listener are
+        // dropped the same way: they belonged to it too.
+        s->connection_id = 0;
+        s->connected = 0;
+        // The queued children were never handed to the application: they
+        // are freed with the membership instead of leaking their slots and
+        // their packet queues. A child that was already accepted keeps its
+        // terminal descriptor like every other socket.
+        for (int n = 0; n < s->accept_count; n++) {
+            int child_fd = s->accept_fds[(s->accept_head + n) % LDNR_ACCEPT_MAX];
+            ldnr_vsock *child = ldnr_socket_at(l, child_fd);
+            if (child) ldnr_socket_clear(child);
+        }
+        s->accept_count = 0;
+        s->accept_head = 0;
+    }
+    // The retired streams belonged to the membership that is gone: their
+    // records are dropped so no reset escapes into a later one.
+    ldnr_retired_purge(l);
+    // The membership is gone: a frame that was prepared for it must not
+    // reach the room that comes next.
+    l->vnet.membership_generation++;
+    pthread_cond_broadcast(&l->vnet.condition);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    pthread_mutex_unlock(&ldnr_stream_send_lock);
+}
+
+int ldnr_fcntl(ldnr *l, int fd, int command, long argument) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int result;
+    if (command == 3) result = s->nonblocking ? 4 : 0;
+    else if (command == 4) { s->nonblocking = !!(argument & 4); pthread_cond_broadcast(&l->vnet.condition); result = 0; }
+    else result = ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+// Parses a timeout option into milliseconds. A zero timeout disables the
+// timeout, the way BSD defines it: it is reported as the internal infinite
+// value -1, so that only a genuinely positive value is stored. Returns -2
+// for an invalid value.
+static int ldnr_option_time(const void *value, uint32_t size, int *out) {
+    if (!value) return -2;
+    if (size == 16) {
+        const int64_t *tv = value;
+        if (tv[0] < 0 || tv[1] < 0) return -2;
+        if (!tv[0] && !tv[1]) { *out = -1; return 0; }
+        int64_t ms = tv[0] * 1000 + tv[1] / 1000;
+        *out = ms > 0x7fffffff ? 0x7fffffff : (int)ms;
+        return 0;
+    }
+    if (size == 8) {
+        const int32_t *tv = value;
+        if (tv[0] < 0 || tv[1] < 0) return -2;
+        if (!tv[0] && !tv[1]) { *out = -1; return 0; }
+        *out = tv[0] * 1000 + tv[1] / 1000;
+        return 0;
+    }
+    if (size == 4) {
+        int32_t timeout = *(const int32_t *)value;
+        if (timeout < 0) return -2;
+        *out = timeout ? timeout : -1;
+        return 0;
+    }
+    return -2;
+}
+
+int ldnr_setsockopt(ldnr *l, int fd, int level, int option, const void *value, uint32_t size) {
+    (void)level;
+    if (!l || !value) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int result = 0;
+    if ((option == 0x20 || option == 4) && size >= 4) {
+        int enabled = *(const int32_t *)value != 0;
+        if (option == 0x20) s->broadcast = enabled;
+        else s->reuse_address = enabled;
+    } else if (option == 0x1005 || option == 0x1006) {
+        int timeout;
+        if (ldnr_option_time(value, size, &timeout)) result = ldnr_fail(LDNR_EINVAL);
+        else if (option == 0x1005) s->send_timeout_ms = timeout;
+        else s->recv_timeout_ms = timeout;
+    } else result = ldnr_fail(LDNR_ENOPROTOOPT);
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return result;
+}
+
+int ldnr_getsockopt(ldnr *l, int fd, int level, int option, void *value, uint32_t *size) {
+    (void)level;
+    if (!l || !value || !size || *size < 4) return ldnr_fail(LDNR_EINVAL);
+    pthread_mutex_lock(&l->vnet.mutex);
+    ldnr_vsock *s = ldnr_socket_at(l, fd);
+    if (!s) { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_EBADF); }
+    int32_t v;
+    if (option == 0x1007) { v = s->remote_error ? s->remote_error : s->connect_error; s->connect_error = 0; }
+    else if (option == 0x1008) v = s->type;
+    else if (option == 0x20) v = s->broadcast;
+    else if (option == 4) v = s->reuse_address;
+    else { pthread_mutex_unlock(&l->vnet.mutex); return ldnr_fail(LDNR_ENOPROTOOPT); }
+    memcpy(value, &v, 4);
+    *size = 4;
+    pthread_mutex_unlock(&l->vnet.mutex);
+    return 0;
+}
+
+static int ldnr_poll_events(ldnr *l, ldnr_vsock *s, int events) {
+    if (!s) return LDNR_POLLNVAL;
+    int result = 0;
+    if (s->type == 2) {
+        if (s->head) result |= LDNR_POLLIN;
+        if (l->vnet.local_address && !s->shut_write && !s->remote_error) result |= LDNR_POLLOUT;
+        // A datagram socket must report a terminal failure too: a wait on
+        // readiness alone would never see it.
+        if (s->remote_error || l->vnet.failed) result |= LDNR_POLLERR;
+    } else {
+        if (s->listening ? s->accept_count : ldnr_stream_can_read(s)) result |= LDNR_POLLIN;
+        if (s->connected && !s->shut_write && !s->remote_error) result |= LDNR_POLLOUT;
+    }
+    if (s->connect_error || s->remote_error) result |= LDNR_POLLERR;
+    // A hangup belongs to a stream: a datagram socket that saw the network
+    // die reports the error alone.
+    if (s->type != 2 && (s->remote_eof || s->shut_read)) result |= LDNR_POLLHUP;
+    return result & (events | LDNR_POLLERR | LDNR_POLLHUP | LDNR_POLLNVAL);
+}
+
+int ldnr_poll(ldnr *l, ldnr_pollfd *fds, size_t count, int timeout_ms) {
+    if (!l || (count && !fds)) return ldnr_fail(LDNR_EINVAL);
+    ldnr_retired_sweep(l);
+    pthread_mutex_lock(&l->vnet.mutex);
+    int64_t deadline = timeout_ms < 0 ? -1 : ldnr_monotonic_ms() + timeout_ms;
+    // An infinite wait with no descriptors would never be wakeable. Match the
+    // host's existing offline guard so a guest thread cannot strand its core.
+    if (!count && timeout_ms < 0) deadline = ldnr_monotonic_ms() + 100;
+    for (;;) {
+        int ready = 0;
+        for (size_t i = 0; i < count; i++) {
+            if (fds[i].fd < 0) { fds[i].revents = 0; continue; }
+            ldnr_vsock *s = ldnr_socket_at(l, fds[i].fd);
+            fds[i].revents = (int16_t)ldnr_poll_events(l, s, fds[i].events);
+            if (fds[i].revents) ready++;
+        }
+        if (ready) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ready;
+        }
+        // Cancellation and a lost network end the call with an explicit
+        // error in every iteration: a descriptor that cannot report either
+        // one must not keep the caller (and its glue reference) waiting.
+        if (l->cancelled) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ECANCELED);
+        }
+        if (l->vnet.failed) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ENETDOWN);
+        }
+        if (timeout_ms == 0 || (deadline >= 0 && deadline <= ldnr_monotonic_ms())) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return 0;
+        }
+        int wait = ldnr_vnet_wait(l, deadline);
+        if (wait == ETIMEDOUT) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return 0;
+        }
+        if (wait == ECANCELED) {
+            pthread_mutex_unlock(&l->vnet.mutex);
+            return ldnr_fail(LDNR_ECANCELED);
+        }
+    }
+}
+
+int ldnr_select(ldnr *l, int nfds, uint64_t *readfds, uint64_t *writefds,
+                uint64_t *exceptfds, int timeout_ms) {
+    if (!l || nfds < 0 || nfds > 1024) return ldnr_fail(LDNR_EINVAL);
+    ldnr_pollfd *fds = calloc((size_t)nfds, sizeof *fds);
+    if (!fds && nfds) return ldnr_fail(LDNR_ENOBUFS);
+    // Only the descriptors that are in one of the sets are polled: an unused
+    // descriptor would report an invalid descriptor and wake the caller.
+    size_t count = 0;
+    for (int fd = 0; fd < nfds; fd++) {
+        uint64_t bit = 1ull << (fd & 63);
+        int events = 0;
+        if (readfds && (readfds[fd >> 6] & bit)) events |= LDNR_POLLIN;
+        if (writefds && (writefds[fd >> 6] & bit)) events |= LDNR_POLLOUT;
+        if (exceptfds && (exceptfds[fd >> 6] & bit)) events |= LDNR_POLLPRI;
+        if (!events) continue;
+        fds[count].fd = fd;
+        fds[count].events = (int16_t)events;
+        count++;
+    }
+    if (!count) {
+        // Nothing to wait for: the call waits for its timeout, the way
+        // select() with an empty set does. An infinite wait is bounded like
+        // the one of poll(), so a guest thread cannot strand its core.
+        free(fds);
+        if (timeout_ms == 0) return 0;
+        int64_t deadline = timeout_ms < 0 ? ldnr_monotonic_ms() + 100
+                                          : ldnr_monotonic_ms() + timeout_ms;
+        pthread_mutex_lock(&l->vnet.mutex);
+        // Unrelated socket activity or a broadcast does not end the wait:
+        // only the deadline or a cancellation does.
+        int wait;
+        while (!(wait = ldnr_vnet_wait(l, deadline)) && ldnr_monotonic_ms() < deadline) { }
+        pthread_mutex_unlock(&l->vnet.mutex);
+        // A cancelled wait ends the call with an explicit error.
+        return wait == ECANCELED ? ldnr_fail(LDNR_ECANCELED) : 0;
+    }
+    int result = ldnr_poll(l, fds, count, timeout_ms);
+    if (result >= 0) {
+        uint64_t r[16] = {0}, w[16] = {0}, e[16] = {0};
+        int ready = 0;
+        for (size_t i = 0; i < count; i++) {
+            int fd = fds[i].fd;
+            uint64_t bit = 1ull << (fd & 63);
+            if (fds[i].revents & LDNR_POLLNVAL) {
+                // A selected descriptor that is not a virtual socket is an
+                // error, the way select() reports a bad descriptor.
+                free(fds);
+                return ldnr_fail(LDNR_EBADF);
+            }
+            // A terminal error or a hang-up is readiness in every set the
+            // descriptor was requested in, the way select() reports a
+            // socket that can answer a failed connect with its pending
+            // error. Exceptional readiness stays exceptional conditions.
+            int terminal = fds[i].revents & (LDNR_POLLERR | LDNR_POLLHUP);
+            if ((fds[i].revents & LDNR_POLLIN) ||
+                (terminal && (fds[i].events & LDNR_POLLIN))) {
+                r[fd >> 6] |= bit; ready++;
+            }
+            if ((fds[i].revents & LDNR_POLLOUT) ||
+                (terminal && (fds[i].events & LDNR_POLLOUT))) {
+                w[fd >> 6] |= bit; ready++;
+            }
+            if (fds[i].revents & LDNR_POLLPRI) { e[fd >> 6] |= bit; ready++; }
+        }
+        if (readfds) memcpy(readfds, r, sizeof r);
+        if (writefds) memcpy(writefds, w, sizeof w);
+        if (exceptfds) memcpy(exceptfds, e, sizeof e);
+        result = ready;
+    }
+    free(fds);
+    return result;
+}
