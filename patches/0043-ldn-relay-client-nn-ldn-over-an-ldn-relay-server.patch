+// Minimal Linux syntax-check surface for hle_ldnr.c; never used by the host build.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <pthread.h>
+
+typedef int Result;
+typedef struct { const char *name; void *fn; } hle_ent;
+#define RES_OK 0
+#define RES_FAIL (-1)
+static inline void ldnr_shim_log(const char *format, ...) { (void)format; }
+#define LOG(...) ldnr_shim_log(__VA_ARGS__)
+
+static const int _mh_execute_header;
+#ifdef LDNR_GLUE_RUNTIME_TEST
+const uint8_t *getsectiondata(const void *header, const char *segment,
+                              const char *section, unsigned long *size);
+#else
+static inline const uint8_t *getsectiondata(const void *header, const char *segment,
+                                            const char *section, unsigned long *size) {
+    (void)header; (void)segment; (void)section;
+    if (size) *size = 0;
+    return NULL;
+}
+#endif
+void dm_thread_native_wait(int entering);
+void hle_bind_system_event(void *event, int autoclear);
+void hle_signal_bound_system_event(void *event);
+// The identity of a binding: a rebind of the same address gets a new one.
+uint64_t hle_system_event_binding(void *event);
+// Signals only the binding with that identity, never the address it had.
+int hle_signal_system_event_binding(uint64_t binding);
+
+// The host profile. The glue reads the program id from it: the host does not
+// expose the local communication id of the control.nacp, so the program id
+// is the fallback.
+struct dm_profile { uint64_t program_id; };
+const struct dm_profile *dm_profile(void);
diff --git a/dm/host/ldnr/tests/t_glue.c b/dm/host/ldnr/tests/t_glue.c
new file mode 100644
index 0000000..a8baf83
--- /dev/null
+++ b/dm/host/ldnr/tests/t_glue.c
@@ -0,0 +1,600 @@
+// Runtime test of the Apple glue. The host symbols the glue calls are
+// stubbed here, so the test runs without the Apple SDK. It checks the
+// result translation, the event binding identity, the hook selection in
+// both modes, the entry names and the Finalize lifetime on the real glue
+// entry points.
+#define _POSIX_C_SOURCE 200809L
+#ifndef LDNR_GLUE_RUNTIME_TEST
+#define LDNR_GLUE_RUNTIME_TEST
+#endif
+#ifndef LDNR_GLUE_SYNTAX_TEST
+#define LDNR_GLUE_SYNTAX_TEST
+#endif
+
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+// A calloc the test can fail on demand: the unity build below routes all
+// of its allocations through it, so the out-of-memory paths of the glue
+// are exercised deterministically.
+static _Atomic int ldnr_test_calloc_fails;
+static void *ldnr_test_calloc(size_t n, size_t s) {
+    if (atomic_load(&ldnr_test_calloc_fails)) return NULL;
+    void *p = malloc(n * s);
+    if (p) memset(p, 0, n * s);
+    return p;
+}
+#define calloc ldnr_test_calloc
+#include "../../hle_ldnr.c"
+#undef calloc
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdio.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#define CHECK(expression)                                                           \
+    do {                                                                            \
+        if (!(expression)) {                                                        \
+            fprintf(stderr, "CHECK failed at %s:%d: %s\n", __FILE__, __LINE__,    \
+                    #expression);                                                   \
+            abort();                                                                \
+        }                                                                           \
+    } while (0)
+
+// ---------- stubs of the host symbols ----------
+
+static _Atomic int g_wait_entered, g_wait_exited;
+void dm_thread_native_wait(int entering) {
+    if (entering) atomic_fetch_add(&g_wait_entered, 1);
+    else atomic_fetch_add(&g_wait_exited, 1);
+}
+
+static uint64_t g_next_binding = 1;
+static uint64_t g_bound_id;
+static void *g_bound_event;
+static _Atomic uint64_t g_signalled;
+
+void hle_bind_system_event(void *event, int autoclear) {
+    (void)autoclear;
+    g_bound_event = event;
+    g_bound_id = g_next_binding++;
+}
+uint64_t hle_system_event_binding(void *event) {
+    return event == g_bound_event ? g_bound_id : 0;
+}
+int hle_signal_system_event_binding(uint64_t binding) {
+    atomic_store(&g_signalled, binding);
+    return 1;
+}
+void hle_signal_bound_system_event(void *event) { (void)event; }
+
+static struct dm_profile g_profile = {UINT64_C(0x0100c0ffee)};
+const struct dm_profile *dm_profile(void) { return &g_profile; }
+
+// The section lookup: the test records the entries itself, the Mach-O
+// section does not exist here.
+static const hle_ent *g_table;
+static size_t g_count;
+const uint8_t *getsectiondata(const void *header, const char *segment,
+                              const char *section, unsigned long *size) {
+    (void)header; (void)segment; (void)section;
+    if (size) *size = g_count * sizeof(hle_ent);
+    return (const uint8_t *)g_table;
+}
+
+// ---------- a scripted relay ----------
+
+// The fake transport connects, answers the authentication and nothing else:
+// the calls that wait for the relay then block inside the core, the way a
+// real unanswered request does.
+static pthread_mutex_t glue_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t glue_cond = PTHREAD_COND_INITIALIZER;
+static uint8_t glue_frames[8][4096];
+static size_t glue_sizes[8];
+static int glue_head, glue_count, glue_connected;
+static unsigned glue_wire[64];
+
+static void glue_push_locked(const uint8_t *frame, size_t size)
+{
+    if (glue_count >= 8) return;
+    int index = (glue_head + glue_count) % 8;
+    memcpy(glue_frames[index], frame, size);
+    glue_sizes[index] = size;
+    glue_count++;
+    pthread_cond_broadcast(&glue_cond);
+}
+
+// The authentication reply announces protocol 1.2, like the relay of the
+// test suite does.
+static void glue_auth_ok(uint32_t request_id, uint8_t *frame, size_t *size)
+{
+    static const uint8_t payload[] = {
+        1, 2, 0, 0,                 // major 1, minor 2, padding
+        0x1f, 0, 0, 0,              // the features of the relay
+        0,0,0,0,0,0,0,0,            // u64
+        0,0,0,0,0,0,0,0,            // u64
+        0,0,                        // u16
+        0,0,0,0,                    // u32
+        0,0,0,0,                    // u32
+    };
+    memcpy(frame, "LDNR", 4);
+    frame[4] = 1; frame[5] = 2; frame[6] = frame[7] = 0;
+    size_t payload_size = sizeof payload;
+    frame[8] = (uint8_t)payload_size; frame[9] = (uint8_t)(payload_size >> 8);
+    frame[10] = (uint8_t)(payload_size >> 16); frame[11] = (uint8_t)(payload_size >> 24);
+    frame[12] = (uint8_t)request_id; frame[13] = (uint8_t)(request_id >> 8);
+    frame[14] = (uint8_t)(request_id >> 16); frame[15] = (uint8_t)(request_id >> 24);
+    memcpy(frame + 16, payload, payload_size);
+    *size = 16 + payload_size;
+}
+
+static int glue_connect(void *ctx, const char *server, char *error, size_t error_size)
+{
+    (void)ctx; (void)server; (void)error; (void)error_size;
+    pthread_mutex_lock(&glue_mutex);
+    glue_connected = 1; glue_head = 0; glue_count = 0;
+    memset(glue_wire, 0, sizeof glue_wire);
+    pthread_mutex_unlock(&glue_mutex);
+    return 0;
+}
+
+static ssize_t glue_recv(void *ctx, void *frame, size_t capacity)
+{
+    (void)ctx;
+    pthread_mutex_lock(&glue_mutex);
+    while (glue_connected && !glue_count) pthread_cond_wait(&glue_cond, &glue_mutex);
+    if (!glue_connected) { pthread_mutex_unlock(&glue_mutex); return 0; }
+    size_t size = glue_sizes[glue_head];
+    CHECK(size <= capacity);
+    memcpy(frame, glue_frames[glue_head], size);
+    glue_head = (glue_head + 1) % 8;
+    glue_count--;
+    pthread_mutex_unlock(&glue_mutex);
+    return (ssize_t)size;
+}
+
+static int glue_send(void *ctx, const void *data, size_t size)
+{
+    (void)ctx;
+    const uint8_t *bytes = data;
+    if (size < 16) return -1;
+    uint8_t type = bytes[5];
+    uint32_t request_id = (uint32_t)bytes[12] | (uint32_t)bytes[13] << 8 |
+                          (uint32_t)bytes[14] << 16 | (uint32_t)bytes[15] << 24;
+    pthread_mutex_lock(&glue_mutex);
+    if (!glue_connected) { pthread_mutex_unlock(&glue_mutex); return -1; }
+    if (type < 64) glue_wire[type]++;
+    if (type == 0x01) {
+        uint8_t frame[64];
+        size_t frame_size;
+        glue_auth_ok(request_id, frame, &frame_size);
+        glue_push_locked(frame, frame_size);
+    }
+    pthread_mutex_unlock(&glue_mutex);
+    return 0;
+}
+
+static void glue_close(void *ctx)
+{
+    (void)ctx;
+    pthread_mutex_lock(&glue_mutex);
+    glue_connected = 0; glue_head = 0; glue_count = 0;
+    pthread_cond_broadcast(&glue_cond);
+    pthread_mutex_unlock(&glue_mutex);
+}
+
+static const ldnr_transport glue_transport = {
+    NULL, glue_connect, glue_recv, glue_send, glue_close, NULL, NULL,
+};
+
+// The runtime glue reads its transport through this hook instead of opening
+// a TCP connection of its own.
+const ldnr_transport *ldnr_glue_test_transport(void) { return &glue_transport; }
+
+static unsigned glue_wire_count(uint8_t type)
+{
+    pthread_mutex_lock(&glue_mutex);
+    unsigned count = glue_wire[type];
+    pthread_mutex_unlock(&glue_mutex);
+    return count;
+}
+
+// ---------- the checks ----------
+
+// The documented nn::ldn results: module 203, description in bits 9-15.
+static Result ldnr_res(unsigned description) {
+    return (Result)((description << 9) | 203u);
+}
+
+static void test_result_translation(void)
+{
+    // A missing room, a full room and a wrong password are different codes.
+    CHECK(lr_result(LDNR_EROOMNOTFOUND) == ldnr_res(65));
+    CHECK(lr_result(LDNR_EROOMFULL) == ldnr_res(67));
+    CHECK(lr_result(LDNR_EBADPASSWORD) == ldnr_res(20));
+    // The relay refuses a password room on a plaintext connection: the code
+    // stays apart from the other classes.
+    CHECK(lr_result(LDNR_ETLSREQUIRED) == ldnr_res(29));
+    CHECK(lr_result(LDNR_ETLSREQUIRED) != lr_result(LDNR_EBADPASSWORD));
+    // An explicit rejection of the connection has its documented code.
+    CHECK(lr_result(LDNR_EREJECTED) == ldnr_res(67));
+    // A lost relay is a timeout, not a disconnect by the user.
+    CHECK(lr_result(LDNR_ENETDOWN) == ldnr_res(66));
+    CHECK(lr_result(LDNR_EVERSIONMISMATCH) == ldnr_res(113));
+    // A failure without an error is not a success.
+    CHECK(lr_failure(0) != 0);
+    CHECK(lr_failure(LDNR_EINVAL) == ldnr_res(96));
+}
+
+static void test_event_binding(void)
+{
+    int event = 0;
+    lr_bind_event(&event);
+    CHECK(g_bound_event == &event);
+    uint64_t first = g_bound_id;
+    lr_state(NULL);
+    CHECK(atomic_load(&g_signalled) == first);
+    // The event is rebound at the same address: the old callback must not
+    // signal the new binding.
+    lr_bind_event(&event);
+    CHECK(g_bound_id != first);
+    atomic_store(&g_signalled, 0);
+    lr_state(NULL);
+    CHECK(atomic_load(&g_signalled) == g_bound_id);
+    CHECK(atomic_load(&g_signalled) != first);
+}
+
+// The entries the glue registered: the runtime test emits the same
+// name/function pairs that the Mach-O section carries in production.
+static const hle_ent emitted[] = {
+    ldnr_ent_lr_ldn_initialize, ldnr_ent_lr_ldn_finalize, ldnr_ent_lr_ldn_state,
+    ldnr_ent_lr_ldn_attach, ldnr_ent_lr_ldn_get_event,
+    ldnr_ent_lr_ldn_open_station, ldnr_ent_lr_ldn_close_station,
+    ldnr_ent_lr_ldn_open_ap, ldnr_ent_lr_ldn_close_ap,
+    ldnr_ent_lr_ldn_disconnect, ldnr_ent_lr_ldn_destroy,
+    ldnr_ent_lr_ldn_scan, ldnr_ent_lr_ldn_scan_private,
+    ldnr_ent_lr_ldn_create, ldnr_ent_lr_ldn_create_private,
+    ldnr_ent_lr_ldn_connect, ldnr_ent_lr_ldn_connect_private,
+    ldnr_ent_lr_ldn_info, ldnr_ent_lr_ldn_info_history, ldnr_ent_lr_ldn_ip,
+    ldnr_ent_lr_ldn_security, ldnr_ent_lr_ldn_advertise, ldnr_ent_lr_ldn_reason,
+    ldnr_ent_lr_ldn_filter, ldnr_ent_lr_ldn_clear_filter, ldnr_ent_lr_ldn_policy,
+    ldnr_ent_lr_ldn_reject, ldnr_ent_lr_ldn_config,
+    ldnr_ent_lr_socket_init, ldnr_ent_lr_socket_init4, ldnr_ent_lr_socket_finalize,
+    ldnr_ent_lr_socket_errno4, ldnr_ent_lr_socket_errno, ldnr_ent_lr_ns_errno,
+    ldnr_ent_lr_ns_set_errno,
+    ldnr_ent_lr_socket, ldnr_ent_lr_socket4, ldnr_ent_lr_ns_socket,
+    ldnr_ent_lr_bind_new, ldnr_ent_lr_bind_old, ldnr_ent_lr_ns_bind,
+    ldnr_ent_lr_connect_new, ldnr_ent_lr_connect_old, ldnr_ent_lr_ns_connect,
+    ldnr_ent_lr_listen_cpp, ldnr_ent_lr_listen_c,
+    ldnr_ent_lr_accept_new, ldnr_ent_lr_accept_old, ldnr_ent_lr_accept_c,
+    ldnr_ent_lr_close_cpp, ldnr_ent_lr_close_c,
+    ldnr_ent_lr_shutdown_cpp, ldnr_ent_lr_shutdown_c,
+    ldnr_ent_lr_sendto_old, ldnr_ent_lr_sendto_new, ldnr_ent_lr_sendto_c,
+    ldnr_ent_lr_recvfrom_old, ldnr_ent_lr_recvfrom_new, ldnr_ent_lr_recvfrom_c,
+    ldnr_ent_lr_send_old, ldnr_ent_lr_send_new, ldnr_ent_lr_send_c,
+    ldnr_ent_lr_recv_old, ldnr_ent_lr_recv_new, ldnr_ent_lr_recv_c,
+    ldnr_ent_lr_sockname_new, ldnr_ent_lr_sockname_old, ldnr_ent_lr_sockname_c,
+    ldnr_ent_lr_peername_new, ldnr_ent_lr_peername_c,
+    ldnr_ent_lr_setopt_new, ldnr_ent_lr_setopt_old, ldnr_ent_lr_setopt_c,
+    ldnr_ent_lr_getopt_new, ldnr_ent_lr_getopt_old, ldnr_ent_lr_getopt_c,
+    ldnr_ent_lr_fcntl_new, ldnr_ent_lr_fcntl_old, ldnr_ent_lr_fcntl_c,
+    ldnr_ent_lr_poll_new, ldnr_ent_lr_poll_old, ldnr_ent_lr_poll_c,
+    ldnr_ent_lr_select_new, ldnr_ent_lr_select_old,
+    ldnr_ent_lr_gai_new, ldnr_ent_lr_gai_old, ldnr_ent_lr_gai_c,
+    ldnr_ent_lr_freeai_new, ldnr_ent_lr_freeai_old, ldnr_ent_lr_freeai_c,
+    ldnr_ent_lr_gai_error_new, ldnr_ent_lr_gai_error_c,
+    ldnr_ent_lr_host_new, ldnr_ent_lr_host_c,
+    ldnr_ent_lr_eventfd, ldnr_ent_lr_eventfd_read, ldnr_ent_lr_eventfd_write,
+    ldnr_ent_lr_resolver_get, ldnr_ent_lr_resolver_set,
+    ldnr_ent_lr_ns_resolver_get, ldnr_ent_lr_ns_resolver_set,
+    ldnr_ent_lr_recvmsg, ldnr_ent_lr_sendmsg,
+};
+
+// Waits for a child and answers whether it reported success.
+static int child_reported_success(pid_t child)
+{
+    int status = 0;
+    if (waitpid(child, &status, 0) != child) return 0;
+    return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+static void test_hook_selection(void)
+{
+    static const hle_ent table[] = {
+        {"_ZN2nn3ldn10InitializeEv", (void *)1},
+        {"_ZN2nn3ldn8FinalizeEv", (void *)2},
+    };
+    unsetenv("DM_LDNR");
+    g_table = table;
+    g_count = 2;
+    // The enabled mode runs in a child forked before the hook was asked for
+    // anything in this process: its environment answer is a fresh one.
+    fflush(NULL);
+    pid_t child = fork();
+    CHECK(child >= 0);
+    if (child == 0) {
+        setenv("DM_LDNR", "1", 1);
+        int ok = ldnr_hook_lookup("_ZN2nn3ldn10InitializeEv") == (void *)1 &&
+                 ldnr_hook_lookup("_ZN2nn3ldn8FinalizeEv") == (void *)2 &&
+                 ldnr_hook_lookup("not a symbol") == NULL &&
+                 ldnr_hook_lookup("_ZN2nn3ldn8FinalizeXv") == NULL;
+        _exit(ok ? 0 : 1);
+    }
+    CHECK(child_reported_success(child));
+
+    // A second child checks the lookup over the real emitted table, still
+    // before this process ever asked the hook.
+    fflush(NULL);
+    child = fork();
+    CHECK(child >= 0);
+    if (child == 0) {
+        setenv("DM_LDNR", "1", 1);
+        g_table = emitted;
+        g_count = sizeof emitted / sizeof emitted[0];
+        int ok = 1;
+        for (size_t i = 0; i < g_count; i++)
+            ok &= ldnr_hook_lookup(emitted[i].name) == emitted[i].fn;
+        _exit(ok ? 0 : 1);
+    }
+    CHECK(child_reported_success(child));
+
+    // The hook is off unless DM_LDNR is set: this process asked nothing
+    // before now, so its first answer is the disabled one.
+    CHECK(ldnr_hook_lookup("_ZN2nn3ldn10InitializeEv") == NULL);
+    CHECK(ldnr_hook_lookup("not a symbol") == NULL);
+    setenv("DM_LDNR", "1", 1);
+    // The cached answer of the disabled mode does not change in this
+    // process any more.
+    CHECK(ldnr_hook_lookup("_ZN2nn3ldn10InitializeEv") == NULL);
+    unsetenv("DM_LDNR");
+}
+
+// The names are ABI-verified spellings of the intended C++ symbols: a typo
+// does not demangle, and the call would then bypass the relay
+// implementation. The lookup itself is checked by the forked children in
+// test_hook_selection.
+static void test_mangled_names(void)
+{
+    CHECK(!strcmp(ldnr_ent_lr_ldn_initialize.name, "_ZN2nn3ldn10InitializeEv"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_finalize.name, "_ZN2nn3ldn8FinalizeEv"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_attach.name,
+                  "_ZN2nn3ldn22AttachStateChangeEventEPNS_2os15SystemEventTypeE"));
+    // GetStateChangeEvent is 19 letters: a name of 18 does not demangle.
+    CHECK(!strcmp(ldnr_ent_lr_ldn_get_event.name,
+                  "_ZN2nn3ldn19GetStateChangeEventEPNS_2os15SystemEventTypeE"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_scan.name,
+                  "_ZN2nn3ldn4ScanEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_scan_private.name,
+                  "_ZN2nn3ldn11ScanPrivateEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_create.name,
+                  "_ZN2nn3ldn13CreateNetworkERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_10UserConfigE"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_connect.name,
+                  "_ZN2nn3ldn7ConnectERKNS0_11NetworkInfoERKNS0_14SecurityConfigERKNS0_10UserConfigEiNS0_13ConnectOptionE"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_connect_private.name,
+                  "_ZN2nn3ldn14ConnectPrivateERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_17SecurityParameterERKNS0_10UserConfigEiNS0_13ConnectOptionE"));
+    CHECK(!strcmp(ldnr_ent_lr_ldn_info.name, "_ZN2nn3ldn14GetNetworkInfoEPNS0_11NetworkInfoE"));
+    // The node array is nn::ldn::NodeLatestUpdate: inside the same
+    // namespace it is spelled NS0_, not NS_.
+    CHECK(!strcmp(ldnr_ent_lr_ldn_info_history.name,
+                  "_ZN2nn3ldn24GetNetworkInfoAndHistoryEPNS0_11NetworkInfoEPNS0_16NodeLatestUpdateEi"));
+    CHECK(!strcmp(ldnr_ent_lr_poll_new.name, "_ZN2nn6socket4PollEPNS0_6PollFdEmi"));
+    CHECK(!strcmp(ldnr_ent_lr_poll_old.name, "_ZN2nn6socket4PollEP6pollfdmi"));
+    CHECK(!strcmp(ldnr_ent_lr_select_new.name,
+                  "_ZN2nn6socket6SelectEiPNS0_5FdSetES2_S2_PNS0_7TimeValE"));
+    CHECK(!strcmp(ldnr_ent_lr_setopt_new.name,
+                  "_ZN2nn6socket10SetSockOptEiNS0_5LevelENS0_6OptionEPKvj"));
+    CHECK(!strcmp(ldnr_ent_lr_fcntl_new.name, "_ZN2nn6socket5FcntlEiNS0_12FcntlCommandEz"));
+    CHECK(!strcmp(ldnr_ent_lr_socket_init.name, "_ZN2nn6socket10InitializeERKNS0_6ConfigE"));
+    CHECK(!strcmp(ldnr_ent_lr_socket_finalize.name, "_ZN2nn6socket8FinalizeEv"));
+}
+
+// A byte-count hook reports its error through the whole return register:
+// the emitted entry, called through the ssize_t signature of the real
+// nn::socket API, must yield -1. A narrower declaration would leave the
+// upper word unwritten and the guest would see 4294967295 instead.
+static void test_byte_count_hooks_return_full_width(void)
+{
+    typedef ssize_t (*msg_fn)(void);
+    typedef ssize_t (*recv_fn)(int, void *, unsigned long, int);
+    typedef ssize_t (*recvfrom_fn)(int, void *, unsigned long, int, void *, unsigned *);
+    typedef ssize_t (*send_fn)(int, const void *, unsigned long, int);
+    typedef ssize_t (*sendto_fn)(int, const void *, unsigned long, int, const void *, unsigned);
+    uint8_t byte = 0;
+    setenv("DM_LDNR_SERVER", "127.0.0.1:1", 1);
+    CHECK(((msg_fn)ldnr_ent_lr_recvmsg.fn)() == (ssize_t)-1);
+    CHECK(((msg_fn)ldnr_ent_lr_sendmsg.fn)() == (ssize_t)-1);
+    // A bad descriptor fails inside the core without touching the relay.
+    CHECK(((recv_fn)ldnr_ent_lr_recv_c.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((recv_fn)ldnr_ent_lr_recv_old.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((recv_fn)ldnr_ent_lr_recv_new.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((recvfrom_fn)ldnr_ent_lr_recvfrom_c.fn)(-1, &byte, 1, 0, NULL, NULL) == (ssize_t)-1);
+    CHECK(((send_fn)ldnr_ent_lr_send_c.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((send_fn)ldnr_ent_lr_send_old.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((send_fn)ldnr_ent_lr_send_new.fn)(-1, &byte, 1, 0) == (ssize_t)-1);
+    CHECK(((sendto_fn)ldnr_ent_lr_sendto_c.fn)(-1, &byte, 1, 0, NULL, 0) == (ssize_t)-1);
+    lr_ldn_finalize();
+}
+
+// The guest's maximum cannot grow the staging buffer past the reply's
+// capacity, and a staging buffer that cannot be allocated reports the
+// out-of-memory mapping rather than pretending the relay answered.
+static void test_scan_alloc_failure(void)
+{
+    setenv("DM_LDNR_SERVER", "127.0.0.1:1", 1);
+    int count = 99;
+    uint8_t out[LDNR_MAX_NETWORKS * sizeof(ldnr_network_info)];
+    // A huge guest maximum allocates only the reply's capacity: the call
+    // reaches the core and fails on the state, not on the size.
+    Result result = lr_ldn_scan(out, &count, 0x40000000, NULL, 0);
+    CHECK(count == 0);
+    CHECK(result == lr_result(LDNR_EINVAL));
+    // The core now exists: the failing allocation is the one inside the
+    // scan entry.
+    atomic_store(&ldnr_test_calloc_fails, 1);
+    result = lr_ldn_scan(out, &count, 1, NULL, 0);
+    atomic_store(&ldnr_test_calloc_fails, 0);
+    CHECK(count == 0);
+    CHECK(result == lr_result(LDNR_ENOBUFS));
+    lr_ldn_finalize();
+}
+
+// A call that blocks inside the core on a legal established state must not
+// keep Finalize waiting: the glue teardown ends it, and the glue state is
+// clean afterwards.
+typedef struct {
+    uint8_t out[sizeof(ldnr_network_info)];
+    int count;
+    Result result;
+} test_blocker;
+
+static void *test_block(void *argument)
+{
+    test_blocker *blocker = argument;
+    // The glue entry holds the core reference for the whole call: it is
+    // exactly the reference Finalize waits for.
+    blocker->result = lr_ldn_scan(blocker->out, &blocker->count, 1, NULL, 0);
+    return NULL;
+}
+
+static int test_wait_entered(int baseline)
+{
+    int64_t deadline = (int64_t)time(NULL) + 4;
+    while (atomic_load(&g_wait_entered) <= baseline) {
+        if ((int64_t)time(NULL) >= deadline) return 0;
+        sched_yield();
+    }
+    return 1;
+}
+
+static void test_finalize_cancels_a_blocked_call(void)
+{
+    test_blocker blocker;
+    pthread_t thread;
+    int event = 0;
+
+    setenv("DM_LDNR_SERVER", "127.0.0.1:1", 1);
+    CHECK(lr_ldn_initialize() == RES_OK);
+    CHECK(g_glue.core != NULL);
+    // The binding is recorded so a state change can signal it; the open of
+    // the station fires it.
+    lr_bind_event(&event);
+    uint64_t binding = g_bound_id;
+    CHECK(lr_ldn_open_station() == RES_OK);
+    CHECK(atomic_load(&g_signalled) == binding);
+    CHECK(lr_ldn_state() != 0);
+
+    atomic_store(&g_signalled, 0);
+    memset(&blocker, 0, sizeof blocker);
+    blocker.count = 99;
+    int baseline = atomic_load(&g_wait_entered);
+    CHECK(pthread_create(&thread, NULL, test_block, &blocker) == 0);
+    // The scan is inside the core's request wait: the wait entry is the
+    // synchronization, not a guessed delay.
+    CHECK(test_wait_entered(baseline));
+    CHECK(glue_wire_count(0x13) == 1);   // the SCAN reached the relay
+    // The real glue teardown: no direct core call on the side.
+    lr_ldn_finalize();
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(blocker.result != RES_OK);
+    CHECK(blocker.count == 0);
+    // The teardown left nothing behind: no core, no active call, no stale
+    // binding that could signal a dead event.
+    CHECK(g_glue.core == NULL);
+    CHECK(g_glue.active == 0 && !g_glue.closing);
+    CHECK(atomic_load(&g_signalled) == 0);
+    CHECK(atomic_load(&g_wait_entered) == atomic_load(&g_wait_exited));
+
+    // The glue makes a fresh core for the next use: a close/reconnect on
+    // the production path works.
+    CHECK(lr_ldn_initialize() == RES_OK);
+    CHECK(g_glue.core != NULL);
+    CHECK(lr_ldn_open_station() == RES_OK);
+    lr_ldn_finalize();
+    CHECK(g_glue.core == NULL);
+}
+
+// Two finalizers racing a blocked call: the teardown has one owner, the
+// other waits for it and returns without touching its state.
+static void *test_finalize_thread(void *argument)
+{
+    (void)argument;
+    lr_ldn_finalize();
+    return NULL;
+}
+
+static void test_double_finalize(void)
+{
+    test_blocker blocker;
+    pthread_t scan, first, second;
+
+    setenv("DM_LDNR_SERVER", "127.0.0.1:1", 1);
+    CHECK(lr_ldn_initialize() == RES_OK);
+    CHECK(lr_ldn_open_station() == RES_OK);
+    memset(&blocker, 0, sizeof blocker);
+    int baseline = atomic_load(&g_wait_entered);
+    CHECK(pthread_create(&scan, NULL, test_block, &blocker) == 0);
+    CHECK(test_wait_entered(baseline));
+    CHECK(pthread_create(&first, NULL, test_finalize_thread, NULL) == 0);
+    CHECK(pthread_create(&second, NULL, test_finalize_thread, NULL) == 0);
+    CHECK(pthread_join(scan, NULL) == 0);
+    CHECK(pthread_join(first, NULL) == 0);
+    CHECK(pthread_join(second, NULL) == 0);
+    CHECK(blocker.result != RES_OK);
+    CHECK(g_glue.core == NULL);
+    CHECK(g_glue.active == 0 && !g_glue.closing);
+    // The glue still works after the race.
+    CHECK(lr_ldn_initialize() == RES_OK);
+    lr_ldn_finalize();
+    CHECK(g_glue.core == NULL);
+}
+
+// A Connect whose security configuration the wire refuses must fail: the
+// frame never goes out, and the caller does not see a success.
+static void test_connect_with_an_unencodable_passphrase(void)
+{
+    uint8_t info[LDNR_NATIVE_NETWORK_INFO_SIZE];
+    uint8_t security[LDNR_NATIVE_SECURITY_CONFIG_SIZE];
+    uint8_t user[LDNR_NATIVE_USER_CONFIG_SIZE];
+    Result result;
+
+    setenv("DM_LDNR_SERVER", "127.0.0.1:1", 1);
+    CHECK(lr_ldn_initialize() == RES_OK);
+    CHECK(lr_ldn_open_station() == RES_OK);
+    memset(info, 0, sizeof(info));
+    memset(security, 0, sizeof(security));
+    memset(user, 0, sizeof(user));
+    // A passphrase of one byte: the native layout of the guest accepts it,
+    // the wire refuses it.
+    security[0x02] = 1;
+    // The error of the call must be its own: a stale one from an earlier
+    // call must not stand in for it.
+    ldnr_set_errno(0);
+    result = lr_ldn_connect(info, security, user, 0, 0);
+    // The call failed: it is not a success with a stale error.
+    CHECK(result != RES_OK);
+    CHECK(result == ldnr_res(96));
+    // The failure carries an error of its own.
+    CHECK(ldnr_last_errno() == LDNR_EINVAL);
+    // The request never reached the relay.
+    CHECK(glue_wire_count(0x15) == 0);
+    lr_ldn_finalize();
+}
+
+int main(void)
+{
+    test_result_translation();
+    test_event_binding();
+    test_hook_selection();
+    test_mangled_names();
+    test_byte_count_hooks_return_full_width();
+    test_scan_alloc_failure();
+    test_connect_with_an_unencodable_passphrase();
+    test_finalize_cancels_a_blocked_call();
+    test_double_finalize();
+    puts("PASS");
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_ldnr_e2e.c b/dm/host/ldnr/tests/t_ldnr_e2e.c
new file mode 100644
index 0000000..3cbdb05
--- /dev/null
+++ b/dm/host/ldnr/tests/t_ldnr_e2e.c
@@ -0,0 +1,198 @@
+// Real relay integration test. No server is bundled: set LDNR_SERVER_BIN.
+#include "ldnr.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL %s:%d: %s (errno=%d)\n", \
+    __FILE__, __LINE__, #x, ldnr_last_errno()); goto out; } } while (0)
+
+// The core reports the BSD error numbers of nn::ldn, not the ones of the
+// host: the host numbers differ (Linux uses 104 for a reset connection).
+#define LDN_ECONNRESET 54
+
+static uint16_t reserve_port(void) {
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return 0;
+    struct sockaddr_in address;
+    memset(&address, 0, sizeof address); address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(0x7f000001u); // 127.0.0.1
+    if (bind(fd, (struct sockaddr *)&address, sizeof address) ||
+        listen(fd, 1)) { close(fd); return 0; }
+    socklen_t size = sizeof address;
+    uint16_t port = getsockname(fd, (struct sockaddr *)&address, &size) ? 0 : ntohs(address.sin_port);
+    close(fd); return port;
+}
+
+static void test_sleep_ms(long ms) {
+    struct timespec delay = {ms / 1000, (ms % 1000) * 1000000};
+    while (nanosleep(&delay, &delay) && errno == EINTR) {}
+}
+
+static int wait_state(ldnr *l, int state) {
+    for (int i = 0; i < 100; i++) {
+        if (ldnr_get_state(l) == state) return 1;
+        test_sleep_ms(20);
+    }
+    return 0;
+}
+
+static int wait_nodes(ldnr *l, int nodes) {
+    for (int i = 0; i < 100; i++) {
+        ldnr_network_info info;
+        if (!ldnr_get_network_info(l, &info) && info.node_count == nodes) return 1;
+        test_sleep_ms(20);
+    }
+    return 0;
+}
+
+int main(void) {
+    const char *binary = getenv("LDNR_SERVER_BIN");
+    if (!binary || !*binary) { puts("SKIP: LDNR_SERVER_BIN is unset"); return 0; }
+    uint16_t port = reserve_port();
+    if (!port) { perror("reserve port"); return 1; }
+    pid_t server = fork();
+    if (server < 0) { perror("fork"); return 1; }
+    if (server == 0) {
+        char listen_arg[64];
+        snprintf(listen_arg, sizeof listen_arg, "127.0.0.1:%u", port);
+        // The client has no TLS yet; the test room password needs the
+        // server's explicit plaintext opt-out (protocol 1.2 default refuses).
+        execl(binary, binary, "-listen", listen_arg, "-log-level", "warn",
+              "-require-tls-for-password=false", (char *)NULL);
+        _exit(127);
+    }
+    char address[64];
+    snprintf(address, sizeof address, "127.0.0.1:%u", port);
+    ldnr *host = NULL, *station = NULL;
+    int result = 1, host_socket = -1, station_socket = -1;
+    ldnr_config config = {0};
+    config.server = address; config.room_password = "e2e-room"; config.player_name = "host";
+    // The built-in transport is a plaintext stream: the room password may
+    // only travel in clear when the caller accepts the risk.
+    config.allow_plaintext_password = 1;
+    config.connect_timeout_ms = 3000; config.scan_timeout_ms = 3000;
+    config.log = getenv("LDNR_LOG") != NULL;
+    CHECK(!ldnr_create(&config, &host));
+    config.player_name = "station";
+    CHECK(!ldnr_create(&config, &station));
+    CHECK(!ldnr_initialize(host)); CHECK(!ldnr_initialize(station));
+    int opened = 0;
+    for (int i = 0; i < 100 && !opened; i++) {
+        if (!ldnr_open_access_point(host)) opened = 1;
+        else test_sleep_ms(20);
+    }
+    CHECK(opened); CHECK(!ldnr_open_station(station));
+
+    ldnr_network_config network_config;
+    memset(&network_config, 0, sizeof network_config);
+    network_config.intent_id.local_communication_id = 0x11223344;
+    network_config.intent_id.scene_id = 7; network_config.channel = 6;
+    network_config.node_count_max = 4; network_config.local_communication_version = 1;
+    ldnr_security_config security;
+    memset(&security, 0, sizeof security);
+    ldnr_user_config user;
+    memset(&user, 0, sizeof user); memcpy(user.user_name, "host", 4);
+    CHECK(!ldnr_create_network(host, &network_config, &security, &user, NULL, NULL, 0));
+    const uint8_t advertise[] = {'e', '2', 'e', 0, 1, 2, 3, 4};
+    CHECK(!ldnr_set_advertise_data(host, advertise, sizeof advertise));
+    CHECK(!ldnr_set_station_accept_policy(host, 0));
+    const uint8_t filter_mac[6] = {2, 0, 0, 0, 0, 9};
+    CHECK(!ldnr_add_accept_filter_entry(host, filter_mac));
+
+    ldnr_scan_filter filter;
+    memset(&filter, 0, sizeof filter);
+    // The native flags 0x01 (local communication id) and 0x20 (scene id).
+    filter.flags = 0x21;
+    filter.network_id.intent_id.local_communication_id = network_config.intent_id.local_communication_id;
+    filter.network_id.intent_id.scene_id = 7;
+    ldnr_network_info found[4]; int count = 0;
+    memset(found, 0, sizeof found);
+    CHECK(!ldnr_scan(station, found, &count, 4, &filter, 0, 0));
+    CHECK(count >= 1);
+    int room = -1;
+    for (int i = 0; i < count; i++)
+        if (found[i].advertise_data_size == sizeof advertise &&
+            !memcmp(found[i].advertise_data, advertise, sizeof advertise)) room = i;
+    CHECK(room >= 0);
+    memset(&user, 0, sizeof user); memcpy(user.user_name, "station", 7);
+    CHECK(!ldnr_connect_network(station, &found[room], NULL, &security, &user, NULL, 0, 0));
+    // The address of nn::ldn is the host order value of the four octets:
+    // 10.114.0.1 is 0x0A720001 there and 0x0100720A on the socket layer.
+    uint32_t host_ip = 0, station_ip = 0, mask = 0;
+    CHECK(!ldnr_get_ipv4_address(host, &host_ip, &mask));
+    CHECK(!ldnr_get_ipv4_address(station, &station_ip, &mask));
+    CHECK(host_ip == UINT32_C(0x0A720001));
+    CHECK(station_ip == UINT32_C(0x0A720002));
+    CHECK(mask == UINT32_C(0xFFFF0000));
+    uint32_t host_wire = ldnr_ipv4_from_native(host_ip);
+    uint32_t station_wire = ldnr_ipv4_from_native(station_ip);
+    CHECK(wait_nodes(host, 2));
+
+    host_socket = ldnr_socket(host, 2, 2, 17); station_socket = ldnr_socket(station, 2, 2, 17);
+    CHECK(host_socket >= 0 && station_socket >= 0);
+    ldnr_sockaddr host_udp = {0, ldnr_htons(40000)}, station_udp = {0, ldnr_htons(40001)};
+    CHECK(!ldnr_bind(host, host_socket, &host_udp)); CHECK(!ldnr_bind(station, station_socket, &station_udp));
+    const char udp_message[] = "udp unicast";
+    station_udp.address = station_wire;
+    CHECK(ldnr_sendto(host, host_socket, udp_message, sizeof udp_message, 0, &station_udp) == sizeof udp_message);
+    uint8_t buffer[128]; ldnr_sockaddr source;
+    CHECK(ldnr_recvfrom(station, station_socket, buffer, sizeof buffer, 0, &source, 2000) == sizeof udp_message);
+    CHECK(!memcmp(buffer, udp_message, sizeof udp_message));
+    CHECK(source.address == host_wire && source.port == ldnr_htons(40000));
+    const char broadcast_message[] = "udp broadcast";
+    host_udp.address = ldnr_ipv4(10, 114, 255, 255);
+    CHECK(ldnr_sendto(station, station_socket, broadcast_message, sizeof broadcast_message, 0, &host_udp) == sizeof broadcast_message);
+    CHECK(ldnr_recvfrom(host, host_socket, buffer, sizeof buffer, 0, &source, 2000) == sizeof broadcast_message);
+    CHECK(!memcmp(buffer, broadcast_message, sizeof broadcast_message));
+    CHECK(!ldnr_close_socket(host, host_socket)); CHECK(!ldnr_close_socket(station, station_socket));
+    host_socket = station_socket = -1;
+
+    int listener = ldnr_socket(host, 2, 1, 6), connector = ldnr_socket(station, 2, 1, 6);
+    CHECK(listener >= 0 && connector >= 0);
+    ldnr_sockaddr tcp_address = {0, ldnr_htons(40002)};
+    CHECK(!ldnr_bind(host, listener, &tcp_address)); CHECK(!ldnr_listen(host, listener, 4));
+    tcp_address.address = host_wire;
+    CHECK(!ldnr_connect_socket(station, connector, &tcp_address, 3000));
+    int accepted = ldnr_accept(host, listener, &source, 2000);
+    CHECK(accepted >= 0 && source.address == station_wire);
+    const char request[] = "tcp request", response[] = "tcp response";
+    CHECK(ldnr_send(station, connector, request, sizeof request, 0) == sizeof request);
+    CHECK(ldnr_recv(host, accepted, buffer, sizeof buffer, 0, 2000) == sizeof request);
+    CHECK(!memcmp(buffer, request, sizeof request));
+    CHECK(ldnr_send(host, accepted, response, sizeof response, 0) == sizeof response);
+    CHECK(ldnr_recv(station, connector, buffer, sizeof buffer, 0, 2000) == sizeof response);
+    CHECK(!memcmp(buffer, response, sizeof response));
+    CHECK(!ldnr_close_socket(station, connector));
+    // The orderly close ends the sending direction: the peer reads the end
+    // of the stream, not an error.
+    CHECK(ldnr_recv(host, accepted, buffer, sizeof buffer, 0, 2000) == 0);
+    CHECK(!ldnr_close_socket(host, accepted)); CHECK(!ldnr_close_socket(host, listener));
+
+    CHECK(!ldnr_disconnect(station));
+    CHECK(ldnr_get_state(station) == 3); CHECK(wait_nodes(host, 1));
+    CHECK(!ldnr_connect_network(station, &found[room], NULL, &security, &user, NULL, 0, 0));
+    CHECK(wait_nodes(host, 2));
+    CHECK(!ldnr_destroy_network(host));
+    CHECK(ldnr_get_state(host) == 2); CHECK(wait_state(station, 3));
+    CHECK(ldnr_get_disconnect_reason(station) == 3);
+    CHECK(!ldnr_close_access_point(host)); CHECK(!ldnr_close_station(station));
+    result = 0;
+out:
+    if (host_socket >= 0 && host) ldnr_close_socket(host, host_socket);
+    if (station_socket >= 0 && station) ldnr_close_socket(station, station_socket);
+    if (station) ldnr_destroy(station);
+    if (host) ldnr_destroy(host);
+    kill(server, SIGTERM);
+    while (waitpid(server, NULL, 0) < 0 && errno == EINTR) {}
+    if (!result) puts("PASS: real relay host/join/scan/UDP/TCP/disconnect/destroy");
+    return result;
+}
diff --git a/dm/host/ldnr/tests/t_native.c b/dm/host/ldnr/tests/t_native.c
new file mode 100644
index 0000000..88dcf83
--- /dev/null
+++ b/dm/host/ldnr/tests/t_native.c
@@ -0,0 +1,340 @@
+#include "ldnr_native.h"
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+static void fill_bytes(uint8_t *bytes, size_t size, uint8_t seed)
+{
+    size_t i;
+
+    for (i = 0; i < size; ++i)
+        bytes[i] = (uint8_t)(seed + i * 17u);
+}
+
+#define CHECK_ROUND_TRIP(source, kind, size)                                          \
+    do {                                                                              \
+        uint8_t bytes_[size];                                                         \
+        ldnr_##kind decoded_ = {0};                                                   \
+        assert(ldnr_native_##kind##_encode(&(source), bytes_, sizeof(bytes_)) ==      \
+               LDNR_NATIVE_OK);                                                       \
+        assert(ldnr_native_##kind##_decode(&decoded_, bytes_, sizeof(bytes_)) ==      \
+               LDNR_NATIVE_OK);                                                       \
+        assert(memcmp(&(source), &decoded_, sizeof(source)) == 0);                    \
+    } while (0)
+
+// The expectations are the libnx layouts (nn::ldn): IntentId 0x10,
+// NetworkId 0x20, CommonNetworkInfo 0x30, NodeInfo 0x40, NetworkInfo 0x480
+// with common at 0x20, server_random at 0x50 and the nodes at 0x68,
+// NetworkConfig 0x20 and ScanFilter 0x60 with the flags at 0x5c.
+static void test_layouts(void)
+{
+    assert(sizeof(ldnr_intent_id) == 0x10);
+    assert(offsetof(ldnr_intent_id, scene_id) == 0x0a);
+    assert(sizeof(ldnr_network_id) == 0x20);
+    assert(offsetof(ldnr_network_id, session_id) == 0x10);
+    assert(sizeof(ldnr_ssid) == 0x22);
+    assert(offsetof(ldnr_ssid, string) == 0x01);
+    assert(sizeof(ldnr_common_network_info) == 0x30);
+    assert(offsetof(ldnr_common_network_info, ssid) == 0x06);
+    assert(offsetof(ldnr_common_network_info, channel) == 0x28);
+    assert(offsetof(ldnr_common_network_info, network_type) == 0x2b);
+    assert(sizeof(ldnr_node_info) == 0x40);
+    assert(offsetof(ldnr_node_info, mac_address) == 0x04);
+    assert(offsetof(ldnr_node_info, node_id) == 0x0a);
+    assert(offsetof(ldnr_node_info, user_name) == 0x0c);
+    assert(offsetof(ldnr_node_info, platform) == 0x2d);
+    assert(offsetof(ldnr_node_info, local_communication_version) == 0x2e);
+    assert(sizeof(ldnr_network_info) == 0x480);
+    assert(offsetof(ldnr_network_info, common) == 0x20);
+    assert(offsetof(ldnr_network_info, server_random) == 0x50);
+    assert(offsetof(ldnr_network_info, security_mode) == 0x60);
+    assert(offsetof(ldnr_network_info, station_accept_policy) == 0x62);
+    assert(offsetof(ldnr_network_info, version) == 0x63);
+    assert(offsetof(ldnr_network_info, node_count_max) == 0x66);
+    assert(offsetof(ldnr_network_info, node_count) == 0x67);
+    assert(offsetof(ldnr_network_info, nodes) == 0x68);
+    assert(offsetof(ldnr_network_info, advertise_data_size) == 0x26a);
+    assert(offsetof(ldnr_network_info, advertise_data) == 0x26c);
+    assert(sizeof(ldnr_user_config) == 0x30);
+    assert(sizeof(ldnr_security_config) == 0x44);
+    assert(offsetof(ldnr_security_config, passphrase) == 0x04);
+    assert(sizeof(ldnr_security_parameter) == 0x20);
+    assert(offsetof(ldnr_security_parameter, session_id) == 0x10);
+    assert(sizeof(ldnr_network_config) == 0x20);
+    assert(offsetof(ldnr_network_config, channel) == 0x10);
+    assert(offsetof(ldnr_network_config, node_count_max) == 0x12);
+    assert(offsetof(ldnr_network_config, local_communication_version) == 0x14);
+    assert(sizeof(ldnr_scan_filter) == 0x60);
+    assert(offsetof(ldnr_scan_filter, network_type) == 0x20);
+    assert(offsetof(ldnr_scan_filter, bssid) == 0x24);
+    assert(offsetof(ldnr_scan_filter, ssid) == 0x2a);
+    assert(offsetof(ldnr_scan_filter, flags) == 0x5c);
+    assert(sizeof(ldnr_address_entry) == 0x0c);
+    assert(offsetof(ldnr_address_entry, mac_address) == 0x04);
+    assert(sizeof(ldnr_node_latest_update) == 0x08);
+}
+
+static void test_identifier_and_node_round_trips(void)
+{
+    ldnr_intent_id intent = {0};
+    ldnr_network_id network = {0};
+    ldnr_ssid ssid = {0};
+    ldnr_common_network_info common = {0};
+    ldnr_node_info node = {0};
+
+    intent.local_communication_id = INT64_C(-0x123456789abcdef);
+    intent.scene_id = 0xf123;
+    CHECK_ROUND_TRIP(intent, intent_id, LDNR_NATIVE_INTENT_ID_SIZE);
+
+    network.intent_id = intent;
+    fill_bytes(network.session_id, sizeof(network.session_id), 3);
+    CHECK_ROUND_TRIP(network, network_id, LDNR_NATIVE_NETWORK_ID_SIZE);
+
+    ssid.length = LDNR_NATIVE_SSID_MAX;
+    fill_bytes(ssid.string, sizeof(ssid.string), 7);
+    ssid.string[LDNR_NATIVE_SSID_MAX] = 0;
+    CHECK_ROUND_TRIP(ssid, ssid, LDNR_NATIVE_SSID_SIZE);
+
+    fill_bytes(common.bssid, sizeof(common.bssid), 11);
+    common.ssid = ssid;
+    common.channel = -1234;
+    common.link_level = -5;
+    common.network_type = 2;
+    CHECK_ROUND_TRIP(common, common_network_info,
+                     LDNR_NATIVE_COMMON_NETWORK_INFO_SIZE);
+
+    node.ipv4_address = UINT32_C(0x89abcdef);
+    fill_bytes(node.mac_address, sizeof(node.mac_address), 19);
+    node.node_id = -7;
+    node.is_connected = 1;
+    fill_bytes(node.user_name, sizeof(node.user_name), 23);
+    node.platform = 1;
+    node.local_communication_version = -2345;
+    CHECK_ROUND_TRIP(node, node_info, LDNR_NATIVE_NODE_INFO_SIZE);
+}
+
+static void test_network_info_round_trip(void)
+{
+    ldnr_network_info info = {0};
+    uint8_t bytes[LDNR_NATIVE_NETWORK_INFO_SIZE];
+    ldnr_network_info decoded = {0};
+    size_t i;
+
+    info.network_id.intent_id.local_communication_id = INT64_C(0x102030405060708);
+    info.network_id.intent_id.scene_id = 42;
+    fill_bytes(info.network_id.session_id, sizeof(info.network_id.session_id), 29);
+    fill_bytes(info.common.bssid, sizeof(info.common.bssid), 31);
+    info.common.ssid.length = 5;
+    memcpy(info.common.ssid.string, "relay", 5);
+    info.common.channel = 11;
+    info.common.link_level = 3;
+    info.common.network_type = 1;
+    fill_bytes(info.server_random, sizeof(info.server_random), 37);
+    info.security_mode = 2;
+    info.station_accept_policy = 1;
+    info.version = 3;
+    info.node_count_max = 8;
+    info.node_count = 2;
+    for (i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; ++i) {
+        info.nodes[i].ipv4_address = UINT32_C(0xc0a80001) + (uint32_t)i;
+        fill_bytes(info.nodes[i].mac_address, sizeof(info.nodes[i].mac_address),
+                   (uint8_t)(41 + i));
+        info.nodes[i].node_id = (int8_t)i;
+        info.nodes[i].is_connected = i < info.node_count;
+        fill_bytes(info.nodes[i].user_name, sizeof(info.nodes[i].user_name),
+                   (uint8_t)(53 + i));
+        info.nodes[i].local_communication_version = (int16_t)(100 + i);
+    }
+    info.advertise_data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX;
+    fill_bytes(info.advertise_data, sizeof(info.advertise_data), 67);
+
+    assert(ldnr_native_network_info_encode(&info, bytes, sizeof(bytes)) == LDNR_NATIVE_OK);
+    // The advertise data size is at 0x26a and the first node at 0x68.
+    assert(bytes[0x26a] == 0x80 && bytes[0x26b] == 0x01);
+    assert(bytes[0x68] == 0x01 && bytes[0x69] == 0x00 && bytes[0x6a] == 0xa8 &&
+           bytes[0x6b] == 0xc0);
+    assert(ldnr_native_network_info_decode(&decoded, bytes, sizeof(bytes)) == LDNR_NATIVE_OK);
+    assert(memcmp(&info, &decoded, sizeof(info)) == 0);
+}
+
+static void test_config_round_trips(void)
+{
+    ldnr_user_config user = {0};
+    ldnr_security_config security = {0};
+    ldnr_security_parameter parameter = {0};
+    ldnr_network_config network = {0};
+    ldnr_scan_filter filter = {0};
+    ldnr_node_latest_update update = {0};
+
+    fill_bytes(user.user_name, sizeof(user.user_name), 71);
+    CHECK_ROUND_TRIP(user, user_config, LDNR_NATIVE_USER_CONFIG_SIZE);
+
+    security.security_mode = 0x1234;
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX;
+    fill_bytes(security.passphrase, sizeof(security.passphrase), 73);
+    CHECK_ROUND_TRIP(security, security_config, LDNR_NATIVE_SECURITY_CONFIG_SIZE);
+
+    fill_bytes(parameter.server_random, sizeof(parameter.server_random), 79);
+    fill_bytes(parameter.session_id, sizeof(parameter.session_id), 83);
+    CHECK_ROUND_TRIP(parameter, security_parameter, LDNR_NATIVE_SECURITY_PARAMETER_SIZE);
+
+    network.intent_id.local_communication_id = INT64_C(-9000000000);
+    network.intent_id.scene_id = 0xabcd;
+    network.channel = -161;
+    network.node_count_max = 8;
+    network.local_communication_version = -2;
+    CHECK_ROUND_TRIP(network, network_config, LDNR_NATIVE_NETWORK_CONFIG_SIZE);
+
+    filter.network_id.intent_id = network.intent_id;
+    fill_bytes(filter.network_id.session_id, sizeof(filter.network_id.session_id), 89);
+    filter.network_type = UINT32_C(0xf0e0d0c0);
+    fill_bytes(filter.bssid, sizeof(filter.bssid), 97);
+    filter.ssid.length = 8;
+    memcpy(filter.ssid.string, "ldn-test", 8);
+    filter.flags = UINT32_C(0x89abcdef);
+    CHECK_ROUND_TRIP(filter, scan_filter, LDNR_NATIVE_SCAN_FILTER_SIZE);
+
+    update.state_change = 0xa5;
+    CHECK_ROUND_TRIP(update, node_latest_update, LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE);
+}
+
+static void test_address_fixture(void)
+{
+    // nn::ldn keeps the address in host order: 10.114.0.1 is 0x0A720001.
+    static const uint8_t fixture[LDNR_NATIVE_ADDRESS_ENTRY_SIZE] = {
+        0x01, 0x00, 0x72, 0x0a,
+        0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
+        0x00, 0x00
+    };
+    ldnr_address_entry decoded = {0};
+    uint8_t encoded[LDNR_NATIVE_ADDRESS_ENTRY_SIZE];
+
+    assert(ldnr_native_address_entry_decode(&decoded, fixture, sizeof(fixture)) ==
+           LDNR_NATIVE_OK);
+    assert(decoded.ipv4_address == UINT32_C(0x0A720001));
+    assert(memcmp(decoded.mac_address, fixture + 4, sizeof(decoded.mac_address)) == 0);
+    assert(ldnr_native_address_entry_encode(&decoded, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_OK);
+    assert(memcmp(encoded, fixture, sizeof(fixture)) == 0);
+}
+
+static void test_malformed_lengths_and_arguments(void)
+{
+    ldnr_network_info info = {0};
+    ldnr_network_config network = {0};
+    ldnr_security_config security = {0};
+    ldnr_scan_filter filter = {0};
+    ldnr_address_entry address = {0};
+    uint8_t network_bytes[LDNR_NATIVE_NETWORK_INFO_SIZE] = {0};
+    uint8_t small[LDNR_NATIVE_SCAN_FILTER_SIZE] = {0};
+
+    assert(ldnr_native_network_info_decode(&info, network_bytes,
+                                           sizeof(network_bytes) - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_network_info_encode(&info, network_bytes,
+                                           sizeof(network_bytes) + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_network_config_decode(&network, small,
+                                             LDNR_NATIVE_NETWORK_CONFIG_SIZE - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_security_config_encode(&security, small,
+                                              LDNR_NATIVE_SECURITY_CONFIG_SIZE + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_scan_filter_decode(&filter, small, sizeof(small) - 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_address_entry_decode(&address, small,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE + 1) ==
+           LDNR_NATIVE_ERROR_LENGTH);
+    assert(ldnr_native_address_entry_decode(NULL, small,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE) ==
+           LDNR_NATIVE_ERROR_ARGUMENT);
+    assert(ldnr_native_address_entry_encode(&address, NULL,
+                                            LDNR_NATIVE_ADDRESS_ENTRY_SIZE) ==
+           LDNR_NATIVE_ERROR_ARGUMENT);
+}
+
+static void test_validation(void)
+{
+    ldnr_ssid ssid = {0};
+    ldnr_network_info info = {0};
+    ldnr_network_config network = {0};
+    ldnr_security_config security = {0};
+    ldnr_scan_filter filter = {0};
+    uint8_t ssid_bytes[LDNR_NATIVE_SSID_SIZE] = {0};
+    uint8_t info_bytes[LDNR_NATIVE_NETWORK_INFO_SIZE] = {0};
+    uint8_t network_bytes[LDNR_NATIVE_NETWORK_CONFIG_SIZE] = {0};
+    uint8_t security_bytes[LDNR_NATIVE_SECURITY_CONFIG_SIZE] = {0};
+    uint8_t filter_bytes[LDNR_NATIVE_SCAN_FILTER_SIZE] = {0};
+    uint8_t encoded[LDNR_NATIVE_NETWORK_INFO_SIZE];
+
+    ssid.length = LDNR_NATIVE_SSID_MAX + 1;
+    ssid_bytes[0] = ssid.length;
+    assert(ldnr_native_ssid_encode(&ssid, ssid_bytes, sizeof(ssid_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    assert(ldnr_native_ssid_decode(&ssid, ssid_bytes, sizeof(ssid_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    info.node_count = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info.node_count = 0;
+    info.node_count_max = -1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info.node_count_max = 0;
+    info.advertise_data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX + 1;
+    assert(ldnr_native_network_info_encode(&info, encoded, sizeof(encoded)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    info_bytes[0x26] = LDNR_NATIVE_SSID_MAX + 1;   // the SSID length
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info_bytes[0x26] = 0;
+    info_bytes[0x67] = LDNR_NATIVE_NODE_COUNT_MAX + 1;   // the node count
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    info_bytes[0x67] = 0;
+    info_bytes[0x26a] = 0x81;                       // the advertise data size
+    info_bytes[0x26b] = 0x01;
+    assert(ldnr_native_network_info_decode(&info, info_bytes, sizeof(info_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    network.node_count_max = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_config_encode(&network, network_bytes,
+                                             sizeof(network_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    network_bytes[0x12] = LDNR_NATIVE_NODE_COUNT_MAX + 1;
+    assert(ldnr_native_network_config_decode(&network, network_bytes,
+                                             sizeof(network_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    assert(ldnr_native_security_config_encode(&security, security_bytes,
+                                              sizeof(security_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    security_bytes[2] = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    assert(ldnr_native_security_config_decode(&security, security_bytes,
+                                              sizeof(security_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+
+    filter.ssid.length = LDNR_NATIVE_SSID_MAX + 1;
+    assert(ldnr_native_scan_filter_encode(&filter, filter_bytes, sizeof(filter_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+    filter_bytes[0x2a] = LDNR_NATIVE_SSID_MAX + 1;
+    assert(ldnr_native_scan_filter_decode(&filter, filter_bytes, sizeof(filter_bytes)) ==
+           LDNR_NATIVE_ERROR_INVALID);
+}
+
+int main(void)
+{
+    test_layouts();
+    test_identifier_and_node_round_trips();
+    test_network_info_round_trip();
+    test_config_round_trips();
+    test_address_fixture();
+    test_malformed_lengths_and_arguments();
+    test_validation();
+    return 0;
+}
