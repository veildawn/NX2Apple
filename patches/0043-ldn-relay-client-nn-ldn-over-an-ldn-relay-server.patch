+// The relay that does not answer the create leaves the client without a
+// membership: the room is gone, the sockets that belong to it are down and
+// their waiters are woken, and the guest sees the reason of the loss.
+static void test_membership_timeout_retires_the_membership(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info;
+    ldnr_sockaddr source;
+    ldnr *context = NULL;
+    int socket;
+
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    // A listener of the room: it must not wait for a connection that can no
+    // longer arrive.
+    socket = ldnr_socket(context, 2, 1, 6);
+    CHECK(socket >= 0);
+    CHECK(ldnr_listen(context, socket, 4) == 0);
+
+    // The relay never answers the create: the membership ends with the
+    // deadline of the request.
+    transport->silent_create = 1;
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+    // The membership is gone: the guest sees the open state and the reason.
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(ldnr_get_disconnect_reason(context) == 6);   // SignalLost
+    CHECK(ldnr_get_network_info(context, &info) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOTCONN);
+    // The sockets of the lost membership are down: their waiters are woken.
+    CHECK(ldnr_accept(context, socket, &source, 5000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    ldnr_destroy(context);
+    free((void *)api);
+}
