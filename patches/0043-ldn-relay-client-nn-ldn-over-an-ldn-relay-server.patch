+static void test_bad_frames_and_truncation(void)
+{
+    uint8_t bad[sizeof(scan_result_frame)];
+    uint8_t header[16] = {
+        'L', 'D', 'N', 'R', 0x01, 0x03, 0x00, 0x00,
+        0x08, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00
+    };
+    uint8_t *oversize;
+    size_t i;
+
+    decode_bad(NULL, 0);
+    decode_bad(ping_frame, 1);
+    decode_bad(ping_frame, 15);
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[0] = 'X';
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[4] = 2;
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[5] = 0x7f;
+    decode_bad(bad, sizeof(ping_frame));
+
+    decode_bad(ping_frame, sizeof(ping_frame) - 1);
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    put32(bad + 8, 7);
+    decode_bad(bad, sizeof(ping_frame));
+    decode_bad(bad, sizeof(ping_frame) - 1);
+    put32(bad + 8, 9);
+    decode_bad(bad, sizeof(ping_frame));
+
+    memcpy(bad, header, sizeof(header));
+    put32(bad + 8, 0);
+    decode_bad(bad, sizeof(bad) < sizeof(header) ? sizeof(bad) : sizeof(header));
+
+    /* The decoder accepts exactly one frame, not bytes outside its length. */
+    memcpy(bad, ping_frame, sizeof(ping_frame));
+    bad[sizeof(ping_frame)] = 0;
+    decode_bad(bad, sizeof(ping_frame) + 1);
+
+    oversize = malloc(16 + 65537);
+    CHECK(oversize != NULL);
+    memset(oversize, 0, 16 + 65537);
+    memcpy(oversize, header, sizeof(header));
+    put32(oversize + 8, 65537);
+    decode_bad(oversize, 16 + 65537);
+    free(oversize);
+
+    /* Adjust the outer length as well, so these exercise payload truncation,
+     * not only the frame-length consistency check. */
+    for (i = 0; i < sizeof(scan_result_frame); ++i) {
+        memcpy(bad, scan_result_frame, i);
+        if (i >= 16)
+            put32(bad + 8, (uint32_t)(i - 16));
+        decode_bad(bad, i);
+    }
+    for (i = 0; i < sizeof(connect_ack_frame); ++i) {
+        memcpy(bad, connect_ack_frame, i);
+        if (i >= 16)
+            put32(bad + 8, (uint32_t)(i - 16));
+        decode_bad(bad, i);
+    }
+}
