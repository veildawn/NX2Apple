+// A node that joins is an observable change: the guest event is signalled
+// even when the state itself did not move, and the change is recorded.
+static void test_network_update(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_changes changes;
+    ldnr_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info = test_network_info();
+    ldnr_network_info updated = test_network_info();
+    ldnr_node_latest_update update;
+    ldnr *context = NULL;
+    int expected_changes = 0;
+
+    memset(&changes, 0, sizeof(changes));
+    pthread_mutex_init(&changes.mutex, NULL);
+    pthread_cond_init(&changes.condition, NULL);
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.callback_ctx = &changes;
+    config.state_changed = test_state_changed;
+    config.connect_timeout_ms = 200;
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+    expected_changes = test_change_count(&changes);
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memcpy(user.user_name, "guest", 5);
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0) == 0);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+
+    // A second node joins the room: the state stays the same, but the guest
+    // has to learn about it.
+    updated.node_count = 2;
+    updated.nodes[1].ipv4_address = ldnr_ipv4(192, 168, 44, 11);
+    updated.nodes[1].node_id = 1;
+    updated.nodes[1].is_connected = 1;
+    test_push_network_update(transport, &updated);
+    test_wait_for_changes(&changes, expected_changes + 1);
+    expected_changes++;
+    CHECK(ldnr_get_network_info_latest_update(context, &update) == 0);
+    CHECK((update.state_change & 0x01) != 0);   // a node joined
+    // The change is read once: the state is cleared afterwards.
+    CHECK(ldnr_get_network_info_latest_update(context, &update) == 0);
+    CHECK(update.state_change == 0);
+
+    ldnr_destroy(context);
+    free((void *)api);
+    pthread_mutex_destroy(&changes.mutex);
+    pthread_cond_destroy(&changes.condition);
+}
