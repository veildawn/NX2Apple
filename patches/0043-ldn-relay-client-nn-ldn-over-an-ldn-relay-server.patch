+/* A frame that cannot be read is classified: the caller has to know whether
+ * the connection is broken or only one datagram was lost. */
+static void test_decode_status_classes(void)
+{
+    uint8_t frame[64];
+    ldnr_message message;
+    ldnr_decode_status status;
+
+    /* A frame of another major is not a frame of this protocol. */
+    memcpy(frame, ping_frame, sizeof(ping_frame));
+    frame[4] = 2;
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(frame, sizeof(ping_frame), &message, 1, 0,
+                                       &status) != 0);
+    CHECK(status.kind == LDNR_DECODE_VERSION);
+    CHECK(status.request_id == UINT64_C(0x11121314));
+
+    /* A payload above the limit the relay announced is not a frame. */
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(ping_frame, sizeof(ping_frame), &message, 1, 4,
+                                       &status) != 0);
+    CHECK(status.kind == LDNR_DECODE_LIMIT);
+
+    /* An unknown mandatory type is answered with an error that names it. */
+    memcpy(frame, ping_frame, sizeof(ping_frame));
+    frame[5] = 0x7e;
+    frame[6] = 0x00;
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(frame, sizeof(ping_frame), &message, 1, 0,
+                                       &status) != 0);
+    CHECK(status.kind == LDNR_DECODE_UNSUPPORTED);
+    CHECK(status.type == 0x7e);
+    CHECK(status.request_id == UINT64_C(0x11121314));
+
+    /* An unknown optional type is ignored by design. */
+    frame[6] = 0x01;
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(frame, sizeof(ping_frame), &message, 1, 0,
+                                       &status) == 0);
+    CHECK(message.type == LDNR_MSG_NONE);
+    ldnr_protocol_message_free(&message);
+
+    /* A relayed segment that lost its bytes breaks its stream, not the
+     * connection. The frame announces more payload than it carries. */
+    memset(frame, 0, sizeof(frame));
+    memcpy(frame, "LDNR", 4);
+    frame[4] = 1; frame[5] = 0x30;
+    put32(frame + 8, 22);
+    put32(frame + 12, UINT32_C(0x11223344));
+    put32(frame + LDNR_WIRE_HEADER, UINT32_C(0x0100720a));
+    put16(frame + LDNR_WIRE_HEADER + 4, 40000);
+    put32(frame + LDNR_WIRE_HEADER + 6, UINT32_C(0x0200720a));
+    put16(frame + LDNR_WIRE_HEADER + 10, 40001);
+    frame[LDNR_WIRE_HEADER + 12] = 6;    /* TCP */
+    put32(frame + LDNR_WIRE_HEADER + 13, UINT32_C(0x55667788));
+    put16(frame + LDNR_WIRE_HEADER + 17, 64);   /* more bytes than the frame holds */
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(frame, 38, &message, 1, 0, &status) != 0);
+    CHECK(status.kind == LDNR_DECODE_FORMAT);
+    CHECK(status.has_connection_id);
+    CHECK(status.connection_id == UINT64_C(0x55667788));
+
+    /* A datagram that does not fit is lost: the connection stays in order. */
+    frame[LDNR_WIRE_HEADER + 12] = 17;   /* UDP */
+    memset(&message, 0, sizeof(message));
+    CHECK(ldnr_protocol_decode_status(frame, 38, &message, 1, 0, &status) != 0);
+    CHECK(status.kind == LDNR_DECODE_DATAGRAM);
+    CHECK(!status.has_connection_id);
+}
+
+int main(void)
+{
+    _Static_assert(sizeof(hello_frame) == 41, "HELLO fixture size");
+    _Static_assert(sizeof(create_network_frame) == 148, "CREATE_NETWORK fixture size");
+    _Static_assert(sizeof(scan_result_frame) == 504, "SCAN_RESULT fixture size");
+    _Static_assert(sizeof(connect_ack_frame) == 502, "CONNECT_ACK fixture size");
+
+    test_auth_ping_and_pong();
+    test_create_network();
+    test_control_requests_and_empty_acks();
+    test_scan_result_and_message_free();
+    test_connect_ack();
+    test_udp_proxy_data();
+    test_tcp_proxy_messages();
+    test_record_trailing_extensions();
+    test_bad_frames_and_truncation();
+    test_invalid_lengths();
+    test_relay_message_ids();
+    test_address_and_port_conversions();
+    test_scan_filter_flag_mapping();
+    test_scan_carries_the_1_2_extension();
+    test_create_carries_the_accept_policy();
+    test_error_encoding();
+    test_decode_status_classes();
+
+    puts("PASS");
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_state.c b/dm/host/ldnr/tests/t_state.c
new file mode 100644
index 0000000..75c879a
--- /dev/null
+++ b/dm/host/ldnr/tests/t_state.c
@@ -0,0 +1,1652 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include "../ldnr.h"
+#include "../ldnr_protocol.h"
+#include "../ldnr_transport.h"
+// The private state of the core: the table of the opens that wait for their
+// answer is part of it.
+#include "../ldnr_internal.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define TEST_FRAME_CAPACITY 65536u
+#define TEST_QUEUE_DEPTH 32u
+
+#define CHECK(expression)                                                           \
+    do {                                                                            \
+        if (!(expression)) {                                                        \
+            fprintf(stderr, "CHECK failed at %s:%d: %s\n", __FILE__, __LINE__,    \
+                    #expression);                                                   \
+            abort();                                                                \
+        }                                                                           \
+    } while (0)
+
+enum {
+    TEST_STATE_NONE = 0,
+    TEST_STATE_INITIALIZED = 1,
+    TEST_STATE_AP_OPEN = 2,
+    TEST_STATE_STATION_OPEN = 3,
+    TEST_STATE_AP_CREATED = 4,
+    TEST_STATE_STATION_CONNECTED = 5,
+};
+
+enum {
+    TEST_EINVAL = 22,
+    TEST_ENOBUFS = 55,
+    TEST_EISCONN = 56,
+    TEST_ENOTCONN = 57,
+    TEST_ENETDOWN = 50,
+    TEST_ETIMEDOUT = 60,
+    TEST_ECONNREFUSED = 61,
+    // The classes of the relay are kept apart: the guest can tell a full
+    // room from a missing one, and a wrong password from a lost relay.
+    TEST_EBADFRAME = 101,
+    TEST_EROOMNOTFOUND = 104,
+    TEST_EROOMFULL = 105,
+    TEST_EBADPASSWORD = 106,
+    TEST_ETLSREQUIRED = 116,
+};
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_frame;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    test_frame queue[TEST_QUEUE_DEPTH];
+    size_t head;
+    size_t count;
+    int connected;
+    int connect_count;
+    int fail_connect;
+    int auth_error;
+    int sent_count;               // the frames the core sent to the relay
+    int proxy_refusal;            // 1: an error, 2: a refused reply
+    uint32_t create_status;
+    uint32_t connect_status;
+    uint32_t filter_status;       // the filter request fails
+    uint32_t policy_status;       // the policy request fails
+    uint32_t destroy_status;      // the removal of the room fails
+    uint16_t error_code;          // the code of the error replies
+    uint16_t filter_code;         // the code of a failed filter request
+    uint16_t destroy_code;        // the code of a failed removal request
+    int silent_create;            // the create request is never answered
+    int silent_proxy;             // the open of a stream is never answered
+    int close_count;              // the times the transport was closed
+    int filter_count;             // the filter requests the core sent
+    int policy_count;             // the policy requests the core sent
+    int destroy_count;            // the removal requests the core sent
+    uint8_t filters[16][6];       // the macs of the filter requests
+    uint16_t connect_version;     // the version of the last connect request
+} test_transport;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    int changes;
+} test_changes;
+
+static ldnr_network_info test_network_info(void)
+{
+    ldnr_network_info info;
+    memset(&info, 0, sizeof(info));
+    info.network_id.intent_id.local_communication_id = INT64_C(0x102030405);
+    info.network_id.intent_id.scene_id = 7;
+    info.network_id.session_id[0] = 0x42;
+    info.network_id.session_id[15] = 0x24;
+    info.common.ssid.length = 8;
+    memcpy(info.common.ssid.string, "ldnr-tst", 8);
+    info.common.channel = 11;
+    info.common.network_type = 1;
+    info.server_random[0] = 0xa5;
+    info.server_random[15] = 0x5a;
+    info.node_count_max = 8;
+    info.node_count = 1;
+    info.nodes[0].ipv4_address = ldnr_ipv4(192, 168, 44, 10);
+    info.nodes[0].is_connected = 1;
+    return info;
+}
+
+static void test_enqueue_locked(test_transport *transport, const uint8_t *bytes,
+                                size_t size)
+{
+    size_t index;
+    CHECK(size <= TEST_FRAME_CAPACITY);
+    CHECK(transport->count < TEST_QUEUE_DEPTH);
+    index = (transport->head + transport->count) % TEST_QUEUE_DEPTH;
+    memcpy(transport->queue[index].bytes, bytes, size);
+    transport->queue[index].size = size;
+    transport->count++;
+    pthread_cond_broadcast(&transport->condition);
+}
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_writer;
+
+static void test_put(test_writer *writer, const void *data, size_t size)
+{
+    CHECK(size <= sizeof(writer->bytes) - writer->size);
+    if (size)
+        memcpy(writer->bytes + writer->size, data, size);
+    writer->size += size;
+}
+
+static void test_u8(test_writer *writer, uint8_t value)
+{
+    test_put(writer, &value, 1);
+}
+
+static void test_u16(test_writer *writer, uint16_t value)
+{
+    uint8_t bytes[2] = {(uint8_t)value, (uint8_t)(value >> 8)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u32(test_writer *writer, uint32_t value)
+{
+    uint8_t bytes[4] = {(uint8_t)value, (uint8_t)(value >> 8),
+                        (uint8_t)(value >> 16), (uint8_t)(value >> 24)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u64(test_writer *writer, uint64_t value)
+{
+    test_u32(writer, (uint32_t)value);
+    test_u32(writer, (uint32_t)(value >> 32));
+}
+
+static size_t test_record_start(test_writer *writer)
+{
+    size_t start = writer->size;
+    test_u16(writer, 0);
+    return start;
+}
+
+static void test_record_end(test_writer *writer, size_t start)
+{
+    size_t size = writer->size - start - 2;
+    CHECK(size <= 0xffff);
+    writer->bytes[start] = (uint8_t)size;
+    writer->bytes[start + 1] = (uint8_t)(size >> 8);
+}
+
+static void test_put_network(test_writer *writer, const ldnr_network_info *info)
+{
+    size_t network = test_record_start(writer);
+    unsigned i;
+    test_u64(writer, UINT64_C(0x1122334455667788));
+    test_u64(writer, (uint64_t)info->network_id.intent_id.local_communication_id);
+    test_u16(writer, info->network_id.intent_id.scene_id);
+    test_put(writer, info->network_id.session_id, 16);
+    test_put(writer, info->server_random, 16);
+    test_put(writer, info->common.bssid, 6);
+    test_u8(writer, info->common.ssid.length);
+    test_put(writer, info->common.ssid.string, info->common.ssid.length);
+    test_u16(writer, (uint16_t)info->common.channel);
+    test_u8(writer, (uint8_t)info->common.link_level);
+    test_u8(writer, info->common.network_type);
+    test_u16(writer, info->security_mode);
+    test_u8(writer, info->station_accept_policy);
+    test_u8(writer, (uint8_t)info->node_count_max);
+    test_u8(writer, info->node_count);
+    for (i = 0; i < 8; i++) {
+        size_t node = test_record_start(writer);
+        test_u32(writer, info->nodes[i].ipv4_address);
+        test_put(writer, info->nodes[i].mac_address, 6);
+        test_u8(writer, (uint8_t)info->nodes[i].node_id);
+        test_u8(writer, info->nodes[i].is_connected);
+        test_put(writer, info->nodes[i].user_name, 33);
+        test_u16(writer, (uint16_t)info->nodes[i].local_communication_version);
+        test_u8(writer, info->nodes[i].platform);
+        test_record_end(writer, node);
+    }
+    test_u16(writer, info->advertise_data_size);
+    test_put(writer, info->advertise_data, info->advertise_data_size);
+    test_record_end(writer, network);
+}
+
+static void test_finish(test_writer *writer, uint8_t type, uint32_t request_id)
+{
+    size_t payload = writer->size - 16;
+    memset(writer->bytes, 0, 16);
+    memcpy(writer->bytes, "LDNR", 4);
+    writer->bytes[4] = 1;
+    writer->bytes[5] = type;
+    writer->bytes[8] = (uint8_t)payload;
+    writer->bytes[9] = (uint8_t)(payload >> 8);
+    writer->bytes[10] = (uint8_t)(payload >> 16);
+    writer->bytes[11] = (uint8_t)(payload >> 24);
+    writer->bytes[12] = (uint8_t)request_id;
+    writer->bytes[13] = (uint8_t)(request_id >> 8);
+    writer->bytes[14] = (uint8_t)(request_id >> 16);
+    writer->bytes[15] = (uint8_t)(request_id >> 24);
+}
+
+static void test_error_reply_locked(test_transport *transport, uint32_t request_id,
+                                    uint16_t code)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    // The test may choose the class of the failure: the default is the one
+    // of the request that failed.
+    test_u16(&writer, transport->error_code ? transport->error_code : code);
+    test_u16(&writer, 0);
+    test_finish(&writer, 0x05, request_id);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+}
+
+static void test_reply_locked(test_transport *transport, uint8_t type,
+                              uint32_t request_id)
+{
+    test_writer writer;
+    ldnr_network_info info;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+
+    switch (type) {
+    case 0x01:
+        if (transport->auth_error) {
+            // The relay refuses the credentials of the room.
+            test_error_reply_locked(transport, request_id, 6);
+            return;
+        }
+        // The relay selects the major and announces the minor it speaks:
+        // this client needs protocol 1.2.
+        test_u8(&writer, 1);
+        test_u8(&writer, 2);
+        test_u8(&writer, 0);
+        test_u8(&writer, 0);
+        test_u32(&writer, UINT32_C(0x1f));
+        test_u64(&writer, 0);
+        test_u64(&writer, 0);
+        test_u16(&writer, 0);
+        test_u32(&writer, 0);
+        test_u32(&writer, 0);
+        test_finish(&writer, 0x02, request_id);
+        break;
+    case 0x10:
+        if (transport->create_status) {
+            test_error_reply_locked(transport, request_id, 5);
+            return;
+        }
+        info = test_network_info();
+        test_put_network(&writer, &info);
+        test_finish(&writer, 0x11, request_id);
+        break;
+    case 0x15:
+        if (transport->connect_status) {
+            // There is no such room to connect to.
+            test_error_reply_locked(transport, request_id, 4);
+            return;
+        }
+        info = test_network_info();
+        test_u8(&writer, 0);
+        test_u32(&writer, ldnr_ipv4(192, 168, 44, 10));
+        static const uint8_t mac[6] = {0};
+        test_put(&writer, mac, sizeof(mac));
+        test_put_network(&writer, &info);
+        test_finish(&writer, 0x16, request_id);
+        break;
+    case 0x12:
+        if (transport->destroy_status) {
+            // The room is not removed: the relay still owns it.
+            test_error_reply_locked(transport, request_id,
+                                    transport->destroy_code ? transport->destroy_code : 5);
+            return;
+        }
+        test_finish(&writer, 0x12, request_id);
+        break;
+    case 0x19:
+        if (transport->policy_status) {
+            test_error_reply_locked(transport, request_id, 5);
+            return;
+        }
+        test_finish(&writer, 0x19, request_id);
+        break;
+    case 0x1b:
+        if (transport->filter_status) {
+            test_error_reply_locked(transport, request_id,
+                                    transport->filter_code ? transport->filter_code : 5);
+            return;
+        }
+        test_finish(&writer, 0x1b, request_id);
+        break;
+    case 0x17:
+        test_finish(&writer, 0x17, request_id);
+        break;
+    default:
+        test_error_reply_locked(transport, request_id, 1);
+        return;
+    }
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+}
+
+static int test_connect(void *ctx, const char *server, char *error, size_t error_size)
+{
+    test_transport *transport = ctx;
+    (void)server;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connect_count++;
+    if (transport->fail_connect) {
+        if (error_size)
+            snprintf(error, error_size, "intentional test connect failure");
+        pthread_mutex_unlock(&transport->mutex);
+        return -1;
+    }
+    transport->connected = 1;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+static ssize_t test_recv(void *ctx, void *frame, size_t capacity)
+{
+    test_transport *transport = ctx;
+    size_t size;
+
+    pthread_mutex_lock(&transport->mutex);
+    while (transport->connected && transport->count == 0)
+        pthread_cond_wait(&transport->condition, &transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    CHECK(transport->count != 0);
+    size = transport->queue[transport->head].size;
+    CHECK(size <= capacity);
+    memcpy(frame, transport->queue[transport->head].bytes, size);
+    transport->head = (transport->head + 1) % TEST_QUEUE_DEPTH;
+    transport->count--;
+    pthread_mutex_unlock(&transport->mutex);
+    return (ssize_t)size;
+}
+
+// The connect request carries the session, the room password, the passphrase,
+// the user name and then the local communication version.
+static uint16_t test_read_connect_version(const uint8_t *bytes, size_t size)
+{
+    const uint8_t *body = bytes + 16;
+    size_t body_size = size - 16;
+    uint16_t room, passphrase, offset;
+    CHECK(body_size >= 16 + 2 + 2 + 33 + 2);
+    room = (uint16_t)(body[16] | (uint16_t)body[17] << 8);
+    passphrase = (uint16_t)(body[18 + room] | (uint16_t)body[19 + room] << 8);
+    offset = (uint16_t)(20 + room + passphrase + 33);
+    CHECK(body_size >= (size_t)offset + 2);
+    return (uint16_t)(body[offset] | (uint16_t)body[offset + 1] << 8);
+}
+
+static int test_send(void *ctx, const void *frame, size_t size)
+{
+    test_transport *transport = ctx;
+    const uint8_t *bytes = frame;
+    uint32_t request_id;
+
+    pthread_mutex_lock(&transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return -1;
+    }
+    CHECK(size >= 16 && memcmp(bytes, "LDNR", 4) == 0 && bytes[4] == 1);
+    request_id = (uint32_t)bytes[12] | (uint32_t)bytes[13] << 8 |
+                 (uint32_t)bytes[14] << 16 | (uint32_t)bytes[15] << 24;
+    transport->sent_count++;
+    if (bytes[5] == 0x15) transport->connect_version = test_read_connect_version(bytes, size);
+    if (bytes[5] == 0x1b) {
+        // The filter request carries the mac of the station.
+        CHECK(size >= 22);
+        if (transport->filter_count <
+            (int)(sizeof transport->filters / sizeof transport->filters[0]))
+            memcpy(transport->filters[transport->filter_count], bytes + 16, 6);
+        transport->filter_count++;
+    }
+    if (bytes[5] == 0x19) transport->policy_count++;
+    if (bytes[5] == 0x12) transport->destroy_count++;
+    if (bytes[5] == 0x10 && transport->silent_create) {
+        // The relay does not answer the create: the client waits for its
+        // deadline and ends the membership with it.
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    if (bytes[5] == 0x31 && transport->silent_proxy) {
+        // The relay does not answer the open: the socket waits for its
+        // deadline and the open stays in the table of the core.
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    if (bytes[5] == 0x31 && transport->proxy_refusal == 2) {
+        // The relay refuses the open with a reply that names the connection
+        // of the initiator: the accepted flag is zero.
+        test_writer writer;
+        uint32_t connection_id;
+        CHECK(size >= 20);
+        connection_id = (uint32_t)bytes[16] | (uint32_t)bytes[17] << 8 |
+                        (uint32_t)bytes[18] << 16 | (uint32_t)bytes[19] << 24;
+        memset(&writer, 0, sizeof(writer));
+        writer.size = 16;
+        test_u32(&writer, connection_id);
+        test_u32(&writer, 0);
+        test_u8(&writer, 0);
+        test_finish(&writer, 0x32, UINT32_C(0xffffffff));
+        test_enqueue_locked(transport, writer.bytes, writer.size);
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    test_reply_locked(transport, bytes[5], request_id);
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+// The number of frames the core sent to the relay.
+static int test_sent_count(test_transport *transport)
+{
+    pthread_mutex_lock(&transport->mutex);
+    int count = transport->sent_count;
+    pthread_mutex_unlock(&transport->mutex);
+    return count;
+}
+
+// The requests of the room that the core sent.
+typedef struct {
+    int close_count, filter_count, policy_count, destroy_count;
+} test_counters;
+
+static test_counters test_get_counters(test_transport *transport)
+{
+    test_counters counters;
+    pthread_mutex_lock(&transport->mutex);
+    counters.close_count = transport->close_count;
+    counters.filter_count = transport->filter_count;
+    counters.policy_count = transport->policy_count;
+    counters.destroy_count = transport->destroy_count;
+    pthread_mutex_unlock(&transport->mutex);
+    return counters;
+}
+
+// The mac of a filter entry the core sent to the room.
+static int test_has_filter(test_transport *transport, const uint8_t mac[6])
+{
+    int found = 0;
+    pthread_mutex_lock(&transport->mutex);
+    for (int i = 0; i < transport->filter_count &&
+                    i < (int)(sizeof transport->filters / sizeof transport->filters[0]); i++) {
+        if (memcmp(transport->filters[i], mac, 6) == 0) { found = 1; break; }
+    }
+    pthread_mutex_unlock(&transport->mutex);
+    return found;
+}
+
+// The opens that wait for their answer.
+static int test_proxy_open_count(ldnr *l)
+{
+    int count = 0;
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) if (l->proxy_opens[i].used) count++;
+    pthread_mutex_unlock(&l->proxy_mutex);
+    return count;
+}
+
+// The connection id of the single open that waits for its answer. The test
+// drives an inbound PROXY_DISCONNECT with this id, the way the relay does.
+static uint32_t test_proxy_open_connection_id(ldnr *l)
+{
+    uint32_t connection_id = 0;
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++)
+        if (l->proxy_opens[i].used) { connection_id = (uint32_t)l->proxy_opens[i].connection_id; break; }
+    pthread_mutex_unlock(&l->proxy_mutex);
+    return connection_id;
+}
+
+static void test_close(void *ctx)
+{
+    test_transport *transport = ctx;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connected = 0;
+    transport->close_count++;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_transport_destroy(void *ctx)
+{
+    test_transport *transport = ctx;
+    pthread_mutex_destroy(&transport->mutex);
+    pthread_cond_destroy(&transport->condition);
+    free(transport);
+}
+
+static const ldnr_transport *test_transport_create(test_transport **out)
+{
+    test_transport *transport = calloc(1, sizeof(*transport));
+    ldnr_transport *api = calloc(1, sizeof(*api));
+    CHECK(transport != NULL && api != NULL);
+    pthread_mutex_init(&transport->mutex, NULL);
+    pthread_cond_init(&transport->condition, NULL);
+    api->ctx = transport;
+    api->connect = test_connect;
+    api->recv = test_recv;
+    api->send = test_send;
+    api->close = test_close;
+    api->destroy = test_transport_destroy;
+    *out = transport;
+    return api;
+}
+
+static void test_push_disconnect(test_transport *transport, uint32_t reason)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_u64(&writer, 0);
+    test_u64(&writer, 0);
+    test_u32(&writer, reason);
+    test_finish(&writer, 0x21, 0);
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+// The relay closes a proxied stream from its side: the server connect
+// timeout and a peer that left both arrive as an inbound PROXY_DISCONNECT.
+static void test_push_proxy_disconnect(test_transport *transport,
+                                       uint32_t connection_id, uint32_t flags, uint32_t reason)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_u32(&writer, connection_id);
+    test_u32(&writer, ldnr_ipv4(192, 168, 44, 20));
+    test_u8(&writer, (uint8_t)flags);
+    test_u8(&writer, (uint8_t)reason);
+    test_finish(&writer, 0x33, 0);
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+// The relay pushes the new state of the room when a node joins or leaves.
+static void test_push_network_update(test_transport *transport,
+                                     const ldnr_network_info *info)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_put_network(&writer, info);
+    test_finish(&writer, 0x20, 0);
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_state_changed(void *ctx)
+{
+    test_changes *changes = ctx;
+    pthread_mutex_lock(&changes->mutex);
+    changes->changes++;
+    pthread_cond_broadcast(&changes->condition);
+    pthread_mutex_unlock(&changes->mutex);
+}
+
+static int test_change_count(test_changes *changes)
+{
+    int count;
+    pthread_mutex_lock(&changes->mutex);
+    count = changes->changes;
+    pthread_mutex_unlock(&changes->mutex);
+    return count;
+}
+
+static void test_wait_for_changes(test_changes *changes, int expected)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&changes->mutex);
+    while (changes->changes < expected) {
+        int result = pthread_cond_timedwait(&changes->condition, &changes->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+        CHECK(result == 0);
+    }
+    CHECK(changes->changes == expected);
+    pthread_mutex_unlock(&changes->mutex);
+}
