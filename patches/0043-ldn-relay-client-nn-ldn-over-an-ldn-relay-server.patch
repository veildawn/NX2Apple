+    CHECK(ldnr_open_access_point(context) == -1);
+    CHECK(ldnr_disconnect(context) == 0);
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    CHECK(ldnr_disconnect(context) == -1);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
+
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0) == 0);
+    CHECK(test_change_count(&changes) == ++expected_changes);
+    test_push_disconnect(transport, 47);
+    test_wait_for_changes(&changes, expected_changes + 1);
+    expected_changes++;
+    CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+    CHECK(ldnr_get_disconnect_reason(context) == 47);
+    CHECK(ldnr_get_network_info(context, &actual_info) == -1);
