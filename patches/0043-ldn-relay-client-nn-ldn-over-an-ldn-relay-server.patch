+// The filter entries that the host staged belong to the configuration of the
+// room: a create that fails must not consume them, or the room that comes
+// later would admit a station the host wanted to refuse.
+static void test_staged_filters_survive_a_failed_create(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    static const uint8_t mac[6] = {0x02, 0x00, 0x00, 0x00, 0x00, 0x01};
+    ldnr *context = NULL;
+
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    // The host refuses a station before the room exists.
+    CHECK(ldnr_add_accept_filter_entry(context, mac) == 0);
+
+    // The relay refuses the room: the create fails.
+    transport->create_status = 1;
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EROOMFULL);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+
+    // The filters are still staged: the next room gets them.
+    transport->create_status = 0;
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+    CHECK(test_has_filter(transport, mac));
+    ldnr_destroy(context);
+    free((void *)api);
+}
+
+// A room that was created but whose configuration failed is removed again.
+// When the relay does not confirm the removal, the connection is retired
+// before the local membership is cleared: a room that the relay kept would
+// refuse the next create. The error of the operation is the one the caller
+// sees: the rollback is not that operation.
+static void test_failed_rollback_retires_the_transport(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info;
+    ldnr *context = NULL;
+    test_counters counters;
+
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    // The room holds a filter entry, so that its configuration is sent after
+    // the create.
+    static const uint8_t mac[6] = {0x02, 0x00, 0x00, 0x00, 0x00, 0x02};
+    CHECK(ldnr_add_accept_filter_entry(context, mac) == 0);
+    // The room is created, but the list of its filters is refused.
+    transport->filter_status = 1;
+    transport->filter_code = 5;       // the relay says that the room is full
+    // The relay does not remove the room either.
+    transport->destroy_status = 1;
+    transport->destroy_code = 1;       // a broken frame
+
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    // The error of the operation is kept: the failure of the rollback does
+    // not replace it.
+    CHECK(ldnr_last_errno() == TEST_EROOMFULL);
+    counters = test_get_counters(transport);
+    // The removal was tried...
+    CHECK(counters.destroy_count == 1);
+    // ...and the connection was retired: the relay still owns the room.
+    CHECK(counters.close_count >= 1);
+    // The membership is gone.
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(ldnr_get_network_info(context, &info) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOTCONN);
+    ldnr_destroy(context);
+    free((void *)api);
+}
+
+// The opens that wait for their answer are remembered, so that the answer of
+// the relay can reach the socket that waits for it. A socket that is closed
+// releases its entry, and an open that cannot be remembered fails at once
+// instead of going out with no way to answer it.
+static void test_proxy_opens_are_released(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_sockaddr destination;
+    ldnr_message message;
+    ldnr *context = NULL;
+    int socket, before, after;
+
+    // The relay never answers the opens: they wait for their deadline.
+    transport->silent_proxy = 1;
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+
+    // An open that waits for its answer is remembered.
+    socket = ldnr_socket(context, 2, 1, 6);
+    CHECK(socket >= 0);
+    memset(&destination, 0, sizeof(destination));
+    destination.address = ldnr_ipv4(192, 168, 44, 10);
+    destination.port = ldnr_htons(40002);
+    CHECK(ldnr_connect_socket(context, socket, &destination, 50) == -1);
+    CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+    CHECK(test_proxy_open_count(context) == 1);
+
+    // The socket is closed: the open is over and its entry is released.
+    CHECK(ldnr_close_socket(context, socket) == 0);
+    CHECK(test_proxy_open_count(context) == 0);
+
+    // The table of the opens is full: an open that cannot be remembered
+    // fails with an error of its own, and nothing goes out.
+    memset(&message, 0, sizeof(message));
+    message.type = LDNR_MSG_PROXY_CONNECT;
+    message.proxy.source_address = ldnr_ipv4(192, 168, 44, 10);
+    message.proxy.source_port = ldnr_htons(1234);
+    message.proxy.destination_address = ldnr_ipv4(192, 168, 44, 20);
+    message.proxy.destination_port = ldnr_htons(40002);
+    before = test_sent_count(transport);
+    for (int i = 0; i < LDNR_MAX_PROXY_OPENS; i++) {
+        message.proxy.connection_id = (uint64_t)(1000 + i);
+        CHECK(ldnr_client_send(context, LDNR_MSG_PROXY_CONNECT, 0, &message, NULL) == 0);
+    }
+    after = test_sent_count(transport);
+    CHECK(test_proxy_open_count(context) == LDNR_MAX_PROXY_OPENS);
+    CHECK(after == before + LDNR_MAX_PROXY_OPENS);
+    message.proxy.connection_id = 9999;
+    CHECK(ldnr_client_send(context, LDNR_MSG_PROXY_CONNECT, 0, &message, NULL) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOBUFS);
+    // The open that could not be remembered did not go out.
+    CHECK(test_sent_count(transport) == after);
+    ldnr_destroy(context);
+    free((void *)api);
+}
+
+// The state_changed callback runs with the core mutex held, so it must not
+// call back into the core (the real glue only signals an event binding). An
+// event consumer is therefore a separate thread: it wakes on the state change
+// and reads the network configuration. The state and the configuration must be
+// published together, under the core lock, so the consumer never sees the new
+// state with an invalid configuration.
+typedef struct {
+    ldnr *core;                 // the context the consumer reads from
+    int watch;                  // the state the consumer waits for
+    int config_ok;              // GetNetworkConfig succeeded once watch appeared
+    int channel;                // the channel the configuration reported
+    int ready;                  // the consumer thread has finished its read
+} test_config_consumer;
+
+static void *test_config_consumer_main(void *argument)
+{
+    test_config_consumer *consumer = argument;
+    ldnr_network_config config;
+    // Wait until the watched state is published, then read the configuration
+    // at once: it must already be valid, before the Create/Connect call that
+    // published the state has returned on the other thread.
+    while (ldnr_get_state(consumer->core) != consumer->watch)
+        sched_yield();
+    consumer->config_ok = ldnr_get_network_config(consumer->core, &config) == 0;
+    if (consumer->config_ok) consumer->channel = config.channel;
+    consumer->ready = 1;
+    return NULL;
+}
+
+static void test_event_consumer_reads_network_config(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_config_consumer consumer;
+    pthread_t consumer_thread;
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info = test_network_info();
+    ldnr *context = NULL;
+
+    memset(&consumer, 0, sizeof(consumer));
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.connect_timeout_ms = 200;
+
+    memset(&network, 0, sizeof(network));
+    network.intent_id.local_communication_id = INT64_C(0x102030405);
+    network.channel = 11;
+    network.node_count_max = 8;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    consumer.core = context;
+    CHECK(ldnr_initialize(context) == 0);
+
+    // The host creates a room on one thread; the consumer reacts on another.
+    // The consumer reads the configuration as soon as it sees the created
+    // state, which races CreateNetwork's return: the read must succeed.
+    CHECK(ldnr_open_access_point(context) == 0);
+    consumer.watch = TEST_STATE_AP_CREATED;
+    consumer.ready = 0;
+    CHECK(pthread_create(&consumer_thread, NULL, test_config_consumer_main, &consumer) == 0);
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+    CHECK(pthread_join(consumer_thread, NULL) == 0);
+    CHECK(consumer.ready == 1);
+    CHECK(consumer.config_ok == 1);
+    CHECK(consumer.channel == network.channel);
+
+    // The same race on a station connect: the consumer reads the configuration
+    // as soon as it sees the connected state, before ConnectNetwork returns.
+    CHECK(ldnr_destroy_network(context) == 0);
+    CHECK(ldnr_close_access_point(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+    consumer.watch = TEST_STATE_STATION_CONNECTED;
+    consumer.ready = 0;
+    consumer.config_ok = 0;
+    CHECK(pthread_create(&consumer_thread, NULL, test_config_consumer_main, &consumer) == 0);
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0) == 0);
+    CHECK(pthread_join(consumer_thread, NULL) == 0);
+    CHECK(consumer.ready == 1);
+    CHECK(consumer.config_ok == 1);
+    CHECK(consumer.channel == info.common.channel);
+
+    ldnr_destroy(context);
+    free((void *)api);
+}
+
+// Inbound PROXY_DISCONNECT releases the correlation entry of the stream it
+// closes. The server connect timeout arrives this way, and the socket that
+// waited for the answer has its connect_error set, so Close skips the reset
+// that would otherwise clear the entry. A hundred such resets must not fill
+// the table, and disconnect/rejoin cycles must not leak entries either.
+static void test_inbound_proxy_disconnect_releases_correlation(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_sockaddr destination;
+    ldnr *context = NULL;
+    int socket;
+
+    // The relay never answers the opens with a connect reply; it answers them
+    // later with an inbound PROXY_DISCONNECT, the way the connect timeout does.
+    transport->silent_proxy = 1;
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+
+    memset(&destination, 0, sizeof(destination));
+    destination.address = ldnr_ipv4(192, 168, 44, 10);
+    destination.port = ldnr_htons(40002);
+
+    // A hundred opens that the relay resets with a connect-timeout
+    // PROXY_DISCONNECT: each reset releases the entry the open held, so the
+    // table never fills and the opens keep succeeding.
+    for (int i = 0; i < 100; i++) {
+        socket = ldnr_socket(context, 2, 1, 6);
+        CHECK(socket >= 0);
+        // The open waits for its answer; the relay stays silent, so the
+        // socket times out with the entry still in the table.
+        CHECK(ldnr_connect_socket(context, socket, &destination, 20) == -1);
+        CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+        CHECK(test_proxy_open_count(context) == 1);
+        // The relay's connect timeout arrives as an inbound PROXY_DISCONNECT
+        // that names this stream: it releases the correlation entry.
+        test_push_proxy_disconnect(transport, test_proxy_open_connection_id(context), 1, 3);
+        // Give the receive thread a moment to deliver the reset.
+        struct timespec delay = {0, 20 * 1000 * 1000};
+        nanosleep(&delay, NULL);
+        CHECK(test_proxy_open_count(context) == 0);
+        CHECK(ldnr_close_socket(context, socket) == 0);
+    }
+    CHECK(test_proxy_open_count(context) == 0);
+
+    // A station disconnects and rejoins repeatedly: every teardown clears the
+    // correlation table, so no entry survives into the next membership.
+    CHECK(ldnr_destroy_network(context) == 0);
+    for (int cycle = 0; cycle < 5; cycle++) {
+        CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+        socket = ldnr_socket(context, 2, 1, 6);
+        CHECK(socket >= 0);
+        CHECK(ldnr_connect_socket(context, socket, &destination, 20) == -1);
+        CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+        CHECK(test_proxy_open_count(context) == 1);
+        // Leaving the room clears the membership and the correlation table;
+        // the socket is closed first, the way the application would.
+        CHECK(ldnr_close_socket(context, socket) == 0);
+        CHECK(ldnr_destroy_network(context) == 0);
+        CHECK(test_proxy_open_count(context) == 0);
+    }
+    CHECK(test_proxy_open_count(context) == 0);
+    ldnr_destroy(context);
+    free((void *)api);
+}
+
+// The connecting thread is parked inside the wait of its request: its wait
+// returns with the connected state already published, but the requester
+// cannot run any of its own post-reply work while it is held there.
+typedef struct {
+    ldnr *core;
+    int changes;                // the state changes the callback counted
+    int hold;                   // park the wait-exit that sees the connect
+    int held;                   // that wait is parked
+    int release;                // let the parked waiter through
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+} test_hold;
+
+static void test_hold_changed(void *ctx)
+{
+    test_hold *hold = ctx;
+    pthread_mutex_lock(&hold->mutex);
+    hold->changes++;
+    pthread_cond_broadcast(&hold->condition);
+    pthread_mutex_unlock(&hold->mutex);
+}
+
+// The native wait callback runs on the requester's own thread: the exit
+// call (entering=0) happens after the reply was dispatched — the published
+// state is already visible — and before the request returns, so the
+// requester's post-reply work cannot have run yet.
+static void test_hold_native_wait(void *ctx, int entering)
+{
+    test_hold *hold = ctx;
+    if (entering || !hold->hold) return;
+    if (!hold->core || hold->core->state != LDNR_STATE_STATION_CONNECTED) return;
+    pthread_mutex_lock(&hold->mutex);
+    hold->held = 1;
+    pthread_cond_broadcast(&hold->condition);
+    while (!hold->release)
+        pthread_cond_wait(&hold->condition, &hold->mutex);
+    hold->held = 0;
+    hold->release = 0;
+    hold->hold = 0;
+    pthread_mutex_unlock(&hold->mutex);
+}
+
+static void test_wait_for_held(test_hold *hold)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&hold->mutex);
+    while (!hold->held) {
+        int result = pthread_cond_timedwait(&hold->condition, &hold->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+    }
+    pthread_mutex_unlock(&hold->mutex);
+}
+
+typedef struct {
+    ldnr *context;
+    ldnr_network_info info;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    int version;
+    int result;
+} test_connector;
+
+static void *test_connector_thread(void *argument)
+{
+    test_connector *connector = argument;
+    connector->result = ldnr_connect_network(connector->context, &connector->info,
+        NULL, &connector->security, &connector->user, NULL, 0, connector->version);
+    return NULL;
+}
+
+// The connected state is published with the complete configuration: while
+// the connecting thread is still inside its request, an event consumer can
+// already read the version the request asked for.
+static void test_connect_publishes_the_requested_version(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_hold hold;
+    ldnr_config config;
+    test_connector connector;
+    pthread_t connector_thread;
+    ldnr_network_config actual_network;
+    ldnr *context = NULL;
+
+    memset(&hold, 0, sizeof(hold));
+    pthread_mutex_init(&hold.mutex, NULL);
+    pthread_cond_init(&hold.condition, NULL);
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.callback_ctx = &hold;
+    config.state_changed = test_hold_changed;
+    config.native_wait = test_hold_native_wait;
+    config.connect_timeout_ms = 2000;
+    CHECK(ldnr_create(&config, &context) == 0);
+    hold.core = context;
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+
+    hold.hold = 1;
+    memset(&connector, 0, sizeof(connector));
+    connector.context = context;
+    connector.info = test_network_info();
+    memset(&connector.security, 0, sizeof(connector.security));
+    memset(&connector.user, 0, sizeof(connector.user));
+    connector.version = 0x1234;
+    connector.result = -1;
+    CHECK(pthread_create(&connector_thread, NULL, test_connector_thread, &connector) == 0);
+
+    // The requester is held inside the wait of its connect request: the
+    // acknowledgement was dispatched and the connected state published,
+    // but the requester cannot run its post-reply work from there. The
+    // configuration an event consumer would read is the one that was
+    // published with the state — it must already be complete.
+    test_wait_for_held(&hold);
+    CHECK(context->state == LDNR_STATE_STATION_CONNECTED);
+    CHECK(context->has_network_config == 1);
+    CHECK(context->network_config.local_communication_version == 0x1234);
+    CHECK(context->network_config.channel == connector.info.common.channel);
+    CHECK(connector.result == -1);   // the connect has not returned yet
+
+    pthread_mutex_lock(&hold.mutex);
+    hold.release = 1;
+    pthread_cond_broadcast(&hold.condition);
+    pthread_mutex_unlock(&hold.mutex);
+    CHECK(pthread_join(connector_thread, NULL) == 0);
+    CHECK(connector.result == 0);
+    CHECK(ldnr_get_network_config(context, &actual_network) == 0);
+    CHECK(actual_network.local_communication_version == 0x1234);
+
+    ldnr_destroy(context);
+    free((void *)api);
+    pthread_mutex_destroy(&hold.mutex);
+    pthread_cond_destroy(&hold.condition);
+}
+
+// A membership that is lost without the guest asking for it releases the
+// opens that waited for their answer: closing the old descriptors and
+// rejoining never leaves the table full for the next room.
+static void test_kick_releases_pending_opens(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_changes changes;
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info = test_network_info();
+    ldnr_sockaddr destination;
+    ldnr *context = NULL;
+    int socket;
+    int expected_changes;
+
+    // The relay never answers the opens: each stays in the correlation
+    // table until something releases it.
+    transport->silent_proxy = 1;
+    memset(&changes, 0, sizeof(changes));
+    pthread_mutex_init(&changes.mutex, NULL);
+    pthread_cond_init(&changes.condition, NULL);
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.callback_ctx = &changes;
+    config.state_changed = test_state_changed;
+    config.server = "relay.test:11470";
+    config.connect_timeout_ms = 200;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+    expected_changes = test_change_count(&changes);
+
+    memset(&destination, 0, sizeof(destination));
+    destination.address = ldnr_ipv4(192, 168, 44, 10);
+    destination.port = ldnr_htons(40002);
+
+    // Three memberships in a row are kicked: each loses the opens that were
+    // still waiting, so the next room starts with an empty table.
+    for (int cycle = 0; cycle < 3; cycle++) {
+        CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0) == 0);
+        expected_changes++;
+        socket = ldnr_socket(context, 2, 1, 6);
+        CHECK(socket >= 0);
+        CHECK(ldnr_connect_socket(context, socket, &destination, 20) == -1);
+        CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+        CHECK(test_proxy_open_count(context) == 1);
+        // The relay kicks the station: the membership is lost without the
+        // guest asking, and the opens it held are released with it.
+        test_push_disconnect(transport, 4);
+        test_wait_for_changes(&changes, expected_changes + 1);
+        expected_changes++;
+        CHECK(ldnr_get_state(context) == TEST_STATE_STATION_OPEN);
+        CHECK(test_proxy_open_count(context) == 0);
+        // The old descriptor is closed after the loss: the entries it held
+        // are gone either way, so nothing blocks the opens of the next room.
+        CHECK(ldnr_close_socket(context, socket) == 0);
+        CHECK(test_proxy_open_count(context) == 0);
+    }
+
+    // A host that loses its own room the same way: the created membership
+    // is retired and the opens that waited are released too.
+    CHECK(ldnr_close_station(context) == 0);
+    expected_changes++;
+    CHECK(ldnr_open_access_point(context) == 0);
+    expected_changes++;
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == 0);
+    expected_changes++;
+    socket = ldnr_socket(context, 2, 1, 6);
+    CHECK(socket >= 0);
+    CHECK(ldnr_connect_socket(context, socket, &destination, 20) == -1);
+    CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+    CHECK(test_proxy_open_count(context) == 1);
+    test_push_disconnect(transport, 4);
+    test_wait_for_changes(&changes, expected_changes + 1);
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    CHECK(test_proxy_open_count(context) == 0);
+    CHECK(ldnr_close_socket(context, socket) == 0);
+    CHECK(test_proxy_open_count(context) == 0);
+
+    ldnr_destroy(context);
+    free((void *)api);
+    pthread_mutex_destroy(&changes.mutex);
+    pthread_cond_destroy(&changes.condition);
+}
+
+int main(void)
+{
+    test_create_arguments();
+    test_lifecycle_and_replies();
+    test_communication_version();
+    test_network_update();
+    test_room_password_is_refused_locally();
+    test_proxy_open_refusal_fails_the_socket(1);
+    test_proxy_open_refusal_fails_the_socket(2);
+    test_membership_timeout_retires_the_membership();
+    test_staged_filters_survive_a_failed_create();
+    test_failed_rollback_retires_the_transport();
+    test_proxy_opens_are_released();
+    test_event_consumer_reads_network_config();
+    test_inbound_proxy_disconnect_releases_correlation();
+    test_connect_publishes_the_requested_version();
+    test_kick_releases_pending_opens();
+    puts("PASS");
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_tcp.c b/dm/host/ldnr/tests/t_tcp.c
new file mode 100644
index 0000000..583b703
--- /dev/null
+++ b/dm/host/ldnr/tests/t_tcp.c
@@ -0,0 +1,442 @@
+// Regression tests for the TCP transport: a writer pinned to one connection
+// must not continue on the connection that replaced it, and a write that
+// fails part way must leave the framing stream unusable.
+#define _POSIX_C_SOURCE 200809L
+
+#include "../ldnr_transport.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#define CHECK(expression)                                                           \
+    do {                                                                            \
+        if (!(expression)) {                                                        \
+            fprintf(stderr, "CHECK failed at %s:%d: %s\n", __FILE__, __LINE__,    \
+                    #expression);                                                   \
+            abort();                                                                \
+        }                                                                           \
+    } while (0)
+
+// A pair of connected sockets, so the transport writes to a real descriptor.
+static void test_pair(int out[2])
+{
+    CHECK(socketpair(AF_UNIX, SOCK_STREAM, 0, out) == 0);
+}
+
+typedef struct {
+    const ldnr_transport *transport;
+    const uint8_t *frame;
+    size_t size;
+    int result;
+} test_writer;
+
+static void *test_write_thread(void *argument)
+{
+    test_writer *writer = argument;
+    writer->result = writer->transport->send(writer->transport->ctx, writer->frame,
+                                             writer->size);
+    return NULL;
+}
+
+// The first chunk of a large write fills the socket buffer and blocks. The
+// connection is replaced while the writer is blocked: the tail of the frame
+// must not appear on the new connection.
+static void test_writer_does_not_follow_a_replacement(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    int old_pair[2];
+    int new_pair[2];
+    pthread_t thread;
+    test_writer writer;
+    static uint8_t frame[8 * 1024 * 1024];
+    uint8_t received[4096];
+    int flags;
+
+    CHECK(transport != NULL);
+    test_pair(old_pair);
+    test_pair(new_pair);
+    ldnr_tcp_test_replace(transport, old_pair[0]);
+
+    // The peer stops reading, so the writer blocks once the buffer is full.
+    flags = 65536;
+    (void)setsockopt(old_pair[0], SOL_SOCKET, SO_SNDBUF, &flags, sizeof(flags));
+    (void)setsockopt(old_pair[1], SOL_SOCKET, SO_RCVBUF, &flags, sizeof(flags));
+    memset(frame, 0x5a, sizeof(frame));
+    writer.transport = transport;
+    writer.frame = frame;
+    writer.size = sizeof(frame);
+    writer.result = 0;
+    CHECK(pthread_create(&thread, NULL, test_write_thread, &writer) == 0);
+    // The writer has started: the replacement happens while the frame is in
+    // flight.
+    nanosleep(&(struct timespec){0, 200000000}, NULL);
+    ldnr_tcp_test_replace(transport, new_pair[0]);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(writer.result == -1);
+    // The new connection carries nothing: the tail stayed with the old one.
+    flags = 0;
+    CHECK(recv(new_pair[1], received, sizeof(received), MSG_DONTWAIT) == -1);
+    CHECK(errno == EAGAIN || errno == EWOULDBLOCK);
+    close(old_pair[1]);
+    close(new_pair[1]);
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+// A write that fails after some bytes were sent breaks the stream: the next
+// frame is refused instead of being appended to the unfinished one.
+static void test_partial_write_breaks_the_stream(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    int pair[2];
+    uint8_t frame[64];
+    uint8_t received[256];
+    ssize_t size;
+
+    CHECK(transport != NULL);
+    test_pair(pair);
+    ldnr_tcp_test_replace(transport, pair[0]);
+    memset(frame, 0xa5, sizeof(frame));
+    memcpy(frame, "LDNR", 4);
+    // The peer disappears in the middle of the frame.
+    close(pair[1]);
+    CHECK(transport->send(transport->ctx, frame, sizeof(frame)) == -1);
+    // The stream is broken: another frame is refused outright.
+    CHECK(transport->send(transport->ctx, frame, sizeof(frame)) == -1);
+    // A reader sees the failure too, not a frame built from the leftovers.
+    CHECK(transport->recv(transport->ctx, received, sizeof(received)) == -1);
+    (void)size;
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+// The limit announced by the relay is checked before the payload is read: a
+// frame above it ends the connection instead of being delivered.
+static void test_oversized_frame_ends_the_connection(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    int pair[2];
+    uint8_t header[16] = {'L', 'D', 'N', 'R', 1, 0x03};
+    uint8_t received[64];
+
+    CHECK(transport != NULL);
+    test_pair(pair);
+    ldnr_tcp_test_replace(transport, pair[0]);
+    transport->set_limit(transport->ctx, 1024);
+    header[8] = 0x01;
+    header[9] = 0x08;   // a payload of 2049 bytes, above the limit
+    CHECK(send(pair[1], header, sizeof(header), 0) == sizeof(header));
+    CHECK(transport->recv(transport->ctx, received, sizeof(received)) == -1);
+    // The connection is gone: a later frame is refused as well.
+    CHECK(transport->send(transport->ctx, header, sizeof(header)) == -1);
+    close(pair[1]);
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+// A writer that waits for the writer's lock keeps the connection it was
+// made for: the connection that replaces it in the meantime must not carry
+// the frame of the waiting writer.
+static void test_queued_writer_does_not_follow_a_replacement(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    int old_pair[2];
+    int new_pair[2];
+    pthread_t blocker, queued;
+    test_writer first, second;
+    static uint8_t frame[8 * 1024 * 1024];
+    uint8_t received[4096];
+    int flags;
+
+    CHECK(transport != NULL);
+    test_pair(old_pair);
+    test_pair(new_pair);
+    ldnr_tcp_test_replace(transport, old_pair[0]);
+
+    // The peer stops reading, so the first writer blocks once the buffer is
+    // full: it holds the lock of the writers.
+    flags = 65536;
+    (void)setsockopt(old_pair[0], SOL_SOCKET, SO_SNDBUF, &flags, sizeof(flags));
+    (void)setsockopt(old_pair[1], SOL_SOCKET, SO_RCVBUF, &flags, sizeof(flags));
+    memset(frame, 0x5a, sizeof(frame));
+    first.transport = transport; first.frame = frame; first.size = sizeof(frame);
+    first.result = 0;
+    CHECK(pthread_create(&blocker, NULL, test_write_thread, &first) == 0);
+    nanosleep(&(struct timespec){0, 200000000}, NULL);
+    // The second writer is made for the same connection and waits for the
+    // lock that the first one holds.
+    second.transport = transport; second.frame = (const uint8_t *)"SECOND";
+    second.size = 6; second.result = 0;
+    CHECK(pthread_create(&queued, NULL, test_write_thread, &second) == 0);
+    nanosleep(&(struct timespec){0, 200000000}, NULL);
+    // The connection is replaced while the second writer waits for the lock.
+    ldnr_tcp_test_replace(transport, new_pair[0]);
+    CHECK(pthread_join(blocker, NULL) == 0);
+    CHECK(pthread_join(queued, NULL) == 0);
+    CHECK(first.result == -1);
+    CHECK(second.result == -1);
+    // The new connection carries nothing: the frame of the waiting writer
+    // stayed with the connection it was made for.
+    flags = 0;
+    CHECK(recv(new_pair[1], received, sizeof(received), MSG_DONTWAIT) == -1);
+    CHECK(errno == EAGAIN || errno == EWOULDBLOCK);
+    close(old_pair[1]);
+    close(new_pair[1]);
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+// The connect of the transport ends at the deadline: a teardown does not
+// wait for the timeout of the operating system.
+static int test_cancelled(void *ctx)
+{
+    (void)ctx;
+    return 1;
+}
+
+static int64_t test_now_ms(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+// A local listener whose accept queue is full: further SYNs are dropped, so
+// a connect to it stays pending. Unroutable test addresses are not used for
+// this because VPN/TUN proxies on developer machines accept any address.
+static int test_full_listener(uint16_t *port, int fillers[8])
+{
+    struct sockaddr_in address;
+    socklen_t size = sizeof(address);
+    int listener = socket(AF_INET, SOCK_STREAM, 0);
+    CHECK(listener >= 0);
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    CHECK(bind(listener, (struct sockaddr *)&address, sizeof(address)) == 0);
+    CHECK(listen(listener, 0) == 0);
+    CHECK(getsockname(listener, (struct sockaddr *)&address, &size) == 0);
+    *port = ntohs(address.sin_port);
+    for (int i = 0; i < 8; i++) {
+        fillers[i] = socket(AF_INET, SOCK_STREAM, 0);
+        CHECK(fillers[i] >= 0);
+        CHECK(fcntl(fillers[i], F_SETFL, fcntl(fillers[i], F_GETFL) | O_NONBLOCK) == 0);
+        (void)connect(fillers[i], (struct sockaddr *)&address, sizeof(address));
+    }
+    nanosleep(&(struct timespec){0, 200000000}, NULL);
+    return listener;
+}
+
+// A listener that accepts a connection: the tests use it to check that a
+// socket is alive.
+static int test_listener(uint16_t *port)
+{
+    struct sockaddr_in address;
+    socklen_t size = sizeof(address);
+    int listener = socket(AF_INET, SOCK_STREAM, 0);
+    CHECK(listener >= 0);
+    memset(&address, 0, sizeof(address));
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    CHECK(bind(listener, (struct sockaddr *)&address, sizeof(address)) == 0);
+    CHECK(listen(listener, 4) == 0);
+    CHECK(getsockname(listener, (struct sockaddr *)&address, &size) == 0);
+    *port = ntohs(address.sin_port);
+    return listener;
+}
+
+static void test_connect_is_bounded_and_cancellable(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    const ldnr_transport_caps *caps;
+    char error[160] = {0};
+    int64_t start, elapsed;
+
+    CHECK(transport != NULL);
+    caps = ldnr_transport_caps_of(transport);
+    CHECK(caps != NULL);
+    CHECK(caps->connect_ex != NULL);
+    // The built-in transport is a plaintext stream: the core has to know it.
+    CHECK(caps->plaintext == 1);
+
+    uint16_t port;
+    int fillers[8];
+    int listener = test_full_listener(&port, fillers);
+    char pending[32];
+    snprintf(pending, sizeof(pending), "127.0.0.1:%u", port);
+
+    // A connect that is cancelled before it starts fails at once.
+    start = test_now_ms();
+    CHECK(caps->connect_ex(transport->ctx, pending, error, sizeof(error),
+                            5000, test_cancelled, NULL) == -1);
+    elapsed = test_now_ms() - start;
+    CHECK(elapsed < 2000);
+
+    // A connect that nothing answers ends at the deadline. Some hosts
+    // complete it anyway (macOS does not drop SYNs for a full accept queue;
+    // a TUN-mode VPN/proxy answers any address): the case is skipped there
+    // rather than reported as a failure, it is covered where SYNs are dropped.
+    const char *targets[] = {pending, "192.0.2.1:11470"};
+    int bounded = 0;
+    for (size_t i = 0; i < sizeof(targets) / sizeof(targets[0]) && !bounded; i++) {
+        error[0] = 0;
+        start = test_now_ms();
+        int result = caps->connect_ex(transport->ctx, targets[i], error, sizeof(error),
+                                      300, NULL, NULL);
+        elapsed = test_now_ms() - start;
+        CHECK(elapsed < 3000);
+        if (result == -1) { CHECK(error[0] != 0); bounded = 1; }
+        else transport->close(transport->ctx);
+    }
+    if (!bounded) puts("SKIP: connect deadline (this host completes unanswered connects)");
+
+    // A relay that is not there fails at once.
+    error[0] = 0;
+    CHECK(caps->connect_ex(transport->ctx, "127.0.0.1:1", error, sizeof(error),
+                            1000, NULL, NULL) == -1);
+    CHECK(error[0] != 0);
+
+    for (int i = 0; i < 8; i++) close(fillers[i]);
+    close(listener);
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+// A connect that is in progress, with a cancellation the test controls.
+typedef struct {
+    const ldnr_transport *transport;
+    const char *target;
+    char error[160];
+    int result;
+    _Atomic int cancel;
+    _Atomic int finished;
+} test_connect;
+
+static int test_connect_cancel(void *ctx)
+{
+    test_connect *job = ctx;
+    return atomic_load(&job->cancel);
+}
+
+static void *test_connect_thread(void *argument)
+{
+    test_connect *job = argument;
+    const ldnr_transport_caps *caps = ldnr_transport_caps_of(job->transport);
+    job->result = caps->connect_ex(job->transport->ctx, job->target, job->error,
+                                    sizeof job->error, 30000, test_connect_cancel, job);
+    atomic_store(&job->finished, 1);
+    return NULL;
+}
+
+// A close during a connect does not reach a descriptor of somebody else: the
+// descriptor of the connect belongs to the transport while it is published,
+// and only its owner closes it. The round is repeated, because the hazard is
+// a race: the descriptor of the kernel may be handed out again right after
+// the close.
+static void test_close_during_a_connect_keeps_the_descriptor(void)
+{
+    const ldnr_transport *transport = ldnr_tcp_transport_create();
+    uint16_t port;
+    int fillers[8];
+    int listener;
+    char target[32];
+
+    CHECK(transport != NULL);
+    listener = test_full_listener(&port, fillers);
+    snprintf(target, sizeof(target), "127.0.0.1:%u", port);
+
+    for (int round = 0; round < 8; round++) {
+        pthread_t thread;
+        test_connect job;
+        int fd = -1;
+
+        memset(&job, 0, sizeof job);
+        job.transport = transport;
+        job.target = target;
+        CHECK(pthread_create(&thread, NULL, test_connect_thread, &job) == 0);
+
+        // The descriptor of the connect is published: the transport owns it.
+        for (int i = 0; i < 400 && fd < 0; i++) {
+            fd = ldnr_tcp_test_connecting_fd(transport);
+            if (fd < 0) nanosleep(&(struct timespec){0, 5000000}, NULL);
+        }
+        if (fd < 0) {
+            // The host answered the connect even though the queue was full:
+            // the case does not exist here.
+            CHECK(atomic_load(&job.finished));
+            CHECK(pthread_join(thread, NULL) == 0);
+            transport->destroy(transport->ctx);
+            free((void *)transport);
+            for (int i = 0; i < 8; i++) close(fillers[i]);
+            close(listener);
+            puts("SKIP: close during a connect (this host answers the connect)");
+            return;
+        }
+        // The published descriptor is a live one.
+        CHECK(fcntl(fd, F_GETFD) != -1);
+
+        // The close takes the pending connect away and only shuts its
+        // descriptor down: the worker that owns the connect closes it.
+        transport->close(transport->ctx);
+        CHECK(ldnr_tcp_test_connecting_fd(transport) == -1);
+
+        // The connect ends at once.
+        atomic_store(&job.cancel, 1);
+        CHECK(pthread_join(thread, NULL) == 0);
+        CHECK(job.result == -1);
+        CHECK(job.error[0] != 0);
+
+        // The descriptor is closed exactly once, by its owner: it is not
+        // left behind and it is not closed twice.
+        CHECK(fcntl(fd, F_GETFD) == -1);
+        CHECK(errno == EBADF);
+
+        // A descriptor that the kernel hands out now belongs to somebody
+        // else: the transport must not have shut it down.
+        int fresh = socket(AF_INET, SOCK_STREAM, 0);
+        CHECK(fresh >= 0);
+        if (fresh == fd) {
+            uint16_t other_port;
+            int other = test_listener(&other_port);
+            struct sockaddr_in address;
+            memset(&address, 0, sizeof(address));
+            address.sin_family = AF_INET;
+            address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+            address.sin_port = htons(other_port);
+            CHECK(connect(fresh, (struct sockaddr *)&address, sizeof(address)) == 0);
+            int flags = 0;
+#ifdef MSG_NOSIGNAL
+            flags |= MSG_NOSIGNAL;
+#endif
+            CHECK(send(fresh, "x", 1, flags) == 1);
+            close(other);
+        }
+        close(fresh);
+    }
+    for (int i = 0; i < 8; i++) close(fillers[i]);
+    close(listener);
+    transport->destroy(transport->ctx);
+    free((void *)transport);
+}
+
+int main(void)
+{
+    test_writer_does_not_follow_a_replacement();
+    test_queued_writer_does_not_follow_a_replacement();
+    test_partial_write_breaks_the_stream();
+    test_oversized_frame_ends_the_connection();
+    test_connect_is_bounded_and_cancellable();
+    test_close_during_a_connect_keeps_the_descriptor();
+    puts("PASS");
+    return 0;
+}
diff --git a/dm/host/ldnr/tests/t_vnet.c b/dm/host/ldnr/tests/t_vnet.c
new file mode 100644
index 0000000..508c423
--- /dev/null
+++ b/dm/host/ldnr/tests/t_vnet.c
@@ -0,0 +1,3328 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include "../ldnr.h"
+#include "../ldnr_protocol.h"
+#include "../ldnr_transport.h"
+#include "../ldnr_vnet.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define TEST_FRAME_CAPACITY 65536u
+#define TEST_QUEUE_DEPTH 64u
+#define TEST_MAX_SOCKETS 64
+#define TEST_UDP_PORT 4000
+#define TEST_OTHER_UDP_PORT 4001
+#define TEST_TCP_PORT 7000
+#define TEST_LISTEN_PORT 7001
+
+#define CHECK(expression)                                                           \
+    do {                                                                            \
+        if (!(expression)) {                                                        \
+            fprintf(stderr, "CHECK failed at %s:%d: %s\n", __FILE__, __LINE__,    \
+                    #expression);                                                   \
+            abort();                                                                \
+        }                                                                           \
+    } while (0)
+
+enum {
+    TEST_EBADF = 9,
+    TEST_EINVAL = 22,
+    TEST_EPIPE = 32,
+    TEST_EAGAIN = 35,
+    TEST_EINPROGRESS = 36,
+    TEST_EADDRINUSE = 48,
+    TEST_EADDRNOTAVAIL = 49,
+    TEST_ENETDOWN = 50,
+    TEST_ENOBUFS = 55,
+    TEST_ENOTCONN = 57,
+    TEST_ECONNRESET = 54,
+    TEST_ETIMEDOUT = 60,
+    TEST_ECONNREFUSED = 61,
+    TEST_ECANCELED = 125,
+};
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_frame;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    test_frame queue[TEST_QUEUE_DEPTH];
+    size_t head;
+    size_t count;
+    int connected;
+    uint32_t proxy_ack_status;
+    int auto_proxy_ack;
+    uint8_t node_id;            // the node id the relay assigned to us
+    uint32_t max_frame;         // the frame limit the handshake announces
+    unsigned sent_count[LDNR_MSG_ERROR + 1];
+    unsigned sent_seq;          // the wire position of the frames
+    unsigned seq_of[LDNR_MSG_ERROR + 1]; // the wire position of each kind
+    ldnr_message last;
+    uint64_t last_open_id;      // the connection id of the last PROXY_CONNECT
+    size_t data_sizes[16];      // the payload sizes of the last PROXY_DATA
+    int data_size_count;
+    int block_data;             // a PROXY_DATA send waits here
+    int data_blocked;           // a send is waiting for the test
+    int block_reply;            // a PROXY_CONNECT_ACK send waits here
+    int reply_blocked;          // that send is waiting for the test
+    int delay_data;             // park the Nth PROXY_DATA before it is recorded
+    int data_delayed;           // that send is parked
+    int release_data;           // let the parked send through
+    int delay_open;             // park the Nth PROXY_CONNECT before it is recorded
+    int open_delayed;           // that send is parked
+    int release_open;           // let the parked send through
+    int delay_udp;              // park the Nth UDP datagram before it is recorded
+    int udp_delayed;            // that datagram is parked
+    int release_udp;            // let the parked datagram through
+    int delay_disconnect;       // park the Nth PROXY_DISCONNECT before it is recorded
+    int disconnect_delayed;     // that close is parked
+    int release_disconnect;     // let the parked close through
+} test_transport;
+
+typedef struct {
+    atomic_int entered;
+    atomic_int exited;
+} test_waits;
+
+static int64_t test_now_ms(void)
+{
+    struct timespec now;
+    CHECK(clock_gettime(CLOCK_MONOTONIC, &now) == 0);
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+// A pause that lets a blocked thread reach the point the test checks.
+static void test_sleep_ms(int ms)
+{
+    struct timespec duration;
+    duration.tv_sec = ms / 1000;
+    duration.tv_nsec = (long)(ms % 1000) * 1000000;
+    nanosleep(&duration, NULL);
+}
+
+static ldnr_network_info test_network_info(void)
+{
+    ldnr_network_info info;
+    memset(&info, 0, sizeof(info));
+    info.network_id.intent_id.local_communication_id = INT64_C(0x506070809);
+    info.network_id.intent_id.scene_id = 3;
+    info.network_id.session_id[0] = 0x91;
+    info.network_id.session_id[15] = 0x19;
+    info.common.ssid.length = 7;
+    memcpy(info.common.ssid.string, "vnet-ts", 7);
+    info.common.channel = 6;
+    info.common.network_type = 1;
+    info.server_random[0] = 0x37;
+    info.node_count_max = 8;
+    info.node_count = 1;
+    info.nodes[0].ipv4_address = ldnr_ipv4(192, 168, 44, 10);
+    info.nodes[0].is_connected = 1;
+    return info;
+}
+
+static void test_native_wait(void *ctx, int entering)
+{
+    test_waits *waits = ctx;
+    if (entering)
+        atomic_fetch_add(&waits->entered, 1);
+    else
+        atomic_fetch_add(&waits->exited, 1);
+}
+
+static void test_enqueue_locked(test_transport *transport, const uint8_t *bytes,
+                                size_t size)
+{
+    size_t index;
+    CHECK(size <= TEST_FRAME_CAPACITY);
+    CHECK(transport->count < TEST_QUEUE_DEPTH);
+    index = (transport->head + transport->count) % TEST_QUEUE_DEPTH;
+    memcpy(transport->queue[index].bytes, bytes, size);
+    transport->queue[index].size = size;
+    transport->count++;
+    pthread_cond_broadcast(&transport->condition);
+}
+
+typedef struct {
+    uint8_t bytes[TEST_FRAME_CAPACITY];
+    size_t size;
+} test_writer;
+
+static void test_put(test_writer *writer, const void *data, size_t size)
+{
+    CHECK(size <= sizeof(writer->bytes) - writer->size);
+    if (size)
+        memcpy(writer->bytes + writer->size, data, size);
+    writer->size += size;
+}
+
+static void test_u8(test_writer *writer, uint8_t value)
+{
+    test_put(writer, &value, 1);
+}
+
+static void test_u16(test_writer *writer, uint16_t value)
+{
+    uint8_t bytes[2] = {(uint8_t)value, (uint8_t)(value >> 8)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u32(test_writer *writer, uint32_t value)
+{
+    uint8_t bytes[4] = {(uint8_t)value, (uint8_t)(value >> 8),
+                        (uint8_t)(value >> 16), (uint8_t)(value >> 24)};
+    test_put(writer, bytes, sizeof(bytes));
+}
+
+static void test_u64(test_writer *writer, uint64_t value)
+{
+    test_u32(writer, (uint32_t)value);
+    test_u32(writer, (uint32_t)(value >> 32));
+}
+
+static size_t test_record_start(test_writer *writer)
+{
+    size_t start = writer->size;
+    test_u16(writer, 0);
+    return start;
+}
+
+static void test_record_end(test_writer *writer, size_t start)
+{
+    size_t size = writer->size - start - 2;
+    CHECK(size <= 0xffff);
+    writer->bytes[start] = (uint8_t)size;
+    writer->bytes[start + 1] = (uint8_t)(size >> 8);
+}
+
+static void test_put_network(test_writer *writer, const ldnr_network_info *info)
+{
+    size_t network = test_record_start(writer);
+    unsigned i;
+    test_u64(writer, UINT64_C(0x2233445566778899));
+    test_u64(writer, (uint64_t)info->network_id.intent_id.local_communication_id);
+    test_u16(writer, info->network_id.intent_id.scene_id);
+    test_put(writer, info->network_id.session_id, 16);
+    test_put(writer, info->server_random, 16);
+    test_put(writer, info->common.bssid, 6);
+    test_u8(writer, info->common.ssid.length);
+    test_put(writer, info->common.ssid.string, info->common.ssid.length);
+    test_u16(writer, (uint16_t)info->common.channel);
+    test_u8(writer, (uint8_t)info->common.link_level);
+    test_u8(writer, info->common.network_type);
+    test_u16(writer, info->security_mode);
+    test_u8(writer, info->station_accept_policy);
+    test_u8(writer, (uint8_t)info->node_count_max);
+    test_u8(writer, info->node_count);
+    for (i = 0; i < 8; i++) {
+        size_t node = test_record_start(writer);
+        test_u32(writer, info->nodes[i].ipv4_address);
+        test_put(writer, info->nodes[i].mac_address, 6);
+        test_u8(writer, (uint8_t)info->nodes[i].node_id);
+        test_u8(writer, info->nodes[i].is_connected);
+        test_put(writer, info->nodes[i].user_name, 33);
+        test_u16(writer, (uint16_t)info->nodes[i].local_communication_version);
+        test_u8(writer, info->nodes[i].platform);
+        test_record_end(writer, node);
+    }
+    test_u16(writer, info->advertise_data_size);
+    test_put(writer, info->advertise_data, info->advertise_data_size);
+    test_record_end(writer, network);
+}
+
+static void test_finish(test_writer *writer, uint8_t type, uint32_t request_id)
+{
+    size_t payload = writer->size - 16;
+    memset(writer->bytes, 0, 16);
+    memcpy(writer->bytes, "LDNR", 4);
+    writer->bytes[4] = 1;
+    writer->bytes[5] = type;
+    writer->bytes[8] = (uint8_t)payload;
+    writer->bytes[9] = (uint8_t)(payload >> 8);
+    writer->bytes[10] = (uint8_t)(payload >> 16);
+    writer->bytes[11] = (uint8_t)(payload >> 24);
+    writer->bytes[12] = (uint8_t)request_id;
+    writer->bytes[13] = (uint8_t)(request_id >> 8);
+    writer->bytes[14] = (uint8_t)(request_id >> 16);
+    writer->bytes[15] = (uint8_t)(request_id >> 24);
+}
+
+static void test_reply_locked(test_transport *transport, const ldnr_message *request)
+{
+    test_writer writer;
+    ldnr_network_info info;
+    int send_reply = 1;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+
+    switch (request->type) {
+    case LDNR_MSG_AUTH_OK:
+        // The relay selects the major and announces the minor it speaks:
+        // this client needs protocol 1.2.
+        test_u8(&writer, 1);
+        test_u8(&writer, 2);
+        test_u8(&writer, 0);
+        test_u8(&writer, 0);
+        test_u32(&writer, UINT32_C(0x1f));
+        test_u64(&writer, 0);
+        test_u64(&writer, 0);
+        test_u16(&writer, 0);
+        test_u32(&writer, transport->max_frame);
+        test_u32(&writer, 0);
+        test_finish(&writer, 0x02, (uint32_t)request->request_id);
+        break;
+    case LDNR_MSG_CONNECT_ACK:
+        info = test_network_info();
+        test_u8(&writer, transport->node_id);
+        test_u32(&writer, ldnr_ipv4(192, 168, 44, 10));
+        {
+            static const uint8_t mac[6] = {0};
+            test_put(&writer, mac, sizeof(mac));
+        }
+        test_put_network(&writer, &info);
+        test_finish(&writer, 0x16, (uint32_t)request->request_id);
+        break;
+    case LDNR_MSG_DISCONNECTED:
+        test_finish(&writer, 0x17, (uint32_t)request->request_id);
+        break;
+    case LDNR_MSG_PROXY_CONNECT:
+        send_reply = transport->auto_proxy_ack;
+        test_u32(&writer, (uint32_t)request->proxy.connection_id);
+        test_u32(&writer, request->proxy.destination_address);
+        test_u8(&writer, transport->proxy_ack_status == 0);
+        test_finish(&writer, 0x32, 0);
+        break;
+    default:
+        send_reply = 0;
+        break;
+    }
+    if (send_reply)
+        test_enqueue_locked(transport, writer.bytes, writer.size);
+}
+
+static int test_connect(void *ctx, const char *server, char *error, size_t error_size)
+{
+    test_transport *transport = ctx;
+    (void)server;
+    (void)error;
+    (void)error_size;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connected = 1;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+static ssize_t test_recv(void *ctx, void *frame, size_t capacity)
+{
+    test_transport *transport = ctx;
+    size_t size;
+
+    pthread_mutex_lock(&transport->mutex);
+    while (transport->connected && transport->count == 0)
+        pthread_cond_wait(&transport->condition, &transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return 0;
+    }
+    CHECK(transport->count != 0);
+    size = transport->queue[transport->head].size;
+    CHECK(size <= capacity);
+    memcpy(frame, transport->queue[transport->head].bytes, size);
+    transport->head = (transport->head + 1) % TEST_QUEUE_DEPTH;
+    transport->count--;
+    // A waiter that pushes frames must learn that the queue has room.
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+    return (ssize_t)size;
+}
+
+static uint16_t test_read_u16(const uint8_t *bytes)
+{
+    return (uint16_t)((uint16_t)bytes[0] | (uint16_t)bytes[1] << 8);
+}
+
+static uint32_t test_read_u32(const uint8_t *bytes)
+{
+    return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+// The payload of a proxied segment has its own allocation: a relayed
+// segment may be larger than the chunk the client sends.
+static void test_set_payload(ldnr_message *message, const void *data, size_t size)
+{
+    message->proxy.data = malloc(size ? size : 1);
+    CHECK(message->proxy.data != NULL);
+    if (size) memcpy(message->proxy.data, data, size);
+    message->proxy.size = size;
+}
+
+static void test_parse_request(const uint8_t *bytes, size_t size,
+                               ldnr_message *request)
+{
+    const uint8_t *body;
+    size_t body_size;
+    uint16_t length;
+    CHECK(size >= 16 && memcmp(bytes, "LDNR", 4) == 0 && bytes[4] == 1);
+    body = bytes + 16;
+    body_size = size - 16;
+    CHECK(test_read_u32(bytes + 8) == body_size);
+    memset(request, 0, sizeof(*request));
+    request->request_id = test_read_u32(bytes + 12);
+
+    switch (bytes[5]) {
+    case 0x01:
+        request->type = LDNR_MSG_AUTH_OK;
+        break;
+    case 0x15:
+        request->type = LDNR_MSG_CONNECT_ACK;
+        break;
+    case 0x17:
+        request->type = LDNR_MSG_DISCONNECTED;
+        break;
+    case 0x30:
+        CHECK(body_size >= 19);
+        request->proxy.source_address = test_read_u32(body);
+        request->proxy.source_port = ldnr_port_from_host(test_read_u16(body + 4));
+        request->proxy.destination_address = test_read_u32(body + 6);
+        request->proxy.destination_port = ldnr_port_from_host(test_read_u16(body + 10));
+        request->proxy.connection_id = test_read_u32(body + 13);
+        length = test_read_u16(body + 17);
+        CHECK(body_size >= 19 && length == body_size - 19);
+        if (body[12] == 17) {
+            request->type = LDNR_MSG_UDP;
+            CHECK(length <= LDNR_UDP_MTU);
+            request->udp.source_address = request->proxy.source_address;
+            request->udp.source_port = request->proxy.source_port;
+            request->udp.destination_address = request->proxy.destination_address;
+            request->udp.destination_port = request->proxy.destination_port;
+            request->udp.size = length;
+            memcpy(request->udp.data, body + 19, length);
+        } else {
+            CHECK(body[12] == 6 && length <= LDNR_TCP_CHUNK);
+            request->type = LDNR_MSG_PROXY_DATA;
+            test_set_payload(request, body + 19, length);
+        }
+        break;
+    case 0x31:
+        CHECK(body_size == 16);
+        request->type = LDNR_MSG_PROXY_CONNECT;
+        request->proxy.connection_id = test_read_u32(body);
+        request->proxy.source_address = test_read_u32(body + 4);
+        request->proxy.source_port = ldnr_port_from_host(test_read_u16(body + 8));
+        request->proxy.destination_address = test_read_u32(body + 10);
+        request->proxy.destination_port = ldnr_port_from_host(test_read_u16(body + 14));
+        break;
+    case 0x32:
+        CHECK(body_size == 9);
+        request->type = LDNR_MSG_PROXY_CONNECT_ACK;
+        request->proxy.connection_id = test_read_u32(body);
+        request->proxy.source_address = test_read_u32(body + 4);
+        request->status = body[8] ? 0 : TEST_ECONNREFUSED;
+        break;
+    case 0x33:
+        CHECK(body_size == 10);
+        request->type = LDNR_MSG_PROXY_DISCONNECT;
+        request->proxy.connection_id = test_read_u32(body);
+        request->proxy.source_address = test_read_u32(body + 4);
+        request->status = body[8];      // the flags of the frame
+        request->reason = body[9];
+        break;
+    default:
+        request->type = LDNR_MSG_NONE;
+        break;
+    }
+}
+
+static int test_send(void *ctx, const void *frame, size_t size)
+{
+    test_transport *transport = ctx;
+    ldnr_message request;
+
+    pthread_mutex_lock(&transport->mutex);
+    if (!transport->connected) {
+        pthread_mutex_unlock(&transport->mutex);
+        return -1;
+    }
+    test_parse_request(frame, size, &request);
+    CHECK(request.type >= 0 && request.type <= LDNR_MSG_ERROR);
+    if (request.type == LDNR_MSG_PROXY_DATA && transport->delay_data &&
+        --transport->delay_data == 0) {
+        // The frame is parked before it is recorded: a close or a shutdown
+        // that runs now must still go out after it on the wire.
+        transport->data_delayed = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (!transport->release_data)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+        transport->data_delayed = 0;
+        transport->release_data = 0;
+    }
+    if (request.type == LDNR_MSG_PROXY_CONNECT && transport->delay_open &&
+        --transport->delay_open == 0) {
+        // The open is parked before it is recorded: a close that runs now
+        // must still send its reset after it on the wire.
+        transport->open_delayed = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (!transport->release_open)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+        transport->open_delayed = 0;
+        transport->release_open = 0;
+    }
+    if (request.type == LDNR_MSG_UDP && transport->delay_udp &&
+        --transport->delay_udp == 0) {
+        // The datagram is parked before it is recorded: a leave that runs
+        // now must queue behind it, or the datagram must never leave.
+        transport->udp_delayed = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (!transport->release_udp)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+        transport->udp_delayed = 0;
+        transport->release_udp = 0;
+    }
+    if (request.type == LDNR_MSG_PROXY_DISCONNECT && transport->delay_disconnect &&
+        --transport->delay_disconnect == 0) {
+        // The close is parked inside the transport with the socket already
+        // cleared and the stream send step held: what runs against the dead
+        // descriptor now is what the send boundary itself sees.
+        transport->disconnect_delayed = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (!transport->release_disconnect)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+        transport->disconnect_delayed = 0;
+        transport->release_disconnect = 0;
+    }
+    transport->sent_count[request.type]++;
+    transport->seq_of[request.type] = ++transport->sent_seq;
+    if (request.type == LDNR_MSG_PROXY_DATA &&
+        transport->data_size_count < (int)(sizeof transport->data_sizes /
+                                           sizeof transport->data_sizes[0]))
+        transport->data_sizes[transport->data_size_count++] = request.proxy.size;
+    // The payload of the previous frame belongs to the transport.
+    free(transport->last.proxy.data);
+    transport->last = request;
+    if (request.type == LDNR_MSG_PROXY_CONNECT)
+        transport->last_open_id = request.proxy.connection_id;
+    transport->last.networks = NULL;
+    pthread_cond_broadcast(&transport->condition);
+    if (request.type == LDNR_MSG_PROXY_DATA && transport->block_data) {
+        // The frame is in flight: the test closes the socket while the
+        // rest of the buffer is still to be sent.
+        transport->data_blocked = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (transport->block_data)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+    }
+    if (request.type == LDNR_MSG_PROXY_CONNECT_ACK && transport->block_reply) {
+        // The acceptance of a stream is in flight: an accept() must not
+        // hand out its socket until this reply reached the relay.
+        transport->reply_blocked = 1;
+        pthread_cond_broadcast(&transport->condition);
+        while (transport->block_reply)
+            pthread_cond_wait(&transport->condition, &transport->mutex);
+    }
+    test_reply_locked(transport, &request);
+    pthread_mutex_unlock(&transport->mutex);
+    return 0;
+}
+
+static void test_close(void *ctx)
+{
+    test_transport *transport = ctx;
+    pthread_mutex_lock(&transport->mutex);
+    transport->connected = 0;
+    transport->head = 0;
+    transport->count = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_transport_destroy(void *ctx)
+{
+    test_transport *transport = ctx;
+    free(transport->last.proxy.data);
+    pthread_mutex_destroy(&transport->mutex);
+    pthread_cond_destroy(&transport->condition);
+    free(transport);
+}
+
+static const ldnr_transport *test_transport_create(test_transport **out)
+{
+    test_transport *transport = calloc(1, sizeof(*transport));
+    ldnr_transport *api = calloc(1, sizeof(*api));
+    CHECK(transport != NULL && api != NULL);
+    pthread_mutex_init(&transport->mutex, NULL);
+    pthread_cond_init(&transport->condition, NULL);
+    transport->auto_proxy_ack = 1;
+    api->ctx = transport;
+    api->connect = test_connect;
+    api->recv = test_recv;
+    api->send = test_send;
+    api->close = test_close;
+    api->destroy = test_transport_destroy;
+    *out = transport;
+    return api;
+}
+
+static void test_push_message(test_transport *transport, const ldnr_message *message);
+
+// The queue of the fake transport is bounded: a frame is pushed only after
+// the previous ones were taken, so the test cannot overflow it.
+static void test_push_message_slow(test_transport *transport,
+                                   const ldnr_message *message)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&transport->mutex);
+    while (transport->count > TEST_QUEUE_DEPTH / 2) {
+        int result = pthread_cond_timedwait(&transport->condition, &transport->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+    }
+    pthread_mutex_unlock(&transport->mutex);
+    test_push_message(transport, message);
+}
+
+static void test_push_message(test_transport *transport, const ldnr_message *message)
+{
+    test_writer writer;
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+
+    switch (message->type) {
+    case LDNR_MSG_PROXY_DATA:
+        // The wire carries the plain port numbers, not the socket order.
+        test_u32(&writer, message->proxy.source_address);
+        test_u16(&writer, ldnr_port_to_host(message->proxy.source_port));
+        test_u32(&writer, message->proxy.destination_address);
+        test_u16(&writer, ldnr_port_to_host(message->proxy.destination_port));
+        test_u8(&writer, 6);
+        test_u32(&writer, (uint32_t)message->proxy.connection_id);
+        test_u16(&writer, (uint16_t)message->proxy.size);
+        test_put(&writer, message->proxy.data, message->proxy.size);
+        test_finish(&writer, 0x30, 0);
+        break;
+    case LDNR_MSG_PROXY_CONNECT:
+        test_u32(&writer, (uint32_t)message->proxy.connection_id);
+        test_u32(&writer, message->proxy.source_address);
+        test_u16(&writer, ldnr_port_to_host(message->proxy.source_port));
+        test_u32(&writer, message->proxy.destination_address);
+        test_u16(&writer, ldnr_port_to_host(message->proxy.destination_port));
+        test_finish(&writer, 0x31, 0);
+        break;
+    case LDNR_MSG_PROXY_DISCONNECT:
+        test_u32(&writer, (uint32_t)message->proxy.connection_id);
+        test_u32(&writer, message->proxy.source_address);
+        test_u8(&writer, (uint8_t)message->status);   // the flags of the frame
+        test_u8(&writer, (uint8_t)message->reason);
+        test_finish(&writer, 0x33, 0);
+        break;
+    default:
+        CHECK(0);
+    }
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, writer.bytes, writer.size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+// A frame built by hand, for the cases a well-formed message cannot reach.
+static void test_push_frame(test_transport *transport, const uint8_t *bytes,
+                            size_t size)
+{
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->connected);
+    test_enqueue_locked(transport, bytes, size);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static unsigned test_sent_count(test_transport *transport, ldnr_message_type type)
+{
+    unsigned count;
+    pthread_mutex_lock(&transport->mutex);
+    count = transport->sent_count[type];
+    pthread_mutex_unlock(&transport->mutex);
+    return count;
+}
+
+// The wire position of the last frame of a kind: two frames can be ordered.
+static unsigned test_sent_seq(test_transport *transport, ldnr_message_type type)
+{
+    unsigned seq;
+    pthread_mutex_lock(&transport->mutex);
+    seq = transport->seq_of[type];
+    pthread_mutex_unlock(&transport->mutex);
+    return seq;
+}
+
+static void test_last_message(test_transport *transport, ldnr_message_type type,
+                              ldnr_message *out)
+{
+    pthread_mutex_lock(&transport->mutex);
+    CHECK(transport->last.type == type);
+    *out = transport->last;
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_wait_for_send(test_transport *transport, ldnr_message_type type,
+                               unsigned expected)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&transport->mutex);
+    while (transport->sent_count[type] < expected) {
+        int result = pthread_cond_timedwait(&transport->condition, &transport->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+        CHECK(result == 0);
+    }
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static ldnr *test_create_context(const ldnr_transport *api, test_waits *waits)
+{
+    ldnr_config config;
+    ldnr *context = NULL;
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.connect_timeout_ms = 200;
+    config.callback_ctx = waits;
+    config.native_wait = waits ? test_native_wait : NULL;
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(context != NULL);
+    return context;
+}
+
+static ldnr *test_connected_context(const ldnr_transport *api, test_waits *waits)
+{
+    ldnr *context = test_create_context(api, waits);
+    ldnr_network_info info = test_network_info();
+    ldnr_security_config security;
+    uint32_t address;
+    uint32_t mask;
+    memset(&security, 0, sizeof(security));
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, NULL, NULL, 0, 0) == 0);
+    CHECK(ldnr_get_ipv4_address(context, &address, &mask) == 0);
+    // nn::ldn keeps the address in host order: 192.168.44.10 is 0xC0A82C0A.
+    CHECK(address == UINT32_C(0xC0A82C0A));
+    CHECK(mask == UINT32_C(0xFFFF0000));
+    return context;
+}
+
+static void test_destroy_context(ldnr *context, const ldnr_transport *api)
+{
+    ldnr_destroy(context);
+    free((void *)api);
+}
