+        return status;
+    decode_intent_id(&decoded.intent_id, in);
+    decoded.channel = get_i16(in + 0x10);
+    decoded.node_count_max = get_i8(in + 0x12);
+    status = validate_node_count_max(decoded.node_count_max);
+    if (status != LDNR_NATIVE_OK)
