+/* Protocol 1.2 appended the BSSID and the network type to the SCAN payload.
+ * They are always sent: the flags alone decide whether the relay uses them. */
+static void test_scan_carries_the_1_2_extension(void)
+{
+    ldnr_scan_filter filter;
+    ldnr_operation operation;
+    uint8_t output[128];
+    size_t size = 0;
+
+    memset(&filter, 0, sizeof(filter));
+    memset(&operation, 0, sizeof(operation));
+    operation.scan_filter = &filter;
+
+    filter.flags = 0x08 | 0x04;
+    memcpy(filter.bssid, "\x02\x00\x11\x22\x33\x44", 6);
+    filter.network_type = 2;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    /* flags(1) + id(8) + scene(2) + session(16) + ssid(2) + bssid(6) + type(4) */
+    CHECK(size == LDNR_WIRE_HEADER + 39);
+    CHECK(memcmp(output + LDNR_WIRE_HEADER + 29, filter.bssid, 6) == 0);
+    CHECK(output[LDNR_WIRE_HEADER + 35] == 2);
+    CHECK(output[LDNR_WIRE_HEADER + 36] == 0);
+    CHECK(output[LDNR_WIRE_HEADER + 37] == 0);
+    CHECK(output[LDNR_WIRE_HEADER + 38] == 0);
+}
