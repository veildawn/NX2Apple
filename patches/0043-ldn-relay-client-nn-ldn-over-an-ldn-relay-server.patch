+static Result lr_connect(ldnr *l, const void *info_bytes, const void *config_bytes,
+                         const void *security_bytes, const void *user_bytes,
+                         const void *parameter_bytes, int option, int version) {
+    if (!l) return lr_failure(LDNR_EINVAL);
+    // The network information is large: it is allocated outside the guest stack.
+    ldnr_network_info *info = NULL;
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_security_parameter parameter;
+    if (info_bytes) {
+        info = calloc(1, sizeof *info);
+        if (!info) return lr_failure(LDNR_ENOBUFS);
+        if (ldnr_native_network_info_decode(info, info_bytes, sizeof *info) != LDNR_NATIVE_OK) {
+            free(info);
+            // The network information of the caller does not decode: it is
+            // an invalid input.
+            return lr_failure(LDNR_EINVAL);
+        }
+    }
+    // A configuration that does not decode is an invalid input: the local
+    // validation error is returned directly, not a stale core error.
+    // The failure of the operation is kept apart from its error: a core
+    // that failed without recording one must not be reported as a success.
+    int failed = 0;
+    int error = 0;
+    if ((config_bytes && ldnr_native_network_config_decode(&config, config_bytes, sizeof config) != LDNR_NATIVE_OK) ||
+        ldnr_native_security_config_decode(&security, security_bytes, sizeof security) != LDNR_NATIVE_OK ||
+        (user_bytes && ldnr_native_user_config_decode(&user, user_bytes, sizeof user) != LDNR_NATIVE_OK) ||
+        (parameter_bytes && ldnr_native_security_parameter_decode(&parameter, parameter_bytes, sizeof parameter) != LDNR_NATIVE_OK)) {
+        failed = 1;
+        error = LDNR_EINVAL;
+    }
+    if (!failed && ldnr_connect_network(l, info, config_bytes ? &config : NULL, &security,
+                                        user_bytes ? &user : NULL,
+                                        parameter_bytes ? &parameter : NULL, option, version)) {
+        failed = 1;
+        error = ldnr_last_errno();
+    }
+    free(info);
+    return failed ? lr_failure(error) : RES_OK;
+}
+LDNR_HLE("_ZN2nn3ldn7ConnectERKNS0_11NetworkInfoERKNS0_14SecurityConfigERKNS0_10UserConfigEiNS0_13ConnectOptionE", Result, lr_ldn_connect,
