+}
+
+ldnr_native_status ldnr_native_scan_filter_decode(ldnr_scan_filter *value,
+                                                  const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_SCAN_FILTER_SIZE);
+    ldnr_scan_filter decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decode_network_id(&decoded.network_id, in);
+    decoded.network_type = get_u32(in + 0x20);
+    memcpy(decoded.bssid, in + 0x24, sizeof(decoded.bssid));
+    status = decode_ssid(&decoded.ssid, in + 0x2a);
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.flags = get_u32(in + 0x5c);
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_address_entry_encode(const ldnr_address_entry *value,
+                                                    uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_ADDRESS_ENTRY_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_ADDRESS_ENTRY_SIZE);
+    put_u32(out, value->ipv4_address);
+    memcpy(out + 0x04, value->mac_address, sizeof(value->mac_address));
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_address_entry_decode(ldnr_address_entry *value,
+                                                    const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_ADDRESS_ENTRY_SIZE);
+    ldnr_address_entry decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.ipv4_address = get_u32(in);
+    memcpy(decoded.mac_address, in + 0x04, sizeof(decoded.mac_address));
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_node_latest_update_encode(
+    const ldnr_node_latest_update *value, uint8_t *out, size_t out_size)
+{
+    ldnr_native_status status = check_io(value, out, out_size,
+                                         LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE);
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    memset(out, 0, LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE);
+    out[0] = value->state_change;
+    return LDNR_NATIVE_OK;
+}
+
+ldnr_native_status ldnr_native_node_latest_update_decode(
+    ldnr_node_latest_update *value, const uint8_t *in, size_t in_size)
+{
+    ldnr_native_status status = check_io(value, in, in_size,
+                                         LDNR_NATIVE_NODE_LATEST_UPDATE_SIZE);
+    ldnr_node_latest_update decoded = {0};
+
+    if (status != LDNR_NATIVE_OK)
+        return status;
+    decoded.state_change = in[0];
+    *value = decoded;
+    return LDNR_NATIVE_OK;
+}
