+static void test_invalid_lengths(void)
+{
+    uint8_t bad[sizeof(scan_result_frame)];
+    uint8_t blob[16 + 17 + 2 + 1501];
+    ldnr_message message;
+    ldnr_operation operation;
+    ldnr_network_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_address_entry address;
+    uint8_t output[2048];
+    size_t size;
+    char long_name[1025 + 1];
+
+    /* PROXY_DATA's u16 blob length exceeds the remaining payload. */
+    memcpy(bad, udp_data_frame, sizeof(udp_data_frame));
+    put16(bad + 33, 4);
+    decode_bad(bad, sizeof(udp_data_frame));
+
+    /* The native UDP destination is bounded even though ProxyData itself has
+     * a much larger protocol-wide limit. */
+    memset(blob, 0, sizeof(blob));
+    memcpy(blob, udp_data_frame, 35);
+    put32(blob + 8, (uint32_t)(sizeof(blob) - 16));
+    put16(blob + 33, 1501);
+    decode_bad(blob, sizeof(blob));
+
+    /* SCAN_RESULT count cannot exceed the entries actually present. */
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 16, 2);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    /* Outer entry, NetworkInfo, and node record lengths are all checked. */
+    put16(bad + 21, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 23, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 23, 474);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 94, 0);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    /* SSID, native node count, advertise length, and generic string limits. */
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    bad[25 + 56] = 33;
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    bad[25 + 68] = 9;
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 494, 385);
+    decode_bad(bad, sizeof(scan_result_frame));
+    memcpy(bad, scan_result_frame, sizeof(scan_result_frame));
+    put16(bad + 500, 1025);
+    decode_bad(bad, sizeof(scan_result_frame));
+
+    memset(&message, 0, sizeof(message));
+    message.udp.size = LDNR_UDP_MTU + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_UDP, 1, 0,
+                               &message, NULL) != 0);
+    /* A segment above the protocol limit cannot be encoded, but a segment
+     * above the chunk this client sends is valid: the peer may send one. */
+    memset(&message, 0, sizeof(message));
+    message.proxy.size = 65473;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_PROXY_DATA,
+                               1, 0, &message, NULL) != 0);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.size = 20000;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_PROXY_DATA,
+                               1, 0, &message, NULL) != 0);
+
+    memset(long_name, 'a', sizeof(long_name));
+    long_name[sizeof(long_name) - 1] = '\0';
+    CHECK(ldnr_protocol_encode_auth(output, sizeof(output), &size, "", long_name) != 0);
+
+    memset(&operation, 0, sizeof(operation));
+    memset(&config, 0, sizeof(config));
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memset(&address, 0, sizeof(address));
+    config.node_count_max = 1;
+    operation.network_config = &config;
+    operation.security_config = &security;
+    operation.user_config = &user;
+    security.passphrase_size = LDNR_NATIVE_PASSPHRASE_MAX + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_CREATE_ACK,
+                               1, 0, &message, &operation) != 0);
+    security.passphrase_size = 0;
+    operation.data = output;
+    operation.data_size = LDNR_NATIVE_ADVERTISE_DATA_MAX + 1;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_CREATE_ACK,
+                               1, 0, &message, &operation) != 0);
+}
