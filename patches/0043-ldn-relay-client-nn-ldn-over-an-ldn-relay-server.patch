new file mode 100644
index 0000000..ca2f5d6
--- /dev/null
+++ b/dm/host/hle_ldnr.c
@@ -0,0 +1,984 @@
+// Optional nn::ldn / nn::socket takeover for relay play. The separate swldnr
+// section keeps force_init's upstream duplicate check and accounting unchanged.
+#ifdef LDNR_GLUE_SYNTAX_TEST
+#include "ldnr/tests/shim/hle.h"
+#else
+#include "hle.h"
+#include <mach-o/getsect.h>
+#include <mach-o/ldsyms.h>
+#endif
+#include "ldnr/ldnr_internal.h"
+#define LDNR_HOOK_IMPLEMENTATION
+#include "ldnr/ldnr_hook.h"
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef LDNR_GLUE_RUNTIME_TEST
+// Runtime tests get the same name/function pairs as plain objects, so the
+// test can drive the hook lookup with the real entry names.
+#define LDNR_HLE(mangled, ret, cname, ...) \
+    static ret cname(__VA_ARGS__); \
+    __attribute__((used)) static const hle_ent ldnr_ent_##cname = {mangled, (void *)cname}; \
+    static ret cname(__VA_ARGS__)
+#else
+#define LDNR_HLE(mangled, ret, cname, ...) \
+    static ret cname(__VA_ARGS__); \
+    __attribute__((used, section("__DATA,swldnr"))) static const hle_ent ldnr_ent_##cname = {mangled, (void *)cname}; \
+    static ret cname(__VA_ARGS__)
+#endif
+
+// The relay core outlives a single guest call, and Finalize may run while
+// another call is still inside the core. Every call therefore holds a
+// reference: Finalize marks the core closing, waits for the references to
+// drain and only then destroys it.
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t drained;
+    pthread_cond_t torn_down;
+    ldnr *core;
+    int active;                 // guest calls inside the core
+    int closing;                // a Finalize owns the teardown
+    void *event;                // guest event bound to the state change
+    uint64_t binding;           // identity of the binding of the event
+} ldnr_glue;
+
+static ldnr_glue g_glue = {PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER,
+                            PTHREAD_COND_INITIALIZER, NULL, 0, 0, NULL, 0};
+
+static void lr_log(void *ctx, const char *text) { (void)ctx; LOG("ldnr: %s", text); }
+
+// The state change callback runs on a core thread: the binding identity of
+// the event is read under the lock and the signal uses it, so a callback
+// that outlives a rebinding or a Finalize cannot signal the event that
+// took the place of the bound one.
+static void lr_state(void *ctx) {
+    (void)ctx;
+    pthread_mutex_lock(&g_glue.mutex);
+    uint64_t binding = g_glue.binding;
+    pthread_mutex_unlock(&g_glue.mutex);
+    if (binding) hle_signal_system_event_binding(binding);
+}
+static void lr_wait(void *ctx, int entering) { (void)ctx; dm_thread_native_wait(entering); }
+
+static ldnr *lr_core_create(void) {
+    ldnr_config config;
+    memset(&config, 0, sizeof config);
+    config.server = getenv("DM_LDNR_SERVER");
+    config.room_password = getenv("DM_LDNR_ROOM_PASSWORD");
+    config.player_name = getenv("DM_LDNR_NAME");
+    // The built-in transport is plaintext: a room password is only sent
+    // when the user explicitly accepts that (trusted network or VPN).
+    const char *plaintext = getenv("DM_LDNR_ALLOW_PLAINTEXT_PASSWORD");
+    config.allow_plaintext_password = plaintext && atoi(plaintext);
+    const char *verbose = getenv("DM_LDNR_LOG");
+    config.log = verbose && atoi(verbose);
+    config.callback_ctx = NULL;
+    config.state_changed = lr_state;
+    config.native_wait = lr_wait;
+    config.log_message = lr_log;
+    // The native id -1 means "the local communication id of the title":
+    // libnx then takes the first LocalCommunicationId of the user process's
+    // control.nacp (0 when it cannot be loaded) and validates an explicit
+    // id against that list. Known deviation: the host never loads the
+    // control.nacp, so neither rule can run; the profile's program id is
+    // used instead — it is the value the relay and the other stations
+    // compare.
+    config.local_communication_id = (int64_t)dm_profile()->program_id;
+#ifdef LDNR_GLUE_RUNTIME_TEST
+    extern const ldnr_transport *ldnr_glue_test_transport(void);
+    config.transport = ldnr_glue_test_transport();
+#endif
+    ldnr *core = NULL;
+    if (ldnr_create(&config, &core)) {
+        LOG("[RED] LDNR initialization failed: %s", ldnr_last_error(core));
+        return NULL;
+    }
+    return core;
+}
+
+// Takes a reference to the core. The reference keeps the core alive until
+// the matching lr_release().
+static ldnr *lr_acquire(void) {
+    pthread_mutex_lock(&g_glue.mutex);
+    if (g_glue.closing) { pthread_mutex_unlock(&g_glue.mutex); return NULL; }
+    if (!g_glue.core) {
+        ldnr *created = lr_core_create();
+        if (!created) { pthread_mutex_unlock(&g_glue.mutex); return NULL; }
+        g_glue.core = created;
+    }
+    ldnr *core = g_glue.core;
+    g_glue.active++;
+    pthread_mutex_unlock(&g_glue.mutex);
+    return core;
+}
+
+static void lr_release(void) {
+    pthread_mutex_lock(&g_glue.mutex);
+    if (g_glue.active > 0) g_glue.active--;
+    pthread_cond_broadcast(&g_glue.drained);
+    pthread_mutex_unlock(&g_glue.mutex);
+}
+
+void *ldnr_hook_lookup(const char *name) {
+    static int enabled = -1;
+    if (enabled < 0) { const char *env = getenv("DM_LDNR"); enabled = env && atoi(env); }
+    if (!enabled) return NULL;
+    static const hle_ent *table;
+    static size_t count;
+    static int loaded;
+    if (!loaded) {
+        unsigned long size = 0;
+        table = (const hle_ent *)getsectiondata(&_mh_execute_header, "__DATA", "swldnr", &size);
+        count = table ? size / sizeof *table : 0;
+        loaded = 1;
+    }
+    for (size_t i = 0; i < count; i++) if (!strcmp(table[i].name, name)) return table[i].fn;
+    return NULL;
+}
+
+static int lr_guest_address(ldnr_sockaddr *out, const void *input, unsigned size) {
+    if (!out || !input || size < 8) return 0;
+    const uint8_t *bytes = input;
+    if (bytes[1] != 2) return 0;
+    memset(out, 0, sizeof *out);
+    memcpy(&out->port, bytes + 2, 2);
+    memcpy(&out->address, bytes + 4, 4);
+    return 1;
+}
+
+static void lr_put_address(void *output, unsigned *size, const ldnr_sockaddr *address) {
+    if (!output || !size) return;
+    uint8_t bytes[16] = {16, 2};
+    memcpy(bytes + 2, &address->port, 2);
+    memcpy(bytes + 4, &address->address, 4);
+    unsigned count = *size < sizeof bytes ? *size : (unsigned)sizeof bytes;
+    memcpy(output, bytes, count);
+    *size = sizeof bytes;
+}
+
+static int lr_timeval_ms(const int64_t *tv) {
+    if (!tv) return -1;
+    int64_t ms = tv[0] * 1000 + tv[1] / 1000;
+    if (ms > 0x7fffffff) return 0x7fffffff;
+    return ms < 0 ? 0 : (int)ms;
+}
+
+// ---------- nn::ldn ----------
+// The results of nn::ldn are the codes of the module 203 (Ldn) in the
+// Horizon layout: the description in bits 9-15, the module in bits 0-8.
+// The list is the one of the switchbrew error code page (module 203):
+// 20 "the authentication challenge failed", 29 "invalid protocol",
+// 37 "the state is not Initialized", 39 "invalid state or state field",
+// 65 "ResultNetworkNotFound", 66 "ResultConnectionTimeout",
+// 67 "ResultConnectionRejected", 96 "invalid input or state",
+// 97 "no matching LocalCommunicationId in the control.nacp of the user
+// process", 113 "ResultLowerVersion" and 114 "ResultHigherVersion".
+#define LDNR_RES(desc) ((Result)((((uint32_t)(desc)) << 9) | 203u))
+#define LDNR_RES_AUTH_FAILED LDNR_RES(20)    // the authentication challenge failed
+#define LDNR_RES_PROTOCOL    LDNR_RES(29)    // invalid protocol
+#define LDNR_RES_NOT_INIT    LDNR_RES(37)    // the state is not Initialized
+#define LDNR_RES_STATE       LDNR_RES(39)    // invalid state or state field
+#define LDNR_RES_NOT_FOUND   LDNR_RES(65)    // ResultNetworkNotFound
+#define LDNR_RES_TIMEOUT     LDNR_RES(66)    // ResultConnectionTimeout
+#define LDNR_RES_REJECTED    LDNR_RES(67)    // ResultConnectionRejected
+#define LDNR_RES_INVALID     LDNR_RES(96)    // invalid input or state
+#define LDNR_RES_NO_COMM_ID  LDNR_RES(97)    // no LocalCommunicationId in the control.nacp
+
+// The relay reports its failures as distinct classes. They are mapped to
+// the documented nn::ldn results of the module 203: a game that only checks
+// for success is not affected, and a game that inspects the code can tell a
+// rejection from a missing network, a full room or a wrong password. A
+// class without a documented native code is mapped to the closest documented
+// one, and the comment says so.
+static Result lr_result(int error) {
+    switch (error) {
+    case 0: return RES_OK;
+    // The classes of the relay itself.
+    case LDNR_EROOMNOTFOUND: return LDNR_RES_NOT_FOUND;
+    // A full room has no documented native code: the closest documented one
+    // is the documented rejection of the connection.
+    case LDNR_EROOMFULL: return LDNR_RES_REJECTED;
+    // A wrong room password has no documented native code either: the
+    // closest documented one is the failed authentication challenge.
+    case LDNR_EBADPASSWORD: return LDNR_RES_AUTH_FAILED;
+    // The relay refuses a password room on a plaintext connection, and this
+    // client has no TLS yet. No documented code fits exactly: the closest
+    // documented one is the invalid protocol, and it stays apart from the
+    // other classes.
+    case LDNR_ETLSREQUIRED: return LDNR_RES_PROTOCOL;
+    // The security parameters of the caller do not match the network: the
+    // closest documented code is the invalid input or state.
+    case LDNR_ESECURITYMISMATCH: return LDNR_RES_INVALID;
+    // Only the host may change the settings of the room: the closest
+    // documented code is the invalid input or state.
+    case LDNR_ENOTHOST: return LDNR_RES_INVALID;
+    // The relay refuses the request because of its rate or its limits: the
+    // closest documented code is the documented rejection.
+    case LDNR_ERATELIMITED: case LDNR_ELIMITEXCEEDED: return LDNR_RES_REJECTED;
+    // An explicit rejection of the connection has its documented code.
+    case LDNR_EREJECTED: return LDNR_RES_REJECTED;
+    // A parameter the relay calls bad is invalid input on this side too.
+    case LDNR_EBADPARAM: return LDNR_RES_INVALID;
+    // The relay does not support what the caller asked for: the closest
+    // documented code is the invalid input or state.
+    case LDNR_EUNSUPPORTED: return LDNR_RES_INVALID;
+    // The relay speaks an older protocol than this client needs: the
+    // documented code for it is the lower version.
+    case LDNR_EVERSIONMISMATCH: return LDNR_RES(113);
+    // The relay failed on its own side: no documented code fits, the
+    // closest documented one is the invalid input or state.
+    case LDNR_EINTERNAL: return LDNR_RES_INVALID;
+    // The errors of the core.
+    case LDNR_EHOSTUNREACH: return LDNR_RES_NOT_FOUND;
+    case LDNR_ETIMEDOUT: return LDNR_RES_TIMEOUT;
+    // The relay connection was lost: no documented code fits, the closest
+    // documented one is the connection timeout.
+    case LDNR_ENETDOWN: case LDNR_ECONNRESET: return LDNR_RES_TIMEOUT;
+    case LDNR_ECONNREFUSED: return LDNR_RES_REJECTED;
+    case LDNR_ENOTCONN: case LDNR_EISCONN: case LDNR_EALREADY:
+    case LDNR_EPIPE: case LDNR_ESHUTDOWN: case LDNR_EAGAIN:
+    case LDNR_EINPROGRESS: return LDNR_RES_STATE;
+    default: return LDNR_RES_INVALID;
+    }
+}
+
+// A failure of the core always carries an error, but a core that failed
+// without recording one must not be reported as a success: the caller gets
+// the closest documented code for an invalid input or state.
+static Result lr_failure(int error) {
+    return error ? lr_result(error) : LDNR_RES_INVALID;
+}
+
+// A call that arrives while a teardown owns the glue sees no core: it is
+// answered like a call in the state Finalize leaves behind.
+#define LR_NO_CORE LDNR_RES_NOT_INIT
+
+// nn::ldn::LdnState has its own numbering: the core states are translated.
+static int lr_state_value(int state) {
+    switch (state) {
+    case LDNR_STATE_NONE: return 0;            // LdnState_None
+    case LDNR_STATE_INITIALIZED: return 1;     // LdnState_Initialized
+    case LDNR_STATE_AP_OPEN: return 2;         // LdnState_AccessPoint
+    case LDNR_STATE_STATION_OPEN: return 4;    // LdnState_Station
+    case LDNR_STATE_AP_CREATED: return 3;      // LdnState_AccessPointCreated
+    case LDNR_STATE_STATION_CONNECTED: return 5; // LdnState_StationConnected
+    default: return 6;                         // LdnState_Error
+    }
+}
+
+LDNR_HLE("_ZN2nn3ldn10InitializeEv", Result, lr_ldn_initialize, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_initialize(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn8FinalizeEv", void, lr_ldn_finalize, void) {
+    // Teardown has a single owner: a second Finalize waits for the one that
+    // is running and returns without touching its state. Otherwise it could
+    // reopen the acquisition for new calls while the first teardown is
+    // still draining or destroying the old core.
+    pthread_mutex_lock(&g_glue.mutex);
+    if (g_glue.closing) {
+        while (g_glue.closing) pthread_cond_wait(&g_glue.torn_down, &g_glue.mutex);
+        pthread_mutex_unlock(&g_glue.mutex);
+        return;
+    }
+    // The core is taken away from the callers first: a call that starts now
+    // fails instead of using a core that is about to disappear. The calls
+    // that are still inside the core keep it alive until they return.
+    g_glue.closing = 1;
+    ldnr *core = g_glue.core;
+    g_glue.core = NULL;
+    g_glue.event = NULL;
+    g_glue.binding = 0;
+    pthread_mutex_unlock(&g_glue.mutex);
+    // The calls that are still inside the core must end: one that waits for
+    // the relay would keep its reference forever, and Finalize would never
+    // finish. The cancellation ends every wait of the core.
+    if (core) ldnr_cancel(core);
+    pthread_mutex_lock(&g_glue.mutex);
+    while (g_glue.active > 0) pthread_cond_wait(&g_glue.drained, &g_glue.mutex);
+    pthread_mutex_unlock(&g_glue.mutex);
+    if (core) ldnr_destroy(core);
+    pthread_mutex_lock(&g_glue.mutex);
+    g_glue.closing = 0;
+    pthread_cond_broadcast(&g_glue.torn_down);
+    pthread_mutex_unlock(&g_glue.mutex);
+}
+LDNR_HLE("_ZN2nn3ldn8GetStateEv", int, lr_ldn_state, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return 0;
+    int state = lr_state_value(ldnr_get_state(l));
+    lr_release();
+    return state;
+}
+// The event is bound on the guest thread, and the identity of the binding
+// is kept: a rebinding of the same address gets a new identity, so a
+// callback of the old binding cannot signal the new event.
+static void lr_bind_event(void *event) {
+    hle_bind_system_event(event, 0);
+    uint64_t binding = hle_system_event_binding(event);
+    pthread_mutex_lock(&g_glue.mutex);
+    g_glue.event = event;
+    g_glue.binding = binding;
+    pthread_mutex_unlock(&g_glue.mutex);
+}
+LDNR_HLE("_ZN2nn3ldn22AttachStateChangeEventEPNS_2os15SystemEventTypeE", void, lr_ldn_attach, void *event) {
+    lr_bind_event(event);
+}
+LDNR_HLE("_ZN2nn3ldn19GetStateChangeEventEPNS_2os15SystemEventTypeE", void, lr_ldn_get_event, void *event) {
+    lr_bind_event(event);
+}
+LDNR_HLE("_ZN2nn3ldn11OpenStationEv", Result, lr_ldn_open_station, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_open_station(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn12CloseStationEv", Result, lr_ldn_close_station, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_close_station(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn15OpenAccessPointEv", Result, lr_ldn_open_ap, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_open_access_point(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn16CloseAccessPointEv", Result, lr_ldn_close_ap, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_close_access_point(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn10DisconnectEv", Result, lr_ldn_disconnect, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_disconnect(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+LDNR_HLE("_ZN2nn3ldn14DestroyNetworkEv", Result, lr_ldn_destroy, void) {
+    ldnr *l = lr_acquire();
+    if (!l) return LR_NO_CORE;
+    Result result = ldnr_destroy_network(l) ? lr_failure(ldnr_last_errno()) : RES_OK;
+    lr_release();
+    return result;
+}
+
+static Result lr_scan(ldnr *l, void *output, int *count, int maximum, const void *filter_bytes, int channel, int private_scan) {
+    if (count) *count = 0;
+    if (!l || !count || maximum < 0) return lr_result(LDNR_EINVAL);
