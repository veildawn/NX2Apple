+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(context != NULL);
+    CHECK(ldnr_get_state(context) == TEST_STATE_NONE);
+    CHECK(ldnr_get_disconnect_reason(context) == 0);
