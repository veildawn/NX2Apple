+    memset(&message, 0, sizeof(message));
+    message.timestamp = UINT64_C(0x0102030405060708);
+    encode_ok(ping_frame, sizeof(ping_frame), LDNR_MSG_PING, UINT64_C(0x11121314),
+              0, &message, NULL);
