diff --git a/dm/host/ldnr/ldnr_client.c b/dm/host/ldnr/ldnr_client.c
new file mode 100644
index 0000000..ef8a4c0
--- /dev/null
+++ b/dm/host/ldnr/ldnr_client.c
@@ -0,0 +1,640 @@
+// Relay connection, request/reply matching, and the background receive loop.
+// The codec only turns frames into ldnr_message; this file owns no wire rules.
+#include "ldnr_internal.h"
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int ldnr_send_encoded(ldnr *l, const uint8_t *frame, size_t size) {
+    if (!l->transport_open || l->stop) return ldnr_fail(LDNR_ENETDOWN);
+    // The relay announced the largest payload it accepts: a frame above it
+    // would be dropped without an answer.
+    uint32_t limit = atomic_load(&l->max_frame);
+    if (limit && size > (size_t)limit + LDNR_WIRE_HEADER)
+        return ldnr_fail(LDNR_EMSGSIZE);
+    if (l->transport->send(l->transport->ctx, frame, size) < 0) {
+        ldnr_set_error(l, "relay send failed");
+        // The framing stream is broken: the connection cannot carry another
+        // frame. It is closed here, and the receive thread reports the loss
+        // of the relay, so the membership ends with it.
+        if (l->transport->close) l->transport->close(l->transport->ctx);
+        atomic_store(&l->transport_open, 0);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    return 0;
+}
+
+int ldnr_client_send_ex(ldnr *l, ldnr_message_type type, uint64_t request_id,
+                        uint64_t network_id, const ldnr_message *message,
+                        const ldnr_operation *operation) {
+    uint8_t *frame = malloc(LDNR_MAX_FRAME);
+    if (!frame) return ldnr_fail(LDNR_ENOBUFS);
+    size_t size = 0;
+    int result = ldnr_protocol_encode_ex(frame, LDNR_MAX_FRAME, &size, type, request_id,
+                                         network_id, message, operation,
+                                         atomic_load(&l->protocol_major));
+    if (result) {
+        // The frame could not be built: the request is not one the wire
+        // accepts. The failure carries an error of its own, never a stale
+        // one, so that the caller cannot read it as a success.
+        ldnr_set_error(l, "relay frame could not be encoded: %s", ldnr_protocol_error());
+        result = ldnr_fail(LDNR_EINVAL);
+    } else result = ldnr_send_encoded(l, frame, size);
+    free(frame);
+    return result;
+}
+
+// A proxied TCP open is answered by the relay in two ways: with a reply that
+// carries the connection id of the open, or with an error that carries the
+// request id of the open. The open is remembered here, so that both forms
+// reach the socket that waits for the answer.
+static int ldnr_proxy_open_record(ldnr *l, uint64_t request_id, uint64_t connection_id) {
+    int recorded = 0;
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) {
+        if (l->proxy_opens[i].used) continue;
+        l->proxy_opens[i].used = 1;
+        l->proxy_opens[i].request_id = request_id;
+        l->proxy_opens[i].connection_id = connection_id;
+        recorded = 1;
+        break;
+    }
+    pthread_mutex_unlock(&l->proxy_mutex);
+    if (!recorded) {
+        // An open that cannot be remembered must not go out: its answer
+        // would have no way to reach the socket that waits for it.
+        ldnr_set_error(l, "too many proxied opens are waiting for their answer");
+        return ldnr_fail(LDNR_ENOBUFS);
+    }
+    return 0;
+}
+
+// Forgets the open that carries this request id, if it is still waiting. The
+// relay names a proxied open by its request id when it refuses the open; the
+// vnet layer calls this when it learns of the refusal through the socket
+// state instead of through an ERROR frame.
+void ldnr_proxy_open_forget(ldnr *l, uint64_t request_id) {
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) {
+        if (!l->proxy_opens[i].used || l->proxy_opens[i].request_id != request_id) continue;
+        l->proxy_opens[i].used = 0;
+    }
+    pthread_mutex_unlock(&l->proxy_mutex);
+}
+
+// The open that carries this request id, if it is still waiting.
+static int ldnr_proxy_open_take(ldnr *l, uint64_t request_id, uint64_t *connection_id) {
+    int found = 0;
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) {
+        if (!l->proxy_opens[i].used || l->proxy_opens[i].request_id != request_id) continue;
+        *connection_id = l->proxy_opens[i].connection_id;
+        l->proxy_opens[i].used = 0;
+        found = 1;
+        break;
+    }
+    pthread_mutex_unlock(&l->proxy_mutex);
+    return found;
+}
+
+// The open of this stream is answered: it must not be matched by a later
+// error of the relay.
+static void ldnr_proxy_open_clear(ldnr *l, uint64_t connection_id) {
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) {
+        if (!l->proxy_opens[i].used || l->proxy_opens[i].connection_id != connection_id) continue;
+        l->proxy_opens[i].used = 0;
+    }
+    pthread_mutex_unlock(&l->proxy_mutex);
+}
+
+// The membership is gone: no open can be answered any more, and the table
+// must not keep the entries of a room that does not exist any more.
+void ldnr_proxy_open_clear_all(ldnr *l) {
+    pthread_mutex_lock(&l->proxy_mutex);
+    for (unsigned i = 0; i < LDNR_MAX_PROXY_OPENS; i++) l->proxy_opens[i].used = 0;
+    pthread_mutex_unlock(&l->proxy_mutex);
+}
+
+int ldnr_client_send(ldnr *l, ldnr_message_type type, uint64_t network_id,
+                     const ldnr_message *message, const ldnr_operation *operation) {
+    uint64_t request_id = 0;
+    if (type == LDNR_MSG_PROXY_CONNECT && message) {
+        // The open carries a request id of its own: the relay refuses an
+        // open with an error that names it. The ids live above the ones of
+        // the control requests, so that the two can never be confused.
+        request_id = LDNR_PROXY_REQUEST_BASE +
+            (uint64_t)atomic_fetch_add(&l->proxy_request_seq, 1);
+        // The open is remembered before it goes out: an answer that names
+        // it must reach the socket that waits for it.
+        if (ldnr_proxy_open_record(l, request_id, message->proxy.connection_id)) return -1;
+    }
+    if (type == LDNR_MSG_PROXY_DISCONNECT && message) {
+        // The stream is over: a close of the socket or a reset of a stream
+        // that timed out ends the open. The entry must not survive it, or a
+        // later error of the relay would reach a socket that is gone.
+        ldnr_proxy_open_clear(l, message->proxy.connection_id);
+    }
+    int result = ldnr_client_send_ex(l, type, request_id, network_id, message, operation);
+    if (result && request_id) ldnr_proxy_open_forget(l, request_id);
+    return result;
+}
+
+static int ldnr_request_frame(ldnr *l, ldnr_message_type send_type,
+                              uint64_t request_id, uint64_t network_id,
+                              const ldnr_message *message, const ldnr_operation *operation) {
+    uint8_t *frame = malloc(LDNR_MAX_FRAME);
+    if (!frame) return ldnr_fail(LDNR_ENOBUFS);
+    size_t size = 0;
+    int result = ldnr_protocol_encode_ex(frame, LDNR_MAX_FRAME, &size, send_type, request_id,
+                                         network_id, message, operation,
+                                         atomic_load(&l->protocol_major));
+    if (result) {
+        // The frame could not be built: the request is not one the wire
+        // accepts. The failure carries an error of its own, never a stale
+        // one, so that the caller cannot read it as a success.
+        ldnr_set_error(l, "relay frame could not be encoded: %s", ldnr_protocol_error());
+        result = ldnr_fail(LDNR_EINVAL);
+    } else result = ldnr_send_encoded(l, frame, size);
+    free(frame);
+    return result;
+}
+
+// A membership operation changes what the relay knows about this client. If
+// its answer is lost, the relay keeps the old membership: the connection is
+// retired so that the membership ends with it.
+static int ldnr_membership_type(ldnr_message_type type) {
+    switch (type) {
+    case LDNR_MSG_CREATE_ACK: case LDNR_MSG_CONNECT_ACK:
+    case LDNR_MSG_DESTROY_ACK: case LDNR_MSG_DISCONNECTED: return 1;
+    default: return 0;
+    }
+}
+
+int ldnr_client_request(ldnr *l, ldnr_message_type want, ldnr_message_type send_type,
+                        uint64_t network_id, const ldnr_message *message,
+                        const ldnr_operation *operation, ldnr_message *reply_out,
+                        int timeout_ms) {
+    if (!l) return ldnr_fail(LDNR_EINVAL);
+    if (timeout_ms <= 0) timeout_ms = 5000;
+    pthread_mutex_lock(&l->mutex);
+    if (!l->transport_open || l->stop) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_ENETDOWN); }
+    if (l->pending_request) { pthread_mutex_unlock(&l->mutex); return ldnr_fail(LDNR_EALREADY); }
+    ldnr_protocol_message_free(&l->reply);
+    memset(&l->reply, 0, sizeof l->reply);
+    uint64_t id = l->next_request_id++;
+    l->pending_request = id;
+    l->pending_want = want;
+    l->reply_ready = 0;
+    l->reply_status = 0;
+    int result = ldnr_request_frame(l, send_type, id, network_id, message, operation);
+    // The class of the failure is kept apart from the return value: the
+    // return value is always -1, the class says what went wrong.
+    int failure = 0;
+    int64_t deadline = ldnr_monotonic_ms() + timeout_ms;
+    while (!result && !l->reply_ready && !l->stop) {
+        int wait_result = ldnr_wait_until(l, &l->condition, &l->mutex, l->config.callback_ctx,
+                                          l->config.native_wait, deadline);
+        if (wait_result == ETIMEDOUT) { failure = LDNR_ETIMEDOUT; result = ldnr_fail(failure); }
+        else if (wait_result == ECANCELED) { failure = LDNR_ECANCELED; result = ldnr_fail(failure); }
+    }
+    if (!result && !l->reply_ready) { failure = LDNR_ENETDOWN; result = ldnr_fail(failure); }
+    if (!result && l->reply_status) { failure = (int)l->reply_status; result = ldnr_fail(failure); }
+    if (failure == LDNR_ETIMEDOUT && ldnr_membership_type(send_type)) {
+        // The relay may have accepted the operation without the answer
+        // reaching this client: the connection goes away, and the room
+        // membership with it. A late answer is discarded, because the
+        // membership it belongs to is gone.
+        l->stop = 1;
+        if (l->transport && l->transport->close) l->transport->close(l->transport->ctx);
+        atomic_store(&l->transport_open, 0);
+        // The membership is over: it is cleared, the sockets that belong to
+        // it are marked down and their waiters are woken, and the guest
+        // sees the open state with the reason of the loss.
+        ldnr_membership_retire(l, LDNR_REASON_SIGNAL_LOST);
+        // No open of that room can be answered any more.
+        ldnr_proxy_open_clear_all(l);
+    }
+    // The reply is handed over before the request slot is released, so no
+    // other request can replace it while the caller reads it.
+    if (reply_out) {
+        *reply_out = l->reply;
+        memset(&l->reply, 0, sizeof l->reply);
+    } else {
+        ldnr_protocol_message_free(&l->reply);
+        memset(&l->reply, 0, sizeof l->reply);
+    }
+    l->pending_request = 0;
+    pthread_mutex_unlock(&l->mutex);
+    return result;
+}
+
+// Joins a receive thread that has ended (or is ending). The transport is
+// closed before, so the reader cannot stay blocked in recv().
+static void ldnr_retire_receiver(ldnr *l) {
+    pthread_mutex_lock(&l->mutex);
+    int join = l->receive_started;
+    pthread_t thread = l->receive_thread;
+    l->receive_started = 0;
+    pthread_mutex_unlock(&l->mutex);
+    if (join) pthread_join(thread, NULL);
+}
+
+// The cancellation of the core ends a connect that is in progress.
+static int ldnr_client_cancelled(void *ctx) {
+    ldnr *l = ctx;
+    return atomic_load(&l->cancelled) || atomic_load(&l->stop);
+}
+
+// The connect of the transport ends at the deadline of the core and can be
+// interrupted by the cancellation: a teardown does not wait for the
+// operating system's own connection timeout.
+static int ldnr_transport_connect(ldnr *l, char *error, size_t size) {
+    int timeout = l->config.connect_timeout_ms > 0 ? l->config.connect_timeout_ms
+                                                   : LDNR_CONNECT_TIMEOUT_MS;
+    if (l->transport_caps && l->transport_caps->connect_ex)
+        return l->transport_caps->connect_ex(l->transport->ctx, l->server, error, size,
+                                             timeout, ldnr_client_cancelled, l);
+    return l->transport->connect(l->transport->ctx, l->server, error, size);
+}
+
+int ldnr_client_open(ldnr *l) {
+    pthread_mutex_lock(&l->mutex);
+    if (l->transport_open) { pthread_mutex_unlock(&l->mutex); return 0; }
+    l->stop = 0;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_clear_error(l);
+    // A reader that failed earlier must be gone before a new one starts.
+    ldnr_retire_receiver(l);
+    char error[160] = {0};
+    if (ldnr_transport_connect(l, error, sizeof error) < 0) {
+        pthread_mutex_lock(&l->mutex);
+        ldnr_set_error(l, "relay connect failed: %s", *error ? error : "unknown error");
+        pthread_mutex_unlock(&l->mutex);
+        if (l->transport->close) l->transport->close(l->transport->ctx);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    pthread_mutex_lock(&l->mutex);
+    atomic_store(&l->transport_open, 1);
+    if (pthread_create(&l->receive_thread, NULL, ldnr_client_receive_main, l)) {
+        atomic_store(&l->transport_open, 0);
+        l->stop = 1;
+        pthread_mutex_unlock(&l->mutex);
+        if (l->transport->close) l->transport->close(l->transport->ctx);
+        return ldnr_fail(LDNR_ENETDOWN);
+    }
+    l->receive_started = 1;
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_message *message = ldnr_message_new();
+    if (!message) { ldnr_client_close(l); return ldnr_fail(LDNR_ENOBUFS); }
+    ldnr_operation operation = {0};
+    operation.room_password = l->room_password;
+    operation.player_name = l->player_name;
+    int result = ldnr_client_request(l, LDNR_MSG_AUTH_OK, LDNR_MSG_AUTH_OK, 0, message, &operation,
+                                     NULL, l->config.connect_timeout_ms);
+    ldnr_message_delete(message);
+    if (result) {
+        ldnr_client_close(l);
+        return -1;
+    }
+    ldnr_log(l, "connected and authenticated");
+    return 0;
+}
+
+void ldnr_client_close(ldnr *l) {
+    pthread_mutex_lock(&l->mutex);
+    l->stop = 1;
+    if (l->transport_open && l->transport->close) l->transport->close(l->transport->ctx);
+    pthread_mutex_unlock(&l->mutex);
+    ldnr_retire_receiver(l);
+    pthread_mutex_lock(&l->mutex);
+    atomic_store(&l->transport_open, 0);
+    if (l->pending_request) {
+        l->reply_status = LDNR_ENETDOWN;
+        l->reply_ready = 1;
+        pthread_cond_broadcast(&l->condition);
+    }
+    ldnr_vnet_network_down(l);
+    pthread_mutex_unlock(&l->mutex);
+    // The membership is gone: no open of it can be answered any more.
+    ldnr_proxy_open_clear_all(l);
+}
+
+static void ldnr_reply(ldnr *l, const ldnr_message *message) {
+    // Only the fields a caller can see are copied; the scan array changes
+    // owner and is released with the reply.
+    l->reply.network_id = message->network_id;
+    l->reply.ipv4 = message->ipv4;
+    l->reply.node_id = message->node_id;
+    l->reply.status = message->status;
+    l->reply.reason = message->reason;
+    l->reply.subnet_mask = message->subnet_mask;
+    l->reply.max_frame = message->max_frame;
+    l->reply.has_network_info = message->has_network_info;
+    l->reply.network_info = message->network_info;
+    l->reply.networks = message->networks;
+    l->reply.network_count = message->network_count;
+    // The decoded error is kept: the caller maps it to its own result.
+    l->reply_status = (int)message->status;
+    l->reply_ready = 1;
+    pthread_cond_broadcast(&l->condition);
+}
+
+static void ldnr_unexpected_disconnect(ldnr *l, uint32_t reason) {
+    // The membership ended without the guest asking for it: it goes through
+    // the same complete retirement as every other loss, so the correlation
+    // table of its proxied opens is released with it instead of blocking
+    // the opens of the membership that comes later. The state change that
+    // retirement publishes already signals the event: a second signal
+    // would wake the guest twice for one change.
+    if (l->state == LDNR_STATE_STATION_CONNECTED || l->state == LDNR_STATE_AP_CREATED ||
+        l->has_network)
+        ldnr_membership_retire(l, (int)reason);
+}
+
+// The node set of the room changed: the guest is told which kind of change
+// happened, and the state change event is signalled. Every node keeps its
+// own history: a station that joined is not a change of the whole lobby.
+static void ldnr_track_update(ldnr *l, const ldnr_network_info *before,
+                              const ldnr_network_info *after) {
+    uint8_t changes = 0;
+    for (unsigned i = 0; i < LDNR_NATIVE_NODE_COUNT_MAX; i++) {
+        // A node that left keeps its id in the old snapshot: the new one has
+        // an empty slot there.
+        int node_id = after->nodes[i].is_connected ? after->nodes[i].node_id
+                                                   : before->nodes[i].node_id;
+        if (node_id < 0 || (unsigned)node_id >= LDNR_NATIVE_NODE_COUNT_MAX) node_id = (int)i;
+        if (before->nodes[i].is_connected && !after->nodes[i].is_connected) {
+            changes |= 0x02;
+            l->history[node_id].state_change |= 0x02;
+        } else if (!before->nodes[i].is_connected && after->nodes[i].is_connected) {
+            changes |= 0x01;
+            l->history[node_id].state_change |= 0x01;
+        }
+    }
+    if (after->advertise_data_size != before->advertise_data_size ||
+        memcmp(after->advertise_data, before->advertise_data, sizeof after->advertise_data)) {
+        changes |= 0x04;
+        // The advertisement belongs to the host (node zero).
+        l->history[0].state_change |= 0x04;
+    }
+    if (after->station_accept_policy != before->station_accept_policy) {
+        changes |= 0x08;
+        l->history[0].state_change |= 0x08;
+    }
+    if (!changes) return;
+    l->latest_update.state_change |= changes;
+    ldnr_notify(l);
+}
+
+static void ldnr_dispatch(ldnr *l, ldnr_message *message) {
+    pthread_mutex_lock(&l->mutex);
+    if (message->request_id && message->request_id == l->pending_request) {
+        if (message->type == l->pending_want || message->type == LDNR_MSG_ERROR ||
+            message->type == LDNR_MSG_AUTH_ERROR) {
+            // A create or connect acknowledgement installs the network
+            // before the waiter is woken up: a push that follows it must
+            // find the new state, not an empty one.
+            if (message->type == LDNR_MSG_AUTH_OK) {
+                if (message->max_frame) atomic_store(&l->max_frame, message->max_frame);
+                // The transport refuses a frame above the limit of the relay
+                // before it reads its payload.
+                if (l->transport->set_limit)
+                    l->transport->set_limit(l->transport->ctx, message->max_frame);
+                // The relay selected the major: every frame after the
+                // handshake carries it.
+                if (message->protocol_major)
+                    atomic_store(&l->protocol_major, message->protocol_major);
+            }
+            if (!message->status && (message->type == LDNR_MSG_CREATE_ACK ||
+                                      message->type == LDNR_MSG_CONNECT_ACK)) {
+                // The membership and its full configuration are installed
+                // under the core lock before the new state is published and
+                // the event is signalled: an event consumer that calls
+                // GetNetworkConfig right away must see a complete, valid
+                // configuration, not ENOTCONN.
+                if (message->type == LDNR_MSG_CREATE_ACK) {
+                    // The create staged the configuration before the request
+                    // went out: it is installed as the membership's own.
+                    if (ldnr_apply_network(l, message, &l->network_config)) message->status = LDNR_EINVAL;
+                    else ldnr_state_set(l, LDNR_STATE_AP_CREATED);
+                } else {
+                    // A plain connect reports the network it joined: the
+                    // configuration is derived from the acknowledgement, so
+                    // it is complete before the connected state is published.
+                    ldnr_network_config joined;
+                    memset(&joined, 0, sizeof joined);
+                    joined.intent_id = message->network_info.network_id.intent_id;
+                    joined.channel = message->network_info.common.channel;
+                    joined.node_count_max = message->network_info.node_count_max;
+                    // The connect staged the version it asked for before the
+                    // request went out: the published configuration is
+                    // complete in the same step as the connected state.
+                    joined.local_communication_version = l->staged_connect_version;
+                    if (ldnr_apply_network(l, message, &joined)) message->status = LDNR_EINVAL;
+                    else { l->disconnect_reason = 0; ldnr_state_set(l, LDNR_STATE_STATION_CONNECTED); }
+                }
+            }
+            ldnr_reply(l, message);
+            message->networks = NULL;
+            message->network_count = 0;
+            pthread_mutex_unlock(&l->mutex);
+            return;
+        }
+    }
+    switch (message->type) {
+    case LDNR_MSG_NETWORK_UPDATED:
+        if (l->has_network && message->has_network_info) {
+            ldnr_network_info before = l->network;
+            l->network = message->network_info;
+            ldnr_track_update(l, &before, &l->network);
+            pthread_cond_broadcast(&l->condition);
+        }
+        break;
+    case LDNR_MSG_DISCONNECTED:
+        ldnr_unexpected_disconnect(l, message->reason);
+        break;
+    case LDNR_MSG_UDP:
+        ldnr_vnet_udp(l, message);
+        break;
+    case LDNR_MSG_PROXY_CONNECT:
+        ldnr_vnet_proxy_connect(l, message);
+        break;
+    case LDNR_MSG_PROXY_CONNECT_ACK:
+        // The reply carries the connection id of the open: the open is
+        // answered and must not be matched by a later error.
+        ldnr_proxy_open_clear(l, message->proxy.connection_id);
+        ldnr_vnet_proxy_ack(l, message);
+        break;
+    case LDNR_MSG_PROXY_DATA:
+        ldnr_vnet_proxy_data(l, message);
+        break;
+    case LDNR_MSG_PROXY_DISCONNECT:
+        // The relay closed the stream from its side: the server connect
+        // timeout and a peer that left both arrive here. The open that
+        // belongs to this stream is over, so its entry must be released now,
+        // before the vnet layer reports the close to the socket.
+        ldnr_proxy_open_clear(l, message->proxy.connection_id);
+        ldnr_vnet_proxy_disconnect(l, message);
+        break;
+    case LDNR_MSG_PING:
+        pthread_mutex_unlock(&l->mutex);
+        ldnr_message *pong = ldnr_message_new();
+        if (pong) {
+            pong->request_id = message->request_id;
+            pong->timestamp = message->timestamp;
+            // The answer names the request it belongs to.
+            ldnr_client_send_ex(l, LDNR_MSG_PONG, message->request_id, 0, pong, NULL);
+            ldnr_message_delete(pong);
+        }
+        return;
+    case LDNR_MSG_ERROR: {
+        // An error that names a proxied open is the refusal of that open:
+        // the socket that waits for the answer must not wait forever.
+        uint64_t connection_id = 0;
+        if (ldnr_proxy_open_take(l, message->request_id, &connection_id)) {
+            ldnr_message refusal;
+            memset(&refusal, 0, sizeof refusal);
+            refusal.type = LDNR_MSG_PROXY_CONNECT_ACK;
+            refusal.proxy.connection_id = connection_id;
+            refusal.status = LDNR_ECONNREFUSED;
+            ldnr_vnet_proxy_ack(l, &refusal);
+            break;
+        }
+        ldnr_set_error(l, "relay: %s", message->text);
+        break;
+    }
+    default:
+        break;
+    }
+    pthread_mutex_unlock(&l->mutex);
+}
+
+// The connection is gone: every waiter is woken with the failure and the
+// membership ends with it.
+static void ldnr_client_transport_failed(ldnr *l, const char *reason) {
+    pthread_mutex_lock(&l->mutex);
+    if (!l->stop) {
+        ldnr_set_error(l, "%s", reason);
+        // The transport is gone: the connection is not open any more, and
+        // every waiter is woken with the failure.
+        atomic_store(&l->transport_open, 0);
+        if (l->transport && l->transport->close) l->transport->close(l->transport->ctx);
+        if (l->pending_request) {
+            l->reply_status = LDNR_ENETDOWN;
+            l->reply_ready = 1;
+            pthread_cond_broadcast(&l->condition);
+        }
+        // The relay is gone: the native reason for a lost signal is
+        // SignalLost, not a disconnect by the user.
+        ldnr_unexpected_disconnect(l, LDNR_REASON_SIGNAL_LOST);
+    }
+    pthread_mutex_unlock(&l->mutex);
+}
+
+// The answer of the relay could not be read: the caller is told at once
+// instead of waiting for the deadline.
+static void ldnr_client_fail_request(ldnr *l, int error) {
+    pthread_mutex_lock(&l->mutex);
+    if (l->pending_request) {
+        l->reply_status = (uint32_t)error;
+        l->reply_ready = 1;
+        pthread_cond_broadcast(&l->condition);
+    }
+    pthread_mutex_unlock(&l->mutex);
+}
+
+// The client answers a message it cannot read: the relay wants the error
+// that names the request. The code 2 is the relay's own UNSUPPORTED.
+static void ldnr_client_send_error(ldnr *l, uint64_t request_id, uint32_t code,
+                                   const char *text) {
+    ldnr_message *message = ldnr_message_new();
+    if (!message) return;
+    message->error_code = code;
+    snprintf(message->text, sizeof message->text, "%s", text);
+    ldnr_client_send_ex(l, LDNR_MSG_ERROR, request_id, 0, message, NULL);
+    ldnr_message_delete(message);
+}
+
+void *ldnr_client_receive_main(void *argument) {
+    ldnr *l = argument;
+    uint8_t *frame = malloc(LDNR_MAX_FRAME);
+    if (!frame) return NULL;
+    for (;;) {
+        ssize_t size = l->transport->recv(l->transport->ctx, frame, LDNR_MAX_FRAME);
+        pthread_mutex_lock(&l->mutex);
+        int stop = l->stop;
+        pthread_mutex_unlock(&l->mutex);
+        if (stop) break;
+        uint32_t limit = atomic_load(&l->max_frame);
+        if (size > 0 && limit && (size_t)size > (size_t)limit + LDNR_WIRE_HEADER) {
+            // A frame above the negotiated limit is a violation of the
+            // protocol: the framing of the connection cannot be trusted.
+            ldnr_client_transport_failed(l, "relay frame exceeds the negotiated limit");
+            break;
+        }
+        if (size <= 0) {
+            ldnr_client_transport_failed(l, size == 0 ? "relay closed the connection"
+                                                      : "relay receive failed");
+            break;
+        }
+        ldnr_message message;
+        memset(&message, 0, sizeof message);
+        ldnr_decode_status status;
+        // The frame is decoded with the major the relay selected and with the
+        // payload limit it announced: a frame of another major is not a
+        // frame of this protocol, and a frame above the limit is refused.
+        if (ldnr_protocol_decode_status(frame, (size_t)size, &message,
+                                         atomic_load(&l->protocol_major), limit, &status)) {
+            ldnr_protocol_message_free(&message);
+            if (status.kind == LDNR_DECODE_UNSUPPORTED) {
+                // Protocol 1.2: an unknown mandatory message is answered with
+                // the error that names it, and the connection continues.
+                ldnr_log(l, "unsupported relay message type 0x%02x", status.type);
+                ldnr_client_send_error(l, status.request_id, 2,
+                                       "unsupported message type");
+                continue;
+            }
+            if (status.kind == LDNR_DECODE_DATAGRAM) {
+                // A datagram was lost: the connection is still in order.
+                ldnr_log(l, "discarding invalid relay datagram: %s", ldnr_protocol_error());
+                continue;
+            }
+            if (status.has_connection_id) {
+                // The bytes of a relayed segment are lost: the stream that
+                // carried them is broken, the connection is not. The stream
+                // is failed terminally so nothing that follows the gap can
+                // be delivered, and the relay is told with a reset.
+                ldnr_log(l, "resetting the stream that lost its payload");
+                ldnr_vnet_stream_fail(l, status.connection_id);
+                continue;
+            }
+            if (status.kind == LDNR_DECODE_MEMORY) {
+                ldnr_client_fail_request(l, LDNR_ENOBUFS);
+                continue;
+            }
+            // A broken frame ends the connection: the bytes that follow it
+            // would be read as the start of the next frame.
+            ldnr_log(l, "relay protocol violation: %s", ldnr_protocol_error());
+            ldnr_client_transport_failed(l, "relay protocol violation");
+            break;
+        }
+        ldnr_dispatch(l, &message);
+        ldnr_protocol_message_free(&message);
+    }
+    pthread_mutex_lock(&l->mutex);
+    // The transport is gone: a later open must not treat it as connected.
+    atomic_store(&l->transport_open, 0);
+    pthread_mutex_unlock(&l->mutex);
+    free(frame);
+    return NULL;
+}
+
+uint64_t ldnr_next_connection_id(ldnr *l) {
+    // Connection ids live in a node specific namespace (the high byte is our
+    // own node id), so two clients in the same room never pick the same id.
+    uint64_t sequence = atomic_fetch_add(&l->connection_id_seq, 1);
+    uint32_t node = (uint32_t)(atomic_load(&l->node_id) & 0xff);
+    return ((uint64_t)node << 24) | (sequence & 0x00ffffffu);
+}
diff --git a/dm/host/ldnr/ldnr_hook.h b/dm/host/ldnr/ldnr_hook.h
new file mode 100644
index 0000000..b613bcd
--- /dev/null
+++ b/dm/host/ldnr/ldnr_hook.h
@@ -0,0 +1,13 @@
+// The loader's only LDNR entry point. It returns NULL without touching the
+// section table unless DM_LDNR explicitly enables the fork's relay layer.
+// Targets that include loader.c without hle_ldnr.c (the loader tests) link
+// the weak stub instead of an undefined symbol: the hook is simply absent
+// there, and DM_LDNR changes nothing.
+#pragma once
+#include <stddef.h>
+#ifdef LDNR_HOOK_IMPLEMENTATION
+void *ldnr_hook_lookup(const char *name);
+#else
+__attribute__((weak))
+void *ldnr_hook_lookup(const char *name) { (void)name; return NULL; }
+#endif
diff --git a/dm/host/ldnr/ldnr_internal.h b/dm/host/ldnr/ldnr_internal.h
new file mode 100644
index 0000000..d4f3cd0
--- /dev/null
+++ b/dm/host/ldnr/ldnr_internal.h
@@ -0,0 +1,255 @@
+// Private shared state for the unity build and the standalone test build.
+#pragma once
+#include "ldnr.h"
+#include "ldnr_protocol.h"
+#include "ldnr_transport.h"
+#include <pthread.h>
+#include <stdatomic.h>
+
+#define LDNR_MAX_FRAME (1024 * 1024)
+#define LDNR_MAX_SOCKETS 64
+#define LDNR_FD_BASE 512
+#define LDNR_ACCEPT_MAX 16
+#define LDNR_QUEUE_MAX 64
+// A stream must never lose bytes: it is reset instead of dropping data.
+#define LDNR_STREAM_LIMIT (1024 * 1024)
+// The default deadline of a relay connection and of a relay answer.
+#define LDNR_CONNECT_TIMEOUT_MS 5000
+// The proxied TCP opens that wait for their answer at the same time.
+#define LDNR_MAX_PROXY_OPENS 64
+// The request ids of the proxy opens live above the ones of the control
+// requests, so that an error of one is never read as the answer of the other.
+#define LDNR_PROXY_REQUEST_BASE 0x40000000u
+
+enum {
+    LDNR_STATE_NONE = 0, LDNR_STATE_INITIALIZED = 1,
+    LDNR_STATE_AP_OPEN = 2, LDNR_STATE_STATION_OPEN = 3,
+    LDNR_STATE_AP_CREATED = 4, LDNR_STATE_STATION_CONNECTED = 5,
+};
+enum {
+    LDNR_EBADF = 9, LDNR_EINVAL = 22, LDNR_EPIPE = 32, LDNR_EAGAIN = 35,
+    LDNR_EINPROGRESS = 36, LDNR_EALREADY = 37, LDNR_EMSGSIZE = 40,
+    LDNR_ENOPROTOOPT = 42, LDNR_EAFNOSUPPORT = 47, LDNR_EADDRINUSE = 48,
+    LDNR_EADDRNOTAVAIL = 49, LDNR_ENETDOWN = 50, LDNR_ECONNRESET = 54,
+    LDNR_ENOBUFS = 55, LDNR_EISCONN = 56, LDNR_ENOTCONN = 57,
+    LDNR_ESHUTDOWN = 58, LDNR_ETIMEDOUT = 60, LDNR_ECONNREFUSED = 61,
+    LDNR_EHOSTUNREACH = 65, LDNR_ECANCELED = 125,
+};
+
+// The native StationAcceptPolicy of nn::ldn. The relay enforces it before
+// it admits a station.
+enum {
+    LDNR_POLICY_ALWAYS_ACCEPT = 0, LDNR_POLICY_REJECT_ALL = 1,
+    LDNR_POLICY_BLACKLIST = 2, LDNR_POLICY_WHITELIST = 3,
+};
+
+// The relay's own failure classes. They are above the BSD errno numbers so
+// that the two ranges never overlap; the glue maps them to nn::ldn results.
+enum {
+    LDNR_EBADFRAME = 101, LDNR_EUNSUPPORTED = 102, LDNR_EVERSIONMISMATCH = 103,
+    LDNR_EROOMNOTFOUND = 104, LDNR_EROOMFULL = 105, LDNR_EBADPASSWORD = 106,
+    LDNR_ENOTINROOM = 107, LDNR_EALREADYINROOM = 108, LDNR_ERATELIMITED = 109,
+    LDNR_ELIMITEXCEEDED = 110, LDNR_EINTERNAL = 111, LDNR_EREJECTED = 112,
+    LDNR_EBADPARAM = 113, LDNR_ENOTHOST = 114, LDNR_ESECURITYMISMATCH = 115,
+    LDNR_ETLSREQUIRED = 116,
+};
+
+// The per-call flags of nn::socket in the Horizon numbering, which the
+// guest passes to Send/SendTo/Recv/RecvFrom unchanged. Peek keeps the
+// datagram or the segment queued after it is read; DontWait makes the
+// single call nonblocking, whatever the descriptor's own mode is.
+enum {
+    LDNR_MSG_PEEK = 0x02,
+    LDNR_MSG_DONTWAIT = 0x80,
+};
+
+// nn::ldn::DisconnectReason (libnx LdnDisconnectReason).
+enum {
+    LDNR_REASON_NONE = 0,
+    LDNR_REASON_DISCONNECTED_BY_USER = 1,
+    LDNR_REASON_DISCONNECTED_BY_SYSTEM = 2,
+    LDNR_REASON_DESTROYED_BY_USER = 3,
+    LDNR_REASON_DESTROYED_BY_SYSTEM = 4,
+    LDNR_REASON_REJECTED = 5,
+    LDNR_REASON_SIGNAL_LOST = 6,
+};
+
+typedef struct ldnr_packet {
+    struct ldnr_packet *next;
+    ldnr_sockaddr source;
+    size_t size, offset;
+    uint8_t data[];
+} ldnr_packet;
+
+typedef struct {
+    int used, type, fd;
+    int nonblocking, recv_timeout_ms, send_timeout_ms;
+    int broadcast, reuse_address;
+    int bound, listening, backlog;
+    int connecting, connected, remote_eof, shut_read, shut_write;
+    int connect_error;
+    int remote_error;                  // peer reset: reported as ECONNRESET
+    int stream_failed;                 // the stream is broken: no more data
+    ldnr_sockaddr local, peer;
+    uint64_t connection_id;
+    uint64_t generation;               // identity of this socket, not its fd
+    ldnr_packet *head, *tail;
+    int queued;
+    size_t queued_bytes;
+    int accept_fds[LDNR_ACCEPT_MAX], accept_head, accept_count;
+} ldnr_vsock;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    uint32_t local_address, subnet_mask;
+    ldnr_vsock sockets[LDNR_MAX_SOCKETS];
+    uint64_t socket_generation;        // identity counter of the sockets
+    // The membership epoch of the socket layer: it moves on every transition
+    // (a membership applied, lost or left), so a frame that was prepared for
+    // one room is caught at the transmit boundary instead of reaching the
+    // next one. Read while preparing under the socket mutex, read again at
+    // the transmit boundary under the stream send lock; advanced with both
+    // held, in that order.
+    uint64_t membership_generation;
+    int failed;                        // the relay is gone: every wait ends
+    void *wait_ctx;
+    void (*native_wait)(void *, int);
+} ldnr_vnet;
+
+struct ldnr {
+    pthread_mutex_t mutex;
+    pthread_mutex_t control;           // serializes complete control operations
+    pthread_mutex_t error_mutex;
+    pthread_mutex_t proxy_mutex;       // guards the table of the proxy opens
+    pthread_cond_t condition;
+    pthread_t receive_thread;
+    int receive_started, owns_transport;
+    _Atomic int stop, transport_open;
+    _Atomic int cancelled;             // every wait must end now
+    _Atomic uint8_t protocol_major;    // the major the relay selected
+    const ldnr_transport *transport;
+    // The optional capabilities of the transport: NULL for a transport that
+    // declares none, in which case the plain contract is used.
+    const ldnr_transport_caps *transport_caps;
+    ldnr_config config;
+    char *server, *room_password, *player_name;
+    int state, disconnect_reason, initialized;
+    int64_t local_communication_id;    // resolves a native id of -1
+    _Atomic int node_id;               // our node id inside the relay room
+    _Atomic uint32_t max_frame;        // frame limit negotiated with the relay
+    uint32_t ipv4, subnet_mask;
+    int has_network, has_network_config, has_security;
+    uint64_t network_id;
+    ldnr_network_info network;
+    ldnr_network_config network_config;
+    ldnr_security_parameter security;
+    ldnr_security_config security_config;
+    ldnr_user_config user_config;
+    // The settings a host may change before the room exists: they are sent
+    // with the create request (native allows them in AccessPoint state).
+    uint8_t pending_advertise[384];
+    uint16_t pending_advertise_size;
+    uint8_t pending_policy;
+    uint8_t pending_filters[16][6];
+    int pending_filter_count;
+    uint64_t scan_ids[LDNR_MAX_NETWORKS];
+    uint8_t scan_sessions[LDNR_MAX_NETWORKS][16];
+    int scan_count;
+    // The local communication version of the connect request in flight: it
+    // is staged before the request goes out, so the acknowledgement can
+    // publish a complete configuration in one step under the core lock.
+    int16_t staged_connect_version;
+    uint64_t next_request_id, pending_request;
+    _Atomic uint64_t connection_id_seq;
+    // The proxied TCP opens that wait for their answer: the relay refuses
+    // an open with an error that carries the request id of the open.
+    struct {
+        uint64_t request_id;
+        uint64_t connection_id;
+        int used;
+    } proxy_opens[LDNR_MAX_PROXY_OPENS];
+    _Atomic uint32_t proxy_request_seq;
+    ldnr_message_type pending_want;
+    int reply_ready, reply_status;
+    ldnr_message reply;
+    ldnr_node_latest_update latest_update;
+    ldnr_node_latest_update history[8];  // one history per node
+    char error[256];
+    ldnr_vnet vnet;
+};
+
+void ldnr_set_errno(int error);
+int ldnr_fail(int error);
+void ldnr_log(ldnr *l, const char *format, ...);
+void ldnr_set_error(ldnr *l, const char *format, ...);
+void ldnr_clear_error(ldnr *l);
+void ldnr_state_set(ldnr *l, int state);
+void ldnr_notify(ldnr *l);            // an observable network change happened
+int64_t ldnr_monotonic_ms(void);
+int ldnr_wait_until(ldnr *l, pthread_cond_t *condition, pthread_mutex_t *mutex,
+                    void *wait_ctx, void (*native_wait)(void *, int), int64_t deadline);
+
+int ldnr_client_open(ldnr *l);
+void ldnr_client_close(ldnr *l);
+int ldnr_client_request(ldnr *l, ldnr_message_type want, ldnr_message_type send_type,
+                        uint64_t network_id, const ldnr_message *message,
+                        const ldnr_operation *operation, ldnr_message *reply_out,
+                        int timeout_ms);
+int ldnr_client_send(ldnr *l, ldnr_message_type type, uint64_t network_id,
+                     const ldnr_message *message, const ldnr_operation *operation);
+// The variant that carries the request id of the frame: the answer of the
+// relay must be able to name the request it belongs to.
+int ldnr_client_send_ex(ldnr *l, ldnr_message_type type, uint64_t request_id,
+                        uint64_t network_id, const ldnr_message *message,
+                        const ldnr_operation *operation);
+// Forgets the proxied open that carries this request id, if it is still
+// waiting for its answer. The relay names a proxied open by its request id
+// when it refuses the open; the vnet layer calls this when it learns of the
+// refusal through the socket state instead of through an ERROR frame.
+void ldnr_proxy_open_forget(ldnr *l, uint64_t request_id);
+// Every proxied open of this context is forgotten: the membership that could
+// answer them is gone, so the table must not keep their entries.
+void ldnr_proxy_open_clear_all(ldnr *l);
+void *ldnr_client_receive_main(void *argument);
+// The membership of the relay ended without the guest asking for it: it is
+// cleared, the sockets that belong to it are marked down and their waiters
+// are woken, and the open state is published with the reason of the loss.
+// The caller holds the core lock.
+void ldnr_membership_retire(ldnr *l, int reason);
+
+void ldnr_vnet_init(ldnr *l);
+void ldnr_vnet_destroy(ldnr *l);
+int ldnr_apply_network(ldnr *l, const ldnr_message *reply,
+                       const ldnr_network_config *config_in);
+void ldnr_vnet_reset(ldnr *l);
+void ldnr_vnet_set_address(ldnr *l, uint32_t address, uint32_t mask);
+void ldnr_vnet_udp(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_connect(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_ack(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_data(ldnr *l, const ldnr_message *message);
+void ldnr_vnet_proxy_disconnect(ldnr *l, const ldnr_message *message);
+// The bytes of a relayed stream are lost: the stream is failed terminally,
+// its waiters are woken, and the relay is told with a reset. The transport
+// is retired when the reset cannot be sent.
+void ldnr_vnet_stream_fail(ldnr *l, uint64_t connection_id);
+void ldnr_vnet_network_down(ldnr *l);
+// The guest asked to leave the room: the membership generation moves before
+// the leave request goes out, so a frame that was prepared for this room is
+// either fully ahead of the leave or dropped at its transmit boundary. The
+// caller holds no socket lock and it is released again before the reply is
+// awaited: a stalled reply must not stall the socket layer.
+void ldnr_vnet_membership_leave(ldnr *l);
+// Every socket wait ends at once: the relay is gone or the context is
+// closing, so no caller may stay blocked.
+void ldnr_vnet_cancel(ldnr *l);
