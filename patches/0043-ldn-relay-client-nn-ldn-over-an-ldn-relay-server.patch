+// A membership that is applied after the network died opens the socket
+// layer again, but the descriptors that saw the loss keep their terminal
+// error: only new descriptors belong to the new network.
+static void test_rejoin_keeps_old_descriptors_terminal(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr peer;
+    ldnr_message incoming;
+    ldnr_message sent;
+    ldnr_pollfd pollfd;
+    char byte = 'x';
+    int fd;
+    int listener;
+    int fresh;
+    int accepted;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    address.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &address) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    // The network dies under the descriptors: every call on them fails and
+    // a poll reports the terminal state instead of waiting.
+    ldnr_vnet_network_down(context);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(5000);
+    pollfd.fd = fd;
+    pollfd.events = LDNR_POLLIN | LDNR_POLLOUT;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLERR);
+    CHECK(ldnr_sendto(context, fd, &byte, 1, 0, &peer) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_recvfrom(context, fd, &byte, 1, 0, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_accept(context, listener, &peer, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+
+    // The rejoin opens the layer for the descriptors that are made for the
+    // new membership.
+    ldnr_vnet_set_address(context, ldnr_ipv4(192, 168, 44, 10), ldnr_htonl(UINT32_C(0xffff0000)));
+    fresh = ldnr_socket(context, 2, 2, 17);
+    CHECK(fresh >= 0);
+    CHECK(ldnr_sendto(context, fresh, &byte, 1, 0, &peer) == 1);
+    pollfd.fd = fresh;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLOUT);
+    CHECK(ldnr_recvfrom(context, fresh, &byte, 1, 0, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+
+    // The descriptors of the dead network stay terminal.
+    pollfd.fd = fd;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLERR);
+    CHECK(ldnr_sendto(context, fd, &byte, 1, 0, &peer) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_recvfrom(context, fd, &byte, 1, 0, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_accept(context, listener, &peer, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+
+    // Its port is held until the dead listener is closed; a new listener on
+    // the new membership accepts again.
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    address.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &address) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x3456789a);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK,
+                       test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK) + 1);
+    accepted = ldnr_accept(context, listener, &peer, 1000);
+    CHECK(accepted >= 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == 0);
+
+    CHECK(ldnr_close_socket(context, accepted) == 0);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    CHECK(ldnr_close_socket(context, fresh) == 0);
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    test_destroy_context(context, api);
+}
+
+// A listener takes the sockets that wait in its accept queue with it: their
+// streams are reset on the relay and their slots are free again, so the
+// queue never hands out a dead descriptor.
+static void test_listener_close_reclaims_queued_children(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr peer;
+    ldnr_message incoming;
+    ldnr_message sent;
+    unsigned acknowledgements;
+    unsigned disconnects;
+    int listener;
+    int first;
+    int second;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &address) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+
+    // The queued child is never accepted: closing the listener resets its
+    // stream on the relay and frees its slot.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(sent.status == 1);   // the stream of the child is reset
+    CHECK(ldnr_accept(context, listener, &peer, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EBADF);
+
+    // Both slots came back: the listener's first, then the child's.
+    first = ldnr_socket(context, 2, 2, 17);
+    second = ldnr_socket(context, 2, 2, 17);
+    CHECK(first == listener);
+    CHECK(second == listener + 1);
+    CHECK(ldnr_close_socket(context, first) == 0);
+    CHECK(ldnr_close_socket(context, second) == 0);
+    test_destroy_context(context, api);
+}
+
+typedef struct {
+    ldnr *context;
+    int fd;
+    int how;
+    int result;
+} test_shutter;
+
+static void *test_shut_thread(void *argument)
+{
+    test_shutter *shutter = argument;
+    shutter->result = ldnr_shutdown(shutter->context, shutter->fd, shutter->how);
+    return NULL;
+}
+
+// A frame that was prepared but is still in flight owns the wire: a close
+// or a shutdown that runs while it is parked must queue behind it. DATA
+// may never go out after its own FIN or RST.
+static void test_data_never_follows_the_fin(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    test_sender sender;
+    test_shutter shutter;
+    pthread_t send_thread;
+    pthread_t shut_thread;
+    static uint8_t payload[16385];
+    unsigned data_frames;
+    unsigned disconnects;
+    int client;
+
+    memset(payload, 0x5a, sizeof(payload));
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+
+    // The second chunk is parked before it reaches the wire: the shutdown
+    // that runs in parallel must not pass it.
+    data_frames = test_sent_count(transport, LDNR_MSG_PROXY_DATA);
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    test_set_flag(transport, &transport->delay_data, 2);
+    sender.context = context;
+    sender.fd = client;
+    sender.data = payload;
+    sender.size = sizeof(payload);
+    sender.result = 0;
+    CHECK(pthread_create(&send_thread, NULL, test_send_thread, &sender) == 0);
+    test_wait_for_flag(transport, &transport->data_delayed);
+
+    shutter.context = context;
+    shutter.fd = client;
+    shutter.how = 1;   // SHUT_WR
+    shutter.result = -1;
+    CHECK(pthread_create(&shut_thread, NULL, test_shut_thread, &shutter) == 0);
+    test_sleep_ms(60);
+    // The FIN could not pass the chunk that is still in flight.
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DATA) == data_frames + 1);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+    test_set_flag(transport, &transport->release_data, 1);
+    CHECK(pthread_join(send_thread, NULL) == 0);
+    CHECK(pthread_join(shut_thread, NULL) == 0);
+    CHECK(shutter.result == 0);
+    CHECK(sender.result == (ssize_t)sizeof(payload));
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DATA) == data_frames + 2);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 0);   // the FIN follows the data, never precedes it
+
+    // The close that follows sends nothing new: the FIN already went out
+    // and the peer's own close will reap the stream.
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_sleep_ms(30);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects + 1);
+    test_destroy_context(context, api);
+}
+
+// A send that is in flight ends when its stream does: whichever terminal
+// frame is applied first decides how much of the buffer goes out, but the
+// wire never sees a DATA frame after the FIN or behind the reset the peer
+// already sent.
+static void test_send_stops_at_shutdown_and_reset(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    ldnr_message incoming;
+    test_sender sender;
+    pthread_t thread;
+    static uint8_t payload[16385];
+    unsigned data_frames;
+    unsigned disconnects;
+    uint64_t connection_id;
+    ssize_t expected;
+    int client;
+    int64_t deadline;
+
+    memset(payload, 0x5a, sizeof(payload));
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+
+    // Shutdown in mid-flight: the second chunk goes out first or not at
+    // all, and the FIN is the last frame either way.
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    data_frames = test_sent_count(transport, LDNR_MSG_PROXY_DATA);
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 1;
+    transport->data_blocked = 0;
+    pthread_mutex_unlock(&transport->mutex);
+    sender.context = context;
+    sender.fd = client;
+    sender.data = payload;
+    sender.size = sizeof(payload);
+    sender.result = 0;
+    CHECK(pthread_create(&thread, NULL, test_send_thread, &sender) == 0);
+    test_wait_for_blocked_data(transport);
+    // The first chunk is in flight: the shutdown waits behind it and then
+    // races the second chunk for the wire.
+    pthread_t shut;
+    test_shutter shutter;
+    shutter.context = context;
+    shutter.fd = client;
+    shutter.how = 1;
+    shutter.result = -1;
+    CHECK(pthread_create(&shut, NULL, test_shut_thread, &shutter) == 0);
+    test_sleep_ms(60);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+    // Whichever frame is applied first wins: the second DATA chunk out
+    // first means a full send, the FIN first means a partial one.
+    deadline = test_now_ms() + 2000;
+    for (;;) {
+        if (test_sent_count(transport, LDNR_MSG_PROXY_DATA) == data_frames + 2) {
+            expected = 16385;
+            break;
+        }
+        if (test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects + 1) {
+            expected = 16384;
+            break;
+        }
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(pthread_join(shut, NULL) == 0);
+    CHECK(shutter.result == 0);
+    CHECK(sender.result == expected);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 0);   // a shutdown writes only the FIN
+    // The close after the FIN sends nothing new.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_sleep_ms(30);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+
+    // A reset from the peer in mid-flight ends the buffer the same way: the
+    // chunk that was already out stays the last one on the wire.
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.port = ldnr_htons(TEST_TCP_PORT + 1);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+    data_frames = test_sent_count(transport, LDNR_MSG_PROXY_DATA);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 1;
+    transport->data_blocked = 0;
+    pthread_mutex_unlock(&transport->mutex);
+    sender.context = context;
+    sender.fd = client;
+    sender.data = payload;
+    sender.size = sizeof(payload);
+    sender.result = 0;
+    CHECK(pthread_create(&thread, NULL, test_send_thread, &sender) == 0);
+    test_wait_for_blocked_data(transport);
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.status = 1;
+    test_push_message(transport, &incoming);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+    // The peer reset lands behind the chunk that was in flight: either it
+    // is applied before the second chunk is sent or it is not.
+    deadline = test_now_ms() + 2000;
+    for (;;) {
+        if (test_sent_count(transport, LDNR_MSG_PROXY_DATA) == data_frames + 2) {
+            expected = 16385;
+            break;
+        }
+        int32_t error = 0;
+        uint32_t error_size = sizeof(error);
+        CHECK(ldnr_getsockopt(context, client, 0, 0x1007, &error, &error_size) == 0);
+        if (error == TEST_ECONNRESET) {
+            expected = 16384;
+            break;
+        }
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(sender.result == expected);
+    // The socket must have taken the reset before the close runs.
+    deadline = test_now_ms() + 2000;
+    for (;;) {
+        int32_t error = 0;
+        uint32_t error_size = sizeof(error);
+        CHECK(ldnr_getsockopt(context, client, 0, 0x1007, &error, &error_size) == 0);
+        if (error == TEST_ECONNRESET) break;
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    // The close of a stream the peer reset is abortive: a reset retires it
+    // at both ends.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 1);
+    test_destroy_context(context, api);
+}
+
+// A select() on an empty set waits for its timeout the way the native call
+// does: unrelated socket activity does not end it, only the deadline or a
+// cancellation does.
+typedef struct {
+    ldnr *context;
+    test_waits *waits;
+    int baseline;
+    int cancel;
+    int fired;
+} test_waker;
+
+static void *test_wake_thread(void *argument)
+{
+    test_waker *waker = argument;
+    int64_t deadline = test_now_ms() + 2000;
+    while (atomic_load(&waker->waits->entered) <= waker->baseline) {
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    waker->fired = 1;
+    if (waker->cancel)
+        ldnr_cancel(waker->context);
+    else
+        // A datagram for another socket wakes the condition of the socket
+        // layer: the empty select must not confuse it with its own wait.
+        CHECK(ldnr_inject_udp(waker->context,
+                              ldnr_ipv4(192, 168, 44, 30), ldnr_htons(6000),
+                              ldnr_ipv4(192, 168, 44, 10), ldnr_htons(TEST_UDP_PORT),
+                              "z", 1) == 0);
+    return NULL;
+}
+
+static void test_empty_select_waits_for_deadline(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    test_waker waker;
+    pthread_t thread;
+    int64_t started;
+    int fd;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+
+    memset(&waker, 0, sizeof(waker));
+    waker.context = context;
+    waker.waits = &waits;
+    waker.baseline = atomic_load(&waits.entered);
+    CHECK(pthread_create(&thread, NULL, test_wake_thread, &waker) == 0);
+    started = test_now_ms();
+    CHECK(ldnr_select(context, 0, NULL, NULL, NULL, 300) == 0);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(waker.fired);
+    // The wake of the other socket did not end the wait: the timeout ran out.
+    CHECK(test_now_ms() - started >= 250);
+
+    memset(&waker, 0, sizeof(waker));
+    waker.context = context;
+    waker.waits = &waits;
+    waker.baseline = atomic_load(&waits.entered);
+    waker.cancel = 1;
+    CHECK(pthread_create(&thread, NULL, test_wake_thread, &waker) == 0);
+    started = test_now_ms();
+    CHECK(ldnr_select(context, 0, NULL, NULL, NULL, 2000) == -1);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(waker.fired);
+    CHECK(ldnr_last_errno() == TEST_ECANCELED);
+    CHECK(test_now_ms() - started < 1500);
+
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    test_destroy_context(context, api);
+}
+
+// An incoming stream exists for the application only after the relay took
+// the acceptance: while the reply is still in flight, accept() must not
+// hand out the child.
+static void test_accept_waits_for_the_reply(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr name;
+    ldnr_sockaddr peer;
+    ldnr_message incoming;
+    ldnr_message sent;
+    unsigned acknowledgements;
+    int listener;
+    int accepted;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    name.address = ldnr_ipv4(192, 168, 44, 10);
+    name.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &name) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+
+    // The acceptance is held inside the transport: the child exists but is
+    // not admitted yet, so accept() finds nothing.
+    test_set_flag(transport, &transport->block_reply, 1);
+    test_push_message(transport, &incoming);
+    test_wait_for_flag(transport, &transport->reply_blocked);
+    CHECK(ldnr_accept(context, listener, &peer, 100) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    test_set_flag(transport, &transport->block_reply, 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+
+    // Once the relay took the reply the child is handed out and can send.
+    accepted = ldnr_accept(context, listener, &peer, 1000);
+    CHECK(accepted >= 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == 0);
+    CHECK(peer.address == incoming.proxy.source_address);
+    CHECK(ldnr_send(context, accepted, "x", 1, 0) == 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.size == 1);
+
+    CHECK(ldnr_close_socket(context, accepted) == 0);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    test_destroy_context(context, api);
+}
+
+// The bytes of a relayed segment are lost: the stream that carried them is
+// failed terminally, a later segment does not fill the hole, and the relay
+// is told with a reset.
+static void test_lost_payload_fails_the_stream(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_message sent;
+    ldnr_message incoming;
+    test_writer writer;
+    unsigned disconnects;
+    uint64_t connection_id;
+    char buffer[64];
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+    CHECK(ldnr_get_sock_name(context, client, &name) == 0);
+
+    // A segment whose declared payload never arrives on the wire: the bytes
+    // that were queued for the stream are gone.
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_u32(&writer, peer.address);
+    test_u16(&writer, ldnr_port_to_host(peer.port));
+    test_u32(&writer, ldnr_ipv4(192, 168, 44, 10));
+    test_u16(&writer, ldnr_port_to_host(name.port));
+    test_u8(&writer, 6);
+    test_u32(&writer, (uint32_t)connection_id);
+    test_u16(&writer, 8);               // the frame declares eight bytes
+    test_put(&writer, "los", 3);        // and carries only three
+    test_finish(&writer, 0x30, 0);
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    test_push_frame(transport, writer.bytes, writer.size);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.status == 1);   // a reset, not a FIN
+    CHECK(sent.reason == 1);   // the delivery of the payload failed
+
+    // The segment that follows the gap must not be delivered: the reader
+    // sees the failure, never a hole in the stream.
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = name.port;
+    test_set_payload(&incoming, "after", 5);
+    test_push_message(transport, &incoming);
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    test_sleep_ms(50);
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    CHECK(ldnr_send(context, client, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+
+    // Closing a broken stream is abortive.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 1);
+    test_destroy_context(context, api);
+}
+
+// A lost membership retires the identities of its streams: the next
+// membership numbers its streams from one again, and an old descriptor
+// must neither take the frames of the new streams nor send closes for
+// them.
+static void test_rejoin_retires_stream_identities(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_network_info info;
+    ldnr_security_config security;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_message sent;
+    ldnr_message incoming;
+    test_writer writer;
+    uint64_t first_id;
+    unsigned disconnects;
+    char buffer[64];
+    int old_tcp;
+    int new_tcp;
+    int old_listener;
+    int64_t deadline;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+
+    // An established stream and a listener of the first membership.
+    old_tcp = ldnr_socket(context, 2, 1, 6);
+    CHECK(old_tcp >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, old_tcp, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    first_id = sent.proxy.connection_id;
+    old_listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(old_listener >= 0);
+    name.address = ldnr_ipv4(192, 168, 44, 10);
+    name.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, old_listener, &name) == 0);
+    CHECK(ldnr_listen(context, old_listener, 2) == 0);
+
+    // The network dies under the sockets and the room membership ends.
+    ldnr_vnet_network_down(context);
+    memset(&writer, 0, sizeof(writer));
+    writer.size = 16;
+    test_finish(&writer, 0x17, 0);   // DISCONNECTED, the way a lost signal reports
+    test_push_frame(transport, writer.bytes, writer.size);
+    memset(&info, 0, sizeof(info));
+    info = test_network_info();
+    memset(&security, 0, sizeof(security));
+    deadline = test_now_ms() + 2000;
+    for (;;) {
+        if (ldnr_connect_network(context, &info, NULL, &security, NULL, NULL, 0, 0) == 0)
+            break;
+        CHECK(ldnr_last_errno() == TEST_EINVAL);
+        CHECK(test_now_ms() < deadline);
+        test_sleep_ms(5);
+    }
+
+    // The new membership numbers its streams from one again: the fresh
+    // connect reuses the connection id of the old stream.
+    new_tcp = ldnr_socket(context, 2, 1, 6);
+    CHECK(new_tcp >= 0);
+    peer.port = ldnr_htons(TEST_TCP_PORT + 1);
+    CHECK(ldnr_connect_socket(context, new_tcp, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    CHECK(sent.proxy.connection_id == first_id);
+    CHECK(ldnr_get_sock_name(context, new_tcp, &name) == 0);
+
+    // A segment for the recycled id reaches only the new socket.
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = first_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = name.port;
+    test_set_payload(&incoming, "fresh", 5);
+    test_push_message(transport, &incoming);
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recv(context, new_tcp, buffer, sizeof(buffer), 0, 1000) == 5);
+    CHECK(memcmp(buffer, "fresh", 5) == 0);
+    CHECK(ldnr_recv(context, old_tcp, buffer, sizeof(buffer), 0, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+    CHECK(ldnr_send(context, old_tcp, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+
+    // The dead listener of the old membership refuses the connections of
+    // the new one instead of queueing them for a dead accept().
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x1111);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK,
+                       test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK) + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == TEST_ECONNREFUSED);
+    CHECK(ldnr_accept(context, old_listener, &peer, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENETDOWN);
+
+    // Closing the dead descriptors emits nothing into the new membership.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, old_tcp) == 0);
+    CHECK(ldnr_close_socket(context, old_listener) == 0);
+    test_sleep_ms(30);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+
+    CHECK(ldnr_close_socket(context, new_tcp) == 0);
+    test_destroy_context(context, api);
+}
+
+// A terminal readiness is reported in every set the descriptor was
+// requested in: a failed connect is writable the way select() reports it,
+// not only exceptional.
+static void test_select_maps_errors_to_sets(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    uint64_t readfds[16], writefds[16], exceptfds[16];
+    uint64_t bit;
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    bit = UINT64_C(1) << (client & 63);
+
+    // A refused connect leaves a terminal error on the socket.
+    transport->proxy_ack_status = TEST_ECONNREFUSED;
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNREFUSED);
+
+    // Selected for writability alone, the failed connect is still reported.
+    memset(readfds, 0, sizeof(readfds));
+    memset(writefds, 0, sizeof(writefds));
+    memset(exceptfds, 0, sizeof(exceptfds));
+    writefds[client >> 6] |= bit;
+    CHECK(ldnr_select(context, client + 1, readfds, writefds, exceptfds, 1000) == 1);
+    CHECK((writefds[client >> 6] & bit) != 0);
+    CHECK((readfds[client >> 6] & bit) == 0);
+    CHECK((exceptfds[client >> 6] & bit) == 0);
+
+    // In every requested set: the same descriptor reports two bits.
+    memset(readfds, 0, sizeof(readfds));
+    memset(writefds, 0, sizeof(writefds));
+    memset(exceptfds, 0, sizeof(exceptfds));
+    readfds[client >> 6] |= bit;
+    writefds[client >> 6] |= bit;
+    CHECK(ldnr_select(context, client + 1, readfds, writefds, exceptfds, 1000) == 2);
+    CHECK((readfds[client >> 6] & bit) != 0);
+    CHECK((writefds[client >> 6] & bit) != 0);
+
+    // The error itself is no exceptional readiness: an exceptfds-only
+    // selection is not woken by it.
+    memset(exceptfds, 0, sizeof(exceptfds));
+    exceptfds[client >> 6] |= bit;
+    CHECK(ldnr_select(context, client + 1, NULL, NULL, exceptfds, 0) == 0);
+    CHECK((exceptfds[client >> 6] & bit) == 0);
+
+    // The same mapping holds for a descriptor the lost network killed.
+    ldnr_vnet_network_down(context);
+    memset(readfds, 0, sizeof(readfds));
+    memset(writefds, 0, sizeof(writefds));
+    memset(exceptfds, 0, sizeof(exceptfds));
+    readfds[client >> 6] |= bit;
+    writefds[client >> 6] |= bit;
+    CHECK(ldnr_select(context, client + 1, readfds, writefds, exceptfds, 1000) == 2);
+    CHECK((readfds[client >> 6] & bit) != 0);
+    CHECK((writefds[client >> 6] & bit) != 0);
+
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_destroy_context(context, api);
+}
+
+// The orderly close of a stream is a FIN that only ends this side's
+// direction: the peer's own close reaps the stream, and a peer that never
+// closes is reset when the bounded linger runs out.
+static void test_close_is_fin_then_linger_reset(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    ldnr_message incoming;
+    uint64_t first_id;
+    uint64_t second_id;
+    unsigned disconnects;
+    int first;
+    int second;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+
+    first = ldnr_socket(context, 2, 1, 6);
+    CHECK(first >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, first, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    first_id = sent.proxy.connection_id;
+    second = ldnr_socket(context, 2, 1, 6);
+    CHECK(second >= 0);
+    peer.port = ldnr_htons(TEST_TCP_PORT + 1);
+    CHECK(ldnr_connect_socket(context, second, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    second_id = sent.proxy.connection_id;
+
+    // The ordinary close sends a FIN: the sending direction is over, the
+    // peer's stays open.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(ldnr_close_socket(context, first) == 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == first_id);
+    CHECK(sent.status == 0);
+
+    // The peer's own FIN reaps the retired stream at both ends: nothing is
+    // answered for it.
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.connection_id = first_id;
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 20);
+    incoming.proxy.source_port = ldnr_htons(TEST_TCP_PORT);
+    incoming.status = 0;
+    test_push_message(transport, &incoming);
+    test_sleep_ms(60);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects + 1);
+
+    // The peer that never closes is reset when the bounded linger ends.
+    CHECK(ldnr_close_socket(context, second) == 0);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 2);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == second_id);
+    CHECK(sent.status == 0);
+    // The linger ends on the socket layer's own clock: the reset that reaps
+    // the stream is sent with no socket call made at all.
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 3);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == second_id);
+    CHECK(sent.status == 1);   // the linger ran out: the stream is reset
+
+    test_destroy_context(context, api);
+}
+
+// A zero SO_RCVTIMEO disables the timeout, the way BSD defines it: the
+// receive waits for a datagram instead of failing at once. An explicit
+// zero call timeout and the nonblocking mode keep their meaning.
+typedef struct {
+    ldnr *context;
+    test_waits *waits;
+    int baseline;
+    int fired;
+} test_udp_waker;
+
+static void *test_udp_wake_thread(void *argument)
+{
+    test_udp_waker *waker = argument;
+    int64_t deadline = test_now_ms() + 2000;
+    while (atomic_load(&waker->waits->entered) <= waker->baseline) {
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    waker->fired = 1;
+    CHECK(ldnr_inject_udp(waker->context, ldnr_ipv4(192, 168, 44, 30),
+                          ldnr_htons(6000), ldnr_ipv4(192, 168, 44, 10),
+                          ldnr_htons(TEST_UDP_PORT), "zero", 4) == 0);
+    return NULL;
+}
+
+static void test_zero_socket_timeout_disables(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr source;
+    test_udp_waker waker;
+    pthread_t thread;
+    int64_t zero[2] = {0, 0};
+    char buffer[32];
+    int fd;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x1006, zero, sizeof zero) == 0);
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x1005, zero, sizeof zero) == 0);
+
+    // The disabled socket timeout: the receive waits for the datagram that
+    // is pushed after the call has blocked.
+    memset(&waker, 0, sizeof(waker));
+    waker.context = context;
+    waker.waits = &waits;
+    waker.baseline = atomic_load(&waits.entered);
+    CHECK(pthread_create(&thread, NULL, test_udp_wake_thread, &waker) == 0);
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0, &source, -2) == 4);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(waker.fired);
+    CHECK(memcmp(buffer, "zero", 4) == 0);
+    CHECK(source.address == ldnr_ipv4(192, 168, 44, 30));
+    CHECK(source.port == ldnr_htons(6000));
+    CHECK(atomic_load(&waits.entered) > waker.baseline);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+
+    // An explicit zero call timeout and the nonblocking mode still do not
+    // wait.
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(ldnr_fcntl(context, fd, 4, 4) == 0);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(ldnr_fcntl(context, fd, 4, 0) == 0);
+
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    test_destroy_context(context, api);
+}
+
+// MSG_DONTWAIT (0x80 in the Horizon numbering) makes one call nonblocking
+// on a descriptor that stays blocking: a receive with the flag answers
+// EAGAIN at once — without entering the wait, even with a positive
+// SO_RCVTIMEO — and the descriptor blocks again on the next plain call.
+static void test_msg_dontwait_is_per_call(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_sockaddr source;
+    ldnr_message sent;
+    ldnr_message incoming;
+    ldnr_pollfd pollfd;
+    char buffer[32];
+    int32_t option;
+    int fd;
+    int client;
+    int entered;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(fd >= 0 && client >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+
+    // A positive SO_RCVTIMEO does not stretch the flagged call either: it
+    // fails at once and never reaches the wait.
+    option = 150;
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x1006, &option, sizeof option) == 0);
+    entered = atomic_load(&waits.entered);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0x80, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) == entered);
+    // recv() on a datagram socket is the same receive: it honors the flag.
+    CHECK(ldnr_recv(context, fd, buffer, sizeof buffer, 0x80, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) == entered);
+    // A queued datagram is returned by the flagged call.
+    CHECK(ldnr_inject_udp(context, ldnr_ipv4(192, 168, 44, 30), ldnr_htons(6000),
+                          ldnr_ipv4(192, 168, 44, 10), ldnr_htons(TEST_UDP_PORT),
+                          "now", 3) == 0);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0x80, &source, -2) == 3);
+    CHECK(memcmp(buffer, "now", 3) == 0);
+    CHECK(source.address == ldnr_ipv4(192, 168, 44, 30));
+
+    // The stream read honors the flag the same way: a connected socket
+    // with nothing queued fails at once.
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    CHECK(ldnr_get_sock_name(context, client, &name) == 0);
+    entered = atomic_load(&waits.entered);
+    CHECK(ldnr_recv(context, client, buffer, sizeof buffer, 0x80, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) == entered);
+    memset(&incoming, 0, sizeof incoming);
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = sent.proxy.connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = name.address;
+    incoming.proxy.destination_port = name.port;
+    test_set_payload(&incoming, "flag", 4);
+    test_push_message(transport, &incoming);
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    // The pushed segment reaches the socket queue through the receive
+    // thread: poll until it is readable so the flagged call is not a race.
+    pollfd.fd = client;
+    pollfd.events = LDNR_POLLIN;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 1000) == 1);
+    CHECK((pollfd.revents & LDNR_POLLIN) != 0);
+    CHECK(ldnr_recv(context, client, buffer, sizeof buffer, 0x80, -2) == 4);
+    CHECK(memcmp(buffer, "flag", 4) == 0);
+
+    // The flag does not change the descriptor: the next plain call waits
+    // on the socket timeout again instead of failing at once.
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof buffer, 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) > entered);
+
+    CHECK(ldnr_close_socket(context, client) == 0);
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
+
+// A blocking connect waits on the clock of SO_SNDTIMEO: the receive
+// timeout belongs to the receive calls and must not end the open early.
+static void test_connect_uses_the_send_timeout(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    int64_t started;
+    int64_t elapsed;
+    int32_t option;
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    // The relay never answers the open: only the socket timeout ends it.
+    transport->auto_proxy_ack = 0;
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    // A short receive timeout would end the open early if it governed it.
+    option = 150;
+    CHECK(ldnr_setsockopt(context, client, 0, 0x1006, &option, sizeof option) == 0);
+    option = 800;
+    CHECK(ldnr_setsockopt(context, client, 0, 0x1005, &option, sizeof option) == 0);
+    started = test_now_ms();
+    CHECK(ldnr_connect_socket(context, client, &peer, -2) == -1);
+    elapsed = test_now_ms() - started;
+    CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+    CHECK(elapsed >= 500);
+    CHECK(ldnr_close_socket(context, client) == 0);
+
+    // The same open with a short send timeout and a long receive one ends
+    // on the send clock instead.
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    option = 2000;
+    CHECK(ldnr_setsockopt(context, client, 0, 0x1006, &option, sizeof option) == 0);
+    option = 120;
+    CHECK(ldnr_setsockopt(context, client, 0, 0x1005, &option, sizeof option) == 0);
+    started = test_now_ms();
+    CHECK(ldnr_connect_socket(context, client, &peer, -2) == -1);
+    elapsed = test_now_ms() - started;
+    CHECK(ldnr_last_errno() == TEST_ETIMEDOUT);
+    CHECK(elapsed >= 60);
+    CHECK(elapsed < 1000);
+    CHECK(ldnr_close_socket(context, client) == 0);
+
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
+
+typedef struct {
+    ldnr *context;
+    int fd;
+    const void *data;
+    size_t size;
+    ldnr_sockaddr destination;
+    ssize_t result;
+} test_sendtor;
+
+static void *test_sendto_thread(void *argument)
+{
+    test_sendtor *sendtor = argument;
+    sendtor->result = ldnr_sendto(sendtor->context, sendtor->fd, sendtor->data,
+                                sendtor->size, 0, &sendtor->destination);
+    return NULL;
+}
+
+typedef struct {
+    ldnr *context;
+    int result;
+} test_leaver;
+
+static void *test_disconnect_thread(void *argument)
+{
+    test_leaver *leaver = argument;
+    leaver->result = ldnr_disconnect(leaver->context);
+    return NULL;
+}
+
+// A datagram that was prepared for the room must never reach the room that
+// replaces it: the membership transition and the in-flight datagram are
+// serialized, so the wire sees it either before the leave or not at all.
+static void test_udp_never_reaches_the_new_room(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_network_info info;
+    ldnr_security_config security;
+    ldnr_sockaddr address;
+    test_sendtor sendtor;
+    test_leaver leaver;
+    pthread_t send_thread;
+    pthread_t leave_thread;
+    unsigned udp_seq;
+    unsigned leave_seq;
+    int fd;
+    int fresh;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+
+    // The datagram is parked inside the transport before it reaches the
+    // wire: the disconnect that runs in parallel must queue behind it, the
+    // datagram may not follow the leave into the next room.
+    test_set_flag(transport, &transport->delay_udp, 1);
+    memset(&sendtor, 0, sizeof(sendtor));
+    sendtor.context = context;
+    sendtor.fd = fd;
+    sendtor.data = "parked";
+    sendtor.size = 6;
+    sendtor.destination.address = ldnr_ipv4(192, 168, 44, 20);
+    sendtor.destination.port = ldnr_htons(5000);
+    CHECK(pthread_create(&send_thread, NULL, test_sendto_thread, &sendtor) == 0);
+    test_wait_for_flag(transport, &transport->udp_delayed);
+
+    memset(&leaver, 0, sizeof(leaver));
+    leaver.context = context;
+    leaver.result = -1;
+    CHECK(pthread_create(&leave_thread, NULL, test_disconnect_thread, &leaver) == 0);
+    test_sleep_ms(60);
+    // The leave waits behind the datagram that is still in flight: nothing
+    // for the old room may follow the datagram, and the datagram may not
+    // follow the leave into the room that replaces it.
+    CHECK(test_sent_count(transport, LDNR_MSG_DISCONNECTED) == 0);
+    CHECK(test_sent_count(transport, LDNR_MSG_UDP) == 0);
+    test_set_flag(transport, &transport->release_udp, 1);
+    CHECK(pthread_join(send_thread, NULL) == 0);
+    CHECK(sendtor.result == 6);
+    CHECK(pthread_join(leave_thread, NULL) == 0);
+    CHECK(leaver.result == 0);
+
+    // The datagram went out while this client was still in the room it was
+    // prepared for: its frame precedes the leave on the wire.
+    CHECK(test_sent_count(transport, LDNR_MSG_UDP) == 1);
+    CHECK(test_sent_count(transport, LDNR_MSG_DISCONNECTED) == 1);
+    udp_seq = test_sent_seq(transport, LDNR_MSG_UDP);
+    leave_seq = test_sent_seq(transport, LDNR_MSG_DISCONNECTED);
+    CHECK(udp_seq != 0 && leave_seq != 0);
+    CHECK(udp_seq < leave_seq);
+
+    // The room it was prepared for is gone: the next membership works on
+    // fresh descriptors, and nothing of the old datagram appears there.
+    info = test_network_info();
+    memset(&security, 0, sizeof(security));
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, NULL, NULL, 0, 0) == 0);
+    fresh = ldnr_socket(context, 2, 2, 17);
+    CHECK(fresh >= 0);
+    CHECK(ldnr_sendto(context, fresh, "new", 3, 0, &sendtor.destination) == 3);
+    CHECK(test_sent_count(transport, LDNR_MSG_UDP) == 2);
+    CHECK(test_sent_seq(transport, LDNR_MSG_UDP) > leave_seq);
+    CHECK(ldnr_close_socket(context, fresh) == 0);
+    test_destroy_context(context, api);
+}
+
+// A network-down drops the children that wait in a listener's accept queue:
+// they belonged to the lost membership, so their slots and their packet
+// queues are freed instead of leaking as descriptors that were never
+// handed out.
+static void test_network_down_reclaims_queued_children(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_message incoming;
+    int listener;
+    int held;
+    int first;
+    int second;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &address) == 0);
+    CHECK(ldnr_listen(context, listener, 4) == 0);
+
+    // Two streams are answered and queued, but the application never
+    // accepted them: they hold their slots.
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK,
+                       test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK) + 1);
+    incoming.proxy.connection_id = UINT64_C(0x2345678a);
+    incoming.proxy.source_port = ldnr_htons(8001);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK,
+                       test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK) + 1);
+    held = ldnr_socket(context, 2, 2, 17);
+    CHECK(held == listener + 3);
+    CHECK(ldnr_close_socket(context, held) == 0);
+
+    ldnr_vnet_network_down(context);
+
+    // The queued children were never handed out: their slots came back.
+    first = ldnr_socket(context, 2, 2, 17);
+    second = ldnr_socket(context, 2, 2, 17);
+    CHECK(first == listener + 1);
+    CHECK(second == listener + 2);
+    CHECK(ldnr_close_socket(context, first) == 0);
+    CHECK(ldnr_close_socket(context, second) == 0);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    test_destroy_context(context, api);
+}
+
+// A read shutdown closes only the reading direction: what the peer still
+// sends is dropped at the door, the queue never grows into a reset, and
+// the stream keeps writing. The reads answer the end of the stream
+// consistently.
+static void test_shut_read_discards_incoming(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    ldnr_message incoming;
+    uint64_t connection_id;
+    unsigned disconnects;
+    int client;
+    char buffer[64];
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+
+    CHECK(ldnr_shutdown(context, client, 0) == 0);   // SHUT_RD
+    CHECK(ldnr_recv(context, client, buffer, sizeof buffer, 0, 0) == 0);
+
+    // The peer keeps sending: every segment is dropped at the door and the
+    // read still reports the end of the stream.
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    for (int i = 0; i < 80; i++) {
+        test_set_payload(&incoming, "more", 4);
+        test_push_message_slow(transport, &incoming);
+        free(incoming.proxy.data);
+        incoming.proxy.data = NULL;
+    }
+    test_sleep_ms(60);
+    // A queue that grew under the shutdown would have overflowed into a
+    // reset by now: nothing was sent and the stream is not failed.
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+    CHECK(ldnr_recv(context, client, buffer, sizeof buffer, 0, 0) == 0);
+
+    // The sending direction keeps working.
+    CHECK(ldnr_send(context, client, "y", 1, 0) == 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.proxy.size == 1 && memcmp(sent.proxy.data, "y", 1) == 0);
+
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_destroy_context(context, api);
+}
+
+// A relay that accepts smaller frames than the chunk size still carries the
+// whole send: the split follows the negotiated limit, minus the fields of
+// the PROXY_DATA payload itself.
+static void test_send_respects_the_frame_limit(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    static uint8_t payload[3000];
+    int client;
+
+    // The handshake announces a 1024-byte payload limit: the PROXY_DATA
+    // fields take 19 of them, so a frame carries 1005 bytes of payload.
+    transport->max_frame = 1024;
+    memset(payload, 0x5a, sizeof(payload));
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+
+    transport->data_size_count = 0;
+    CHECK(ldnr_send(context, client, payload, sizeof payload, 0) ==
+          (ssize_t)sizeof payload);
+    // 1005 + 1005 + 990 = 3000: no frame asks for more than the limit.
+    CHECK(transport->data_size_count == 3);
+    CHECK(transport->data_sizes[0] == 1005);
+    CHECK(transport->data_sizes[1] == 1005);
+    CHECK(transport->data_sizes[2] == 990);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_destroy_context(context, api);
+}
+
+// A sweeper that cannot be started retires the stream with the fallback
+// reset of the close instead of leaving it half-open on the relay. This
+// runs as the first test so that no sweeper can already be watching.
+static void test_sweeper_failure_sends_reset(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    uint64_t connection_id;
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+
+    // The sweeper's spawn fails the way a resource exhaustion would.
+    ldnr_test_sweeper_create_fails = 1;
+    CHECK(ldnr_close_socket(context, client) == 0);
+    ldnr_test_sweeper_create_fails = 0;
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    // The linger could not run: the stream is retired with the reset that
+    // replaces it, not with the FIN of the orderly close.
+    CHECK(sent.status == 1);
+
+    test_destroy_context(context, api);
+}
+
+// A socket that dies before its first chunk reports the loss with the
+// descriptor error: no byte is counted as sent and no frame of the dead
+// stream goes out.
+static void test_send_reports_the_lost_socket(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    test_closer closer;
+    pthread_t close_thread;
+    unsigned data_frames;
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+
+    // The close is parked inside the transport with the socket already
+    // cleared: a send on the dead descriptor sees what the send boundary
+    // sees and fails with the descriptor error, not a partial count.
+    test_set_flag(transport, &transport->delay_disconnect, 1);
+    memset(&closer, 0, sizeof(closer));
+    closer.context = context;
+    closer.fd = client;
+    closer.result = -1;
+    CHECK(pthread_create(&close_thread, NULL, test_close_thread, &closer) == 0);
+    test_wait_for_flag(transport, &transport->disconnect_delayed);
+
+    data_frames = test_sent_count(transport, LDNR_MSG_PROXY_DATA);
+    CHECK(ldnr_send(context, client, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EBADF);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DATA) == data_frames);
+
+    test_set_flag(transport, &transport->release_disconnect, 1);
+    CHECK(pthread_join(close_thread, NULL) == 0);
+    CHECK(closer.result == 0);
+    // The orderly close went out as a FIN once it was let through.
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 0);
+    test_destroy_context(context, api);
+}
+
+int main(void)
