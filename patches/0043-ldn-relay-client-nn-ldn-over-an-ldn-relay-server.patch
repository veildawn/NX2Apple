+int ldnr_getsockopt(ldnr *l, int fd, int level, int option, void *value, uint32_t *size);
+int ldnr_poll(ldnr *l, ldnr_pollfd *fds, size_t count, int timeout_ms);
+int ldnr_select(ldnr *l, int nfds, uint64_t *readfds, uint64_t *writefds,
+                uint64_t *exceptfds, int timeout_ms);
+uint32_t ldnr_ipv4(unsigned a, unsigned b, unsigned c, unsigned d);
+uint16_t ldnr_htons(uint16_t value);
+uint32_t ldnr_htonl(uint32_t value);
+
+// The relay and the socket layer carry an address as the four network octets
+// in one word (10.114.0.1 -> 0x0100720A), while nn::ldn keeps the host-order
+// value (10.114.0.1 -> 0x0A720001). These convert between the two forms.
+uint32_t ldnr_ipv4_to_native(uint32_t wire);
+uint32_t ldnr_ipv4_from_native(uint32_t native);
