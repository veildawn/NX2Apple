+/* The relay carries the four network octets in one word, nn::ldn keeps the
+ * host order value: 10.114.0.1 is 0x0100720a on the wire and 0x0A720001 in
+ * the guest structures. */
+static void test_address_and_port_conversions(void)
+{
+    CHECK(ldnr_ipv4_to_native(UINT32_C(0x0100720A)) == UINT32_C(0x0A720001));
+    CHECK(ldnr_ipv4_from_native(UINT32_C(0x0A720001)) == UINT32_C(0x0100720A));
+    CHECK(ldnr_ipv4_to_native(UINT32_C(0x080A720A)) == UINT32_C(0x0A720A08));
+    CHECK(ldnr_port_to_host(UINT16_C(0x9C40)) == UINT16_C(0x409C));
+    CHECK(ldnr_port_from_host(UINT16_C(0x409C)) == UINT16_C(0x9C40));
+}
