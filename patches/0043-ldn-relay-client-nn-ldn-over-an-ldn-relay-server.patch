+// The local communication version reaches the relay and stays in the
+// configuration of the connection.
+static void test_communication_version(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr_network_info info = test_network_info();
+    ldnr_network_config actual_network;
+    ldnr *context = NULL;
+
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.connect_timeout_ms = 200;
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_station(context) == 0);
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+    memcpy(user.user_name, "guest", 5);
+
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0x1234) == 0);
+    CHECK(transport->connect_version == 0x1234);
+    CHECK(ldnr_get_network_config(context, &actual_network) == 0);
+    CHECK(actual_network.local_communication_version == 0x1234);
+
+    // The version is a number of its own: 0x0 to 0x7FFF.
+    CHECK(ldnr_disconnect(context) == 0);
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, 0x8000) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+    CHECK(ldnr_connect_network(context, &info, NULL, &security, &user, NULL, 0, -1) == -1);
+    CHECK(ldnr_last_errno() == TEST_EINVAL);
+
+    ldnr_destroy(context);
+    free((void *)api);
+}
