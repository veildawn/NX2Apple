+    message.node_id = 3;
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_REJECT_ACK,
+                               UINT64_C(0x01020304), 0, &message, NULL) == 0);
+    CHECK(output[5] == 0x1a);
+    CHECK(size == 17);
+    CHECK(output[16] == 3);
+
+    memcpy(operation.mac, "\x02\x4c\x44\x4e\x00\x07", 6);
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_FILTER_ACK,
+                               UINT64_C(0x01020304), 0, &message, &operation) == 0);
+    CHECK(output[5] == 0x1b);
+    CHECK(size == 22);
+
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size,
+                               LDNR_MSG_CLEAR_FILTER_ACK, UINT64_C(0x01020304), 0,
+                               &message, NULL) == 0);
+    CHECK(output[5] == 0x1c);
+    CHECK(size == 16);
+
+    decode_ok(reject_ack_frame, sizeof(reject_ack_frame), &message);
