+/* The payload of a PROXY_DATA message is heap allocated: a relayed segment
+ * may be larger than the chunk this client sends. */
+static void set_proxy_payload(ldnr_message *message, const uint8_t *data, size_t size)
+{
+    message->proxy.size = size;
+    message->proxy.data = malloc(size ? size : 1);
+    CHECK(message->proxy.data != NULL);
+    if (size) memcpy(message->proxy.data, data, size);
