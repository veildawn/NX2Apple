+static void test_record_trailing_extensions(void)
+{
+    uint8_t extended[sizeof(scan_result_frame) + 2];
+    ldnr_message message;
+
+    /* Extra bytes at the end of a Ping payload are left for a newer minor. */
+    memcpy(extended, ping_frame, sizeof(ping_frame));
+    extended[sizeof(ping_frame)] = 0xa5;
+    put32(extended + 8, 9);
+    decode_ok(extended, sizeof(ping_frame) + 1, &message);
+    CHECK(message.request_id == UINT64_C(0x11121314));
+    CHECK(message.timestamp == UINT64_C(0x0102030405060708));
+    ldnr_protocol_message_free(&message);
+
+    /* ConnectAck ends in NetworkInfo, so growing that record appends an
+     * extension without changing any outer record. */
+    memcpy(extended, connect_ack_frame, sizeof(connect_ack_frame));
+    extended[sizeof(connect_ack_frame)] = 0xde;
+    extended[sizeof(connect_ack_frame) + 1] = 0xad;
+    put16(extended + 27, 475);
+    put32(extended + 8, 488);
+    decode_ok(extended, sizeof(connect_ack_frame) + 2, &message);
+    CHECK(message.network_id == UINT64_C(0x1122334455667788));
+    check_network_info(&message.network_info);
+    ldnr_protocol_message_free(&message);
+
+    /* ScanEntry is independently length-delimited. */
+    memcpy(extended, scan_result_frame, sizeof(scan_result_frame));
+    extended[sizeof(scan_result_frame)] = 0xbe;
+    extended[sizeof(scan_result_frame) + 1] = 0xef;
+    put16(extended + 21, 483);
+    put32(extended + 8, 490);
+    decode_ok(extended, sizeof(scan_result_frame) + 2, &message);
+    CHECK(message.network_count == 1);
+    check_network_info(&message.networks[0].info);
+    ldnr_protocol_message_free(&message);
+
+    /* Extend node zero inside both enclosing records. Offsets are from the
+     * fixed fixture above: frame 16, scan prefix 5, entry prefix 2, network
+     * prefix 2, and 69 NetworkInfo body bytes before the node records. */
+    memcpy(extended, scan_result_frame, 144);
+    extended[144] = 0x11;
+    extended[145] = 0x22;
+    memcpy(extended + 146, scan_result_frame + 144, sizeof(scan_result_frame) - 144);
+    put16(extended + 94, 50);
+    put16(extended + 23, 475);
+    put16(extended + 21, 483);
+    put32(extended + 8, 490);
+    decode_ok(extended, sizeof(scan_result_frame) + 2, &message);
+    CHECK(message.network_count == 1);
+    check_network_info(&message.networks[0].info);
+    ldnr_protocol_message_free(&message);
+}
