+/* The native filter flags and the relay flags use different bits: the relay
+ * knows the communication id, the scene id, the session and the SSID. The
+ * network type and the BSSID have no relay equivalent. */
+static void test_scan_filter_flag_mapping(void)
+{
+    ldnr_scan_filter filter;
+    ldnr_operation operation;
+    uint8_t output[128];
+    size_t size = 0;
+
+    memset(&filter, 0, sizeof(filter));
+    memset(&operation, 0, sizeof(operation));
+    operation.scan_filter = &filter;
+
+    filter.flags = 0x01;   // LocalCommunicationId
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x01);
+
+    filter.flags = 0x02;   // SessionId
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x04);
+
+    filter.flags = 0x20;   // SceneId
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x02);
+
+    filter.flags = 0x10;   // Ssid
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x08);
+
+    filter.flags = 0x08;   // Bssid, the relay bit 0x10 of protocol 1.2
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x10);
+
+    filter.flags = 0x04;   // NetworkType, the relay bit 0x20 of protocol 1.2
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x20);
+
+    filter.flags = 0x3b;   // every relay known flag at once
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_SCAN_ACK,
+                               UINT64_C(0x01020304), 0, NULL, &operation) == 0);
+    CHECK(output[LDNR_WIRE_HEADER] == 0x1f);
+}
