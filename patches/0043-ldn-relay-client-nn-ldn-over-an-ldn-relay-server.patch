+// The relay room password is a user secret. A transport that does not say
+// that it protects the bytes may well be a plaintext stream: the create is
+// refused before the password goes out.
+static void test_room_password_is_refused_locally(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    ldnr_config config;
+    ldnr_network_config network;
+    ldnr_security_config security;
+    ldnr_user_config user;
+    ldnr *context = NULL;
+    int before;
+
+    memset(&config, 0, sizeof(config));
+    config.transport = api;
+    config.server = "relay.test:11470";
+    config.room_password = "a-secret";
+    config.connect_timeout_ms = 200;
+
+    memset(&network, 0, sizeof(network));
+    network.node_count_max = 4;
+    memset(&security, 0, sizeof(security));
+    memset(&user, 0, sizeof(user));
+
+    CHECK(ldnr_create(&config, &context) == 0);
+    CHECK(ldnr_initialize(context) == 0);
+    CHECK(ldnr_open_access_point(context) == 0);
+    before = test_sent_count(transport);
+    // The refusal is local: nothing goes out to the relay.
+    CHECK(ldnr_create_network(context, &network, &security, &user, NULL, NULL, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ETLSREQUIRED);
+    CHECK(test_sent_count(transport) == before);
+    // The room was not created: the state stays in the access point.
+    CHECK(ldnr_get_state(context) == TEST_STATE_AP_OPEN);
+    ldnr_destroy(context);
+    free((void *)api);
+}
