+static void test_udp(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    ldnr_sockaddr name;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr source;
+    ldnr_message sent;
+    ldnr_pollfd pollfd;
+    uint64_t readfds[16];
+    char buffer[32];
+    int32_t option;
+    uint32_t option_size;
+    int fd;
+    int other;
+    int ephemeral;
+    int entered;
+    int exited;
+    ssize_t size;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    other = ldnr_socket(context, 2, 2, 17);
+    ephemeral = ldnr_socket(context, 2, 2, 0);
+    CHECK(fd >= 0 && other >= 0 && ephemeral >= 0);
+
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+    CHECK(ldnr_get_sock_name(context, fd, &name) == 0);
+    CHECK(name.address == address.address && name.port == address.port);
+    CHECK(ldnr_bind(context, other, &address) == -1);
+    CHECK(ldnr_last_errno() == TEST_EADDRINUSE);
+    address.address = ldnr_ipv4(192, 168, 44, 99);
+    CHECK(ldnr_bind(context, other, &address) == -1);
+    CHECK(ldnr_last_errno() == TEST_EADDRNOTAVAIL);
+    address.address = 0;
+    address.port = ldnr_htons(TEST_OTHER_UDP_PORT);
+    CHECK(ldnr_bind(context, other, &address) == 0);
+    CHECK(ldnr_get_peer_name(context, other, &peer) == -1);
+    CHECK(ldnr_last_errno() == TEST_ENOTCONN);
+
+    address.address = 0;
+    address.port = 0;
+    CHECK(ldnr_bind(context, ephemeral, &address) == 0);
+    CHECK(ldnr_get_sock_name(context, ephemeral, &name) == 0);
+    CHECK(name.address == ldnr_ipv4(192, 168, 44, 10));
+    CHECK(ldnr_htons(name.port) >= 49152 && ldnr_htons(name.port) <= 65535);
+
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(5000);
+    CHECK(ldnr_sendto(context, fd, "unicast", 7, 0, &peer) == 7);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.source_address == ldnr_ipv4(192, 168, 44, 10));
+    CHECK(sent.udp.source_port == ldnr_htons(TEST_UDP_PORT));
+    CHECK(sent.udp.destination_address == peer.address);
+    CHECK(sent.udp.destination_port == peer.port);
+    CHECK(sent.udp.size == 7 && memcmp(sent.udp.data, "unicast", 7) == 0);
+
+    option = 1;
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x20, &option, sizeof(option)) == 0);
+    option = 0;
+    option_size = sizeof(option);
+    CHECK(ldnr_getsockopt(context, fd, 0, 0x20, &option, &option_size) == 0);
+    CHECK(option_size == sizeof(option) && option == 1);
+    peer.address = UINT32_C(0xffffffff);
+    CHECK(ldnr_sendto(context, fd, "broadcast", 9, 0, &peer) == 9);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.destination_address == UINT32_C(0xffffffff));
+    CHECK(sent.udp.destination_port == ldnr_htons(5000));
+    CHECK(sent.udp.size == 9 && memcmp(sent.udp.data, "broadcast", 9) == 0);
+
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    CHECK(ldnr_connect_socket(context, other, &peer, 0) == 0);
+    CHECK(ldnr_get_peer_name(context, other, &peer) == 0);
+    CHECK(peer.address == ldnr_ipv4(192, 168, 44, 20));
+    CHECK(peer.port == ldnr_htons(5000));
+    CHECK(ldnr_send(context, other, "connected", 9, 0) == 9);
+    test_last_message(transport, LDNR_MSG_UDP, &sent);
+    CHECK(sent.udp.destination_address == peer.address);
+    CHECK(sent.udp.destination_port == peer.port);
+    CHECK(sent.udp.source_port == ldnr_htons(TEST_OTHER_UDP_PORT));
+
+    CHECK(ldnr_inject_udp(context, peer.address, peer.port,
+                          ldnr_ipv4(192, 168, 44, 10), ldnr_htons(TEST_OTHER_UDP_PORT),
+                          "datagram", 8) == 0);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recvfrom(context, other, buffer, sizeof(buffer), 2, &source, 0);
+    CHECK(size == 8 && memcmp(buffer, "datagram", 8) == 0);
+    CHECK(source.address == peer.address && source.port == peer.port);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recvfrom(context, other, buffer, sizeof(buffer), 0, &source, 0);
+    CHECK(size == 8 && memcmp(buffer, "datagram", 8) == 0);
+
+    CHECK(ldnr_fcntl(context, fd, 3, 0) == 0);
+    CHECK(ldnr_fcntl(context, fd, 4, 4) == 0);
+    CHECK(ldnr_fcntl(context, fd, 3, 0) == 4);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(ldnr_fcntl(context, fd, 4, 0) == 0);
+    option = 10;
+    CHECK(ldnr_setsockopt(context, fd, 0, 0x1006, &option, sizeof(option)) == 0);
+    entered = atomic_load(&waits.entered);
+    exited = atomic_load(&waits.exited);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, NULL, -2) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+    CHECK(atomic_load(&waits.entered) > entered);
+    CHECK(atomic_load(&waits.exited) > exited);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+
+    pollfd.fd = fd;
+    pollfd.events = LDNR_POLLIN | LDNR_POLLOUT;
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 0) == 1);
+    CHECK(pollfd.revents == LDNR_POLLOUT);
+    memset(readfds, 0, sizeof(readfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    CHECK(ldnr_select(context, fd + 1, readfds, NULL, NULL, 0) == 0);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) == 0);
+
+    CHECK(ldnr_inject_udp(context, ldnr_ipv4(192, 168, 44, 30), ldnr_htons(6000),
+                          UINT32_C(0xffffffff), ldnr_htons(TEST_UDP_PORT),
+                          "b-in", 4) == 0);
+    pollfd.revents = 0;
+    CHECK(ldnr_poll(context, &pollfd, 1, 1000) == 1);
+    CHECK((pollfd.revents & LDNR_POLLIN) != 0);
+    memset(readfds, 0, sizeof(readfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    CHECK(ldnr_select(context, fd + 1, readfds, NULL, NULL, 1000) == 1);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) != 0);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, &source, 0) == 4);
+    CHECK(memcmp(buffer, "b-in", 4) == 0);
+    CHECK(source.address == ldnr_ipv4(192, 168, 44, 30));
+
+    /* A connected datagram socket shut for writing must refuse send() just
+     * like sendto(): no UDP frame may leave after SHUT_WR. */
+    {
+        unsigned frames = test_sent_count(transport, LDNR_MSG_UDP);
+        CHECK(ldnr_shutdown(context, other, 1) == 0);
+        CHECK(ldnr_send(context, other, "late", 4, 0) == -1);
+        CHECK(ldnr_last_errno() == TEST_EPIPE);
+        CHECK(ldnr_sendto(context, other, "late", 4, 0, &peer) == -1);
+        CHECK(ldnr_last_errno() == TEST_EPIPE);
+        CHECK(test_sent_count(transport, LDNR_MSG_UDP) == frames);
+    }
+
+    CHECK(ldnr_close_socket(context, ephemeral) == 0);
+    CHECK(ldnr_close_socket(context, other) == 0);
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
+
+typedef struct {
+    test_transport *transport;
+    test_waits *waits;
+    int baseline;
+    ldnr_message message;
+    int fired;
+} test_delayed_push;
+
+static void *test_push_after_wait(void *argument)
+{
+    test_delayed_push *delayed = argument;
+    int64_t deadline = test_now_ms() + 2000;
+    while (atomic_load(&delayed->waits->entered) <= delayed->baseline) {
+        if (test_now_ms() >= deadline)
+            return NULL;
+        sched_yield();
+    }
+    delayed->fired = 1;
+    test_push_message(delayed->transport, &delayed->message);
+    return NULL;
+}
+
+static void test_tcp(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_message sent;
+    ldnr_message incoming;
+    test_delayed_push delayed;
+    pthread_t thread;
+    uint64_t connection_id;
+    char buffer[32];
+    int client;
+    int listener;
+    int accepted;
+    int baseline;
+    ssize_t size;
+    unsigned acknowledgements;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    CHECK(ldnr_get_peer_name(context, client, &name) == 0);
+    CHECK(name.address == peer.address && name.port == peer.port);
+    CHECK(ldnr_get_sock_name(context, client, &name) == 0);
+    CHECK(name.address == ldnr_ipv4(192, 168, 44, 10) && name.port != 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+    CHECK(connection_id != 0);
+    CHECK(sent.proxy.destination_address == peer.address);
+    CHECK(sent.proxy.destination_port == peer.port);
+
+    CHECK(ldnr_send(context, client, "hello", 5, 0) == 5);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.proxy.size == 5 && memcmp(sent.proxy.data, "hello", 5) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = name.port;
+    test_set_payload(&incoming, "stream", 6);
+    memset(&delayed, 0, sizeof(delayed));
+    delayed.transport = transport;
+    delayed.waits = &waits;
+    delayed.baseline = atomic_load(&waits.entered);
+    delayed.message = incoming;
+    CHECK(pthread_create(&thread, NULL, test_push_after_wait, &delayed) == 0);
+    memset(buffer, 0, sizeof(buffer));
+    size = ldnr_recv(context, client, buffer, 2, 2, 1000);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(delayed.fired);
+    // The payload of the pushed frame belongs to the test.
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    CHECK(size == 2 && memcmp(buffer, "st", 2) == 0);
+    CHECK(atomic_load(&waits.entered) > delayed.baseline);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    CHECK(ldnr_recv(context, client, buffer, 2, 0, 0) == 2);
+    CHECK(memcmp(buffer, "st", 2) == 0);
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 0) == 4);
+    CHECK(memcmp(buffer, "ream", 4) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.connection_id = connection_id;
+    test_push_message(transport, &incoming);
+    baseline = 0;
+    while (baseline++ < 1000) {
+        size = ldnr_recv(context, client, buffer, sizeof(buffer), 0, 10);
+        if (size == 0)
+            break;
+        CHECK(size == -1 && ldnr_last_errno() == TEST_EAGAIN);
+    }
+    CHECK(size == 0);
+    // A plain FIN closes the sending side of the peer only: the stream can
+    // still be written to.
+    CHECK(ldnr_send(context, client, "x", 1, 0) == 1);
+    // Closing the descriptor is the orderly close of this direction: a FIN
+    // ends it, and the peer's own close reaps the stream.
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.status == 0);   // a full close is a FIN, not a reset
+
+    // A reset is an error, not an orderly end of file.
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 50);
+    peer.port = ldnr_htons(9100);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    CHECK(sent.proxy.connection_id != connection_id);
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.connection_id = sent.proxy.connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.status = 1;   // the relay marks a reset with the first flag bit
+    test_push_message(transport, &incoming);
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    CHECK(ldnr_send(context, client, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    CHECK(ldnr_close_socket(context, client) == 0);
+
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    name.address = ldnr_ipv4(192, 168, 44, 10);
+    name.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &name) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+    memset(&delayed, 0, sizeof(delayed));
+    delayed.transport = transport;
+    delayed.waits = &waits;
+    delayed.baseline = atomic_load(&waits.entered);
+    delayed.message = incoming;
+    CHECK(pthread_create(&thread, NULL, test_push_after_wait, &delayed) == 0);
+    accepted = ldnr_accept(context, listener, &peer, 1000);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(delayed.fired);
+    CHECK(accepted >= 0);
+    CHECK(peer.address == incoming.proxy.source_address);
+    CHECK(peer.port == incoming.proxy.source_port);
+    CHECK(atomic_load(&waits.entered) > delayed.baseline);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == 0);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(ldnr_get_peer_name(context, accepted, &peer) == 0);
+    CHECK(peer.address == incoming.proxy.source_address);
+    CHECK(peer.port == incoming.proxy.source_port);
+    CHECK(ldnr_get_sock_name(context, accepted, &name) == 0);
+    CHECK(name.address == incoming.proxy.destination_address);
+    CHECK(name.port == incoming.proxy.destination_port);
+
+    CHECK(ldnr_send(context, accepted, "reply", 5, 0) == 5);
+    test_last_message(transport, LDNR_MSG_PROXY_DATA, &sent);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(sent.proxy.size == 5 && memcmp(sent.proxy.data, "reply", 5) == 0);
+
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    free(incoming.proxy.data);
+    test_set_payload(&incoming, "request", 7);
+    test_push_message(transport, &incoming);
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recv(context, accepted, buffer, sizeof(buffer), 0, 1000) == 7);
+    CHECK(memcmp(buffer, "request", 7) == 0);
+    incoming.type = LDNR_MSG_PROXY_DISCONNECT;
+    incoming.proxy.size = 0;
+    test_push_message(transport, &incoming);
+    CHECK(ldnr_recv(context, accepted, buffer, sizeof(buffer), 0, 1000) == 0);
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    CHECK(ldnr_close_socket(context, accepted) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == incoming.proxy.connection_id);
+    CHECK(sent.status == 0);   // the peer closed already: our FIN completes it
+    CHECK(ldnr_close_socket(context, listener) == 0);
+
+    transport->proxy_ack_status = TEST_ECONNREFUSED;
+    client = ldnr_socket(context, 2, 1, 6);
+    peer.address = ldnr_ipv4(192, 168, 44, 40);
+    peer.port = ldnr_htons(9000);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNREFUSED);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
+
+// Only the descriptors that are in one of the sets are polled: an unused
+// descriptor below nfds must not wake the call, and a selected descriptor
+// that is not a socket is an error.
+static void test_select_descriptors(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    uint64_t readfds[16], writefds[16], exceptfds[16];
+    char buffer[32];
+    int64_t started;
+    int fd;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+
+    // nfds covers every descriptor below the socket, but only the socket is
+    // in a set: the call waits for it instead of returning at once.
+    memset(readfds, 0, sizeof(readfds));
+    memset(writefds, 0, sizeof(writefds));
+    memset(exceptfds, 0, sizeof(exceptfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    started = test_now_ms();
+    CHECK(ldnr_select(context, fd + 1, readfds, writefds, exceptfds, 50) == 0);
+    CHECK(test_now_ms() - started >= 40);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) == 0);
+
+    // A selected descriptor that is not a socket is an error, the way
+    // select() reports a bad descriptor.
+    memset(readfds, 0, sizeof(readfds));
+    readfds[0] |= UINT64_C(1) << 3;
+    CHECK(ldnr_select(context, fd + 1, readfds, writefds, exceptfds, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_EBADF);
+
+    // A datagram wakes the call.
+    CHECK(ldnr_inject_udp(context, ldnr_ipv4(192, 168, 44, 30), ldnr_htons(6000),
+                          ldnr_ipv4(192, 168, 44, 10), ldnr_htons(TEST_UDP_PORT),
+                          "wake", 4) == 0);
+    memset(readfds, 0, sizeof(readfds));
+    readfds[fd >> 6] |= UINT64_C(1) << (fd & 63);
+    CHECK(ldnr_select(context, fd + 1, readfds, writefds, exceptfds, 1000) == 1);
+    CHECK((readfds[fd >> 6] & (UINT64_C(1) << (fd & 63))) != 0);
+    CHECK(ldnr_recvfrom(context, fd, buffer, sizeof(buffer), 0, NULL, 0) == 4);
+
+    CHECK(ldnr_close_socket(context, fd) == 0);
+    test_destroy_context(context, api);
+}
+
+// The connection ids live in a namespace of their own: the high byte is the
+// node id of the client, so two clients of the same room never pick the same
+// id for their first stream.
+static void test_connection_id_namespace(void)
+{
+    test_transport *first_transport;
+    test_transport *second_transport;
+    const ldnr_transport *first_api = test_transport_create(&first_transport);
+    const ldnr_transport *second_api = test_transport_create(&second_transport);
+    test_waits first_waits;
+    test_waits second_waits;
+    ldnr *first;
+    ldnr *second;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    uint64_t first_id, second_id, next_id;
+    int first_socket, second_socket;
+
+    atomic_init(&first_waits.entered, 0);
+    atomic_init(&first_waits.exited, 0);
+    atomic_init(&second_waits.entered, 0);
+    atomic_init(&second_waits.exited, 0);
+    first_transport->node_id = 3;
+    second_transport->node_id = 4;
+    first = test_connected_context(first_api, &first_waits);
+    second = test_connected_context(second_api, &second_waits);
+
+    first_socket = ldnr_socket(first, 2, 1, 6);
+    CHECK(first_socket >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 60);
+    peer.port = ldnr_htons(9200);
+    CHECK(ldnr_connect_socket(first, first_socket, &peer, 1000) == 0);
+    test_last_message(first_transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    first_id = sent.proxy.connection_id;
+    CHECK((first_id >> 24) == 3);
+
+    second_socket = ldnr_socket(second, 2, 1, 6);
+    CHECK(second_socket >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 61);
+    peer.port = ldnr_htons(9201);
+    CHECK(ldnr_connect_socket(second, second_socket, &peer, 1000) == 0);
+    test_last_message(second_transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    second_id = sent.proxy.connection_id;
+    CHECK((second_id >> 24) == 4);
+    CHECK(first_id != second_id);
+
+    // The next id of a client stays inside its own namespace.
+    first_socket = ldnr_socket(first, 2, 1, 6);
+    CHECK(first_socket >= 0);
+    peer.port = ldnr_htons(9202);
+    CHECK(ldnr_connect_socket(first, first_socket, &peer, 1000) == 0);
+    test_last_message(first_transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    next_id = sent.proxy.connection_id;
+    CHECK((next_id >> 24) == 3);
+    CHECK(next_id != first_id);
+
+    CHECK(ldnr_close_socket(first, first_socket) == 0);
+    CHECK(ldnr_close_socket(second, second_socket) == 0);
+    test_destroy_context(first, first_api);
+    test_destroy_context(second, second_api);
+}
+
+// An incoming connection with an id that is already in use belongs to another
+// stream: the relay may reset such a collision, so it is refused here.
+static void test_incoming_collision(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr name;
+    ldnr_sockaddr peer;
+    ldnr_message incoming;
+    ldnr_message sent;
+    int listener;
+    int accepted;
+    unsigned acknowledgements;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    listener = ldnr_socket(context, 2, 1, 6);
+    CHECK(listener >= 0);
+    name.address = ldnr_ipv4(192, 168, 44, 10);
+    name.port = ldnr_htons(TEST_LISTEN_PORT);
+    CHECK(ldnr_bind(context, listener, &name) == 0);
+    CHECK(ldnr_listen(context, listener, 2) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_CONNECT;
+    incoming.proxy.connection_id = UINT64_C(0x23456789);
+    incoming.proxy.source_address = ldnr_ipv4(192, 168, 44, 30);
+    incoming.proxy.source_port = ldnr_htons(8000);
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = ldnr_htons(TEST_LISTEN_PORT);
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == 0);
+    accepted = ldnr_accept(context, listener, &peer, 1000);
+    CHECK(accepted >= 0);
+
+    // The same id a second time is refused: the relay would reset one of the
+    // two streams.
+    acknowledgements = test_sent_count(transport, LDNR_MSG_PROXY_CONNECT_ACK);
+    test_push_message(transport, &incoming);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_CONNECT_ACK, acknowledgements + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT_ACK, &sent);
+    CHECK(sent.status == TEST_ECONNREFUSED);
+    CHECK(ldnr_accept(context, listener, &peer, 100) == -1);
+    CHECK(ldnr_last_errno() == TEST_EAGAIN);
+
+    CHECK(ldnr_close_socket(context, accepted) == 0);
+    CHECK(ldnr_close_socket(context, listener) == 0);
+    test_destroy_context(context, api);
+}
+
+// A send that is in flight when its socket is closed and reused must not
+// put the rest of the buffer on the socket that took the slot.
+typedef struct {
+    ldnr *context;
+    int fd;
+    const uint8_t *data;
+    size_t size;
+    ssize_t result;
+} test_sender;
+
+static void *test_send_thread(void *argument)
+{
+    test_sender *sender = argument;
+    sender->result = ldnr_send(sender->context, sender->fd, sender->data,
+                                sender->size, 0);
+    return NULL;
+}
+
+typedef struct {
+    ldnr *context;
+    int fd;
+    int result;
+} test_closer;
+
+static void *test_close_thread(void *argument)
+{
+    test_closer *closer = argument;
+    closer->result = ldnr_close_socket(closer->context, closer->fd);
+    return NULL;
+}
+
+static void test_wait_for_blocked_data(test_transport *transport)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&transport->mutex);
+    while (!transport->data_blocked) {
+        int result = pthread_cond_timedwait(&transport->condition, &transport->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+    }
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_wait_for_flag(test_transport *transport, int *flag)
+{
+    struct timespec deadline;
+    CHECK(clock_gettime(CLOCK_REALTIME, &deadline) == 0);
+    deadline.tv_sec += 2;
+    pthread_mutex_lock(&transport->mutex);
+    while (!*flag) {
+        int result = pthread_cond_timedwait(&transport->condition, &transport->mutex,
+                                            &deadline);
+        CHECK(result != ETIMEDOUT);
+    }
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_set_flag(test_transport *transport, int *flag, int value)
+{
+    pthread_mutex_lock(&transport->mutex);
+    *flag = value;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+}
+
+static void test_send_keeps_the_socket_identity(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    test_sender sender;
+    pthread_t thread;
+    static uint8_t payload[16385];
+    unsigned data_frames;
+    int client;
+    int replacement;
+
+    memset(payload, 0x5a, sizeof(payload));
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+
+    data_frames = test_sent_count(transport, LDNR_MSG_PROXY_DATA);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 1;
+    pthread_mutex_unlock(&transport->mutex);
+    sender.context = context;
+    sender.fd = client;
+    sender.data = payload;
+    sender.size = sizeof(payload);
+    sender.result = 0;
+    CHECK(pthread_create(&thread, NULL, test_send_thread, &sender) == 0);
+    test_wait_for_blocked_data(transport);
+    // The close waits for the chunk that is in flight: it cannot retire the
+    // stream underneath it, so it is parked on its own thread.
+    test_closer closer;
+    pthread_t close_thread;
+    unsigned disconnects;
+    closer.context = context;
+    closer.fd = client;
+    closer.result = -1;
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(pthread_create(&close_thread, NULL, test_close_thread, &closer) == 0);
+    test_sleep_ms(60);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+    pthread_mutex_lock(&transport->mutex);
+    transport->block_data = 0;
+    pthread_cond_broadcast(&transport->condition);
+    pthread_mutex_unlock(&transport->mutex);
+    CHECK(pthread_join(close_thread, NULL) == 0);
+    CHECK(closer.result == 0);
+    // The slot came back and a new socket took it while the send was still
+    // in flight.
+    replacement = ldnr_socket(context, 2, 1, 6);
+    CHECK(replacement == client);
+    CHECK(pthread_join(thread, NULL) == 0);
+    // The tail did not follow the descriptor to the socket that took its
+    // slot: only the chunks that raced ahead of the close went out.
+    CHECK(sender.result == 16384 || sender.result == 16385);
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DATA) ==
+          data_frames + (sender.result == 16385 ? 2 : 1));
+    CHECK(ldnr_close_socket(context, replacement) == 0);
+    test_destroy_context(context, api);
+}
+
+typedef struct {
+    ldnr *context;
+    int fd;
+    ldnr_sockaddr peer;
+    int result;
+    int error;              // the thread's own error code, read on that thread
+} test_connecter;
+
+static void *test_connect_thread(void *argument)
+{
+    test_connecter *connecter = argument;
+    connecter->result = ldnr_connect_socket(connecter->context, connecter->fd,
+                                            &connecter->peer, 1000);
+    connecter->error = connecter->result < 0 ? ldnr_last_errno() : 0;
+    return NULL;
+}
+
+// A close that runs while its open is still in flight queues behind it: the
+// wire sees the open first and the reset second, so the relay never keeps a
+// stream that has no descriptor here.
+static void test_close_never_passes_the_open(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_message sent;
+    test_connecter connecter;
+    test_closer closer;
+    pthread_t connect_thread;
+    pthread_t close_thread;
+    uint64_t connection_id;
+    unsigned disconnects;
+    int client;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+
+    // The relay's answer is not wanted: the stream stays in the opening
+    // state, so the close that follows sends a reset.
+    transport->auto_proxy_ack = 0;
+    // The open is parked inside the transport before it reaches the wire:
+    // the close that starts now must queue behind it, not pass it.
+    test_set_flag(transport, &transport->delay_open, 1);
+    memset(&connecter, 0, sizeof(connecter));
+    connecter.context = context;
+    connecter.fd = client;
+    connecter.peer = peer;
+    connecter.result = -2;
+    CHECK(pthread_create(&connect_thread, NULL, test_connect_thread, &connecter) == 0);
+    test_wait_for_flag(transport, &transport->open_delayed);
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    closer.context = context;
+    closer.fd = client;
+    closer.result = -1;
+    CHECK(pthread_create(&close_thread, NULL, test_close_thread, &closer) == 0);
+    test_sleep_ms(60);
+    // The reset could not pass the open that is still in flight.
+    CHECK(test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT) == disconnects);
+    test_set_flag(transport, &transport->release_open, 1);
+    CHECK(pthread_join(connect_thread, NULL) == 0);
+    CHECK(pthread_join(close_thread, NULL) == 0);
+    CHECK(closer.result == 0);
+    // The descriptor died under the connect: the open is reported as lost.
+    CHECK(connecter.result == -1);
+    CHECK(connecter.error == TEST_EBADF);
+    // The wire saw the open first and the reset second: the relay reaps the
+    // stream instead of keeping an orphan with no local socket.
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    pthread_mutex_lock(&transport->mutex);
+    connection_id = transport->last_open_id;
+    pthread_mutex_unlock(&transport->mutex);
+    CHECK(connection_id != 0);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.proxy.connection_id == connection_id);
+    CHECK(sent.status == 1);
+    test_destroy_context(context, api);
+}
+
+// A stream that overflowed is broken: no byte that arrives after the gap
+// may reach the application, and the peer is told with a reset.
+static void test_stream_overflow_is_terminal(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr peer;
+    ldnr_sockaddr name;
+    ldnr_message sent;
+    ldnr_message incoming;
+    static uint8_t chunk[16384];
+    unsigned disconnects;
+    uint64_t connection_id;
+    char buffer[64];
+    int client;
+    int i;
+
+    memset(chunk, 0x33, sizeof(chunk));
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    client = ldnr_socket(context, 2, 1, 6);
+    CHECK(client >= 0);
+    peer.address = ldnr_ipv4(192, 168, 44, 20);
+    peer.port = ldnr_htons(TEST_TCP_PORT);
+    CHECK(ldnr_connect_socket(context, client, &peer, 1000) == 0);
+    test_last_message(transport, LDNR_MSG_PROXY_CONNECT, &sent);
+    connection_id = sent.proxy.connection_id;
+    CHECK(ldnr_get_sock_name(context, client, &name) == 0);
+
+    memset(&incoming, 0, sizeof(incoming));
+    incoming.type = LDNR_MSG_PROXY_DATA;
+    incoming.proxy.connection_id = connection_id;
+    incoming.proxy.source_address = peer.address;
+    incoming.proxy.source_port = peer.port;
+    incoming.proxy.destination_address = ldnr_ipv4(192, 168, 44, 10);
+    incoming.proxy.destination_port = name.port;
+    // The queue of the stream takes 64 segments; the one after that does
+    // not fit any more.
+    for (i = 0; i < 65; i++) {
+        test_set_payload(&incoming, chunk, sizeof(chunk));
+        test_push_message_slow(transport, &incoming);
+        free(incoming.proxy.data);
+        incoming.proxy.data = NULL;
+    }
+    // The peer is told that the stream was reset: the wait for that frame
+    // makes the order of the reader and the failure deterministic.
+    disconnects = test_sent_count(transport, LDNR_MSG_PROXY_DISCONNECT);
+    test_wait_for_send(transport, LDNR_MSG_PROXY_DISCONNECT, disconnects + 1);
+    test_last_message(transport, LDNR_MSG_PROXY_DISCONNECT, &sent);
+    CHECK(sent.status == 1);   // the relay marks a reset with the first flag bit
+    CHECK(sent.reason == 1);   // the delivery of the payload failed
+    // The reader sees the reset, not the bytes that were queued before it.
+    memset(buffer, 0, sizeof(buffer));
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    // A frame that arrives after the reset is not queued either.
+    test_set_payload(&incoming, "late", 4);
+    test_push_message(transport, &incoming);
+    free(incoming.proxy.data);
+    incoming.proxy.data = NULL;
+    CHECK(ldnr_recv(context, client, buffer, sizeof(buffer), 0, 1000) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    CHECK(ldnr_send(context, client, "x", 1, 0) == -1);
+    CHECK(ldnr_last_errno() == TEST_ECONNRESET);
+    CHECK(ldnr_close_socket(context, client) == 0);
+    test_destroy_context(context, api);
+}
