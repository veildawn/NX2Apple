+/* The ports in a message are the socket ones (network byte order); the wire
+ * carries the plain numbers. */
+static void check_udp_message(const ldnr_message *message)
+{
+    CHECK(message->type == LDNR_MSG_UDP);
+    CHECK(message->request_id == UINT64_C(0x44332211));
+    CHECK(message->udp.source_address == UINT32_C(0x0100720a));
+    CHECK(message->udp.source_port == ldnr_port_from_host(40000));
+    CHECK(message->udp.destination_address == UINT32_C(0x0200720a));
+    CHECK(message->udp.destination_port == ldnr_port_from_host(40001));
+    CHECK(message->udp.size == 3);
+    CHECK(message->udp.data[0] == 0xaa);
+    CHECK(message->udp.data[1] == 0x55);
+    CHECK(message->udp.data[2] == 0xff);
+}
+
+static void check_tcp_tuple(const ldnr_message *message)
+{
+    CHECK(message->proxy.connection_id == UINT64_C(0x11223344));
+    CHECK(message->proxy.source_address == UINT32_C(0x0100720a));
+    CHECK(message->proxy.source_port == ldnr_port_from_host(40000));
+    CHECK(message->proxy.destination_address == UINT32_C(0x0200720a));
+    CHECK(message->proxy.destination_port == ldnr_port_from_host(40001));
+}
