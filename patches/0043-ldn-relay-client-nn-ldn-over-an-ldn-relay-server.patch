+static void test_tcp_proxy_messages(void)
+{
+    ldnr_message message;
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0100720a);
+    message.proxy.source_port = ldnr_port_from_host(40000);
+    message.proxy.destination_address = UINT32_C(0x0200720a);
+    message.proxy.destination_port = ldnr_port_from_host(40001);
+    encode_ok(tcp_connect_frame, sizeof(tcp_connect_frame), LDNR_MSG_PROXY_CONNECT,
+              UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_connect_frame, sizeof(tcp_connect_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_CONNECT);
+    check_tcp_tuple(&message);
+    ldnr_protocol_message_free(&message);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0200720a);
+    message.status = 0;
+    encode_ok(tcp_connect_reply_frame, sizeof(tcp_connect_reply_frame),
+              LDNR_MSG_PROXY_CONNECT_ACK, UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_connect_reply_frame, sizeof(tcp_connect_reply_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_CONNECT_ACK);
+    CHECK(message.proxy.connection_id == UINT64_C(0x11223344));
+    CHECK(message.proxy.source_address == UINT32_C(0x0200720a));
+    CHECK(message.status == 0);
+    ldnr_protocol_message_free(&message);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0100720a);
+    message.proxy.source_port = ldnr_port_from_host(40000);
+    message.proxy.destination_address = UINT32_C(0x0200720a);
+    message.proxy.destination_port = ldnr_port_from_host(40001);
+    set_proxy_payload(&message, (const uint8_t *)"\x01\x02\x03", 3);
+    encode_ok(tcp_data_frame, sizeof(tcp_data_frame), LDNR_MSG_PROXY_DATA,
+              UINT64_C(0x44332211), 0, &message, NULL);
+    free(message.proxy.data); message.proxy.data = NULL;
+    decode_ok(tcp_data_frame, sizeof(tcp_data_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_DATA);
+    check_tcp_tuple(&message);
+    CHECK(message.proxy.size == 3);
+    CHECK(message.proxy.data[0] == 1 && message.proxy.data[1] == 2 &&
+          message.proxy.data[2] == 3);
+    ldnr_protocol_message_free(&message);
+
+    memset(&message, 0, sizeof(message));
+    message.proxy.connection_id = UINT64_C(0x11223344);
+    message.proxy.source_address = UINT32_C(0x0100720a);
+    message.status = 1;
+    message.reason = 2;
+    encode_ok(tcp_disconnect_frame, sizeof(tcp_disconnect_frame),
+              LDNR_MSG_PROXY_DISCONNECT, UINT64_C(0x44332211), 0, &message, NULL);
+    decode_ok(tcp_disconnect_frame, sizeof(tcp_disconnect_frame), &message);
+    CHECK(message.type == LDNR_MSG_PROXY_DISCONNECT);
+    CHECK(message.proxy.connection_id == UINT64_C(0x11223344));
+    CHECK(message.proxy.source_address == UINT32_C(0x0100720a));
+    CHECK(message.status != 0);
+    CHECK(message.reason == 2);
+    ldnr_protocol_message_free(&message);
+}
