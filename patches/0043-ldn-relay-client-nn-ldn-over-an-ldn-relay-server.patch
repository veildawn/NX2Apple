+/* The client answers a message it cannot read with an error that names the
+ * request it belongs to. */
+static void test_error_encoding(void)
+{
+    uint8_t output[512];
+    size_t size = 0;
+    ldnr_message message;
+    static const char text[] = "unsupported message type";
+
+    memset(&message, 0, sizeof(message));
+    message.error_code = 2;   /* the relay's own UNSUPPORTED */
+    snprintf(message.text, sizeof(message.text), "%s", text);
+    CHECK(ldnr_protocol_encode(output, sizeof(output), &size, LDNR_MSG_ERROR,
+                               UINT64_C(0x11223344), 0, &message, NULL) == 0);
+    CHECK(output[5] == 0x05);
+    CHECK(output[12] == 0x44 && output[13] == 0x33 && output[14] == 0x22 &&
+          output[15] == 0x11);
+    /* The payload is the code, the length of the text and the text. */
+    CHECK(output[LDNR_WIRE_HEADER] == 2 && output[LDNR_WIRE_HEADER + 1] == 0);
+    CHECK(output[LDNR_WIRE_HEADER + 2] == (uint8_t)sizeof(text) - 1);
+    CHECK(output[LDNR_WIRE_HEADER + 3] == 0);
+    CHECK(memcmp(output + LDNR_WIRE_HEADER + 4, text, sizeof(text) - 1) == 0);
+    CHECK(size == LDNR_WIRE_HEADER + 4 + sizeof(text) - 1);
+}
