+++ b/dm/host/ldnr/tests/Makefile
@@ -0,0 +1,60 @@
+CC ?= cc
+# The build output stays inside the source tree: it is removed with "make
+# clean" and never lands outside the checkout.
+BUILD_DIR ?= $(CURDIR)/build
+CPPFLAGS += -D_POSIX_C_SOURCE=200809L -I..
+# macOS hides the BSD names (INADDR_LOOPBACK among them) behind a strict
+# POSIX feature level, so the Darwin sources are enabled as well.
+UNAME_S := $(shell uname -s)
+ifeq ($(UNAME_S),Darwin)
+CPPFLAGS += -D_DARWIN_C_SOURCE
+endif
+CFLAGS ?= -O2 -g
+CFLAGS += -std=c11 -Wall -Wextra -Werror -pedantic
+LDLIBS += -pthread
+
+CORE := ../ldnr_native.c ../ldnr_protocol.c ../ldnr_tcp.c \
+        ../ldnr_vnet.c ../ldnr_client.c ../ldnr.c
+TESTS := t_native t_protocol t_state t_vnet t_ldnr_e2e t_tcp t_glue
+BINARIES := $(addprefix $(BUILD_DIR)/,$(TESTS))
+
+.PHONY: all run glue-check clean
+all: $(BINARIES) glue-check
+
+$(BUILD_DIR):
+	mkdir -p $@
+
+$(BUILD_DIR)/t_native: t_native.c ../ldnr_native.c | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) ../ldnr_native.c $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_protocol: t_protocol.c ../ldnr_protocol.c | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) ../ldnr_protocol.c $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_state: t_state.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_vnet: t_vnet.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_ldnr_e2e: t_ldnr_e2e.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CORE) $< $(LDLIBS) -o $@
+
+$(BUILD_DIR)/t_tcp: t_tcp.c ../ldnr_tcp.c | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) ../ldnr_tcp.c $< $(LDLIBS) -o $@
+
+# The glue unity-includes the core: a single translation unit, and the glue
+# entry table casts a function pointer to void * (Mach-O section entries),
+# which -pedantic rejects.
+$(BUILD_DIR)/t_glue: t_glue.c ../../hle_ldnr.c $(CORE) | $(BUILD_DIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -Wno-pedantic -I../.. -DLDNR_GLUE_RUNTIME_TEST \
+		-DLDNR_GLUE_SYNTAX_TEST $< $(LDLIBS) -o $@
+
+glue-check:
+	$(CC) -std=c11 -D_POSIX_C_SOURCE=200809L -DLDNR_GLUE_SYNTAX_TEST \
+		-Wall -Wextra -Werror -fsyntax-only -I../.. -I.. ../../hle_ldnr.c
+
+run: all
+	@set -e; for test in $(BINARIES); do $$test; done
+
+clean:
+	rm -rf $(BUILD_DIR)
