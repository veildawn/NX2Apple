+static void check_network_info(const ldnr_network_info *info)
+{
+    static const uint8_t bssid[] = {0x02, 0x00, 0x00, 0x00, 0x00, 0x01};
+    static const uint8_t mac[] = {0x02, 0x4c, 0x44, 0x4e, 0x00, 0x01};
+    size_t i;
+
+    CHECK(info->network_id.intent_id.local_communication_id ==
+          INT64_C(0x0102030405060708));
+    CHECK(info->network_id.intent_id.scene_id == 0x1234);
+    for (i = 0; i < 16; ++i) {
+        CHECK(info->network_id.session_id[i] == i);
+        CHECK(info->server_random[i] == 0x10 + i);
+    }
+    CHECK(memcmp(info->common.bssid, bssid, sizeof(bssid)) == 0);
+    CHECK(info->common.ssid.length == 3);
+    CHECK(memcmp(info->common.ssid.string, "ldn", 3) == 0);
+    CHECK(info->common.channel == 11);
+    CHECK(info->common.link_level == 3);
+    CHECK(info->common.network_type == 2);
+    CHECK(info->security_mode == 1);
+    CHECK(info->station_accept_policy == 0);
+    CHECK(info->node_count_max == 8);
+    CHECK(info->node_count == 1);
+    /* 10.114.0.1: the relay sends 0x0100720a, nn::ldn keeps 0x0A720001. */
+    CHECK(info->nodes[0].ipv4_address == UINT32_C(0x0A720001));
+    CHECK(memcmp(info->nodes[0].mac_address, mac, sizeof(mac)) == 0);
+    CHECK(info->nodes[0].node_id == 0);
+    CHECK(info->nodes[0].is_connected == 1);
+    CHECK(memcmp(info->nodes[0].user_name, "host", 4) == 0);
+    CHECK(info->nodes[0].local_communication_version == 2);
+    for (i = 1; i < LDNR_NATIVE_NODE_COUNT_MAX; ++i)
+        CHECK(info->nodes[i].is_connected == 0);
+    CHECK(info->advertise_data_size == 2);
+    CHECK(info->advertise_data[0] == 0xaa);
+    CHECK(info->advertise_data[1] == 0xbb);
+}
