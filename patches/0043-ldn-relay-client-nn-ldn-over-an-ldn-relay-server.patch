+// A blocked poll ends when its core is cancelled: the datagram socket with
+// no queued packet reports a terminal readiness instead of spinning, and a
+// wait that has no descriptor to report comes back with an explicit error.
+typedef struct {
+    ldnr *context;
+    int fd;
+    int result;
+    int error;              // the thread's own error code, read on that thread
+    int16_t revents;
+} test_poller;
+
+static void *test_poll_thread(void *argument)
+{
+    test_poller *poller = argument;
+    ldnr_pollfd pollfd;
+    pollfd.fd = poller->fd;
+    pollfd.events = LDNR_POLLIN;
+    pollfd.revents = 0;
+    poller->result = ldnr_poll(poller->context, &pollfd, 1, -1);
+    // The error of the call lives on the thread that made it.
+    poller->error = poller->result < 0 ? ldnr_last_errno() : 0;
+    poller->revents = pollfd.revents;
+    return NULL;
+}
+
+static void test_poll_cancellation_ends(void)
+{
+    test_transport *transport;
+    const ldnr_transport *api = test_transport_create(&transport);
+    test_waits waits;
+    ldnr *context;
+    ldnr_sockaddr address;
+    test_poller poller;
+    pthread_t thread;
+    int64_t deadline;
+    int baseline;
+    int fd;
+
+    atomic_init(&waits.entered, 0);
+    atomic_init(&waits.exited, 0);
+    context = test_connected_context(api, &waits);
+    fd = ldnr_socket(context, 2, 2, 17);
+    CHECK(fd >= 0);
+    address.address = ldnr_ipv4(192, 168, 44, 10);
+    address.port = ldnr_htons(TEST_UDP_PORT);
+    CHECK(ldnr_bind(context, fd, &address) == 0);
+
+    // A poll without a descriptor to report ends with an explicit error.
+    memset(&poller, 0, sizeof(poller));
+    poller.context = context;
+    poller.fd = -1;
+    baseline = atomic_load(&waits.entered);
+    CHECK(pthread_create(&thread, NULL, test_poll_thread, &poller) == 0);
+    deadline = test_now_ms() + 2000;
+    while (atomic_load(&waits.entered) <= baseline) {
+        CHECK(test_now_ms() < deadline);
+        sched_yield();
+    }
+    ldnr_cancel(context);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(poller.result == -1);
+    CHECK(poller.error == TEST_ECANCELED);
+
+    // A poll on the datagram socket ends with a terminal readiness instead
+    // of waiting for a packet that can no longer arrive.
+    memset(&poller, 0, sizeof(poller));
+    poller.context = context;
+    poller.fd = fd;
+    CHECK(pthread_create(&thread, NULL, test_poll_thread, &poller) == 0);
+    CHECK(pthread_join(thread, NULL) == 0);
+    CHECK(poller.result == 1);
+    CHECK(poller.revents == LDNR_POLLERR);
+    CHECK(atomic_load(&waits.entered) == atomic_load(&waits.exited));
+    test_destroy_context(context, api);
+}
